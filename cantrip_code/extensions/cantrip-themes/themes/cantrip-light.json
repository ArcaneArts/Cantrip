{
  "$schema": "vscode://schemas/color-theme",
  "name": "Cantrip Light",
  "type": "light",
  "colors": {
    "foreground": "#20242A",
    "descriptionForeground": "#636A74",
    "disabledForeground": "#8A9098",
    "focusBorder": "#526C91",
    "errorForeground": "#B4232C",
    "editor.background": "#00000000",
    "editorStickyScroll.background": "#F8F9FB80",
    "editorStickyScrollGutter.background": "#F8F9FB80",
    "editorGroup.emptyBackground": "#00000000",
    "editorGroupHeader.tabsBackground": "#00000000",
    "tab.activeBackground": "#00000018",
    "tab.inactiveBackground": "#00000000",
    "tab.unfocusedActiveBackground": "#00000012",
    "tab.unfocusedInactiveBackground": "#00000000",
    "editor.foreground": "#282C33",
    "editorLineNumber.foreground": "#9BA0A8",
    "editorLineNumber.activeForeground": "#444A53",
    "editorCursor.foreground": "#20242A",
    "editor.lineHighlightBackground": "#00000008",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#B7CAE699",
    "editor.inactiveSelectionBackground": "#D2DDEC99",
    "editorWidget.background": "#FFFFFF",
    "editorWidget.border": "#D8DBE0",
    "sideBar.background": "#00000000",
    "sideBar.foreground": "#343941",
    "sideBarSectionHeader.background": "#00000000",
    "activityBar.background": "#00000000",
    "activityBar.foreground": "#20242A",
    "activityBar.inactiveForeground": "#7A8089",
    "titleBar.activeBackground": "#00000000",
    "titleBar.inactiveBackground": "#00000000",
    "titleBar.activeForeground": "#20242A",
    "statusBar.background": "#00000000",
    "statusBar.noFolderBackground": "#00000000",
    "statusBar.foreground": "#343941",
    "panel.background": "#00000000",
    "panelSectionHeader.background": "#00000000",
    "panel.border": "#DFE2E7",
    "terminal.background": "#00000000",
    "breadcrumb.background": "#00000000",
    "input.background": "#00000000",
    "input.border": "#D4D7DC",
    "dropdown.background": "#FFFFFF",
    "dropdown.border": "#D4D7DC",
    "list.activeSelectionBackground": "#E3E8F0",
    "list.hoverBackground": "#EFF1F4",
    "button.background": "#252A31",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#111419"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#747B85" }
    },
    {
      "scope": ["keyword", "storage"],
      "settings": { "foreground": "#744A9C" }
    },
    {
      "scope": ["string", "constant.other.symbol"],
      "settings": { "foreground": "#477326" }
    },
    {
      "scope": ["constant.numeric", "constant.language"],
      "settings": { "foreground": "#985C19" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#245E9A" }
    },
    {
      "scope": ["entity.name.type", "support.type"],
      "settings": { "foreground": "#16706B" }
    }
  ]
}
