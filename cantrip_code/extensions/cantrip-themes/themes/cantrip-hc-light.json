{
  "$schema": "vscode://schemas/color-theme",
  "name": "Cantrip High Contrast Light",
  "type": "light",
  "colors": {
    "foreground": "#000000",
    "descriptionForeground": "#303030",
    "focusBorder": "#0000004D",
    "contrastActiveBorder": "#00000000",
    "contrastBorder": "#00000026",
    "settings.focusedRowBackground": "#0000000D",
    "settings.focusedRowBorder": "#00000000",
    "editor.background": "#00000000",
    "editorGroup.emptyBackground": "#00000000",
    "editorGroupHeader.tabsBackground": "#00000000",
    "tab.activeBackground": "#0000001F",
    "tab.inactiveBackground": "#00000000",
    "tab.unfocusedActiveBackground": "#00000018",
    "tab.unfocusedInactiveBackground": "#00000000",
    "editor.foreground": "#000000",
    "editorCursor.foreground": "#000000",
    "editorLineNumber.foreground": "#303030",
    "editorLineNumber.activeForeground": "#000000",
    "editor.lineHighlightBackground": "#0000000D",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#B7D7FF",
    "sideBar.background": "#00000000",
    "sideBarSectionHeader.background": "#00000000",
    "sideBar.foreground": "#000000",
    "activityBar.background": "#00000000",
    "activityBar.foreground": "#000000",
    "titleBar.activeBackground": "#00000000",
    "titleBar.inactiveBackground": "#00000000",
    "titleBar.activeForeground": "#000000",
    "statusBar.background": "#00000000",
    "statusBar.noFolderBackground": "#00000000",
    "statusBar.foreground": "#000000",
    "panel.background": "#00000000",
    "panelSectionHeader.background": "#00000000",
    "terminal.background": "#00000000",
    "breadcrumb.background": "#00000000",
    "input.background": "#00000000",
    "input.foreground": "#000000",
    "dropdown.background": "#FFFFFF",
    "dropdown.foreground": "#000000",
    "list.activeSelectionBackground": "#B7D7FF",
    "button.background": "#000000",
    "button.foreground": "#FFFFFF"
  },
  "tokenColors": [
    { "scope": ["comment"], "settings": { "foreground": "#3F3F3F" } },
    {
      "scope": ["keyword", "storage"],
      "settings": { "foreground": "#6B006B" }
    },
    { "scope": ["string"], "settings": { "foreground": "#075F07" } },
    {
      "scope": ["constant", "entity.name.function", "entity.name.type"],
      "settings": { "foreground": "#005A70" }
    }
  ]
}
