{
  "$schema": "vscode://schemas/color-theme",
  "name": "Cantrip High Contrast Dark",
  "type": "dark",
  "colors": {
    "foreground": "#FFFFFF",
    "descriptionForeground": "#D0D0D0",
    "focusBorder": "#FFFFFF4D",
    "contrastActiveBorder": "#FFFFFF00",
    "contrastBorder": "#FFFFFF26",
    "settings.focusedRowBackground": "#FFFFFF0D",
    "settings.focusedRowBorder": "#FFFFFF00",
    "editor.background": "#000000",
    "editor.foreground": "#FFFFFF",
    "editorCursor.foreground": "#FFFFFF",
    "editor.lineHighlightBackground": "#FFFFFF0D",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#1F4B78",
    "sideBar.background": "#000000",
    "sideBar.foreground": "#FFFFFF",
    "activityBar.background": "#000000",
    "activityBar.foreground": "#FFFFFF",
    "titleBar.activeBackground": "#000000",
    "titleBar.activeForeground": "#FFFFFF",
    "statusBar.background": "#000000",
    "statusBar.foreground": "#FFFFFF",
    "panel.background": "#000000",
    "input.background": "#000000",
    "input.foreground": "#FFFFFF",
    "dropdown.background": "#000000",
    "dropdown.foreground": "#FFFFFF",
    "list.activeSelectionBackground": "#1F4B78",
    "button.background": "#FFFFFF",
    "button.foreground": "#000000"
  },
  "tokenColors": [
    { "scope": ["comment"], "settings": { "foreground": "#D0D0D0" } },
    {
      "scope": ["keyword", "storage"],
      "settings": { "foreground": "#FF9DFF" }
    },
    { "scope": ["string"], "settings": { "foreground": "#9DFF9D" } },
    {
      "scope": ["constant", "entity.name.function", "entity.name.type"],
      "settings": { "foreground": "#9DFFFF" }
    }
  ]
}
