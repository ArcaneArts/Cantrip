+		if (priority === NotificationPriority.DEFAULT || priority === NotificationPriority.OPTIONAL) {
+			if (isNotificationSource(notification.source) && filter.sources.get(notification.source.id) === NotificationsFilter.ERROR) {
+				priority = NotificationPriority.SILENT; // explicitly filtered by source, including errors
+			} else if (severity !== Severity.Error && filter.global === NotificationsFilter.ERROR) {
+				// Global do not disturb continues to surface errors. Unlike the global
+				// filter, muting one source is an explicit request to silence it.
+				priority = NotificationPriority.SILENT;
 			}
 		}
 
