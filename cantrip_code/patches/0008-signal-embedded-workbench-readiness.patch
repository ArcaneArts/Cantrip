+function signalCantripWorkbenchReady(): void {
+	if (mainWindow.parent === mainWindow || !mainWindow.document.querySelector('.part.editor')) {
+		return;
+	}
+
+	const nonce = new URL(mainWindow.location.href).searchParams.get('cantripFrameNonce');
+	if (!nonce || !CANTRIP_FRAME_NONCE_PATTERN.test(nonce)) {
+		return;
+	}
+
+	mainWindow.parent.postMessage({
+		type: 'cantrip-code.workbench-ready',
+		version: 1,
+		nonce,
+	}, '*');
 }
 
