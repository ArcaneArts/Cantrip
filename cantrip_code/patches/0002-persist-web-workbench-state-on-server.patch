+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { IRemoteService } from '../../../../platform/ipc/common/services.js';
+import { IEnvironmentService } from '../../../../platform/environment/common/environment.js';
+import { RemoteStorageService } from '../../../../platform/storage/common/storageService.js';
+import { IUserDataProfilesService } from '../../../../platform/userDataProfile/common/userDataProfile.js';
+import { IAnyWorkspaceIdentifier } from '../../../../platform/workspace/common/workspace.js';
+import { IRemoteAgentService } from '../../remote/common/remoteAgentService.js';
+import { IUserDataProfileService } from '../../userDataProfile/common/userDataProfile.js';
+
+function storageRemoteService(remoteAgentService: IRemoteAgentService): IRemoteService {
+	const connection = remoteAgentService.getConnection();
+	if (!connection) {
+		throw new Error('A remote connection is required for remote browser storage.');
+	}
+
+	return {
+		_serviceBrand: undefined,
+		getChannel: channelName => connection.getChannel(channelName),
+		registerChannel: () => { throw new Error('Registering browser storage channels is unsupported.'); },
+	};
+}
+
+export class BrowserRemoteStorageService extends RemoteStorageService {
+
+	constructor(
+		workspace: IAnyWorkspaceIdentifier,
+		private readonly userDataProfileService: IUserDataProfileService,
+		userDataProfilesService: IUserDataProfilesService,
+		remoteAgentService: IRemoteAgentService,
+		environmentService: IEnvironmentService,
+	) {
+		super(
+			workspace,
+			{ currentProfile: userDataProfileService.currentProfile, defaultProfile: userDataProfilesService.defaultProfile },
+			storageRemoteService(remoteAgentService),
+			environmentService,
+		);
+
+		this._register(this.userDataProfileService.onDidChangeCurrentProfile(event => event.join(this.switchToProfile(event.profile))));
+	}
+}
