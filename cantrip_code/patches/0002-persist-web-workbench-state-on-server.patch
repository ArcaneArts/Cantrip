+import { Emitter } from '../../base/common/event.js';
+import { Disposable } from '../../base/common/lifecycle.js';
+import { isEqualOrParent } from '../../base/common/extpath.js';
+import { IEnvironmentService } from '../../platform/environment/common/environment.js';
+import { IFileService } from '../../platform/files/common/files.js';
+import { ILogService } from '../../platform/log/common/log.js';
+import { ApplicationStorageMain, IStorageMain, ProfileStorageMain, WorkspaceStorageMain } from '../../platform/storage/electron-main/storageMain.js';
+import { IProfileStorageChangeEvent, IStorageMainService } from '../../platform/storage/electron-main/storageMainService.js';
+import { IUserDataProfile, IUserDataProfilesService } from '../../platform/userDataProfile/common/userDataProfile.js';
+import { IAnyWorkspaceIdentifier } from '../../platform/workspace/common/workspace.js';
+
+/**
+ * Owns the browser workbench storage databases in the remote server process.
+ * This keeps UI state alongside the server's user-data directory instead of in
+ * browser IndexedDB, where an embedded or replaced webview can lose it.
+ */
+export class ServerStorageMainService extends Disposable implements IStorageMainService {
+
+	declare readonly _serviceBrand: undefined;
+
+	readonly applicationStorage: IStorageMain;
+
+	private readonly profileStorages = new Map<string, IStorageMain>();
+	private readonly workspaceStorages = new Map<string, IStorageMain>();
+
+	private readonly onDidChangeProfileStorageEmitter = this._register(new Emitter<IProfileStorageChangeEvent>());
+	readonly onDidChangeProfileStorage = this.onDidChangeProfileStorageEmitter.event;
+
+	constructor(
+		private readonly environmentService: IEnvironmentService,
+		private readonly userDataProfilesService: IUserDataProfilesService,
+		private readonly logService: ILogService,
+		private readonly fileService: IFileService,
+	) {
+		super();
+		this.applicationStorage = new ApplicationStorageMain({}, userDataProfilesService, logService, fileService);
+	}
+
+	profileStorage(profile: IUserDataProfile): IStorageMain {
+		const serverProfile = this.userDataProfilesService.profiles.find(candidate => candidate.id === profile.id) ?? this.userDataProfilesService.defaultProfile;
+		if (serverProfile.isDefault) {
+			return this.applicationStorage;
+		}
+
+		let storage = this.profileStorages.get(serverProfile.id);
+		if (!storage) {
+			storage = new ProfileStorageMain(serverProfile, {}, this.logService, this.fileService);
+			this.profileStorages.set(serverProfile.id, storage);
+			this._register(storage.onDidChangeStorage(event => this.onDidChangeProfileStorageEmitter.fire({
+				...event,
+				profile: serverProfile,
+				storage: storage!,
+			})));
+		}
+		return storage;
+	}
+
+	workspaceStorage(workspace: IAnyWorkspaceIdentifier): IStorageMain {
+		let storage = this.workspaceStorages.get(workspace.id);
+		if (!storage) {
+			storage = new WorkspaceStorageMain(workspace, {}, this.logService, this.environmentService, this.fileService);
+			this.workspaceStorages.set(workspace.id, storage);
+		}
+		return storage;
+	}
+
+	isUsed(candidatePath: string): boolean {
+		return [this.applicationStorage, ...this.profileStorages.values(), ...this.workspaceStorages.values()].some(storage =>
+			typeof storage.path === 'string' && isEqualOrParent(storage.path, candidatePath)
+		);
+	}
+
+	override dispose(): void {
+		void Promise.allSettled([
+			this.applicationStorage.close(),
+			...Array.from(this.profileStorages.values(), storage => storage.close()),
+			...Array.from(this.workspaceStorages.values(), storage => storage.close()),
+		]).finally(() => super.dispose());
+	}
+}
