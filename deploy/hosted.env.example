# Copy to deploy/hosted.env, replace every marked value, then run Compose with
# `docker compose --env-file deploy/hosted.env -f deploy/compose.hosted.yml up -d`.
CANTRIP_API_DOMAIN=api.cantrip.example
CANTRIP_CODE_DOMAIN=code.cantrip.example
CANTRIP_APP_ORIGIN=https://app.cantrip.example

POSTGRES_DB=cantrip
POSTGRES_USER=cantrip
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
DATABASE_URL=postgresql://cantrip:replace-with-the-same-url-safe-password@postgres:5432/cantrip
REDIS_URL=redis://redis:6379

CANTRIP_ADMIN_BOOTSTRAP_TOKEN=replace-with-at-least-32-random-characters
CANTRIP_SECRET_ENCRYPTION_KEYS={"primary":"replace-with-base64-32-byte-key"}
CANTRIP_ACTIVE_SECRET_ENCRYPTION_KEY_ID=primary
CANTRIP_PUBLIC_REGISTRATION=false
CANTRIP_METRICS_TOKEN=replace-with-at-least-32-random-characters

# Per-process quotas. Redis-backed shared enforcement is required before
# horizontally scaling the server beyond one replica.
CANTRIP_ACCOUNT_REMOTE_SURFACE_LIMIT=16
CANTRIP_WORKER_REMOTE_SURFACE_LIMIT=8
CANTRIP_ACCOUNT_UPLOAD_BYTES_PER_MINUTE=268435456
CANTRIP_WORKER_UPLOAD_BYTES_PER_MINUTE=134217728
CANTRIP_ACCOUNT_RELAY_BYTES_PER_MINUTE=536870912
CANTRIP_WORKER_RELAY_BYTES_PER_MINUTE=268435456

# Optional TURN REST configuration. Use one or more comma-separated turn: or
# turns: URLs and the shared secret configured on the TURN service.
# CANTRIP_TURN_URLS=turns:turn.cantrip.example:5349?transport=tcp
# CANTRIP_TURN_SHARED_SECRET=replace-with-turn-rest-shared-secret

# Optional worker service profile. Generate a fresh code in Settings immediately
# before first start and remove it after enrollment succeeds.
CANTRIP_WORKER_ENROLLMENT_CODE=replace-with-one-time-link-code
CANTRIP_WORKER_NAME=Hosted Worker
