map $http_upgrade $cantrip_connection_upgrade {
    default upgrade;
    ''      close;
}

upstream cantrip_api {
    server 127.0.0.1:4310;
    keepalive 32;
}

upstream cantrip_code {
    server 127.0.0.1:4311;
    keepalive 32;
}

server {
    listen 443 ssl http2;
    server_name api.cantrip.example;

    # Configure ssl_certificate and ssl_certificate_key with your ACME client.
    client_max_body_size 25m;
    location / {
        proxy_pass http://cantrip_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $cantrip_connection_upgrade;
        proxy_read_timeout 1d;
        proxy_send_timeout 1d;
        proxy_buffering off;
    }
}
server {
    listen 443 ssl http2;
    server_name code.cantrip.example;

    # Use the Code origin's own certificate and key.
    location / {
        proxy_pass http://cantrip_code;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $cantrip_connection_upgrade;
        proxy_read_timeout 1d;
        proxy_send_timeout 1d;
        proxy_buffering off;
    }
}
