CANTRIP_SERVER_HOST=127.0.0.1
CANTRIP_SERVER_PORT=4310
CANTRIP_CODE_SURFACE_HOST=127.0.0.1
CANTRIP_CODE_SURFACE_PORT=4311
CANTRIP_CODE_SURFACE_ORIGIN=http://127.0.0.1:4311
CANTRIP_DEPLOYMENT_MODE=local
CANTRIP_BOOTSTRAP_MODE=standalone
CANTRIP_AUTH_MODE=none
CANTRIP_DATA_DIR=./data
CANTRIP_APP_ORIGINS=http://127.0.0.1:5173

# For a remote server, bind an appropriate interface, set hosted mode, and use
# either protected single-user password mode or account mode.
# CANTRIP_SERVER_HOST=0.0.0.0
# CANTRIP_DEPLOYMENT_MODE=hosted
# CANTRIP_BOOTSTRAP_MODE=hosted
# CANTRIP_AUTH_MODE=accounts
# CANTRIP_ADMIN_BOOTSTRAP_TOKEN=replace-with-at-least-32-random-characters
# CANTRIP_PUBLIC_REGISTRATION=false
# CANTRIP_COOKIE_SECURE=true
# CANTRIP_COOKIE_SAME_SITE=none
# CANTRIP_SESSION_TTL_SECONDS=2592000
# CANTRIP_AUTH_RATE_LIMIT=10
# CANTRIP_APP_ORIGINS=https://your-cantrip-client.example
# CANTRIP_CODE_SURFACE_HOST=0.0.0.0
# CANTRIP_CODE_SURFACE_PORT=443
# CANTRIP_CODE_SURFACE_ORIGIN=https://code.your-cantrip.example
# DATABASE_URL=postgresql://user:password@database.example/cantrip
