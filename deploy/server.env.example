CANTRIP_SERVER_HOST=127.0.0.1
CANTRIP_SERVER_PORT=4310
CANTRIP_CODE_SURFACE_HOST=127.0.0.1
CANTRIP_CODE_SURFACE_PORT=4311
CANTRIP_CODE_SURFACE_ORIGIN=http://127.0.0.1:4311
CANTRIP_DEPLOYMENT_MODE=local
CANTRIP_BOOTSTRAP_MODE=standalone
CANTRIP_AUTH_MODE=none
CANTRIP_DATA_DIR=./data
CANTRIP_APP_ORIGINS=http://127.0.0.1:5173

# For a remote server, bind an appropriate interface, set hosted mode, and use
# either protected single-user password mode or account mode.
# CANTRIP_SERVER_HOST=0.0.0.0
# CANTRIP_DEPLOYMENT_MODE=hosted
# CANTRIP_BOOTSTRAP_MODE=hosted
# CANTRIP_AUTH_MODE=accounts
# CANTRIP_ADMIN_BOOTSTRAP_TOKEN=replace-with-at-least-32-random-characters
# CANTRIP_PUBLIC_REGISTRATION=false
# CANTRIP_COOKIE_SECURE=true
# CANTRIP_COOKIE_SAME_SITE=none
# CANTRIP_SESSION_TTL_SECONDS=2592000
# CANTRIP_AUTH_RATE_LIMIT=10
# CANTRIP_PUBLIC_ORIGIN=https://api.your-cantrip.example
# Only list the reverse proxy peers that can connect to the Node listener.
# CANTRIP_TRUSTED_PROXIES=10.0.0.0/8
# Generate a 32-byte key (for example, `openssl rand -base64 32`) and keep it
# outside source control. Retain old key entries during rotation.
# CANTRIP_SECRET_ENCRYPTION_KEYS={"2026-08":"replace-with-base64-32-byte-key"}
# CANTRIP_ACTIVE_SECRET_ENCRYPTION_KEY_ID=2026-08
# CANTRIP_APP_ORIGINS=https://your-cantrip-client.example
# CANTRIP_CODE_SURFACE_HOST=0.0.0.0
# CANTRIP_CODE_SURFACE_PORT=443
# CANTRIP_CODE_SURFACE_ORIGIN=https://code.your-cantrip.example
# DATABASE_URL=postgresql://user:password@database.example/cantrip
# CANTRIP_API_BODY_LIMIT_BYTES=1048576
# CANTRIP_API_RATE_LIMIT_PER_MINUTE=1200
# CANTRIP_UPLOAD_LIMIT_BYTES=26214400
# CANTRIP_UPLOAD_RATE_LIMIT_PER_MINUTE=30
# CANTRIP_ACCOUNT_UPLOAD_CONCURRENCY=4
# CANTRIP_ACCOUNT_UPLOAD_BYTES_PER_MINUTE=268435456
# CANTRIP_WORKER_UPLOAD_BYTES_PER_MINUTE=134217728
# CANTRIP_WEBSOCKET_MAX_PAYLOAD_BYTES=8388608
# CANTRIP_WEBSOCKET_HANDSHAKE_RATE_PER_MINUTE=120
# CANTRIP_ACCOUNT_WEBSOCKET_LIMIT=32
# CANTRIP_ACCOUNT_REMOTE_SURFACE_LIMIT=16
# CANTRIP_WORKER_REMOTE_SURFACE_LIMIT=8
# CANTRIP_ACCOUNT_RELAY_BYTES_PER_MINUTE=536870912
# CANTRIP_WORKER_RELAY_BYTES_PER_MINUTE=268435456
# CANTRIP_ACCOUNT_COMMAND_CONCURRENCY=128
# CANTRIP_WORKER_COMMAND_CONCURRENCY=64
# CANTRIP_ACCOUNT_COMMAND_RATE_PER_MINUTE=2400
# CANTRIP_WORKER_COMMAND_RATE_PER_MINUTE=1200
# CANTRIP_PAIRING_RATE_LIMIT_PER_MINUTE=20
# CANTRIP_METRICS_TOKEN=replace-with-at-least-32-random-characters
# Redis enables worker routing and live-event fanout across server replicas.
# REDIS_URL=redis://127.0.0.1:6379
# CANTRIP_SERVER_INSTANCE_ID=relay-1
# Set this to the deployment's hard replica ceiling. Global quotas are safely
# partitioned across this many instances and readiness fails above the ceiling.
# CANTRIP_COORDINATION_MAX_INSTANCES=1
# CANTRIP_COORDINATION_PRESENCE_TTL_MS=30000
# Durable automation claims are fenced and recover after this interval.
# CANTRIP_SCHEDULER_LEASE_TTL_MS=120000
