CANTRIP_SERVER_URL=http://127.0.0.1:4310
# Generate this short-lived, single-use code from the signed-in Cantrip app.
# After the first successful start, remove it: the worker stores its unique
# credential and immutable identity in CANTRIP_WORKER_DATA_DIR with mode 0600.
CANTRIP_WORKER_ENROLLMENT_CODE=replace-with-one-time-link-code
CANTRIP_WORKER_NAME=Cantrip Worker
CANTRIP_WORKER_DATA_DIR=./data
CANTRIP_CODE_IDLE_TIMEOUT_MS=1800000
# CANTRIP_CHROMIUM_EXECUTABLE=/absolute/path/to/chrome-or-chromium
# For secret-manager injection instead of the persisted credential file:
# CANTRIP_WORKER_CREDENTIAL=replace-with-enrolled-worker-credential
# CANTRIP_WORKER_ID=replace-with-that-credential-worker-id
