+      socket = candidate
+    }
 
     if (!socket)
       return
@@ -359,7 +370,11 @@
   }
 
   function reconnect() {
-    setTimeout(connect, closedTime ? Math.max(0, closedTime + delay - performance.now()) : 0)
+    clearTimeout(reconnectTimer)
+    reconnectTimer = setTimeout(() => {
+      reconnectTimer = null
+      connect()
+    }, closedTime ? Math.max(0, closedTime + delay - performance.now()) : 0)
   }
 
   function connected() {
@@ -421,6 +436,8 @@
 
   function terminate() {
     terminated = true
+    clearTimeout(reconnectTimer)
+    reconnectTimer = null
