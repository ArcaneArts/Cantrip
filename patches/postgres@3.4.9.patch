@@ -95,6 +95,7 @@
     , rows = 0
     , serverSignature = null
     , nextWriteTimer = null
+    , reconnectTimer = null
     , terminated = false
     , incomings = null
     , results = null
@@ -111,6 +112,7 @@
     queue: queues.closed,
     idleTimer,
     connect(query) {
