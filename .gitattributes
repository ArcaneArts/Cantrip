# Preserve the pinned OpenVSCode snapshot byte-for-byte. Its upstream test
# fixtures intentionally contain mixed encodings, line endings, and whitespace
# that must not be rewritten or treated as Cantrip formatting violations.
cantrip_code/upstream/** -text -whitespace

# Preserve the pinned Codex snapshot while keeping it identifiable as vendored.
cantrip_codex/upstream/** -text -whitespace linguist-vendored

# Patch files intentionally preserve upstream whitespace in context lines.
cantrip_code/patches/*.patch -whitespace
