# Preserve the pinned Codex snapshot while keeping it identifiable as vendored.
cantrip_codex/upstream/** -text -whitespace linguist-vendored

# Patch files must keep their committed LF bytes. Windows Git checkouts often
# enable core.autocrlf; converting only the patches to CRLF makes them
# impossible to apply to the byte-preserved upstream snapshot above.
cantrip_codex/patches/*.patch -text -whitespace
