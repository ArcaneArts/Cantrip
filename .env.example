# Leave DATABASE_URL unset to use embedded PGlite in .cantrip/dev/server-db.
# DATABASE_URL=postgresql://cantrip:cantrip@127.0.0.1:54329/cantrip

CANTRIP_SERVER_HOST=127.0.0.1
CANTRIP_SERVER_PORT=4310
CANTRIP_CODE_SURFACE_HOST=127.0.0.1
CANTRIP_CODE_SURFACE_PORT=4311
CANTRIP_CODE_SURFACE_ORIGIN=http://127.0.0.1:4311
CANTRIP_SERVER_URL=http://127.0.0.1:4310
CANTRIP_DEPLOYMENT_MODE=local
CANTRIP_BOOTSTRAP_MODE=pnpm-dev
CANTRIP_AUTH_MODE=none
# Protected single-user mode accepts only an Argon2id encoded hash, never a
# plaintext password. Account mode can use a one-time first-owner token and
# optionally permit later public registrations.
# CANTRIP_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=1$...
# CANTRIP_ADMIN_BOOTSTRAP_TOKEN=replace-with-at-least-32-random-characters
# CANTRIP_PUBLIC_REGISTRATION=false
# CANTRIP_SESSION_TTL_SECONDS=2592000
# CANTRIP_AUTH_RATE_LIMIT=10
# Hosted servers must configure a versioned envelope-encryption keyring. Values
# are canonical base64 encodings of 32 random bytes. The active key encrypts new
# values; retain older entries while startup rewraps existing provider secrets.
# CANTRIP_SECRET_ENCRYPTION_KEYS={"2026-08":"replace-with-base64-32-byte-key"}
# CANTRIP_ACTIVE_SECRET_ENCRYPTION_KEY_ID=2026-08
# Hosted HTTPS deployments default to Secure cookies. SameSite=none supports
# approved cross-origin web/native clients and requires Secure cookies.
# CANTRIP_COOKIE_SECURE=true
# Hosted mode defaults to Secure, SameSite=None cookies so desktop/mobile
# webviews can authenticate across origins. Same-origin deployments may choose lax.
# CANTRIP_COOKIE_SAME_SITE=none
# Anonymous remote access remains a temporary trusted-network escape hatch.
# CANTRIP_ALLOW_INSECURE_REMOTE=true
CANTRIP_AGENT_MODEL=gemma4:26b
CANTRIP_AGENT_MODEL_PROVIDER=ollama
CANTRIP_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
CANTRIP_APP_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:1420,http://tauri.localhost,https://tauri.localhost,tauri://localhost,capacitor://localhost
CANTRIP_DATA_DIR=../.cantrip/dev
# This token path is accepted only by anonymous loopback pnpm-dev/Tauri
# bootstraps. Standalone and hosted workers enroll with a one-time link code.
CANTRIP_WORKER_TOKEN=cantrip-local-development
CANTRIP_WORKER_DEVELOPMENT_BOOTSTRAP=true
CANTRIP_WORKER_ID=local-worker
CANTRIP_WORKER_NAME=Local Worker
CANTRIP_WORKER_DATA_DIR=../.cantrip/dev/worker
# Standalone worker enrollment (use one code once; the worker stores the
# resulting credential with mode 0600 in its data directory):
# CANTRIP_WORKER_ENROLLMENT_CODE=ctwl_replace-with-link-code
# Non-interactive secret injection may instead provide both of these:
# CANTRIP_WORKER_CREDENTIAL=ctwk_replace-with-worker-credential
# CANTRIP_WORKER_ID=worker-immutable-id
# Development-only escape hatch; release workers use their bundled CLI.
# CANTRIP_CODEX_BIN=/absolute/path/to/codex
# CANTRIP_CHROMIUM_EXECUTABLE=/absolute/path/to/chrome-or-chromium

# Optional relay-only WebRTC acceleration for Remote Surfaces. Leave both
# values unset to use the server-routed WebSocket stream. The shared secret
# stays on the server and derives short-lived TURN REST credentials.
# CANTRIP_TURN_URLS=turn:relay.cantrip.art:3478?transport=udp,turns:relay.cantrip.art:5349
# CANTRIP_TURN_SHARED_SECRET=replace-with-the-coturn-static-auth-secret
# CANTRIP_TURN_TTL_SECONDS=600
# CANTRIP_WEBRTC_NEGOTIATION_TIMEOUT_MS=8000
