{
  "name": "@cantrip/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "migrate": "node --env-file-if-exists=.env dist/migrate.js",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "pnpm --filter @cantrip/version build && pnpm --filter @cantrip/logging build && pnpm --filter @cantrip/protocol build && vitest run --maxWorkers=2",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@cantrip/logging": "workspace:*",
    "@cantrip/protocol": "workspace:*",
    "@cantrip/version": "workspace:*",
    "@electric-sql/pglite": "^0.5.4",
    "@fastify/cors": "^11.3.0",
    "@fastify/websocket": "^11.3.0",
    "@node-rs/argon2": "^2.0.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.2",
    "postgres": "^3.4.9",
    "redis": "^5.12.1",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10"
  }
}
