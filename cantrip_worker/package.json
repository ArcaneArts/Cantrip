{
  "name": "@cantrip/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "pnpm --filter @cantrip/version build && pnpm --filter @cantrip/logging build && pnpm --filter @cantrip/protocol build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cantrip/logging": "workspace:*",
    "@cantrip/protocol": "workspace:*",
    "@cantrip/version": "workspace:*",
    "@zavora-ai/computer-use-mcp": "7.0.0",
    "node-pty": "^1.1.0",
    "node-screenshots": "0.2.8",
    "sharp": "0.34.4",
    "webdav-server": "2.6.3",
    "werift": "^0.24.3",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
