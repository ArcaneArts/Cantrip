#!/bin/sh
set -eu
case "$1" in
    remove|upgrade|deconfigure)
        if [ -d /run/systemd/system ]; then
            deb-systemd-invoke stop cantrip-os-workspaces.service
        else
            if [ "$1" = upgrade ] && cantrip-workspaces status | /usr/bin/python3 -c 'import json,sys; sys.exit(json.load(sys.stdin)["service"] != "running")'; then
                touch /run/cantrip-os-workspaces/upgrade-restart
            fi
            cantrip-workspaces service stop
        fi
        ;;
esac
