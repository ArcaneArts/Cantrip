# Dependencies and package-manager state.
node_modules/
.pnpm-store/

# Build output and tool caches.
dist/
build/
out/
.cache/
.vite/
.turbo/
*.tsbuildinfo

# Cantrip runtime state. This includes PGlite, Codex homes, worker clones,
# conversation/runtime logs, and other machine-local data.
.cantrip/

# Databases and local PostgreSQL data directories outside .cantrip.
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
pgdata/
postgres-data/
.postgres/

# Local configuration and secrets.
.env
.env.*
!.env.example
.envrc

# Logs, coverage, and test artifacts.
*.log
*.log.*
logs/
coverage/
test-results/
playwright-report/

# Operating-system metadata.
.DS_Store

# Generated Capacitor projects are added when native work begins.
cantrip_app/android/
cantrip_app/ios/

# Rust/Tauri build output.
cantrip_app/src-tauri/target/
cantrip_app/src-tauri/gen/
cantrip_app/src-tauri/resources/runtime/*
!cantrip_app/src-tauri/resources/runtime/.gitkeep

# Locally assembled release artifacts.
artifacts/
