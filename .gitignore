# Dependencies and package-manager state.
node_modules/
.pnpm-store/

# Build output and tool caches.
dist/
/build/
/out/
.cache/
.vite/
.turbo/
*.tsbuildinfo

# Cantrip runtime state. This includes PGlite, Codex homes, worker clones,
# conversation/runtime logs, and other machine-local data.
.cantrip/

# Databases and local PostgreSQL data directories outside .cantrip.
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
pgdata/
postgres-data/
.postgres/

# Local configuration and secrets.
.env
.env.*
!.env.example
.envrc
deploy/hosted.env
*.jks
*.keystore

# Logs, coverage, and test artifacts.
*.log
*.log.*
logs/
coverage/
test-results/
playwright-report/

# Operating-system metadata.
.DS_Store

# Rust/Tauri build output.
cantrip_cli/target/
cantrip_app/src-tauri/target/
cantrip_app/src-tauri/gen/
cantrip_app/src-tauri/resources/runtime/*
!cantrip_app/src-tauri/resources/runtime/.gitkeep

# Locally compiled pinned Codex runtime.
cantrip_codex/.build/
cantrip_codex/.upstream-backup-*/

# Locally assembled release artifacts.
artifacts/
!/.repro/20260823-112446-explorer-code-desktop-health-request-fai/artifacts/
!/.repro/20260823-112446-explorer-code-desktop-health-request-fai/artifacts/*.txt

# Cantrip Code source is tracked, but its prepared source, dependency tree,
# caches, compiled workbench, and packaged server are always generated.
.cantrip-code/
cantrip_code/.build/
cantrip_code/.cache/
cantrip_code/.prepared/
cantrip_code/artifacts/
cantrip_code/node_modules/
cantrip_code/upstream/node_modules/
cantrip_code/upstream/.build/
cantrip_code/upstream/.cache/
cantrip_code/upstream/out*/
cantrip_code/upstream/extensions/**/out/
cantrip_code/upstream/extensions/**/dist/
cantrip_code/upstream/build/node_modules/
cantrip_code/upstream/coverage/
cantrip_code/upstream/test-results/
cantrip_code/upstream/test-output.json
