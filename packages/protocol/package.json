{
  "name": "@cantrip/protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./workflows": {
      "types": "./src/workflows.ts",
      "import": "./dist/workflows.js"
    },
    "./automations": {
      "types": "./src/automations.ts",
      "import": "./dist/automations.js"
    },
    "./policies": {
      "types": "./src/policies.ts",
      "import": "./dist/policies.js"
    },
    "./tasks": {
      "types": "./src/tasks.ts",
      "import": "./dist/tasks.js"
    },
    "./encryption": {
      "types": "./src/encryption.ts",
      "import": "./dist/encryption.js"
    },
    "./private-labels": {
      "types": "./src/private-labels.ts",
      "import": "./dist/private-labels.js"
    },
    "./surface-private-state": {
      "types": "./src/surface-private-state.ts",
      "import": "./dist/surface-private-state.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "croner": "^10.0.1",
    "zod": "^4.4.3"
  }
}
