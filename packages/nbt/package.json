{
  "name": "@cantrip/nbt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./storage": {
      "types": "./src/storage/index.ts",
      "import": "./dist/storage/index.js"
    },
    "./paged": {
      "types": "./src/paged/index.ts",
      "import": "./dist/paged/index.js"
    },
    "./document": {
      "types": "./src/document/index.ts",
      "import": "./dist/document/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "pako": "3.0.3"
  },
  "devDependencies": {
    "nbtify": "2.2.0",
    "fake-indexeddb": "^6.2.5"
  }
}
