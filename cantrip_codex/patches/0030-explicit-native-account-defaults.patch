diff --git a/codex-rs/tui/src/app/account_defaults.rs b/codex-rs/tui/src/app/account_defaults.rs
new file mode 100644
index 0000000000000000000000000000000000000000..50d2d98464caded4584b6f4aaa0296fc4b6d5aaf
--- /dev/null
+++ b/codex-rs/tui/src/app/account_defaults.rs
@@ -0,0 +1,148 @@
+use super::*;
+use crate::native_account_defaults::Snapshot;
+use codex_app_server_protocol::ConfigEdit;
+use uuid::Uuid;
+
+pub(super) struct Pending {
+    id: Uuid,
+    source: Uuid,
+    thread: Option<ThreadId>,
+    phase: Phase,
+    edits: Vec<ConfigEdit>,
+    selection: String,
+}
+enum Phase {
+    Reading,
+    Preview(Snapshot),
+    Writing,
+}
+impl Pending {
+    fn current(&self, id: Uuid, app_server: &AppServerSession, thread: Option<ThreadId>) -> bool {
+        self.id == id && self.source == app_server.configuration_scope() && self.thread == thread
+    }
+}
+
+impl App {
+    pub(super) fn open_account_defaults(&mut self, app_server: &AppServerSession) {
+        let thread = self.chat_widget.thread_id();
+        if app_server.has_managed_gateway() && !app_server.is_managed_gateway_thread(thread) {
+            self.chat_widget
+                .add_error_message("Open the managed root thread to edit account defaults.".into());
+            return;
+        }
+        if self
+            .native_account_defaults
+            .as_ref()
+            .is_some_and(|pending| {
+                pending.current(pending.id, app_server, thread)
+                    && matches!(pending.phase, Phase::Reading | Phase::Writing)
+            })
+        {
+            self.chat_widget
+                .add_info_message("Account defaults request is still running.".into(), None);
+            return;
+        }
+        let id = Uuid::new_v4();
+        let model = self.chat_widget.current_model();
+        let effort = self.chat_widget.current_reasoning_effort();
+        let tier = self.config.service_tier.as_deref();
+        let mut edits = crate::config_update::build_model_selection_edits(model, effort.clone());
+        edits.extend(crate::config_update::build_service_tier_selection_edits(
+            tier,
+        ));
+        self.native_account_defaults = Some(Pending {
+            id,
+            source: app_server.configuration_scope(),
+            thread,
+            phase: Phase::Reading,
+            edits,
+            selection: format!(
+                "{model} · {} reasoning · {} tier",
+                effort
+                    .map(|value| value.to_string())
+                    .unwrap_or("inherited".into()),
+                tier.unwrap_or("inherited")
+            ),
+        });
+        let tx = self.app_event_tx.clone();
+        let handle = app_server.request_handle();
+        tokio::spawn(async move {
+            let result = crate::native_account_defaults::read(handle).await;
+            tx.send(AppEvent::AccountDefaultsRead { id, result });
+        });
+    }
+
+    pub(super) fn account_defaults_read(
+        &mut self,
+        app_server: &AppServerSession,
+        id: Uuid,
+        result: Result<Snapshot, String>,
+    ) {
+        let Some(pending) = self.native_account_defaults.as_mut().filter(|pending| {
+            pending.current(id, app_server, self.chat_widget.thread_id())
+                && matches!(pending.phase, Phase::Reading)
+        }) else {
+            return;
+        };
+        match result {
+            Ok(snapshot) => {
+                let summary = format!(
+                    "Saved: {}. Selection: {}. Existing chats and Cantrip’s new-chat model choice stay separate.",
+                    snapshot.summary, pending.selection
+                );
+                pending.phase = Phase::Preview(snapshot);
+                self.chat_widget
+                    .open_account_defaults_confirmation(id, summary);
+            }
+            Err(error) => {
+                self.native_account_defaults = None;
+                self.chat_widget.add_error_message(error);
+            }
+        }
+    }
+
+    pub(super) fn save_account_defaults(&mut self, app_server: &AppServerSession, id: Uuid) {
+        let Some(pending) = self
+            .native_account_defaults
+            .as_mut()
+            .filter(|pending| pending.current(id, app_server, self.chat_widget.thread_id()))
+        else {
+            self.chat_widget.add_error_message(
+                "The account defaults source changed. Open /defaults again.".into(),
+            );
+            return;
+        };
+        let Phase::Preview(snapshot) = &pending.phase else {
+            return;
+        };
+        let version = snapshot.version.clone();
+        let edits = pending.edits.clone();
+        pending.phase = Phase::Writing;
+        let tx = self.app_event_tx.clone();
+        let handle = app_server.request_handle();
+        tokio::spawn(async move {
+            let message = crate::native_account_defaults::write(handle, id, version, edits).await;
+            tx.send(AppEvent::AccountDefaultsWritten { id, message });
+        });
+    }
+
+    pub(super) fn account_defaults_written(
+        &mut self,
+        app_server: &AppServerSession,
+        id: Uuid,
+        message: String,
+    ) {
+        if !self
+            .native_account_defaults
+            .as_ref()
+            .is_some_and(|pending| {
+                pending.current(id, app_server, self.chat_widget.thread_id())
+                    && matches!(pending.phase, Phase::Writing)
+            })
+        {
+            return;
+        }
+        self.native_account_defaults = None;
+        self.chat_widget.add_info_message(message, None);
+    }
+}
