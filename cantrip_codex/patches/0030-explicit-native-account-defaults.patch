diff --git a/codex-rs/tui/src/native_account_defaults.rs b/codex-rs/tui/src/native_account_defaults.rs
new file mode 100644
index 0000000..46d9dd1
--- /dev/null
+++ b/codex-rs/tui/src/native_account_defaults.rs
@@ -0,0 +1,136 @@
+//! Explicit native account defaults. These calls never update a live thread.
+use codex_app_server_client::AppServerRequestHandle;
+use codex_app_server_protocol as api;
+use serde_json::Value;
+use uuid::Uuid;
+
+#[derive(Debug, Clone)]
+pub(crate) struct Snapshot {
+    pub version: String,
+    pub summary: String,
+}
+
+pub(crate) fn snapshot(response: api::ConfigReadResponse) -> Result<Snapshot, String> {
+    let layers = response
+        .layers
+        .ok_or("Native config read omitted its layers.")?;
+    let user = layers.into_iter().find(|layer| {
+        matches!(
+            &layer.name,
+            api::ConfigLayerSource::User { profile: None, .. }
+        )
+    });
+    let (version, stored) = match user {
+        Some(layer) => (layer.version, layer.config),
+        None => (
+            codex_config::version_for_toml(&toml::Value::Table(Default::default())),
+            Value::Object(Default::default()),
+        ),
+    };
+    let label = |key: &str| {
+        stored
+            .get(key)
+            .and_then(Value::as_str)
+            .unwrap_or("inherited")
+    };
+    Ok(Snapshot {
+        version,
+        summary: format!(
+            "{} · {} reasoning · {} tier",
+            label("model"),
+            label("model_reasoning_effort"),
+            label("service_tier")
+        ),
+    })
+}
+
+pub(crate) async fn read(handle: AppServerRequestHandle) -> Result<Snapshot, String> {
+    let response = handle
+        .request_typed(api::ClientRequest::ConfigRead {
+            request_id: api::RequestId::String(format!("tui-defaults-read-{}", Uuid::new_v4())),
+            params: api::ConfigReadParams {
+                include_layers: true,
+                cwd: None,
+            },
+        })
+        .await
+        .map_err(|_| "Could not read native account defaults. Try /defaults again.".to_string())?;
+    snapshot(response)
+}
+
+pub(crate) fn write_request(
+    operation_id: Uuid,
+    version: String,
+    edits: Vec<api::ConfigEdit>,
+) -> api::ClientRequest {
+    api::ClientRequest::ConfigBatchWrite {
+        request_id: api::RequestId::String(format!("tui-defaults-write-{operation_id}")),
+        params: api::ConfigBatchWriteParams {
+            edits,
+            file_path: None,
+            expected_version: Some(version),
+            reload_user_config: false,
+        },
+    }
+}
+
+pub(crate) async fn write(
+    handle: AppServerRequestHandle,
+    operation_id: Uuid,
+    version: String,
+    edits: Vec<api::ConfigEdit>,
+) -> String {
+    let result: Result<api::ConfigWriteResponse, _> = handle
+        .request_typed(write_request(operation_id, version, edits))
+        .await;
+    let written = match result {
+        Ok(result) => result,
+        Err(codex_app_server_client::TypedRequestError::Server { .. }) => return "Native configuration rejected the change. Read /defaults before trying again.".into(),
+        Err(_) => return "Account default write was not confirmed. Read /defaults before making another change; it was not retried.".into(),
+    };
+    let message = match read(handle).await {
+        Ok(snapshot) if snapshot.version == written.version => {
+            "Account defaults saved and verified. Existing chats keep their settings."
+        }
+        Ok(_) => {
+            "Account defaults saved; another edit changed the configuration before readback. Read /defaults to review it."
+        }
+        Err(_) => "Account defaults saved, but readback failed. Read /defaults to verify them.",
+    };
+    if written.status == api::WriteStatus::OkOverridden {
+        format!("{message} Another configuration layer overrides one or more defaults.")
+    } else {
+        message.into()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn explicit_defaults_use_versioned_non_reloading_native_write() {
+        let edits = vec![crate::config_update::clear_config_value("service_tier")];
+        let request =
+            serde_json::to_value(write_request(Uuid::nil(), "native-v1".into(), edits)).unwrap();
+        assert_eq!(request["method"], "config/batchWrite");
+        assert_eq!(request["params"]["expectedVersion"], "native-v1");
+        let decoded: api::ConfigBatchWriteParams =
+            serde_json::from_value(request["params"].clone()).unwrap();
+        assert!(!decoded.reload_user_config);
+        assert_eq!(request["params"]["edits"][0]["value"], Value::Null);
+        assert!(request["params"]["filePath"].is_null());
+    }
+    #[test]
+    fn preview_uses_user_layer_not_runtime_overrides_or_private_config() {
+        let response = serde_json::from_value(serde_json::json!({
+            "config": {}, "origins": {}, "layers": [
+                { "name": { "type": "sessionFlags" }, "version": "flags", "config": { "model": "wrong" }, "disabledReason": null },
+                { "name": { "type": "user", "file": "/private/config.toml", "profile": null }, "version": "v1",
+                  "config": { "model": "saved", "model_reasoning_effort": "high", "secret": "private" }, "disabledReason": null }
+            ]
+        })).unwrap();
+        let result = snapshot(response).unwrap();
+        assert_eq!(result.version, "v1");
+        assert_eq!(result.summary, "saved · high reasoning · inherited tier");
+    }
+}
