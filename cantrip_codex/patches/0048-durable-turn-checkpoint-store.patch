+use super::*;
+use serde_json::json;
+use std::io::BufRead;
+use std::process::Command;
+use std::process::Stdio;
+
+type Store = LockedCheckpoint<serde_json::Value>;
+
+fn checkpoint(revision: u64) -> Checkpoint<serde_json::Value> {
+    Checkpoint {
+        identity: CheckpointIdentity {
+            thread_id: "thread/with/unsafe/path".into(),
+            turn_id: "original-turn".into(),
+            checkpoint_id: "pause-1".into(),
+        },
+        revision,
+        runtime_version: "fixture-runtime-1".into(),
+        history_binding: "committed-native-history-head".into(),
+        state: CheckpointState::Suspended,
+        continuation: Some(json!({ "pendingInput": ["accepted steer"], "nextStep": 3 })),
+    }
+}
+
+fn store(path: &Path) -> Store {
+    Store::acquire(path, "thread/with/unsafe/path").unwrap()
+}
+
+#[test]
+fn persists_continuation_across_fresh_owners_and_repeated_replacements() {
+    let directory = tempfile::tempdir().unwrap();
+    assert_eq!(
+        store(directory.path()).read("fixture-runtime-1").unwrap(),
+        None
+    );
+    for revision in 1..=4 {
+        let owner = store(directory.path());
+        owner
+            .commit(
+                (revision > 1).then_some(revision - 1),
+                &checkpoint(revision),
+            )
+            .unwrap();
+        drop(owner);
+        assert_eq!(
+            store(directory.path()).read("fixture-runtime-1").unwrap(),
+            Some(checkpoint(revision))
+        );
+    }
+    assert_eq!(std::fs::read_dir(directory.path()).unwrap().count(), 2);
+}
+
+#[test]
+fn a_live_owner_excludes_another_owner() {
+    let directory = tempfile::tempdir().unwrap();
+    let owner = store(directory.path());
+    assert!(Store::acquire(directory.path(), "thread/with/unsafe/path").is_err());
+    drop(owner);
+    assert!(Store::acquire(directory.path(), "thread/with/unsafe/path").is_ok());
+}
+
+#[test]
+fn stale_and_skipped_revisions_preserve_the_committed_checkpoint() {
+    let directory = tempfile::tempdir().unwrap();
+    let owner = store(directory.path());
+    owner.commit(None, &checkpoint(1)).unwrap();
+    assert!(owner.commit(None, &checkpoint(2)).is_err());
+    assert!(owner.commit(Some(1), &checkpoint(3)).is_err());
+    assert_eq!(
+        owner.read("fixture-runtime-1").unwrap(),
+        Some(checkpoint(1))
+    );
+}
+
+#[test]
+fn terminal_tombstones_reject_reopening_and_allow_a_new_suspension() {
+    for state in [CheckpointState::Consumed, CheckpointState::Invalidated] {
+        let directory = tempfile::tempdir().unwrap();
+        let owner = store(directory.path());
+        owner.commit(None, &checkpoint(1)).unwrap();
+        let mut terminal = checkpoint(2);
+        terminal.state = state;
+        terminal.continuation = None;
+        owner.commit(Some(1), &terminal).unwrap();
+        assert!(owner.commit(Some(2), &checkpoint(3)).is_err());
+        let mut next = checkpoint(3);
+        next.identity.checkpoint_id = "pause-2".into();
+        owner.commit(Some(2), &next).unwrap();
+        assert_eq!(owner.read("fixture-runtime-1").unwrap(), Some(next));
+    }
+}
+
+#[test]
+fn rejects_a_foreign_settlement_and_invalid_payload_lifecycles() {
+    let directory = tempfile::tempdir().unwrap();
+    let owner = store(directory.path());
+    owner.commit(None, &checkpoint(1)).unwrap();
+    let mut next = checkpoint(2);
+    next.state = CheckpointState::Consumed;
+    assert!(owner.commit(Some(1), &next).is_err());
+    next.continuation = None;
+    next.identity.turn_id = "other-turn".into();
+    assert!(owner.commit(Some(1), &next).is_err());
+    next = checkpoint(2);
+    next.identity.thread_id = "other-thread".into();
+    assert!(owner.commit(Some(1), &next).is_err());
+    assert_eq!(
+        owner.read("fixture-runtime-1").unwrap(),
+        Some(checkpoint(1))
+    );
+}
+
+#[test]
+fn corrupt_and_future_versions_are_retained_without_fallback() {
+    let directory = tempfile::tempdir().unwrap();
+    let owner = store(directory.path());
+    owner.commit(None, &checkpoint(1)).unwrap();
+    let original = std::fs::read(&owner.path).unwrap();
+    assert!(owner.read("other-runtime").is_err());
+    assert_eq!(std::fs::read(&owner.path).unwrap(), original);
+    for bytes in [
+        b"{broken".to_vec(),
+        br#"{"formatVersion":99,"newFormat":"preserve me"}"#.to_vec(),
+        {
+            let mut envelope: Envelope = serde_json::from_slice(&original).unwrap();
+            envelope.record_json.push(' ');
+            serde_json::to_vec(&envelope).unwrap()
+        },
+    ] {
+        std::fs::write(&owner.path, &bytes).unwrap();
+        assert!(owner.read("fixture-runtime-1").is_err());
+        assert!(owner.commit(Some(1), &checkpoint(2)).is_err());
+        assert_eq!(std::fs::read(&owner.path).unwrap(), bytes);
+    }
+}
+
+#[test]
+fn staging_failure_preserves_the_previous_record() {
+    let directory = tempfile::tempdir().unwrap();
+    let owner = store(directory.path());
+    owner.commit(None, &checkpoint(1)).unwrap();
+    let previous = std::fs::read(&owner.path).unwrap();
+    // Point only staging at a real non-directory; reads still use the old path.
+    let blocker = directory.path().join("not-a-directory");
+    std::fs::write(&blocker, "occupied").unwrap();
+    let mut owner = owner;
+    owner.directory = blocker;
+    assert!(owner.commit(Some(1), &checkpoint(2)).is_err());
+    assert_eq!(std::fs::read(&owner.path).unwrap(), previous);
+    assert_eq!(
+        owner.read("fixture-runtime-1").unwrap(),
+        Some(checkpoint(1))
+    );
+}
+
+#[cfg(unix)]
+#[test]
+fn checkpoint_and_lock_files_are_private() {
+    use std::os::unix::fs::PermissionsExt;
+    let directory = tempfile::tempdir().unwrap();
+    let path = directory.path().join("private");
+    let owner = store(&path);
+    owner.commit(None, &checkpoint(1)).unwrap();
+    assert_eq!(
+        std::fs::metadata(&path).unwrap().permissions().mode() & 0o777,
+        0o700
+    );
+    for entry in std::fs::read_dir(path).unwrap() {
+        assert_eq!(
+            entry.unwrap().metadata().unwrap().permissions().mode() & 0o777,
+            0o600
+        );
+    }
+}
+
+#[test]
+fn checkpoint_lock_child() {
+    let Some(path) = std::env::var_os("CANTRIP_CHECKPOINT_LOCK_CHILD") else {
+        return;
+    };
+    let owner = store(Path::new(&path));
+    owner.commit(None, &checkpoint(1)).unwrap();
+    println!("CHECKPOINT_COMMITTED");
+    std::io::stdout().flush().unwrap();
+    loop {
+        std::thread::park();
+    }
+}
+
+#[test]
+fn a_killed_process_releases_ownership_and_leaves_a_readable_checkpoint() {
+    let directory = tempfile::tempdir().unwrap();
+    let mut child = Command::new(std::env::current_exe().unwrap())
+        .args(["--exact", "tests::checkpoint_lock_child", "--nocapture"])
+        .env("CANTRIP_CHECKPOINT_LOCK_CHILD", directory.path())
+        .stdout(Stdio::piped())
+        .spawn()
+        .unwrap();
+    let output = child.stdout.take().unwrap();
+    let (sender, receiver) = std::sync::mpsc::channel();
+    std::thread::spawn(move || {
+        let ready = std::io::BufReader::new(output)
+            .lines()
+            .any(|line| line.is_ok_and(|line| line == "CHECKPOINT_COMMITTED"));
+        let _ = sender.send(ready);
+    });
+    let ready = receiver.recv_timeout(std::time::Duration::from_secs(10));
+    if !matches!(ready, Ok(true)) {
+        let _ = child.kill();
+        let _ = child.wait();
+        panic!("child did not commit checkpoint: {ready:?}");
+    }
+    let competing = Store::acquire(directory.path(), "thread/with/unsafe/path");
+    child.kill().unwrap();
+    child.wait().unwrap();
+    assert!(competing.is_err());
+    assert_eq!(
+        store(directory.path()).read("fixture-runtime-1").unwrap(),
+        Some(checkpoint(1))
+    );
+}
+
+#[test]
+fn settled_records_do_not_block_a_later_runtime_upgrade() {
+    let directory = tempfile::tempdir().unwrap();
+    let owner = store(directory.path());
+    owner.commit(None, &checkpoint(1)).unwrap();
+    let mut terminal = checkpoint(2);
+    terminal.state = CheckpointState::Consumed;
+    terminal.continuation = None;
+    owner.commit(Some(1), &terminal).unwrap();
+    let mut next = checkpoint(3);
+    next.identity.checkpoint_id = "next-pause".into();
+    next.runtime_version = "fixture-runtime-2".into();
+    owner.commit(Some(2), &next).unwrap();
+    assert_eq!(owner.read("fixture-runtime-2").unwrap(), Some(next));
+}
+
+#[test]
+fn uncommitted_temporary_files_are_not_recovery_candidates() {
+    let directory = tempfile::tempdir().unwrap();
+    let owner = store(directory.path());
+    owner.commit(None, &checkpoint(1)).unwrap();
+    let mut temporary = tempfile::NamedTempFile::new_in(directory.path()).unwrap();
+    temporary.write_all(b"partial checkpoint").unwrap();
+    temporary.as_file().sync_all().unwrap();
+    assert_eq!(
+        owner.read("fixture-runtime-1").unwrap(),
+        Some(checkpoint(1))
+    );
+}
