+//! Durable storage and exclusive process ownership for suspended native turns.
+//!
+//! This crate stores a caller-defined continuation, not a second conversation.
+//! The native turn owner must first commit the referenced history boundary, then
+//! commit this record, then acknowledge pause. Keep the returned lock for the
+//! entire lifetime of any execution that could consume or replace this record.
+//! All methods perform blocking filesystem operations; async callers must use
+//! their blocking pool. No operation here starts a turn or invokes a tool.
+
+use serde::Deserialize;
+use serde::Serialize;
+use serde::de::DeserializeOwned;
+use sha2::Digest;
+use sha2::Sha256;
+use std::fs::File;
+use std::fs::OpenOptions;
+use std::io;
+use std::io::Write;
+use std::marker::PhantomData;
+use std::path::Path;
+use std::path::PathBuf;
+
+const FORMAT_VERSION: u32 = 1;
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct CheckpointIdentity {
+    pub thread_id: String,
+    pub turn_id: String,
+    pub checkpoint_id: String,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase")]
+pub enum CheckpointState {
+    Suspended,
+    Consumed,
+    Invalidated,
+}
+
+/// The payload must contain continuation data or references to already durable
+/// native history. Callers must never include credentials or execution grants.
+#[derive(Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct Checkpoint<T> {
+    pub identity: CheckpointIdentity,
+    pub revision: u64,
+    pub runtime_version: String,
+    /// Exact history-position evidence, interpreted by the native runtime.
+    pub history_binding: String,
+    pub state: CheckpointState,
+    pub continuation: Option<T>,
+}
+
+#[derive(Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Envelope {
+    format_version: u32,
+    // Hash the original serialized bytes, independent of map ordering after
+    // deserialization. This is corruption detection, not authentication.
+    record_json: String,
+    sha256: String,
+}
+
+fn digest(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+
+fn invalid(message: &str) -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, message)
+}
+
+/// Owns the operating-system lock, which is released even by SIGKILL or a crash.
+/// The lock file is permanent: unlinking it would let another process lock a
+/// different inode while an existing owner still holds the original lock.
+pub struct LockedCheckpoint<T> {
+    directory: PathBuf,
+    path: PathBuf,
+    thread_id: String,
+    _lock: File,
+    _payload: PhantomData<T>,
+}
+
+impl<T: Serialize + DeserializeOwned> LockedCheckpoint<T> {
+    /// Acquire actual exclusive ownership. A competing live owner produces an
+    /// error from the OS lock; no PID files, age guesses or stale-lock probes.
+    pub fn acquire(directory: &Path, thread_id: &str) -> io::Result<Self> {
+        if thread_id.is_empty() {
+            return Err(invalid("checkpoint thread identity is empty"));
+        }
+        let mut builder = std::fs::DirBuilder::new();
+        builder.recursive(true);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::DirBuilderExt;
+            builder.mode(0o700);
+        }
+        builder.create(directory)?;
+        // No user-supplied identifier becomes a path component.
+        let key = digest(thread_id.as_bytes());
+        let mut options = OpenOptions::new();
+        options.read(true).write(true).create(true).truncate(false);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::OpenOptionsExt;
+            options.mode(0o600);
+        }
+        let lock = options.open(directory.join(format!("{key}.lock")))?;
+        lock.try_lock().map_err(io::Error::from)?;
+        Ok(Self {
+            directory: directory.to_path_buf(),
+            path: directory.join(format!("{key}.json")),
+            thread_id: thread_id.to_owned(),
+            _lock: lock,
+            _payload: PhantomData,
+        })
+    }
+
+    /// Read without modifying missing, corrupt or unsupported checkpoints.
+    /// Compatibility is explicit; a runtime upgrade cannot silently discard one.
+    pub fn read(&self, runtime_version: &str) -> io::Result<Option<Checkpoint<T>>> {
+        let contents = match std::fs::read(&self.path) {
+            Ok(contents) => contents,
+            Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(None),
+            Err(error) => return Err(error),
+        };
+        // Inspect version before decoding the current envelope's structure.
+        let header: serde_json::Value =
+            serde_json::from_slice(&contents).map_err(|_| invalid("checkpoint JSON is corrupt"))?;
+        if header
+            .get("formatVersion")
+            .and_then(serde_json::Value::as_u64)
+            != Some(u64::from(FORMAT_VERSION))
+        {
+            return Err(invalid("checkpoint format version is unsupported"));
+        }
+        let envelope: Envelope = serde_json::from_value(header)
+            .map_err(|_| invalid("checkpoint envelope is corrupt"))?;
+        if digest(envelope.record_json.as_bytes()) != envelope.sha256 {
+            return Err(invalid("checkpoint checksum does not match"));
+        }
+        let record: Checkpoint<T> = serde_json::from_str(&envelope.record_json)
+            .map_err(|_| invalid("checkpoint continuation is corrupt or unsupported"))?;
+        self.validate(&record)?;
+        if record.state == CheckpointState::Suspended && record.runtime_version != runtime_version {
+            return Err(invalid("checkpoint runtime version is unsupported"));
+        }
+        Ok(Some(record))
+    }
+
+    fn validate(&self, record: &Checkpoint<T>) -> io::Result<()> {
+        if record.identity.thread_id != self.thread_id
+            || record.identity.turn_id.is_empty()
+            || record.identity.checkpoint_id.is_empty()
+            || record.runtime_version.is_empty()
+            || record.history_binding.is_empty()
+            || record.revision == 0
+            || (record.state == CheckpointState::Suspended) != record.continuation.is_some()
+        {
+            return Err(invalid(
+                "checkpoint identity, revision or lifecycle is invalid",
+            ));
+        }
+        Ok(())
+    }
+
+    /// Compare and replace under the held process lock. First commit is revision
+    /// one; replacement must advance exactly once from the observed revision.
+    /// A failure before atomic replacement leaves the previous valid record intact.
+    /// An error syncing the directory after replacement can leave the new record
+    /// committed; the caller must reread before retrying and never acknowledge it.
+    pub fn commit(&self, expected_revision: Option<u64>, record: &Checkpoint<T>) -> io::Result<()> {
+        self.validate(record)?;
+        let previous = self.read(&record.runtime_version)?;
+        if previous.as_ref().map(|value| value.revision) != expected_revision {
+            return Err(io::Error::new(
+                io::ErrorKind::AlreadyExists,
+                "checkpoint revision changed",
+            ));
+        }
+        let next = expected_revision
+            .unwrap_or(0)
+            .checked_add(1)
+            .ok_or_else(|| invalid("checkpoint revision is exhausted"))?;
+        if record.revision != next {
+            return Err(invalid("checkpoint replacement must advance its revision"));
+        }
+        if let Some(previous) = &previous {
+            // A terminal tombstone cannot be reopened by an old suspension.
+            if previous.state != CheckpointState::Suspended
+                && previous.identity.checkpoint_id == record.identity.checkpoint_id
+                && record.state == CheckpointState::Suspended
+            {
+                return Err(invalid("a terminal checkpoint cannot be suspended again"));
+            }
+            if record.state != CheckpointState::Suspended && previous.identity != record.identity {
+                return Err(invalid(
+                    "checkpoint settlement belongs to another suspension",
+                ));
+            }
+        } else if record.state != CheckpointState::Suspended {
+            return Err(invalid("checkpoint settlement has no suspension"));
+        }
+        let record_json = serde_json::to_string(record)
+            .map_err(|_| invalid("checkpoint continuation could not be serialized"))?;
+        let envelope = Envelope {
+            format_version: FORMAT_VERSION,
+            sha256: digest(record_json.as_bytes()),
+            record_json,
+        };
+        let bytes = serde_json::to_vec(&envelope)
+            .map_err(|_| invalid("checkpoint envelope could not be serialized"))?;
+        let mut staged = tempfile::NamedTempFile::new_in(&self.directory)?;
+        staged.write_all(&bytes)?;
+        staged.as_file().sync_all()?;
+        // Same-directory replacement: readers see the old or new complete record.
+        // Never delete the old checkpoint before replacing it.
+        staged.persist(&self.path).map_err(|error| error.error)?;
+        #[cfg(unix)]
+        File::open(&self.directory)?.sync_all()?;
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests;
