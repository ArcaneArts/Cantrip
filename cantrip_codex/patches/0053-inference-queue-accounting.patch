diff --git a/codex-rs/ext/extension-api/src/inference_admission.rs b/codex-rs/ext/extension-api/src/inference_admission.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/ext/extension-api/src/inference_admission.rs
@@ -0,0 +1,18 @@
+//! Per-turn observation of worker admission, without owning provider capacity.
+use std::sync::atomic::{AtomicBool, Ordering};
+
+/// Distinguishes cancellation in the provider queue from an empty execution.
+/// Core marks this only after receiving its actual worker grant; its presence
+/// and value are not themselves a permission to run inference.
+#[derive(Debug, Default)]
+pub struct InferenceQueueAdmission(AtomicBool);
+
+impl InferenceQueueAdmission {
+    pub fn mark_admitted(&self) {
+        self.0.store(true, Ordering::Release);
+    }
+
+    pub fn admitted(&self) -> bool {
+        self.0.load(Ordering::Acquire)
+    }
+}
