+// Process-local opt-in from the managed worker, restricted to the exact native ID.
+// An inherited marker cannot change embedded or unrelated remote CLI behavior.
+fn cantrip_managed_attachment(remote: bool, thread_id: ThreadId, bound_id: Option<&str>) -> bool {
+    remote && bound_id == Some(thread_id.to_string().as_str())
+}
+
+#[cfg(test)]
+#[test]
+fn cantrip_managed_attachment_requires_remote_and_exact_identity() {
+    let thread_id = ThreadId::new();
+    let bound_id = thread_id.to_string();
+    assert!(cantrip_managed_attachment(true, thread_id, Some(&bound_id)));
+    assert!(!cantrip_managed_attachment(
+        false,
+        thread_id,
+        Some(&bound_id)
+    ));
+    assert!(!cantrip_managed_attachment(true, thread_id, None));
+    assert!(!cantrip_managed_attachment(
+        true,
+        ThreadId::new(),
+        Some(&bound_id)
+    ));
+}
 
