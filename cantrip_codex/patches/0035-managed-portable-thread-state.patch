diff --git a/codex-rs/state/src/runtime/portable_thread.rs b/codex-rs/state/src/runtime/portable_thread.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/state/src/runtime/portable_thread.rs
@@ -0,0 +1,185 @@
+//! Selected-thread state needed when its history moves to another native home.
+//! Queue and goal databases publish before the thread's final visibility row.
+use super::StateRuntime;
+use crate::{Project, ThreadGoal, ThreadMetadata};
+use serde::{Deserialize, Serialize};
+use sqlx::Row;
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct PortableThreadState {
+    pub memory_mode: String,
+    pub project: Option<Project>,
+    pub goal: Option<ThreadGoal>,
+    pub goal_continuation_deferred: bool,
+}
+
+impl StateRuntime {
+    pub async fn export_portable_thread_state(
+        &self,
+        metadata: &ThreadMetadata,
+    ) -> anyhow::Result<PortableThreadState> {
+        let memory_mode = self
+            .get_thread_memory_mode(metadata.id)
+            .await?
+            .ok_or_else(|| anyhow::anyhow!("source thread memory mode is absent"))?;
+        let project = match metadata.project_id.as_deref() {
+            Some(id) => Some(
+                self.get_project(id)
+                    .await?
+                    .ok_or_else(|| anyhow::anyhow!("source thread project is absent"))?,
+            ),
+            None => None,
+        };
+        let goal = self.thread_goals().get_thread_goal(metadata.id).await?;
+        let goal_continuation_deferred = self
+            .thread_goals()
+            .has_thread_goal_continuation_deferral(metadata.id)
+            .await?;
+        Ok(PortableThreadState {
+            memory_mode,
+            project,
+            goal,
+            goal_continuation_deferred,
+        })
+    }
+
+    pub async fn insert_portable_thread_if_absent(
+        &self,
+        metadata: &ThreadMetadata,
+        state: &PortableThreadState,
+    ) -> anyhow::Result<bool> {
+        anyhow::ensure!(
+            matches!(state.memory_mode.as_str(), "enabled" | "disabled"),
+            "invalid transferred memory mode"
+        );
+        anyhow::ensure!(
+            metadata.project_id.as_deref() == state.project.as_ref().map(|p| p.id.as_str()),
+            "transferred project identity mismatch"
+        );
+        anyhow::ensure!(
+            state
+                .goal
+                .as_ref()
+                .is_none_or(|g| g.thread_id == metadata.id),
+            "transferred goal identity mismatch"
+        );
+        anyhow::ensure!(
+            !state.goal_continuation_deferred || state.goal.is_some(),
+            "transferred goal deferral has no goal"
+        );
+
+        // Native import owns the selected thread's writer lock. Do not restore
+        // old auxiliary state over a visible destination, even on a late retry.
+        if self.get_thread(metadata.id).await?.is_some() {
+            return Ok(false);
+        }
+        self.thread_goals()
+            .restore_portable_thread_goal(
+                metadata.id,
+                state.goal.as_ref(),
+                state.goal_continuation_deferred,
+            )
+            .await?;
+        let mut tx = self.pool.begin_with("BEGIN IMMEDIATE").await?;
+        if let Some(section) = &metadata.section {
+            let appearance = section
+                .appearance
+                .as_ref()
+                .map(serde_json::to_string)
+                .transpose()?;
+            sqlx::query("INSERT INTO thread_sections(id, name, appearance) VALUES (?, ?, ?) ON CONFLICT(id) DO NOTHING")
+                .bind(&section.id).bind(&section.name).bind(&appearance).execute(&mut *tx).await?;
+            let row = sqlx::query("SELECT name, appearance FROM thread_sections WHERE id = ?")
+                .bind(&section.id)
+                .fetch_one(&mut *tx)
+                .await?;
+            let existing_name: String = row.try_get("name")?;
+            let existing_appearance: Option<String> = row.try_get("appearance")?;
+            let existing_appearance = existing_appearance
+                .map(|s| serde_json::from_str::<serde_json::Value>(&s))
+                .transpose()?;
+            let expected_appearance = section
+                .appearance
+                .as_ref()
+                .map(serde_json::to_value)
+                .transpose()?;
+            if existing_name != section.name || existing_appearance != expected_appearance {
+                // Every empty native database contains this pristine built-in
+                // section. Its selected-thread presentation may be customized.
+                let pristine = section.id == "01984de2-8f74-7c91-a3b2-5c5e937cf318"
+                    && existing_name == "Pinned"
+                    && existing_appearance.is_none();
+                let referenced: i64 =
+                    sqlx::query_scalar("SELECT COUNT(*) FROM threads WHERE thread_section_id = ?")
+                        .bind(&section.id)
+                        .fetch_one(&mut *tx)
+                        .await?;
+                anyhow::ensure!(
+                    pristine && referenced == 0,
+                    "destination section already differs"
+                );
+                sqlx::query("UPDATE thread_sections SET name = ?, appearance = ? WHERE id = ?")
+                    .bind(&section.name)
+                    .bind(appearance)
+                    .bind(&section.id)
+                    .execute(&mut *tx)
+                    .await?;
+            }
+        }
+        if let Some(project) = &state.project {
+            let inserted = sqlx::query("INSERT INTO projects(id, name, metadata, position, created_at_ms, updated_at_ms) VALUES (?, ?, ?, ?, ?, ?) ON CONFLICT(id) DO NOTHING")
+                .bind(&project.id).bind(&project.name).bind(serde_json::to_string(&project.metadata)?)
+                .bind(project.position).bind(project.created_at_ms).bind(project.updated_at_ms)
+                .execute(&mut *tx).await?.rows_affected() > 0;
+            if inserted {
+                for (position, root) in project.roots.iter().enumerate() {
+                    sqlx::query(
+                        "INSERT INTO project_roots(project_id, position, path) VALUES (?, ?, ?)",
+                    )
+                    .bind(&project.id)
+                    .bind(i64::try_from(position)?)
+                    .bind(&root.path)
+                    .execute(&mut *tx)
+                    .await?;
+                }
+            } else {
+                let row = sqlx::query("SELECT name, metadata, position, created_at_ms, updated_at_ms FROM projects WHERE id = ?")
+                    .bind(&project.id).fetch_one(&mut *tx).await?;
+                let metadata_json: String = row.try_get("metadata")?;
+                anyhow::ensure!(
+                    row.try_get::<String, _>("name")? == project.name
+                        && serde_json::from_str::<std::collections::BTreeMap<String, String>>(
+                            &metadata_json
+                        )? == project.metadata
+                        && row.try_get::<i64, _>("position")? == project.position
+                        && row.try_get::<i64, _>("created_at_ms")? == project.created_at_ms
+                        && row.try_get::<i64, _>("updated_at_ms")? == project.updated_at_ms,
+                    "destination project already differs"
+                );
+                let roots: Vec<String> = sqlx::query_scalar(
+                    "SELECT path FROM project_roots WHERE project_id = ? ORDER BY position",
+                )
+                .bind(&project.id)
+                .fetch_all(&mut *tx)
+                .await?;
+                anyhow::ensure!(
+                    roots
+                        == project
+                            .roots
+                            .iter()
+                            .map(|r| r.path.clone())
+                            .collect::<Vec<_>>(),
+                    "destination project roots already differ"
+                );
+            }
+        }
+        let inserted = self
+            .insert_thread_if_absent_in_transaction(metadata, &state.memory_mode, &mut tx)
+            .await?;
+        tx.commit().await?;
+        self.insert_thread_spawn_edge_from_source_if_absent(metadata.id, metadata.source.as_str())
+            .await?;
+        Ok(inserted)
+    }
+}
