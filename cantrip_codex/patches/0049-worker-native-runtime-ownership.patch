--- /dev/null
+++ b/codex-rs/cli/src/cantrip_runtime_owner.rs
@@ -0,0 +1,305 @@
+//! Private worker/native lifetime protocol. No inference or credentials live here.
+//!
+//! The keeper owns `owner.lock` while its worker's stdin pipe is open. Registry
+//! mutations take a separate lock. A real app-server holds its own OS file lock
+//! until process death. Taking that lock, never a PID/launcher/socket observation,
+//! proves that its execution cannot continue. All paths use registry -> runtime
+//! lock ordering; native ownership watchers never take the registry lock.
+use anyhow::Context;
+use clap::Parser;
+use notify::Watcher;
+use serde::Deserialize;
+use serde::Serialize;
+use std::collections::BTreeSet;
+use std::fs;
+use std::fs::File;
+use std::io;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+use std::sync::mpsc;
+
+const SCOPE_ENV: &str = "CANTRIP_INFERENCE_SCOPE";
+const GENERATION_ENV: &str = "CANTRIP_INFERENCE_GENERATION";
+const RUNTIME_ENV: &str = "CANTRIP_INFERENCE_RUNTIME";
+
+#[derive(Debug, Parser)]
+pub(crate) struct Command {
+    #[arg(long)]
+    scope: PathBuf,
+    #[arg(long)]
+    generation: String,
+    #[arg(long, conflicts_with = "retire")]
+    prepare: Option<String>,
+    #[arg(long)]
+    retire: Option<String>,
+}
+
+#[derive(Deserialize, Serialize)]
+#[serde(rename_all = "camelCase")]
+struct Intent {
+    version: u8,
+    generation: String,
+    runtime_id: String,
+    active: bool,
+}
+
+fn identity(value: &str) -> anyhow::Result<()> {
+    anyhow::ensure!(
+        value.len() == 36
+            && value.bytes().enumerate().all(|(index, byte)| {
+                if [8, 13, 18, 23].contains(&index) {
+                    byte == b'-'
+                } else {
+                    byte.is_ascii_hexdigit()
+                }
+            }),
+        "invalid native ownership identity"
+    );
+    Ok(())
+}
+
+fn open_lock(path: &Path) -> anyhow::Result<File> {
+    let file = File::options()
+        .read(true)
+        .write(true)
+        .create(true)
+        .truncate(false)
+        .open(path)?;
+    file.lock()?;
+    Ok(file)
+}
+
+fn write_json(path: &Path, value: &impl Serialize) -> anyhow::Result<()> {
+    let parent = path.parent().context("ownership path has no parent")?;
+    let mut temporary = tempfile::Builder::new()
+        .prefix(".write-")
+        .tempfile_in(parent)?;
+    serde_json::to_writer(temporary.as_file_mut(), value)?;
+    temporary.as_file().sync_all()?;
+    temporary.persist(path).map_err(|error| error.error)?;
+    #[cfg(unix)]
+    File::open(parent)?.sync_all()?;
+    Ok(())
+}
+
+fn remove_if_present(path: &Path) -> anyhow::Result<()> {
+    match fs::remove_file(path) {
+        Ok(()) => Ok(()),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(()),
+        Err(error) => Err(error.into()),
+    }
+}
+
+fn current_generation(scope: &Path) -> anyhow::Result<String> {
+    Ok(serde_json::from_slice(&fs::read(
+        scope.join("generation.json"),
+    )?)?)
+}
+
+fn intent_path(scope: &Path, runtime: &str) -> PathBuf {
+    scope.join("runtimes").join(format!("{runtime}.json"))
+}
+
+fn read_intent(scope: &Path, runtime: &str) -> anyhow::Result<Intent> {
+    Ok(serde_json::from_slice(&fs::read(intent_path(
+        scope, runtime,
+    ))?)?)
+}
+
+// Called with registry.lock held. Removing the one-use intent first fences
+// launches that have not entered native code yet. A live native sees removal
+// through its ownership watcher and exits; the OS lease proves its actual death.
+fn retire(scope: &Path, runtime: &str) -> anyhow::Result<()> {
+    remove_if_present(&intent_path(scope, runtime))?;
+    let path = scope.join("runtimes").join(format!("{runtime}.lock"));
+    let lease = open_lock(&path)?;
+    drop(lease);
+    remove_if_present(&path)
+}
+
+fn retire_all(scope: &Path) -> anyhow::Result<()> {
+    let mut runtimes = BTreeSet::new();
+    for entry in fs::read_dir(scope.join("runtimes"))? {
+        let path = entry?.path();
+        let name = path
+            .file_name()
+            .and_then(|name| name.to_str())
+            .unwrap_or("");
+        if name.starts_with(".write-") {
+            remove_if_present(&path)?;
+        } else if matches!(
+            path.extension().and_then(|extension| extension.to_str()),
+            Some("json" | "lock")
+        ) {
+            let runtime = path
+                .file_stem()
+                .and_then(|name| name.to_str())
+                .context("invalid runtime filename")?;
+            identity(runtime)?;
+            runtimes.insert(runtime.to_owned());
+        }
+    }
+    for runtime in runtimes {
+        retire(scope, &runtime)?;
+    }
+    Ok(())
+}
+
+impl Command {
+    pub(crate) fn run(self) -> anyhow::Result<()> {
+        anyhow::ensure!(self.scope.is_absolute(), "ownership scope must be absolute");
+        identity(&self.generation)?;
+        fs::create_dir_all(self.scope.join("runtimes"))?;
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            fs::set_permissions(&self.scope, fs::Permissions::from_mode(0o700))?;
+            fs::set_permissions(
+                self.scope.join("runtimes"),
+                fs::Permissions::from_mode(0o700),
+            )?;
+        }
+        if let Some(runtime) = &self.prepare {
+            identity(runtime)?;
+            let _registry = open_lock(&self.scope.join("registry.lock"))?;
+            anyhow::ensure!(
+                current_generation(&self.scope)? == self.generation,
+                "worker ownership was superseded"
+            );
+            let path = intent_path(&self.scope, runtime);
+            anyhow::ensure!(
+                !path.try_exists()?,
+                "native runtime identity already prepared"
+            );
+            write_json(
+                &path,
+                &Intent {
+                    version: 1,
+                    generation: self.generation.clone(),
+                    runtime_id: runtime.clone(),
+                    active: false,
+                },
+            )?;
+        } else if let Some(runtime) = &self.retire {
+            identity(runtime)?;
+            let _registry = open_lock(&self.scope.join("registry.lock"))?;
+            // A delayed old callback may retire its exact runtime after takeover,
+            // but may never remove a different generation's prepared identity.
+            if let Ok(intent) = read_intent(&self.scope, runtime) {
+                anyhow::ensure!(
+                    intent.generation == self.generation,
+                    "runtime ownership changed"
+                );
+            }
+            // Missing/corrupt metadata revokes native authority; it is not death
+            // evidence. Still remove the exact intent and obtain its OS lease.
+            retire(&self.scope, runtime)?;
+        } else {
+            let _owner = open_lock(&self.scope.join("owner.lock"))?;
+            {
+                let _registry = open_lock(&self.scope.join("registry.lock"))?;
+                write_json(&self.scope.join("generation.json"), &self.generation)?;
+                retire_all(&self.scope)?;
+            }
+            self.acknowledge()?;
+            // This pipe is owned by the Node worker, not a UI or WebSocket. EOF
+            // fences all its native processes before releasing worker ownership.
+            io::copy(&mut io::stdin().lock(), &mut io::sink())?;
+            let _registry = open_lock(&self.scope.join("registry.lock"))?;
+            write_json(&self.scope.join("generation.json"), &String::new())?;
+            retire_all(&self.scope)?;
+            return Ok(());
+        }
+        self.acknowledge()
+    }
+
+    fn acknowledge(&self) -> anyhow::Result<()> {
+        serde_json::to_writer(
+            io::stdout().lock(),
+            &serde_json::json!({ "version": 1, "generation": self.generation, "ready": true }),
+        )?;
+        println!();
+        io::stdout().flush()?;
+        Ok(())
+    }
+}
+
+fn still_owned(scope: &Path, generation: &str, runtime: &str) -> bool {
+    current_generation(scope).is_ok_and(|current| current == generation)
+        && read_intent(scope, runtime).is_ok_and(|intent| {
+            intent.version == 1
+                && intent.generation == generation
+                && intent.runtime_id == runtime
+                && intent.active
+        })
+}
+
+/// Standalone Codex launches have no worker registration. Managed launches must
+/// consume their exact prepared intent before any native inference can begin.
+pub(crate) fn enter_runtime() -> anyhow::Result<()> {
+    let scope = std::env::var_os(SCOPE_ENV);
+    let generation = std::env::var_os(GENERATION_ENV);
+    let runtime = std::env::var_os(RUNTIME_ENV);
+    if scope.is_none() && generation.is_none() && runtime.is_none() {
+        return Ok(());
+    }
+    let scope = PathBuf::from(scope.context("missing native ownership scope")?);
+    let generation = generation
+        .context("missing worker generation")?
+        .into_string()
+        .map_err(|_| anyhow::anyhow!("invalid worker generation"))?;
+    let runtime = runtime
+        .context("missing runtime identity")?
+        .into_string()
+        .map_err(|_| anyhow::anyhow!("invalid runtime identity"))?;
+    identity(&generation)?;
+    identity(&runtime)?;
+    anyhow::ensure!(scope.is_absolute(), "ownership scope must be absolute");
+    let _registry = open_lock(&scope.join("registry.lock"))?;
+    anyhow::ensure!(
+        current_generation(&scope)? == generation,
+        "worker ownership was superseded"
+    );
+    let mut intent = read_intent(&scope, &runtime)?;
+    anyhow::ensure!(
+        intent.version == 1
+            && intent.generation == generation
+            && intent.runtime_id == runtime
+            && !intent.active,
+        "native launch has no unconsumed ownership intent"
+    );
+    let lease = open_lock(&scope.join("runtimes").join(format!("{runtime}.lock")))?;
+    let (changed, changes) = mpsc::sync_channel(1);
+    let mut watcher = notify::recommended_watcher(move |event: notify::Result<notify::Event>| {
+        // Coalesce filesystem changes. A failed watcher cannot retain authority.
+        match event {
+            Ok(event) if matches!(event.kind, notify::EventKind::Access(_)) => {}
+            Ok(_) => {
+                let _ = changed.try_send(());
+            }
+            Err(_) => std::process::exit(1),
+        }
+    })?;
+    watcher.watch(&scope, notify::RecursiveMode::NonRecursive)?;
+    watcher.watch(&scope.join("runtimes"), notify::RecursiveMode::NonRecursive)?;
+    intent.active = true;
+    write_json(&intent_path(&scope, &runtime), &intent)?;
+    // Deliberately process-lifetime: task cancellation, unwinding, or runtime
+    // teardown cannot advertise death while another native task may still infer.
+    let _lease: &'static mut File = Box::leak(Box::new(lease));
+    std::thread::Builder::new()
+        .name("cantrip-runtime-owner".into())
+        .spawn(move || {
+            let _watcher = watcher;
+            loop {
+                if !still_owned(&scope, &generation, &runtime) {
+                    std::process::exit(1);
+                }
+                if changes.recv().is_err() {
+                    std::process::exit(1);
+                }
+            }
+        })?;
+    Ok(())
+}
