+
+#[test]
+fn canonical_completion_preserves_root_turn_identity() {
+    let mut started = start("child", true);
+    if let RolloutItem::EventMsg(EventMsg::TurnStarted(turn)) = &mut started {
+        turn.root_turn_id = Some("root".into());
+    }
+    let mut builder = ThreadHistoryBuilder::new();
+    builder.handle_rollout_item(&started);
+    builder.handle_rollout_item(&user());
+    builder.handle_rollout_item(&end("child"));
+    assert_eq!(
+        builder.canonical_status["child"].root_turn_id.as_deref(),
+        Some("root")
+    );
+    assert_eq!(
+        builder
+            .active_turn_metadata_snapshot()
+            .unwrap()
+            .root_turn_id
+            .as_deref(),
+        Some("root")
+    );
+}
