diff --git a/codex-rs/core/src/unified_exec/suspension.rs b/codex-rs/core/src/unified_exec/suspension.rs
new file mode 100644
index 0000000..048cbda
--- /dev/null
+++ b/codex-rs/core/src/unified_exec/suspension.rs
@@ -0,0 +1,137 @@
+//! Completed terminal data only. No process, launch policy, approval, or command is replayed.
+use super::*;
+use serde::{Deserialize, Serialize};
+use std::sync::atomic::{AtomicBool, Ordering};
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct CompletedOutput {
+    pub(super) pending: (Vec<u8>, Vec<u8>, usize),
+    pub(super) transcript: (Vec<u8>, Vec<u8>, usize),
+    pub(super) exit_code: i32,
+    pub(super) timed_out: bool,
+    pub(super) sandbox_type: Option<codex_sandboxing::SandboxType>,
+    pub(super) sandbox_denied: bool,
+    pub(super) failure_message: Option<String>,
+}
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct CompletedTerminal {
+    process_id: i32,
+    call_id: String,
+    cwd: PathUri,
+    environment_id: String,
+    output: CompletedOutput,
+}
+
+impl UnifiedExecProcessManager {
+    pub(super) fn track_suspension_producer(&self, task: tokio::task::JoinHandle<()>) {
+        let failed = Arc::clone(&self.completion_failed);
+        self.completion_tasks.spawn(async move {
+            if task.await.is_err() {
+                failed.store(true, Ordering::Release);
+            }
+        });
+    }
+
+    pub(crate) async fn capture_completed_terminals(
+        &self,
+    ) -> Result<Vec<CompletedTerminal>, String> {
+        let processes: Vec<_> = self
+            .process_store
+            .lock()
+            .await
+            .processes
+            .values()
+            .map(|entry| Arc::clone(&entry.process))
+            .collect();
+        // Observe actual exit and producer closure; a parent PID alone is insufficient.
+        for process in processes {
+            process.suspension_snapshot().await?;
+        }
+        self.completion_tasks.close();
+        self.completion_tasks.wait().await;
+        self.completion_tasks.reopen();
+        if self.completion_failed.load(Ordering::Acquire) {
+            return Err(
+                "command history producer failed; live Resume and Stop remain available".into(),
+            );
+        }
+        let mut entries: Vec<_> = self
+            .process_store
+            .lock()
+            .await
+            .processes
+            .values()
+            .map(|entry| {
+                (
+                    entry.process_id,
+                    entry.call_id.clone(),
+                    entry.cwd.clone(),
+                    entry.environment_id.clone(),
+                    Arc::clone(&entry.process),
+                    entry.last_used,
+                )
+            })
+            .collect();
+        // Preserve eviction priority without persisting a process-local clock.
+        entries.sort_by_key(|entry| (entry.5, entry.0));
+        let mut saved = Vec::with_capacity(entries.len());
+        for (process_id, call_id, cwd, environment_id, process, _) in entries {
+            let _interaction = process.interaction_lock().lock_owned().await;
+            saved.push(CompletedTerminal {
+                process_id,
+                call_id,
+                cwd,
+                environment_id,
+                output: process.suspension_snapshot().await?,
+            });
+        }
+        Ok(saved)
+    }
+
+    pub(crate) async fn restore_completed_terminals(
+        &self,
+        saved: Vec<CompletedTerminal>,
+    ) -> Result<(), String> {
+        // Validate every entry before changing the live store.
+        let mut entries = Vec::with_capacity(saved.len());
+        let mut ids = HashSet::new();
+        let restored_at = tokio::time::Instant::now();
+        let count = saved.len();
+        for (index, saved) in saved.into_iter().enumerate() {
+            if saved.process_id < 1000
+                || !ids.insert(saved.process_id)
+                || saved.call_id.is_empty()
+                || saved.environment_id.is_empty()
+            {
+                return Err("invalid saved completed terminal identity".into());
+            }
+            entries.push(ProcessEntry {
+                process: Arc::new(UnifiedExecProcess::from_completed(saved.output)?),
+                plugin_metrics_sidecar: None,
+                call_id: saved.call_id,
+                process_id: saved.process_id,
+                cwd: saved.cwd,
+                initial_exec_command_active: Arc::new(AtomicBool::new(false)),
+                hook_command: String::new(),
+                tty: false,
+                environment_id: saved.environment_id,
+                permissions: None,
+                network_approval: None,
+                session: Weak::new(),
+                last_used: restored_at - std::time::Duration::from_nanos((count - index) as u64),
+            });
+        }
+        let mut store = self.process_store.lock().await;
+        if !store.processes.is_empty() || !store.reserved_process_ids.is_empty() {
+            return Err("terminal restoration no longer owns an empty process store".into());
+        }
+        for entry in entries {
+            store.reserved_process_ids.insert(entry.process_id);
+            store.processes.insert(entry.process_id, entry);
+        }
+        Ok(())
+    }
+}
