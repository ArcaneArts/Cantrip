new file mode 100644
index 0000000..0e60399
--- /dev/null
+++ b/codex-rs/core/src/session/protected_resources.rs
@@ -0,0 +1,115 @@
+//! Worker-authorized protection of inert continuation data. Keys and execution
+//! authority never enter the checkpoint or the native history.
+use super::session::Session;
+use crate::unified_exec::suspension::CompletedTerminal;
+use base64::Engine;
+use serde::{Deserialize, Serialize};
+
+const MAX_RESOURCE_BYTES: usize = 32 * 1024 * 1024;
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(super) struct ProtectedResources {
+    format_version: u32,
+    envelope: Envelope,
+}
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Envelope {
+    version: u32,
+    algorithm: String,
+    key_revision: u32,
+    nonce: String,
+    ciphertext: String,
+}
+
+#[derive(Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(super) struct ResourceData {
+    format_version: u32,
+    pub(super) terminals: Vec<CompletedTerminal>,
+}
+
+impl ProtectedResources {
+    fn validate(&self) -> Result<(), String> {
+        let decode = |text: &str| base64::engine::general_purpose::URL_SAFE_NO_PAD.decode(text);
+        if self.format_version != 1
+            || self.envelope.version != 1
+            || self.envelope.algorithm != "AES-256-GCM"
+            || self.envelope.key_revision == 0
+            || decode(&self.envelope.nonce).map_or(true, |bytes| bytes.len() != 12)
+            || self.envelope.ciphertext.len() > (MAX_RESOURCE_BYTES + 16).div_ceil(3) * 4
+            || decode(&self.envelope.ciphertext).map_or(true, |bytes| {
+                bytes.len() < 16 || bytes.len() > MAX_RESOURCE_BYTES + 16
+            })
+        {
+            return Err("native resource protection format is invalid or unsupported".into());
+        }
+        Ok(())
+    }
+
+    pub(super) async fn open(
+        &self,
+        session: &Session,
+        turn_id: &str,
+        checkpoint_id: &str,
+    ) -> Result<ResourceData, String> {
+        self.validate()?;
+        let gate = session
+            .managed_execution_gate()
+            .await
+            .ok_or("native resource restoration requires its connected worker owner")?;
+        let value = gate
+            .protect_resources(
+                session.thread_id,
+                turn_id,
+                checkpoint_id,
+                false,
+                serde_json::to_value(self)
+                    .map_err(|_| "native resource protection could not be encoded")?,
+            )
+            .await?;
+        let data: ResourceData = serde_json::from_value(value)
+            .map_err(|_| "native resource data is invalid or unsupported")?;
+        if data.format_version != 1 {
+            return Err("native resource data version is unsupported".into());
+        }
+        Ok(data)
+    }
+}
+
+pub(super) async fn seal(
+    session: &Session,
+    turn_id: &str,
+    checkpoint_id: &str,
+    terminals: Vec<CompletedTerminal>,
+) -> Result<Option<ProtectedResources>, String> {
+    if terminals.is_empty() {
+        return Ok(None);
+    }
+    let data = ResourceData {
+        format_version: 1,
+        terminals,
+    };
+    let bytes =
+        serde_json::to_vec(&data).map_err(|_| "native resource data could not be encoded")?;
+    if bytes.len() > MAX_RESOURCE_BYTES {
+        return Err("completed terminal data exceeds the durable resource limit; poll or close completed sessions, then retry durable pause".into());
+    }
+    let gate = session.managed_execution_gate().await.ok_or("completed terminal suspension requires worker-backed encryption; live Resume and Stop remain available")?;
+    let value = gate
+        .protect_resources(
+            session.thread_id,
+            turn_id,
+            checkpoint_id,
+            true,
+            serde_json::from_slice(&bytes)
+                .map_err(|_| "native resource data could not be encoded")?,
+        )
+        .await?;
+    let protected: ProtectedResources = serde_json::from_value(value)
+        .map_err(|_| "worker returned invalid native resource protection")?;
+    protected.validate()?;
+    Ok(Some(protected))
+}
