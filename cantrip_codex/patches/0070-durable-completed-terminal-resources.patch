+#[cfg(test)]
+mod resource_tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn resource_replies_authenticate_exact_identity_and_are_one_use() {
+        let (events, mut receiver) = mpsc::unbounded_channel();
+        let gate = ManagedExecutionGate::new("resource-owner".into(), events);
+        let thread_id = ThreadId::new();
+        gate.bind_thread(thread_id).unwrap();
+        let request = {
+            let gate = Arc::clone(&gate);
+            tokio::spawn(async move {
+                gate.protect_resources(
+                    thread_id,
+                    "turn",
+                    "capture",
+                    true,
+                    serde_json::json!({"private":"state"}),
+                )
+                .await
+            })
+        };
+        let ManagedExecutionEvent::ResourceProtection { request_id, .. } =
+            receiver.recv().await.unwrap()
+        else {
+            panic!("expected resource request")
+        };
+        assert!(
+            gate.resolve_resources(
+                ThreadId::new(),
+                "turn",
+                "capture",
+                &request_id,
+                Ok(Value::Null)
+            )
+            .is_err()
+        );
+        assert!(
+            gate.resolve_resources(thread_id, "other", "capture", &request_id, Ok(Value::Null))
+                .is_err()
+        );
+        assert!(
+            gate.resolve_resources(thread_id, "turn", "other", &request_id, Ok(Value::Null))
+                .is_err()
+        );
+        gate.resolve_resources(
+            thread_id,
+            "turn",
+            "capture",
+            &request_id,
+            Ok(serde_json::json!({"protected":true})),
+        )
+        .unwrap();
+        assert_eq!(
+            request.await.unwrap().unwrap(),
+            serde_json::json!({"protected":true})
+        );
+        assert!(
+            gate.resolve_resources(thread_id, "turn", "capture", &request_id, Ok(Value::Null))
+                .is_err()
+        );
+    }
+
+    #[tokio::test]
