+#[tokio::test]
+async fn sparse_child_settings_and_effort_clear_emit_exact_native_receipts() -> Result<()> {
+    let server = wiremock::MockServer::start().await;
+    let home = TempDir::new()?;
+    MockResponsesConfig::new(&server.uri())
+        .with_model("mock-model")
+        .write(home.path())?;
+    let mut app = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    let thread = start_thread(&mut app).await?.thread;
+    send_thread_settings_update(
+        &mut app,
+        ThreadSettingsUpdateParams {
+            thread_id: thread.id.clone(),
+            operation_id: Some("select-child".into()),
+            model: Some("mock-model".into()),
+            effort: Some(Some(ReasoningEffort::High)),
+            multi_agent_enabled: Some(true),
+            subagent_model: Some(Some("chosen-child".into())),
+            subagent_reasoning_effort: Some(Some(ReasoningEffort::Low)),
+            ..Default::default()
+        },
+    )
+    .await?;
+    let chosen = read_thread_settings_updated(&mut app).await?;
+    assert_eq!(chosen.operation_id.as_deref(), Some("select-child"));
+    assert_eq!(
+        chosen.thread_settings.subagent_model.as_deref(),
+        Some("chosen-child")
+    );
+    assert!(chosen.thread_settings.multi_agent_enabled);
+    send_thread_settings_update(
+        &mut app,
+        ThreadSettingsUpdateParams {
+            thread_id: thread.id.clone(),
+            operation_id: Some("clear-effort-and-plan".into()),
+            effort: Some(None),
+            subagent_reasoning_effort: Some(None),
+            collaboration_mode_kind: Some(ModeKind::Plan),
+            ..Default::default()
+        },
+    )
+    .await?;
+    let cleared = read_thread_settings_updated(&mut app).await?;
+    assert_eq!(cleared.thread_settings.model, chosen.thread_settings.model);
+    assert_eq!(cleared.thread_settings.effort, None);
+    assert_eq!(cleared.thread_settings.subagent_reasoning_effort, None);
+    assert_eq!(
+        cleared.thread_settings.subagent_model,
+        chosen.thread_settings.subagent_model
+    );
+    assert_eq!(
+        cleared.thread_settings.collaboration_mode.mode,
+        ModeKind::Plan
+    );
+    send_thread_settings_update(
+        &mut app,
+        ThreadSettingsUpdateParams {
+            thread_id: thread.id,
+            subagent_model: Some(None),
+            multi_agent_enabled: Some(false),
+            ..Default::default()
+        },
+    )
+    .await?;
+    let disabled = read_thread_settings_updated(&mut app).await?;
+    assert!(!disabled.thread_settings.multi_agent_enabled);
+    assert_eq!(disabled.thread_settings.subagent_model, None);
+    assert_eq!(disabled.thread_settings.effort, None);
+    assert!(server.received_requests().await.unwrap().is_empty());
+    Ok(())
+}
