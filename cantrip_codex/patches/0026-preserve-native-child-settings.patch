+#[tokio::test]
+async fn managed_child_settings_preserve_sparse_clear_and_mode_change() {
+    use codex_protocol::protocol::ChildSettingsPatch;
+    let (session, _) = make_session_and_context().await;
+    session
+        .update_managed_config(
+            HashMap::new(),
+            None,
+            true,
+            Some("launch-child".into()),
+            Some(ReasoningEffortConfig::Low),
+        )
+        .await
+        .unwrap();
+    let before = session.thread_settings_snapshot().await;
+    let commit = session
+        .update_settings(SessionSettingsUpdate {
+            child_settings: ChildSettingsPatch {
+                model: Some(Some("chosen-child".into())),
+                reasoning_effort: Some(None),
+                ..Default::default()
+            },
+            ..Default::default()
+        })
+        .await
+        .unwrap();
+    assert_eq!(
+        commit
+            .snapshot
+            .child_settings
+            .as_ref()
+            .unwrap()
+            .model
+            .as_deref(),
+        Some("chosen-child")
+    );
+    assert_eq!(
+        commit
+            .snapshot
+            .child_settings
+            .as_ref()
+            .unwrap()
+            .reasoning_effort,
+        None
+    );
+    assert_eq!(commit.snapshot.model, before.model);
+    let mut refresh = session
+        .get_config()
+        .await
+        .managed_thread_configuration
+        .clone()
+        .unwrap();
+    refresh.preserve_subagent_settings = true;
+    refresh.multi_agent_enabled = false;
+    refresh.subagent_model = Some("stale-launch-child".into());
+    refresh.subagent_reasoning_effort = Some(ReasoningEffortConfig::High);
+    session.update_managed_configuration(refresh).await.unwrap();
+    assert_eq!(session.thread_settings_snapshot().await, commit.snapshot);
+    let config = session.get_config().await;
+    assert!(config.agents_enabled);
+    assert_eq!(
+        config.agent_default_subagent_model.as_deref(),
+        Some("chosen-child")
+    );
+    assert_eq!(config.agent_default_subagent_reasoning_effort, None);
+    let mode_commit = session
+        .update_settings(SessionSettingsUpdate {
+            collaboration_mode_kind: Some(codex_protocol::config_types::ModeKind::Plan),
+            step_settings: StepSettingsUpdate {
+                effort: Some(None),
+                ..Default::default()
+            },
+            child_settings: ChildSettingsPatch {
+                enabled: Some(false),
+                model: Some(None),
+                ..Default::default()
+            },
+            ..Default::default()
+        })
+        .await
+        .unwrap();
+    assert_eq!(mode_commit.snapshot.model, before.model);
+    assert_eq!(mode_commit.snapshot.reasoning_effort, None);
+    assert_eq!(
+        mode_commit.snapshot.collaboration_mode.mode,
+        codex_protocol::config_types::ModeKind::Plan
+    );
+    assert!(
+        mode_commit
+            .snapshot
+            .collaboration_mode
+            .settings
+            .developer_instructions
+            .is_some()
+    );
+    assert_eq!(
+        mode_commit.snapshot.child_settings.as_ref().unwrap().model,
+        None
+    );
+    assert!(
+        !mode_commit
+            .snapshot
+            .child_settings
+            .as_ref()
+            .unwrap()
+            .enabled
+    );
+    let retained = session.restorable_thread_settings().await;
+    assert_eq!(retained.child_settings.model, Some(None));
+    assert_eq!(retained.child_settings.reasoning_effort, Some(None));
+    assert_eq!(retained.child_settings.enabled, Some(false));
+}
