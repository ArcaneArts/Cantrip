+#[test]
+fn thread_settings_sparse_child_and_effort_null_are_distinct_from_omission() {
+    let empty: ThreadSettingsUpdateParams =
+        serde_json::from_value(serde_json::json!({"threadId":"thread"})).unwrap();
+    assert_eq!(empty.effort, None);
+    assert_eq!(empty.subagent_model, None);
+    assert_eq!(empty.subagent_reasoning_effort, None);
+    let clear: ThreadSettingsUpdateParams = serde_json::from_value(serde_json::json!({"threadId":"thread","effort":null,"subagentModel":null,"subagentReasoningEffort":null,"multiAgentEnabled":false,"collaborationModeKind":"plan"})).unwrap();
+    assert_eq!(clear.effort, Some(None));
+    assert_eq!(clear.subagent_model, Some(None));
+    assert_eq!(clear.subagent_reasoning_effort, Some(None));
+    assert_eq!(clear.multi_agent_enabled, Some(false));
+    let encoded = serde_json::to_value(clear).unwrap();
+    assert_eq!(encoded["effort"], serde_json::Value::Null);
+    assert!(encoded.as_object().unwrap().contains_key("effort"));
+    assert!(
+        !serde_json::to_value(empty)
+            .unwrap()
+            .as_object()
+            .unwrap()
+            .contains_key("effort")
+    );
+}
