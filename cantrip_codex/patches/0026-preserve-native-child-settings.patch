+#[tokio::test]
+async fn owned_child_settings_restore_clears_defaults_and_respects_explicit_managed_replacement() {
+    use super::merge_owned_resume_settings;
+    use codex_core::config::{ConfigBuilder, ConfigOverrides, ManagedThreadConfiguration};
+    let home = tempfile::tempdir().unwrap();
+    let mut config = ConfigBuilder::default()
+        .loader_overrides(codex_config::LoaderOverrides::without_managed_config_for_tests())
+        .codex_home(home.path().to_path_buf())
+        .harness_overrides(ConfigOverrides {
+            cwd: Some(home.path().to_path_buf()),
+            ..Default::default()
+        })
+        .build()
+        .await
+        .unwrap();
+    let mut snapshot = full_snapshot();
+    snapshot.child_settings = Some(codex_protocol::protocol::ChildSettingsSnapshot {
+        enabled: false,
+        model: None,
+        reasoning_effort: None,
+    });
+    let owner = codex_protocol::ThreadId::new();
+    for preserve in [true, false] {
+        config
+            .apply_managed_thread_configuration(ManagedThreadConfiguration {
+                preserve_subagent_settings: false,
+                canonical_history: None,
+                execution_gate: None,
+                mcp_servers: Default::default(),
+                developer_instructions: None,
+                multi_agent_enabled: true,
+                subagent_model: Some("explicit-child".into()),
+                subagent_reasoning_effort: Some(
+                    codex_protocol::openai_models::ReasoningEffort::High,
+                ),
+            })
+            .unwrap();
+        let restore = merge_owned_resume_settings(
+            owner,
+            &snapshot,
+            &mut None,
+            &mut ConfigOverrides::default(),
+        );
+        restore
+            .apply_preserving_child_settings(&mut config, preserve)
+            .unwrap();
+        assert_eq!(config.agents_enabled, !preserve);
+        assert_eq!(
+            config.agent_default_subagent_model.as_deref(),
+            if preserve {
+                None
+            } else {
+                Some("explicit-child")
+            }
+        );
+        assert_eq!(
+            config
+                .managed_thread_configuration
+                .as_ref()
+                .unwrap()
+                .subagent_model,
+            config.agent_default_subagent_model
+        );
+    }
+}
