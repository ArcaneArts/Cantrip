+    /// Replaces dynamic tools in persisted session metadata for this resume.
+    /// This preserves the rest of the rollout while allowing callers to
+    /// explicitly migrate a thread away from tools it previously registered.
+    pub fn override_dynamic_tools(&mut self, dynamic_tools: Vec<DynamicToolSpec>) {
+        let items: &mut Vec<RolloutItem> = match self {
+            InitialHistory::New | InitialHistory::Cleared => return,
+            InitialHistory::Resumed(resumed) => Arc::make_mut(&mut resumed.history),
+            InitialHistory::Forked(items) => items,
+        };
+        if let Some(meta) = items.iter_mut().find_map(|item| match item {
+            RolloutItem::SessionMeta(meta_line) => Some(&mut meta_line.meta),
+            _ => None,
+        }) {
+            meta.dynamic_tools = Some(dynamic_tools);
+        }
+    }
