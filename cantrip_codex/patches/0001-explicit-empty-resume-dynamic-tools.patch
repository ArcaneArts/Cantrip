+fn thread_resume_params_preserve_explicit_empty_dynamic_tools() {
+    let omitted = serde_json::from_value::<ThreadResumeParams>(json!({
+        "threadId": "thr_123",
+    }))
+    .expect("omitted dynamic tools should deserialize");
+    assert_eq!(omitted.dynamic_tools, None);
+
+    let empty = serde_json::from_value::<ThreadResumeParams>(json!({
+        "threadId": "thr_123",
+        "dynamicTools": [],
+    }))
+    .expect("explicit empty dynamic tools should deserialize");
+    assert_eq!(empty.dynamic_tools, Some(Vec::new()));
+}
