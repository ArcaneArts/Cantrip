+/// Managed storage can use a fresh home without copying account configuration.
+/// The explicit file remains the native writable user layer; auth is supplied
+/// independently by the owning host. Ordinary app-server launches are unchanged.
+fn loader_overrides_with_managed_user_config_file(
+    mut loader_overrides: LoaderOverrides,
+    user_config_file: Option<std::path::PathBuf>,
+) -> IoResult<LoaderOverrides> {
+    if let Some(path) = user_config_file {
+        if loader_overrides.user_config_path.is_some() {
+            return Err(std::io::Error::new(
+                ErrorKind::InvalidInput,
+                "managed account configuration cannot be combined with another selected user config",
+            ));
+        }
+        loader_overrides.user_config_path = Some(
+            codex_utils_absolute_path::AbsolutePathBuf::from_absolute_path(path).map_err(|_| {
+                std::io::Error::new(
+                    ErrorKind::InvalidInput,
+                    "managed account configuration requires an absolute file path",
+                )
+            })?,
+        );
+    }
+    Ok(loader_overrides)
+}
