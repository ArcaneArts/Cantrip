+#[tokio::test]
+async fn live_app_server_settings_rejection_preserves_running_turn() {
+    let (mut chat, mut rx, mut op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.handle_server_notification(
+        ServerNotification::TurnStarted(TurnStartedNotification {
+            thread_id: "thread-1".into(),
+            turn: AppServerTurn {
+                id: "turn-1".into(),
+                items_view: codex_app_server_protocol::TurnItemsView::Full,
+                items: Vec::new(),
+                status: AppServerTurnStatus::InProgress,
+                error: None,
+                started_at: Some(0),
+                completed_at: None,
+                duration_ms: None,
+            },
+        }),
+        None,
+    );
+    assert!(chat.bottom_pane.is_task_running());
+    chat.handle_server_notification(
+        ServerNotification::Error(ErrorNotification {
+            error: AppServerTurnError {
+                misalignment: None,
+                message: "settings update rejected".into(),
+                codex_error_info: Some(
+                    codex_app_server_protocol::CodexErrorInfo::ThreadSettingsUpdateFailed {
+                        operation_id: Some("settings-1".into()),
+                    },
+                ),
+                additional_details: None,
+            },
+            will_retry: false,
+            thread_id: "thread-1".into(),
+            turn_id: "settings-submission".into(),
+        }),
+        None,
+    );
+    assert!(chat.bottom_pane.is_task_running());
+    assert!(chat.last_non_retry_error.is_none());
+    let cells = drain_insert_history(&mut rx);
+    assert!(
+        cells
+            .iter()
+            .any(|lines| lines_to_single_string(lines).contains("settings update rejected"))
+    );
+    assert!(
+        op_rx.try_recv().is_err(),
+        "a settings rejection must not submit or interrupt a turn"
+    );
+    chat.handle_server_notification(
+        ServerNotification::TurnCompleted(TurnCompletedNotification {
+            thread_id: "thread-1".into(),
+            turn: AppServerTurn {
+                id: "turn-1".into(),
+                items_view: codex_app_server_protocol::TurnItemsView::Full,
+                items: Vec::new(),
+                status: AppServerTurnStatus::Completed,
+                error: None,
+                started_at: Some(0),
+                completed_at: Some(1),
+                duration_ms: Some(1000),
+            },
+        }),
+        None,
+    );
+    assert!(!chat.bottom_pane.is_task_running());
+    assert!(chat.last_non_retry_error.is_none());
+}
