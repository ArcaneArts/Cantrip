+async fn assert_settings_only_rollout(test: &TestCodex) -> Result<()> {
+    let rollout_path = test.codex.rollout_path().expect("rollout path");
+    let contents = tokio::fs::read_to_string(rollout_path).await?;
+    let mut latest = None;
+    for line in contents.lines() {
+        let line: RolloutLine = serde_json::from_str(line)?;
+        if let RolloutItem::EventMsg(event) = line.item {
+            assert!(
+                !matches!(
+                    event,
+                    EventMsg::TurnStarted(_) | EventMsg::UserMessage(_) | EventMsg::AgentMessage(_)
+                ),
+                "settings must not create conversation activity"
+            );
+            if let EventMsg::ThreadSettingsApplied(applied) = event {
+                latest = Some(applied.thread_settings);
+            }
+        }
+    }
+    assert_eq!(latest, Some(test.codex.thread_settings_snapshot().await));
+    Ok(())
+}
