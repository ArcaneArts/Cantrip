+    if suspended {
+        // An unfinished held turn is not an interrupted historical turn. Keep
+        // its actual stored lifecycle without announcing admitted execution.
+        thread.status = loaded_status;
+    } else {
+        set_thread_status_and_interrupt_stale_turns(
+            thread,
+            loaded_status,
+            has_live_in_progress_turn,
+        );
+    }
+}
