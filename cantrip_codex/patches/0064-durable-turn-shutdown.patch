+/// Runtime teardown is not Stop. A frozen continuation keeps its native history
+/// unfinished while the process-local task and execution authority are released.
+pub(super) async fn preserve_for_shutdown(session: &Arc<Session>) -> bool {
+    let Some(owner) = session
+        .services
+        .thread_extension_data
+        .get::<DurableSuspension>()
+    else {
+        return false;
+    };
+    let turn = {
+        let mut active = session.active_turn.lock().await;
+        let _control = owner.control();
+        if !owner.frozen.load(Ordering::Acquire)
+            || active.as_ref().is_some_and(|turn| {
+                turn.finishing.is_some()
+                    || turn
+                        .task
+                        .as_ref()
+                        .is_some_and(|task| task.kind != crate::state::TaskKind::Regular)
+            })
+        {
+            return false;
+        }
+        // Invalidate late readiness/grants before removing their task. Keep the
+        // stored payload and explicit hold, including an unreadable cold hold.
+        owner.epoch.fetch_add(1, Ordering::AcqRel);
+        owner.requested.store(false, Ordering::Release);
+        owner.cancel_live_resume("native runtime is shutting down while suspended");
+        active.take()
+    };
+    if let Some(turn) = turn {
+        let _ = super::turn_suspension::stop_detached_turn(session, turn).await;
+    }
+    true
+}
