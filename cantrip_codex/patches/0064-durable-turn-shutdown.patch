+/// Stop an already detached task without turn-terminal callbacks. Durable callers
+/// retain accepted input in their committed continuation; ordinary handoff keeps
+/// its existing best-effort input policy.
+pub(super) async fn stop_detached_turn(
+    session: &Arc<Session>,
+    mut turn: ActiveTurn,
+) -> Option<String> {
+    // Releasing the task's security lease wakes queued work in this thread.
+    // Both callers are tearing down the runtime; fence starts before release.
+    session.state.lock().await.shutting_down = true;
+    let turn_id = if let Some(task) = turn.task.take() {
+        let context = Arc::clone(&task.turn_context);
+        let turn_id = context.sub_id.clone();
+        task.cancellation_token.cancel();
+        context.turn_metadata_state.cancel_git_enrichment_task();
+        let mut task_handle = task.handle.detach();
+        match tokio::time::timeout(
+            Duration::from_millis(crate::tasks::GRACEFULL_INTERRUPTION_TIMEOUT_MS),
+            &mut task_handle,
+        )
+        .await
+        {
+            Ok(Ok(())) => {}
+            Ok(Err(error)) => {
+                warn!(thread_id = %session.thread_id, %error, "suspended turn task exited abnormally");
+            }
+            Err(_) => {
+                warn!(
+                    thread_id = %session.thread_id,
+                    "suspended turn task did not stop gracefully; aborting it"
+                );
+                task_handle.abort();
+                let _ = task_handle.await;
+            }
+        }
+        session.finish_security_execution(&context).await;
+        Some(turn_id)
+    } else {
+        None
+    };
+    session.input_queue.clear_pending(&turn).await;
+    turn_id
+}
