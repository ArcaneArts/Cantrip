+/// Reserves ownership while Session initialization is fallible. Dropping an
+/// uncommitted reservation (including cancellation) releases only that startup's
+/// thread ID; a live or explicitly bound runner can never be reassigned.
+#[must_use]
+pub(crate) struct ManagedExecutionStartupBinding {
+    gate: Arc<ManagedExecutionGate>,
+    thread_id: ThreadId,
+}
+
+impl ManagedExecutionStartupBinding {
+    pub(crate) fn commit(self) {
+        let mut state = self
+            .gate
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        state.thread_binding_committed = true;
+    }
+}
+
+impl Drop for ManagedExecutionStartupBinding {
+    fn drop(&mut self) {
+        let mut state = self
+            .gate
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if state.thread_id == Some(self.thread_id) {
+            state.startup_bindings -= 1;
+            if state.startup_bindings == 0 && !state.thread_binding_committed {
+                state.thread_id = None;
+            }
+        }
+    }
+}
