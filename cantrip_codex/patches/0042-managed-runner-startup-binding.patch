+#[cfg(test)]
+mod startup_binding_tests {
+    use super::*;
+
+    fn gate() -> Arc<ManagedExecutionGate> {
+        let (events, _) = mpsc::unbounded_channel();
+        ManagedExecutionGate::new("startup-runner".into(), events)
+    }
+
+    #[test]
+    fn failed_startup_can_retry_but_committed_startup_cannot_be_stolen() {
+        let gate = gate();
+        let first = ThreadId::new();
+        let retry = ThreadId::new();
+        let binding = gate.bind_thread_for_startup(first).unwrap();
+        assert!(gate.bind_thread_for_startup(retry).is_err());
+        drop(binding);
+        let binding = gate.bind_thread_for_startup(retry).unwrap();
+        binding.commit();
+        assert!(gate.bind_thread_for_startup(first).is_err());
+        assert!(gate.bind_thread(first).is_err());
+        gate.bind_thread(retry).unwrap();
+    }
+
+    #[test]
+    fn failed_resume_does_not_release_existing_ownership() {
+        let gate = gate();
+        let thread = ThreadId::new();
+        gate.bind_thread(thread).unwrap();
+        drop(gate.bind_thread_for_startup(thread).unwrap());
+        assert!(gate.bind_thread(ThreadId::new()).is_err());
+        gate.bind_thread(thread).unwrap();
+    }
+
+    #[test]
+    fn overlapping_startups_release_only_after_the_last_reservation() {
+        let gate = gate();
+        let thread = ThreadId::new();
+        let next = ThreadId::new();
+        let first = gate.bind_thread_for_startup(thread).unwrap();
+        let second = gate.bind_thread_for_startup(thread).unwrap();
+        drop(first);
+        assert!(gate.bind_thread(next).is_err());
+        drop(second);
+        gate.bind_thread(next).unwrap();
+    }
+
+    #[test]
+    fn successful_overlapping_startup_survives_another_startup_failure() {
+        let gate = gate();
+        let thread = ThreadId::new();
+        let first = gate.bind_thread_for_startup(thread).unwrap();
+        let second = gate.bind_thread_for_startup(thread).unwrap();
+        second.commit();
+        drop(first);
+        assert!(gate.bind_thread(ThreadId::new()).is_err());
+    }
+
+    #[test]
+    fn explicit_binding_during_startup_survives_startup_failure() {
+        let gate = gate();
+        let thread = ThreadId::new();
+        let binding = gate.bind_thread_for_startup(thread).unwrap();
+        gate.bind_thread(thread).unwrap();
+        drop(binding);
+        assert!(gate.bind_thread(ThreadId::new()).is_err());
+    }
+
+    #[test]
+    fn failed_startup_never_reopens_an_invalidated_or_inherited_runner() {
+        let gate = gate();
+        let binding = gate.bind_thread_for_startup(ThreadId::new()).unwrap();
+        gate.invalidate();
+        drop(binding);
+        assert!(gate.is_closed());
+        let thread = ThreadId::new();
+        let inherited = ManagedExecutionGate::inherited_closed(thread);
+        drop(inherited.bind_thread_for_startup(thread).unwrap());
+        assert!(inherited.is_closed());
+        assert!(inherited.bind_thread(ThreadId::new()).is_err());
+    }
+}
