+#[tokio::test]
+async fn managed_config_update_rebases_stale_reload_and_revalidates_current_profile() {
+    let (session, _turn_context) = make_session_and_context().await;
+    let server = |generation: &str| {
+        serde_json::from_value::<McpServerConfig>(json!({
+            "command": "managed-host", "enabled": false,
+            "env": {"CANTRIP_MCP_CONNECTION_GENERATION": generation}
+        }))
+        .unwrap()
+    };
+    session
+        .update_managed_config(
+            HashMap::from([("managed".to_string(), server("old"))]),
+            Some("old".to_string()),
+            true,
+            Some("old-child".to_string()),
+            None,
+        )
+        .await
+        .unwrap();
+    let stale_refresh = session.get_config().await.as_ref().clone();
+    let current_servers = HashMap::from([("managed".to_string(), server("current"))]);
+    session
+        .update_managed_config(
+            current_servers.clone(),
+            Some("current".to_string()),
+            true,
+            Some("current-child".to_string()),
+            Some(ReasoningEffortConfig::Low),
+        )
+        .await
+        .unwrap();
+    for runtime_refresh in [false, true] {
+        if runtime_refresh {
+            session.refresh_runtime_config(stale_refresh.clone()).await;
+        } else {
+            session.refresh_mcp_config(stale_refresh.clone()).await;
+        }
+        let current = session.get_config().await;
+        assert_eq!(current.mcp_servers.get(), &current_servers);
+        assert_eq!(current.developer_instructions.as_deref(), Some("current"));
+        assert_eq!(
+            current.agent_default_subagent_model.as_deref(),
+            Some("current-child")
+        );
+        assert_eq!(
+            current.agent_default_subagent_reasoning_effort,
+            Some(ReasoningEffortConfig::Low)
+        );
+    }
+    // Incoming restrictions are still enforced against the newest owner, rather than
+    // accepting the stale snapshot or bypassing its validator with an assignment.
+    let mut rejecting_refresh = stale_refresh;
+    rejecting_refresh.mcp_servers = codex_config::Constrained::new(HashMap::new(), |servers| {
+        if servers.is_empty() {
+            Ok(())
+        } else {
+            Err(codex_config::ConstraintError::empty_field(
+                "test refreshed restriction",
+            ))
+        }
+    })
+    .unwrap();
+    let before = session.get_config().await;
+    session.refresh_mcp_config(rejecting_refresh.clone()).await;
+    assert!(Arc::ptr_eq(&before, &session.get_config().await));
+    session.refresh_runtime_config(rejecting_refresh).await;
+    assert!(Arc::ptr_eq(&before, &session.get_config().await));
+}
