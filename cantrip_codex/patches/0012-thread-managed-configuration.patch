+#[cfg(test)]
+mod managed_config_tests {
+    use super::ThreadManagedConfigUpdateParams;
+    use serde_json::json;
+
+    #[test]
+    fn managed_config_update_requires_explicit_complete_replacement() {
+        let complete = json!({
+            "threadId": "thread", "mcpServers": {}, "developerInstructions": null,
+            "multiAgentEnabled": false, "subagentModel": null, "subagentReasoningEffort": null
+        });
+        let parsed: ThreadManagedConfigUpdateParams =
+            serde_json::from_value(complete.clone()).unwrap();
+        assert!(parsed.managed_config.mcp_servers.is_empty());
+        assert_eq!(parsed.managed_config.developer_instructions, None);
+        for field in [
+            "threadId",
+            "mcpServers",
+            "developerInstructions",
+            "multiAgentEnabled",
+            "subagentModel",
+            "subagentReasoningEffort",
+        ] {
+            let mut missing = complete.clone();
+            missing.as_object_mut().unwrap().remove(field);
+            assert!(
+                serde_json::from_value::<ThreadManagedConfigUpdateParams>(missing).is_err(),
+                "must require {field}"
+            );
+        }
+        let mut start_profile = complete.clone();
+        start_profile.as_object_mut().unwrap().remove("threadId");
+        let start: super::ThreadStartParams = serde_json::from_value(json!({
+            "managedConfig": start_profile.clone()
+        }))
+        .unwrap();
+        assert!(start.managed_config.unwrap().mcp_servers.is_empty());
+        let resume: super::ThreadResumeParams = serde_json::from_value(json!({
+            "threadId": "thread", "managedConfig": start_profile.clone()
+        }))
+        .unwrap();
+        assert!(resume.managed_config.unwrap().mcp_servers.is_empty());
+        start_profile
+            .as_object_mut()
+            .unwrap()
+            .remove("developerInstructions");
+        assert!(
+            serde_json::from_value::<super::ThreadStartParams>(json!({
+                "managedConfig": start_profile
+            }))
+            .is_err()
+        );
+        let mut root_override = complete.clone();
+        root_override["model"] = json!("stale-worker-model");
+        assert!(serde_json::from_value::<ThreadManagedConfigUpdateParams>(root_override).is_err());
+
+        // Exercise the actual request envelope, including native custom effort
+        // support. A nonempty model-defined effort is valid; empty or nonstring
+        // efforts, omitted replacement fields, and unknown fields are not.
+        let request = |params| {
+            json!({
+                "id": 1, "method": "thread/managedConfig/update", "params": params
+            })
+        };
+        let mut custom_effort = complete.clone();
+        custom_effort["subagentReasoningEffort"] = json!("provider-custom-effort");
+        assert!(serde_json::from_value::<crate::ClientRequest>(request(custom_effort)).is_ok());
+        for invalid_effort in [json!(""), json!(42), json!(false)] {
+            let mut invalid = complete.clone();
+            invalid["subagentReasoningEffort"] = invalid_effort;
+            assert!(serde_json::from_value::<crate::ClientRequest>(request(invalid)).is_err());
+        }
+        for field in [
+            "developerInstructions",
+            "subagentModel",
+            "subagentReasoningEffort",
+        ] {
+            let mut invalid = complete.clone();
+            invalid.as_object_mut().unwrap().remove(field);
+            assert!(serde_json::from_value::<crate::ClientRequest>(request(invalid)).is_err());
+        }
+        let mut unknown = complete;
+        unknown["unexpected"] = json!(true);
+        assert!(serde_json::from_value::<crate::ClientRequest>(request(unknown)).is_err());
+    }
+}
