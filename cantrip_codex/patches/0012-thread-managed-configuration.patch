+async fn managed_config_update_constraint_rejection_leaves_entire_profile_unchanged() {
+    let (session, _turn_context) = make_session_and_context().await;
+    {
+        let mut state = session.state.lock().await;
+        let config = Arc::make_mut(&mut state.session_configuration.original_config_do_not_use);
+        config.mcp_servers = codex_config::Constrained::new(HashMap::new(), |servers| {
+            if servers.is_empty() {
+                Ok(())
+            } else {
+                Err(codex_config::ConstraintError::empty_field(
+                    "test managed restriction",
+                ))
+            }
+        })
+        .expect("valid initial constraint");
+    }
+    let before = session.get_config().await;
+    let root_settings = session.thread_settings_snapshot().await;
+    let instructions = session
+        .state
+        .lock()
+        .await
+        .session_configuration
+        .developer_instructions
+        .clone();
+    let server = serde_json::from_value::<McpServerConfig>(json!({
+        "url": "https://example.com/mcp", "enabled": false
+    }))
+    .expect("valid test server");
+    let result = session
+        .update_managed_config(
+            HashMap::from([("rejected".to_string(), server)]),
+            Some("must not publish".to_string()),
+            !before.agents_enabled,
+            Some("must-not-publish".to_string()),
+            Some(ReasoningEffortConfig::High),
+        )
+        .await;
+    assert!(result.is_err());
+    let after = session.get_config().await;
+    assert!(
+        Arc::ptr_eq(&before, &after),
+        "rejected update must not publish any configuration"
+    );
+    assert_eq!(
+        session
+            .state
+            .lock()
+            .await
+            .session_configuration
+            .developer_instructions,
