+#[tokio::test]
+async fn managed_config_update_replaces_and_removes_profile_preserving_live_root_settings() {
+    let (session, _turn_context) = make_session_and_context().await;
+    // Represent current interactive settings, rather than a stale worker launch profile.
+    {
+        let mut state = session.state.lock().await;
+        let settings = Arc::make_mut(&mut state.session_configuration.step_settings);
+        settings.collaboration_mode.settings.model = "live-tui-model".to_string();
+        settings.collaboration_mode.settings.reasoning_effort = Some(ReasoningEffortConfig::High);
+        settings.service_tier = Some("priority".to_string());
+    }
+    let root_settings = session.thread_settings_snapshot().await;
+    let server = serde_json::from_value::<McpServerConfig>(json!({
+        "command": "managed-host",
+        "args": ["--connection-file", "/stable/connection.json"],
+        "env": {"CANTRIP_MCP_CONNECTION_GENERATION": "new-binding"},
+        "enabled": false,
+        "required": true,
+        "tool_timeout_sec": 0,
+        "enabled_tools": ["managed_tool"],
+        "disabled_tools": ["other_tool"],
+        "tools": {"managed_tool": {"output_token_limit": 512}}
+    }))
+    .expect("valid managed MCP server");
+    let servers = HashMap::from([("managed".to_string(), server)]);
+    session
+        .update_managed_config(
+            servers.clone(),
+            Some("managed instructions".to_string()),
+            true,
+            Some("custom-child".to_string()),
+            Some(ReasoningEffortConfig::Low),
+        )
+        .await
+        .expect("apply managed configuration");
+    let config = session.get_config().await;
+    assert_eq!(config.mcp_servers.get(), &servers);
+    assert_eq!(
+        config.developer_instructions.as_deref(),
+        Some("managed instructions")
+    );
+    assert_eq!(
+        config.agent_default_subagent_model.as_deref(),
+        Some("custom-child")
+    );
+    assert_eq!(
+        config.agent_default_subagent_reasoning_effort,
+        Some(ReasoningEffortConfig::Low)
+    );
+    assert!(config.features.enabled(Feature::Collab));
+    assert!(config.agents_enabled);
+    assert_eq!(
+        session
+            .state
+            .lock()
+            .await
+            .session_configuration
+            .developer_instructions,
+        config.developer_instructions
+    );
+    assert_eq!(session.thread_settings_snapshot().await, root_settings);
+
+    session
+        .update_managed_config(HashMap::new(), None, false, None, None)
+        .await
+        .expect("remove managed configuration");
+    let config = session.get_config().await;
+    assert!(config.mcp_servers.get().is_empty());
+    assert_eq!(config.developer_instructions, None);
+    assert_eq!(config.agent_default_subagent_model, None);
+    assert_eq!(config.agent_default_subagent_reasoning_effort, None);
+    assert!(!config.features.enabled(Feature::Collab));
+    assert!(!config.agents_enabled);
+    assert_eq!(
+        session
+            .state
+            .lock()
+            .await
+            .session_configuration
+            .developer_instructions,
+        None
+    );
+    assert_eq!(session.thread_settings_snapshot().await, root_settings);
+}
