@@ -0,0 +1,26 @@
+use crate::error_code::invalid_params;
+use codex_app_server_protocol::JSONRPCErrorError;
+use codex_app_server_protocol::ThreadManagedConfiguration;
+use codex_core::config::ManagedThreadConfiguration;
+
+/// Decode the entire managed profile before any thread state or startup is changed.
+pub(super) fn parse_managed_configuration(
+    params: ThreadManagedConfiguration,
+) -> Result<ManagedThreadConfiguration, JSONRPCErrorError> {
+    let mcp_servers = params
+        .mcp_servers
+        .into_iter()
+        .map(|(name, value)| {
+            serde_json::from_value::<codex_config::types::McpServerConfig>(value)
+                .map(|config| (name, config))
+                .map_err(|err| invalid_params(format!("invalid managed MCP configuration: {err}")))
+        })
+        .collect::<Result<std::collections::HashMap<_, _>, _>>()?;
+    Ok(ManagedThreadConfiguration {
+        mcp_servers,
+        developer_instructions: params.developer_instructions,
+        multi_agent_enabled: params.multi_agent_enabled,
+        subagent_model: params.subagent_model,
+        subagent_reasoning_effort: params.subagent_reasoning_effort,
+    })
+}
