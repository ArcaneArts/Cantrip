+#[tokio::test]
+async fn guest_extra_roots_are_bound_to_the_selected_filesystem() {
+    let codex_home = tempfile::tempdir().expect("tempdir");
+    let cwd = tempfile::tempdir().expect("tempdir");
+    let guest_root = cwd.path().join("extra-skills");
+    let skill_dir = guest_root.join("extra");
+    fs::create_dir_all(&skill_dir).expect("create extra skill directory");
+    fs::write(
+        skill_dir.join("SKILL.md"),
+        "---\nname: guest-extra\ndescription: from a registered guest root\n---\n",
+    )
+    .expect("write extra skill");
+    let service = HostSkillsService::new(
+        codex_home.path().abs(),
+        /*bundled_skills_enabled*/ false,
+    );
+    let input =
+        HostSkillsLoadInput::new(cwd.path().abs(), Vec::new(), config_stack(&codex_home, ""));
+    let guest: Arc<dyn ExecutorFileSystem> =
+        Arc::new(codex_exec_server::LocalFileSystem::unsandboxed());
+    service.set_guest_extra_roots(Arc::clone(&guest), vec![guest_root.abs()]);
+    let request = service.for_request();
+    let snapshot = request
+        .snapshot_for_cwd(
+            &input,
+            /*force_reload*/ false,
+            Some(Arc::clone(&guest)),
+        )
+        .await;
+    assert!(
+        snapshot
+            .outcome()
+            .skills
+            .iter()
+            .any(|skill| skill.name == "guest-extra" && skill.scope == SkillScope::Repo)
+    );
+    let local = request
+        .snapshot_for_cwd(
+            &input,
+            /*force_reload*/ false,
+            Some(Arc::clone(&LOCAL_FS)),
+        )
+        .await;
+    assert!(
+        !local
+            .outcome()
+            .skills
+            .iter()
+            .any(|skill| skill.name == "guest-extra")
+    );
+    service.set_guest_extra_roots(Arc::clone(&guest), Vec::new());
+    let cleared = service
+        .for_request()
+        .snapshot_for_cwd(&input, /*force_reload*/ false, Some(guest))
+        .await;
+    assert!(
+        !cleared
+            .outcome()
+            .skills
+            .iter()
+            .any(|skill| skill.name == "guest-extra")
+    );
+}
