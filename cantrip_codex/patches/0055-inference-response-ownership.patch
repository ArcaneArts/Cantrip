@@ -0,0 +1,23 @@
+//! An opaque owner retained by actual request dispatch and response tasks.
+use std::any::Any;
+use std::sync::Arc;
+use tokio_util::sync::CancellationToken;
+
+#[derive(Clone)]
+pub struct RequestLifetime {
+    _owner: Arc<dyn Any + Send + Sync>,
+    cancellation: CancellationToken,
+}
+
+impl RequestLifetime {
+    pub fn new<T: Any + Send + Sync>(owner: Arc<T>, cancellation: CancellationToken) -> Self {
+        Self {
+            _owner: owner,
+            cancellation,
+        }
+    }
+
+    pub fn cancellation(&self) -> CancellationToken {
+        self.cancellation.clone()
+    }
+}
