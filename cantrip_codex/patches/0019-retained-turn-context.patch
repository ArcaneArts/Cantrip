+    fn context(turn: Option<&str>, cwd: &str, mode: &str) -> RolloutItem {
+        RolloutItem::TurnContext(
+            serde_json::from_value(json!({
+                "turn_id": turn, "cwd": cwd, "model": "fixture-model",
+                "approval_policy": "never", "sandbox_policy": {"type": "read-only"},
+                "collaboration_mode": {"mode": mode, "settings": {
+                    "model": "fixture-model", "reasoning_effort": "high",
+                    "developer_instructions": "private instructions must not be projected"
+                }},
+                "effort": "high", "summary": "auto"
+            }))
+            .unwrap(),
+        )
+    }
+
+    #[test]
+    fn retained_turn_context_is_exact_deduplicated_and_does_not_use_current_defaults() {
+        let history = build_history_metadata(
+            &thread(&["old", "new", "missing"]),
+            &[
+                context(None, "/unscoped", "default"),
+                context(Some("old"), "/original", "plan"),
+                context(Some("new"), "/later", "default"),
+                context(Some("old"), "/original", "plan"),
+                context(Some(""), "/unscoped-empty", "default"),
+            ],
+            None,
+            false,
+        );
+        assert_eq!(history.turns[0].contexts.len(), 1);
+        let old = serde_json::to_value(&history.turns[0].contexts[0]).unwrap();
+        assert_eq!(
+            old,
+            json!({"cwd": "/original", "model": "fixture-model",
+            "collaborationMode": "plan", "reasoningEffort": "high", "rootTurnId": null})
+        );
+        assert_eq!(
+            history.turns[1].contexts[0].cwd.as_path(),
+            std::path::Path::new("/later")
+        );
+        assert!(history.turns[2].contexts.is_empty());
+    }
+
+    #[test]
+    fn changed_compaction_context_and_child_attribution_are_retained() {
+        let mut child = context(Some("child"), "/child", "default");
+        if let RolloutItem::TurnContext(context) = &mut child {
+            context.root_turn_id = Some("root".into());
+            context.collaboration_mode = None;
+            context.effort = None;
+        }
+        let history = build_history_metadata(
+            &thread(&["old", "child"]),
+            &[
+                context(Some("old"), "/before-compaction", "plan"),
+                context(Some("old"), "/after-compaction", "default"),
+                child,
+            ],
+            None,
+            true,
+        );
+        assert_eq!(history.turns[0].contexts.len(), 2);
+        assert_eq!(
+            history.turns[0].contexts[0].cwd.as_path(),
+            std::path::Path::new("/before-compaction")
+        );
+        assert_eq!(
+            history.turns[0].contexts[1].cwd.as_path(),
+            std::path::Path::new("/after-compaction")
+        );
+        let child = &history.turns[1].contexts[0];
+        assert_eq!(child.root_turn_id.as_deref(), Some("root"));
+        assert!(child.collaboration_mode.is_none());
+        assert!(child.reasoning_effort.is_none());
+    }
