+#[tokio::test]
+async fn quiescent_security_operation_absence_has_typed_proof() -> Result<()> {
+    let server = responses::start_mock_server().await;
+    let home = TempDir::new()?;
+    create_config_toml(home.path(), &server.uri())?;
+    let mut app = TestAppServer::builder().with_codex_home(home.path()).build_initialized().await?;
+    let thread = start_thread(&mut app).await?.thread;
+    for (thread_id, expected_absence) in [(thread.id.as_str(), true), ("not-a-thread-id", false)] {
+        let id = app.send_request("thread/settings/operation/read", Some(json!({ "threadId": thread_id, "operationId": "not-admitted" }))).await?;
+        let error = app.read_stream_until_error_message(RequestId::Integer(id)).await?.error;
+        if expected_absence {
+            assert_eq!(error.code, -32004);
+            assert_eq!(error.data, Some(json!({ "reason": "settingsOperationNotFound", "threadId": thread_id, "operationId": "not-admitted" })));
+        } else {
+            assert_ne!(error.code, -32004);
+            assert_ne!(error.data.as_ref().and_then(|data| data.get("reason")).and_then(Value::as_str), Some("settingsOperationNotFound"));
+        }
+    }
+    Ok(())
+}
