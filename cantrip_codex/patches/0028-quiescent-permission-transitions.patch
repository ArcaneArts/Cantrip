diff --git a/codex-rs/core/src/thread_manager_security_transitions_tests.rs b/codex-rs/core/src/thread_manager_security_transitions_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..84317504b3bad1b663ba28cfde3b76ef2036da1b
--- /dev/null
+++ b/codex-rs/core/src/thread_manager_security_transitions_tests.rs
@@ -0,0 +1,217 @@
+use super::*;
+use crate::codex_thread::CodexThreadSettingsOverrides;
+use crate::config::ConfigBuilder;
+use codex_login::CodexAuth;
+use codex_protocol::protocol::{
+    AskForApproval, SandboxPolicy, SubAgentSource, ThreadSettingsOperationPhase,
+    ThreadSettingsOverrides,
+};
+use codex_protocol::turn_input::{NotSubmittedReason, StartIfIdleSubmission, TurnInputRequest};
+use codex_protocol::user_input::UserInput;
+
+async fn idle_child(
+    manager: &ThreadManager,
+    parent: &Arc<CodexThread>,
+    config: Config,
+) -> Arc<CodexThread> {
+    let source = SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+        parent_thread_id: parent.session.thread_id(),
+        depth: 1,
+        agent_path: None,
+        agent_nickname: None,
+        agent_role: None,
+    });
+    let mut request = ThreadSpawnRequest::new(
+        StartThreadOptions {
+            session_source: Some(source),
+            ..StartThreadOptions::new(config)
+        },
+        Arc::clone(&parent.session.services.auth_manager),
+        parent.session.services.agent_control.clone(),
+    );
+    request.parent_thread_id = Some(parent.session.thread_id());
+    manager
+        .state
+        .spawn_thread(request)
+        .await
+        .expect("real child session starts")
+        .thread
+}
+
+#[tokio::test]
+async fn quiescent_security_waits_for_children_and_preserves_explicit_restrictions() {
+    let home = tempfile::TempDir::new().unwrap();
+    let config = ConfigBuilder::without_managed_config_for_tests()
+        .codex_home(home.path().to_owned())
+        .build()
+        .await
+        .unwrap();
+    let manager = ThreadManager::with_models_provider_and_home_for_tests(
+        CodexAuth::from_api_key("dummy"),
+        config.model_provider.clone(),
+        config.codex_home.to_path_buf(),
+        Arc::new(codex_exec_server::EnvironmentManager::default_for_tests()),
+    );
+    let root = manager
+        .start_thread(StartThreadOptions::new(config.clone()))
+        .await
+        .unwrap()
+        .thread;
+    let inherited = idle_child(&manager, &root, config.clone()).await;
+    let explicit = idle_child(&manager, &root, config).await;
+    explicit
+        .restore_thread_settings(CodexThreadSettingsOverrides {
+            sandbox_policy: Some(SandboxPolicy::ReadOnly {
+                network_access: false,
+            }),
+            ..Default::default()
+        })
+        .await
+        .unwrap();
+    let root_before = root.thread_settings_snapshot().await;
+    let inherited_before = inherited.thread_settings_snapshot().await;
+    let explicit_before = explicit.thread_settings_snapshot().await;
+    assert!(
+        inherited_before
+            .child_security_provenance
+            .as_ref()
+            .unwrap()
+            .permission_profile_inherited
+    );
+    assert!(
+        !explicit_before
+            .child_security_provenance
+            .as_ref()
+            .unwrap()
+            .permission_profile_inherited
+    );
+    let old_context = inherited.session.new_default_turn().await;
+    let old_permissions = old_context.permission_profile();
+    let coordinator = Arc::clone(&root.session.services.agent_control.security_transitions);
+    let root_execution = coordinator
+        .admit(&root.session, "root-active")
+        .await
+        .unwrap()
+        .unwrap();
+    let child_execution = coordinator
+        .admit(&inherited.session, "child-active")
+        .await
+        .unwrap()
+        .unwrap();
+    let patch = ThreadSettingsOverrides {
+        sandbox_policy: Some(SandboxPolicy::WorkspaceWrite {
+            writable_roots: vec![],
+            network_access: false,
+            exclude_tmpdir_env_var: true,
+            exclude_slash_tmp: true,
+        }),
+        approval_policy: Some(AskForApproval::OnRequest),
+        ..Default::default()
+    };
+    let queued = root
+        .queue_quiescent_settings("root-policy".into(), patch.clone())
+        .await
+        .unwrap();
+    assert_eq!(queued.phase, ThreadSettingsOperationPhase::Pending);
+    assert_eq!(root.thread_settings_snapshot().await, root_before);
+    assert_eq!(inherited.thread_settings_snapshot().await, inherited_before);
+    assert_eq!(explicit.thread_settings_snapshot().await, explicit_before);
+    root_execution.release().await;
+    assert_eq!(
+        root.read_settings_operation("root-policy")
+            .await
+            .unwrap()
+            .phase,
+        ThreadSettingsOperationPhase::Pending
+    );
+    for thread in [&root, &explicit] {
+        let result = thread
+            .start_turn_if_idle(TurnInputRequest::user_input(vec![UserInput::Text {
+                text: "must remain queued".into(),
+                text_elements: vec![],
+            }]))
+            .await
+            .unwrap();
+        assert!(matches!(
+            result,
+            StartIfIdleSubmission::NotSubmitted {
+                reason: NotSubmittedReason::PendingSettings
+            }
+        ));
+        assert!(thread.session.active_turn.lock().await.is_none());
+    }
+    assert_eq!(old_context.permission_profile(), old_permissions);
+    child_execution.release().await;
+    let applied = root.read_settings_operation("root-policy").await.unwrap();
+    assert_eq!(applied.phase, ThreadSettingsOperationPhase::Applied);
+    let root_after = root.thread_settings_snapshot().await;
+    let inherited_after = inherited.thread_settings_snapshot().await;
+    let explicit_after = explicit.thread_settings_snapshot().await;
+    assert_eq!(
+        inherited_after.permission_profile,
+        root_after.permission_profile
+    );
+    assert_eq!(
+        codex_sandboxing::compatibility_sandbox_policy_for_permission_profile(
+            &explicit_after.permission_profile,
+            explicit_after.cwd.as_path()
+        ),
+        SandboxPolicy::ReadOnly {
+            network_access: false
+        }
+    );
+    assert_eq!(inherited_after.model, inherited_before.model);
+    assert_eq!(
+        inherited_after.child_settings,
+        inherited_before.child_settings
+    );
+    assert_eq!(explicit_after.model, explicit_before.model);
+    assert_eq!(old_context.permission_profile(), old_permissions);
+    let duplicate = root
+        .queue_quiescent_settings("root-policy".into(), patch)
+        .await
+        .unwrap();
+    assert_eq!(duplicate.phase, ThreadSettingsOperationPhase::Applied);
+    assert_eq!(root.thread_settings_snapshot().await, root_after);
+    assert!(
+        root.queue_quiescent_settings(
+            "root-policy".into(),
+            ThreadSettingsOverrides {
+                approval_policy: Some(AskForApproval::Never),
+                ..Default::default()
+            }
+        )
+        .await
+        .is_err()
+    );
+    explicit
+        .restore_thread_settings(CodexThreadSettingsOverrides {
+            approval_policy: Some(AskForApproval::UnlessTrusted),
+            ..Default::default()
+        })
+        .await
+        .unwrap();
+    let restricted_child = explicit.thread_settings_snapshot().await;
+    let rejected = root
+        .queue_quiescent_settings(
+            "incomparable-security".into(),
+            ThreadSettingsOverrides {
+                approval_policy: Some(AskForApproval::Never),
+                ..Default::default()
+            },
+        )
+        .await
+        .unwrap();
+    assert_eq!(rejected.phase, ThreadSettingsOperationPhase::Pending);
+    let rejected = root
+        .read_settings_operation("incomparable-security")
+        .await
+        .unwrap();
+    assert_eq!(rejected.phase, ThreadSettingsOperationPhase::Rejected);
+    assert!(!rejected.commit_started);
+    assert!(rejected.applied_settings.is_none());
+    assert_eq!(root.thread_settings_snapshot().await, root_after);
+    assert_eq!(explicit.thread_settings_snapshot().await, restricted_child);
+    let record = root.read_thread(true, true).await.unwrap();
+    assert!(record.history.unwrap().items.iter().any(|item| matches!(item, codex_history::RolloutItem::EventMsg(EventMsg::ThreadSettingsOperation(op)) if op.operation_id == "root-policy" && op.phase == ThreadSettingsOperationPhase::Applied)));
+}
