+#[tokio::test]
+async fn quiescent_security_pending_operation_recovers_after_process_restart() -> Result<()> {
+    use codex_app_server_protocol::{
+        AskForApproval, ClientRequest, ThreadSettingsAdmission, ThreadSettingsApplyAt,
+        ThreadSettingsReadParams, ThreadSettingsReadResponse,
+    };
+    use codex_app_server_protocol::{ThreadResumeParams, ThreadResumeResponse};
+    use codex_protocol::protocol::ThreadSettingsOperationPhase;
+    let server = responses::start_mock_server().await;
+    let delayed = responses::sse_response(create_final_assistant_message_sse_response(
+        "interrupted old turn",
+    )?)
+    .set_delay(Duration::from_secs(30));
+    let _requests = responses::mount_response_sequence(&server, vec![delayed]).await;
+    let home = TempDir::new()?;
+    create_config_toml(home.path(), &server.uri())?;
+    let mut app = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    let thread = start_thread(&mut app).await?.thread;
+    start_text_turn(&mut app, thread.id.clone()).await?;
+    app.read_stream_until_notification_message("turn/started")
+        .await?;
+    let receipt: ThreadSettingsUpdateResponse = app
+        .request(|request_id| ClientRequest::ThreadSettingsUpdate {
+            request_id,
+            params: ThreadSettingsUpdateParams {
+                thread_id: thread.id.clone(),
+                operation_id: Some("recover-security".into()),
+                apply_at: Some(ThreadSettingsApplyAt::Quiescent),
+                permissions: Some(":read-only".into()),
+                approval_policy: Some(AskForApproval::OnRequest),
+                ..Default::default()
+            },
+        })
+        .await?;
+    assert_eq!(receipt.admission, Some(ThreadSettingsAdmission::Queued));
+    assert_eq!(
+        read_security_operation(&mut app, &thread.id, "recover-security")
+            .await?
+            .phase,
+        ThreadSettingsOperationPhase::Pending
+    );
+    timeout(DEFAULT_TIMEOUT, async {
+        while _requests.requests().is_empty() { tokio::time::sleep(Duration::from_millis(10)).await; }
+    }).await?;
+    app.crash_for_recovery_test().await?;
+    drop(app);
+    let mut app = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    let id = app
+        .send_thread_resume_request(ThreadResumeParams {
+            thread_id: thread.id.clone(),
+            ..Default::default()
+        })
+        .await?;
+    let _: ThreadResumeResponse = timeout(DEFAULT_TIMEOUT, app.read_response(id)).await??;
+    let recovered = read_security_operation(&mut app, &thread.id, "recover-security").await?;
+    assert_eq!(recovered.phase, ThreadSettingsOperationPhase::Applied);
+    assert_eq!(
+        recovered.resolved_security,
+        receipt.resolved_security.unwrap()
+    );
+    let current: ThreadSettingsReadResponse = app
+        .request(|request_id| ClientRequest::ThreadSettingsRead {
+            request_id,
+            params: ThreadSettingsReadParams {
+                thread_id: thread.id.clone(),
+            },
+        })
+        .await?;
+    assert_eq!(
+        current.thread_settings.approval_policy,
+        AskForApproval::OnRequest
+    );
+    assert_eq!(current.thread_settings.permission_profile.as_ref(), Some(&recovered.resolved_security.permission_profile));
+    assert_eq!(recovered.thread_settings, Some(current.thread_settings));
+    Ok(())
+}
