new file mode 100644
index 0000000000000000000000000000000000000000..181351091a654c1e5c1ffda3c7c7357febd88aeb
--- /dev/null
+++ b/codex-rs/core/src/session/security_transitions.rs
@@ -0,0 +1,719 @@
+//! Durable, root-tree quiescent security transitions. Admission and application
+//! share one coordinator; cached agent status is never an authority check.
+use super::session::{Session, SessionSettingsUpdate};
+use super::thread_settings;
+use codex_protocol::ThreadId;
+use codex_protocol::error::{CodexErr, Result as CodexResult};
+use codex_protocol::protocol::{
+    Event, EventMsg, ThreadSettingsAppliedEvent, ThreadSettingsOperationPhase,
+    ThreadSettingsOperationRecord, ThreadSettingsOverrides, ThreadSettingsSnapshot,
+};
+use std::collections::{HashMap, HashSet};
+use std::sync::{Arc, Weak};
+use tokio::sync::Mutex;
+
+#[derive(Clone, serde::Serialize, serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+struct SecurityPatch {
+    approval_policy: Option<codex_protocol::protocol::AskForApproval>,
+    approvals_reviewer: Option<codex_protocol::config_types::ApprovalsReviewer>,
+    sandbox_policy: Option<codex_protocol::protocol::SandboxPolicy>,
+    permission_profile: Option<codex_protocol::models::PermissionProfile>,
+    active_permission_profile: Option<codex_protocol::models::ActivePermissionProfile>,
+    profile_workspace_roots: Option<Vec<codex_utils_absolute_path::AbsolutePathBuf>>,
+    windows_sandbox_level: Option<codex_protocol::config_types::WindowsSandboxLevel>,
+}
+impl SecurityPatch {
+    fn from_overrides(overrides: ThreadSettingsOverrides) -> CodexResult<Self> {
+        let ThreadSettingsOverrides {
+            approval_policy,
+            approvals_reviewer,
+            sandbox_policy,
+            permission_profile,
+            active_permission_profile,
+            profile_workspace_roots,
+            windows_sandbox_level,
+            ..
+        } = overrides.clone();
+        let security = Self {
+            approval_policy,
+            approvals_reviewer,
+            sandbox_policy,
+            permission_profile,
+            active_permission_profile,
+            profile_workspace_roots,
+            windows_sandbox_level,
+        };
+        if security.clone().overrides() != overrides {
+            return Err(CodexErr::InvalidRequest("quiescent updates accept security fields only; submit model and other settings separately".into()));
+        }
+        Ok(security)
+    }
+    fn overrides(self) -> ThreadSettingsOverrides {
+        ThreadSettingsOverrides {
+            approval_policy: self.approval_policy,
+            approvals_reviewer: self.approvals_reviewer,
+            sandbox_policy: self.sandbox_policy,
+            permission_profile: self.permission_profile,
+            active_permission_profile: self.active_permission_profile,
+            profile_workspace_roots: self.profile_workspace_roots,
+            windows_sandbox_level: self.windows_sandbox_level,
+            ..Default::default()
+        }
+    }
+}
+#[derive(Default)]
+pub(crate) struct SecurityTransitions {
+    pub(crate) mutation_gate: Mutex<()>,
+    state: Mutex<TransitionState>,
+}
+#[derive(Default)]
+struct TransitionState {
+    sessions: HashMap<ThreadId, Weak<Session>>,
+    active: HashSet<(ThreadId, String)>,
+    operations: Vec<ThreadSettingsOperationRecord>,
+}
+
+/// Reserved before capturing initial permissions and released only after task
+/// execution and final hooks end. Drop also releases failed admissions.
+pub(crate) struct SecurityExecutionLease {
+    coordinator: Arc<SecurityTransitions>,
+    key: Option<(ThreadId, String)>,
+}
+impl std::fmt::Debug for SecurityExecutionLease {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("SecurityExecutionLease")
+            .field("key", &self.key)
+            .finish()
+    }
+}
+impl SecurityExecutionLease {
+    pub(crate) async fn release(mut self) {
+        if let Some(key) = self.key.take() {
+            self.coordinator.release(key).await;
+        }
+    }
+}
+impl Drop for SecurityExecutionLease {
+    fn drop(&mut self) {
+        if let Some(key) = self.key.take() {
+            let coordinator = Arc::clone(&self.coordinator);
+            if let Ok(runtime) = tokio::runtime::Handle::try_current() {
+                runtime.spawn(async move {
+                    coordinator.release(key).await;
+                });
+            }
+        }
+    }
+}
+
+impl SecurityTransitions {
+    pub(crate) async fn register(
+        &self,
+        session: &Arc<Session>,
+        history: &[codex_history::RolloutItem],
+    ) -> CodexResult<()> {
+        let mut state = self.state.lock().await;
+        state
+            .sessions
+            .insert(session.thread_id(), Arc::downgrade(session));
+        for item in history {
+            if let codex_history::RolloutItem::EventMsg(EventMsg::ThreadSettingsOperation(record)) =
+                item
+            {
+                if record.thread_id != session.thread_id() {
+                    continue;
+                }
+                match state.operations.iter_mut().find(|old| {
+                    old.thread_id == record.thread_id && old.operation_id == record.operation_id
+                }) {
+                    Some(old) => *old = record.clone(),
+                    None => state.operations.push(record.clone()),
+                }
+            }
+        }
+        *session
+            .settings_operations_snapshot
+            .write()
+            .unwrap_or_else(|e| e.into_inner()) = state
+            .operations
+            .iter()
+            .filter(|op| op.thread_id == session.thread_id())
+            .cloned()
+            .collect();
+        Ok(())
+    }
+
+    pub(crate) async fn reconcile_loaded_child(&self, child: &Arc<Session>) -> CodexResult<()> {
+        let state = self.state.lock().await;
+        if child
+            .thread_config_snapshot()
+            .await
+            .parent_thread_id
+            .is_none()
+        {
+            return Ok(());
+        }
+        let root_record = state.operations.iter().rev().find(|op| {
+            op.phase == ThreadSettingsOperationPhase::Applied && op.thread_id != child.thread_id()
+        });
+        let Some(root_record) = root_record else {
+            return Ok(());
+        };
+        let _guard = thread_settings::acquire_persistence_lock(child).await;
+        let _mutation = self.mutation_gate.lock().await;
+        let current = child.thread_settings_snapshot().await;
+        let mut update = inherited_security_update(&current, &root_record.resolved_settings)?;
+        update.security_transition_commit = true;
+        child.preview_security_snapshot(&update).await?;
+        let commit = child
+            .update_settings(update)
+            .await
+            .map_err(|e| CodexErr::InvalidRequest(e.to_string()))?;
+        child
+            .send_event_raw(Event {
+                id: root_record.submission_id.clone(),
+                msg: EventMsg::ThreadSettingsApplied(ThreadSettingsAppliedEvent {
+                    resolved_security: None,
+                    operation_id: None,
+                    thread_id: Some(child.thread_id()),
+                    thread_settings: commit.snapshot,
+                }),
+            })
+            .await;
+        child.flush_rollout().await.map_err(Into::into)
+    }
+
+    pub(crate) async fn admit(
+        self: &Arc<Self>,
+        session: &Session,
+        turn_id: &str,
+    ) -> CodexResult<Option<SecurityExecutionLease>> {
+        let mut state = self.state.lock().await;
+        if let Err(error) = self.drain_locked(&mut state).await {
+            tracing::warn!(%error, "pending security recovery prevented new admission");
+            return Ok(None);
+        }
+        let pending = state
+            .operations
+            .iter()
+            .any(|op| op.phase == ThreadSettingsOperationPhase::Pending);
+        // A pending owner that is temporarily unloaded has not settled merely
+        // because no task remains. Reattachment restores the durable operation.
+        if pending && state.active.is_empty() {
+            return Ok(None);
+        }
+        if pending && !state.active.is_empty() {
+            let parent = session.thread_config_snapshot().await.parent_thread_id;
+            // Existing parent execution may create work needed to finish. A new
+            // root turn, or an unrelated idle child, must retain its input instead.
+            if !parent.is_some_and(|id| state.active.iter().any(|(active, _)| *active == id)) {
+                return Ok(None);
+            }
+        }
+        state
+            .active
+            .insert((session.thread_id(), turn_id.to_owned()));
+        Ok(Some(SecurityExecutionLease {
+            coordinator: Arc::clone(self),
+            key: Some((session.thread_id(), turn_id.to_owned())),
+        }))
+    }
+
+    pub(crate) async fn admit_auxiliary(
+        self: &Arc<Self>,
+        session: &Session,
+        context: &super::turn_context::TurnContext,
+    ) -> Option<SecurityExecutionLease> {
+        let mut state = self.state.lock().await;
+        if !state
+            .active
+            .contains(&(session.thread_id(), context.sub_id.clone()))
+        {
+            return None;
+        }
+        let key = (
+            session.thread_id(),
+            format!("{}/aux/{}", context.sub_id, uuid::Uuid::new_v4()),
+        );
+        state.active.insert(key.clone());
+        Some(SecurityExecutionLease {
+            coordinator: Arc::clone(self),
+            key: Some(key),
+        })
+    }
+
+    async fn release(&self, key: (ThreadId, String)) {
+        let mut state = self.state.lock().await;
+        state.active.remove(&key);
+        if let Err(error) = self.drain_locked(&mut state).await {
+            tracing::error!(%error, "could not settle native security transition; next admission will retry durable state");
+        }
+        let members: Vec<_> = state.sessions.values().filter_map(Weak::upgrade).collect();
+        drop(state);
+        for member in members {
+            tokio::spawn(member.maybe_start_turn_for_pending_work());
+        }
+    }
+
+    pub(crate) async fn settle(&self) -> CodexResult<()> {
+        let mut state = self.state.lock().await;
+        self.drain_locked(&mut state).await
+    }
+
+    pub(crate) async fn read(
+        &self,
+        thread_id: ThreadId,
+        operation_id: &str,
+    ) -> Option<ThreadSettingsOperationRecord> {
+        self.state
+            .lock()
+            .await
+            .operations
+            .iter()
+            .find(|op| op.thread_id == thread_id && op.operation_id == operation_id)
+            .cloned()
+    }
+
+    pub(crate) async fn enqueue(
+        &self,
+        session: &Session,
+        submission_id: String,
+        operation_id: String,
+        overrides: ThreadSettingsOverrides,
+    ) -> CodexResult<ThreadSettingsOperationRecord> {
+        if operation_id.trim().is_empty() {
+            return Err(CodexErr::InvalidRequest(
+                "quiescent settings require a nonempty operationId".into(),
+            ));
+        }
+        if session
+            .thread_config_snapshot()
+            .await
+            .parent_thread_id
+            .is_some()
+        {
+            return Err(CodexErr::InvalidRequest(
+                "quiescent permission transitions belong to the root thread".into(),
+            ));
+        }
+        let patch = serde_json::to_value(SecurityPatch::from_overrides(overrides.clone())?)
+            .map_err(|e| CodexErr::InvalidRequest(e.to_string()))?;
+        let mut state = self.state.lock().await;
+        if let Some(old) = state
+            .operations
+            .iter()
+            .find(|op| op.thread_id == session.thread_id() && op.operation_id == operation_id)
+        {
+            if old.patch != patch {
+                return Err(CodexErr::InvalidRequest(
+                    "operationId was already used with different settings".into(),
+                ));
+            }
+            return Ok(old.clone());
+        }
+        let updates = thread_settings::prepare_update(overrides);
+        let resolved_settings = session.preview_security_snapshot(&updates).await?;
+        let record = ThreadSettingsOperationRecord {
+            commit_started: false,
+            thread_id: session.thread_id(),
+            operation_id,
+            submission_id,
+            phase: ThreadSettingsOperationPhase::Pending,
+            patch,
+            resolved_settings,
+            applied_settings: None,
+            rejection: None,
+        };
+        persist_record(session, &record).await?;
+        state.operations.push(record.clone());
+        // Application is separate from admission: callers always receive queued,
+        // and may receive correlated terminal evidence before consuming the ack.
+        Ok(record)
+    }
+
+    async fn drain_locked(&self, state: &mut TransitionState) -> CodexResult<()> {
+        if !state.active.is_empty()
+            || !state
+                .operations
+                .iter()
+                .any(|op| op.phase == ThreadSettingsOperationPhase::Pending)
+        {
+            return Ok(());
+        }
+        let members: Vec<_> = state.sessions.values().filter_map(Weak::upgrade).collect();
+        let mut persistence_guards = Vec::new();
+        for member in &members {
+            persistence_guards.push(thread_settings::acquire_persistence_lock(member).await);
+        }
+        let _mutation = self.mutation_gate.lock().await;
+        for index in 0..state.operations.len() {
+            let record = state.operations[index].clone();
+            if record.phase != ThreadSettingsOperationPhase::Pending {
+                continue;
+            }
+            let Some(root) = state
+                .sessions
+                .get(&record.thread_id)
+                .and_then(Weak::upgrade)
+            else {
+                continue;
+            };
+            let result = self.prepare_tree(state, &root, &record).await;
+            let mut terminal = record.clone();
+            match result {
+                Ok(prepared) => {
+                    terminal.commit_started = true;
+                    persist_record_locked(&root, &terminal).await?;
+                    state.operations[index] = terminal.clone();
+                    // Every proposal is validated before any member changes. The
+                    // admission lock remains held across durable member commits.
+                    for (session, mut updates) in prepared {
+                        updates.security_transition_commit = true;
+                        let commit = session
+                            .update_settings(updates)
+                            .await
+                            .map_err(|e| CodexErr::InvalidRequest(e.to_string()))?;
+                        let event = EventMsg::ThreadSettingsApplied(ThreadSettingsAppliedEvent {
+                            resolved_security: None,
+                            operation_id: None,
+                            thread_id: Some(session.thread_id()),
+                            thread_settings: commit.snapshot,
+                        });
+                        // Ephemeral descendants have no restartable history. Their future
+                        // state is covered by the durable root operation; persisted
+                        // descendants must complete their own write before terminal ack.
+                        if let Some(live_thread) = session.live_thread() {
+                            live_thread
+                                .append_items(&[codex_history::RolloutItem::EventMsg(event)])
+                                .await
+                                .map_err(|e| CodexErr::Fatal(e.to_string()))?;
+                        }
+                        session.flush_rollout().await?;
+                    }
+                    terminal.phase = ThreadSettingsOperationPhase::Applied;
+                    terminal.applied_settings = Some(root.thread_settings_snapshot().await);
+                }
+                Err(error) => {
+                    if record.commit_started {
+                        return Err(error);
+                    }
+                    tracing::warn!(%error, operation_id = %record.operation_id, "native queued settings rejected before mutation");
+                    terminal.phase = ThreadSettingsOperationPhase::Rejected;
+                    terminal.rejection = Some("Queued settings no longer satisfy the admitted security resolution or current native requirements. No queued change was applied.".into());
+                }
+            }
+            persist_record_locked(&root, &terminal).await?;
+            state.operations[index] = terminal.clone();
+            if let Some(snapshot) = terminal.applied_settings.clone() {
+                root.send_event_raw(Event {
+                    id: terminal.submission_id.clone(),
+                    msg: EventMsg::ThreadSettingsApplied(ThreadSettingsAppliedEvent {
+                        resolved_security: Some(terminal.resolved_settings.clone()),
+                        operation_id: Some(terminal.operation_id.clone()),
+                        thread_id: Some(root.thread_id()),
+                        thread_settings: snapshot,
+                    }),
+                })
+                .await;
+            }
+            if terminal.phase == ThreadSettingsOperationPhase::Rejected {
+                root.send_event_raw(Event {
+                    id: terminal.submission_id.clone(),
+                    msg: EventMsg::Error(codex_protocol::protocol::ErrorEvent {
+                        misalignment: None,
+                        message: terminal.rejection.clone().unwrap_or_default(),
+                        codex_error_info: Some(
+                            codex_protocol::protocol::CodexErrorInfo::ThreadSettingsUpdateFailed {
+                                operation_id: Some(terminal.operation_id.clone()),
+                            },
+                        ),
+                    }),
+                })
+                .await;
+            }
+        }
+        Ok(())
+    }
+
+    async fn prepare_tree(
+        &self,
+        state: &TransitionState,
+        root: &Arc<Session>,
+        record: &ThreadSettingsOperationRecord,
+    ) -> CodexResult<Vec<(Arc<Session>, SessionSettingsUpdate)>> {
+        let security: SecurityPatch = serde_json::from_value(record.patch.clone())
+            .map_err(|e| CodexErr::InvalidRequest(e.to_string()))?;
+        let overrides = security.overrides();
+        let updates = thread_settings::prepare_update(overrides);
+        let proposed = root.preview_security_snapshot(&updates).await?;
+        if !same_security(&proposed, &record.resolved_settings) {
+            return Err(CodexErr::InvalidRequest(
+                "admitted security resolution changed".into(),
+            ));
+        }
+        let mut prepared = vec![(Arc::clone(root), updates)];
+        for child in state.sessions.values().filter_map(Weak::upgrade) {
+            if child.thread_id() == root.thread_id() {
+                continue;
+            }
+            let current = child.thread_settings_snapshot().await;
+            let update = inherited_security_update(&current, &proposed)?;
+            child.preview_security_snapshot(&update).await?;
+            prepared.push((child, update));
+        }
+        Ok(prepared)
+    }
+}
+
+fn same_security(a: &ThreadSettingsSnapshot, b: &ThreadSettingsSnapshot) -> bool {
+    a.approval_policy == b.approval_policy
+        && a.approvals_reviewer == b.approvals_reviewer
+        && a.permission_profile == b.permission_profile
+        && a.active_permission_profile == b.active_permission_profile
+}
+
+fn inherited_security_update(
+    child: &ThreadSettingsSnapshot,
+    root: &ThreadSettingsSnapshot,
+) -> CodexResult<SessionSettingsUpdate> {
+    let provenance = child.child_security_provenance.clone().unwrap_or_default();
+    let permissions = if provenance.permission_profile_inherited {
+        root.permission_profile.clone()
+    } else {
+        codex_protocol::intersect_effective_permission_profiles(
+            &root.permission_profile,
+            &child.permission_profile,
+            child.cwd.as_path(),
+        )
+        .map_err(|e| {
+            CodexErr::InvalidRequest(format!("child permissions cannot be bounded: {e}"))
+        })?
+    };
+    let policy = if provenance.approval_policy_inherited {
+        root.approval_policy
+    } else {
+        bounded_approval_policy(child.approval_policy, root.approval_policy)?
+    };
+    let reviewer = if provenance.approvals_reviewer_inherited {
+        root.approvals_reviewer
+    } else {
+        match (child.approvals_reviewer, root.approvals_reviewer) {
+            (codex_protocol::config_types::ApprovalsReviewer::User, _)
+            | (_, codex_protocol::config_types::ApprovalsReviewer::User) => {
+                codex_protocol::config_types::ApprovalsReviewer::User
+            }
+            _ => root.approvals_reviewer,
+        }
+    };
+    Ok(SessionSettingsUpdate {
+        child_security_provenance: Some(provenance.clone()),
+        permission_profile: Some(permissions),
+        active_permission_profile: if provenance.permission_profile_inherited {
+            root.active_permission_profile.clone()
+        } else {
+            None
+        },
+        step_settings: super::step_settings::StepSettingsUpdate {
+            approval_policy: Some(policy),
+            approvals_reviewer: Some(reviewer),
+            ..Default::default()
+        },
+        ..Default::default()
+    })
+}
+
+fn bounded_approval_policy(
+    child: codex_protocol::protocol::AskForApproval,
+    root: codex_protocol::protocol::AskForApproval,
+) -> CodexResult<codex_protocol::protocol::AskForApproval> {
+    use codex_protocol::protocol::AskForApproval::*;
+    if child == root {
+        return Ok(child);
+    }
+    Ok(match (child, root) {
+        (UnlessTrusted, OnRequest) | (OnRequest, UnlessTrusted) => UnlessTrusted,
+        (Never, OnRequest) | (OnRequest, Never) => Never,
+        (Granular(a), Granular(b)) => Granular(codex_protocol::protocol::GranularApprovalConfig {
+            sandbox_approval: a.sandbox_approval && b.sandbox_approval, rules: a.rules && b.rules,
+            skill_approval: a.skill_approval && b.skill_approval, request_permissions: a.request_permissions && b.request_permissions,
+            mcp_elicitations: a.mcp_elicitations && b.mcp_elicitations,
+        }),
+        (Granular(a), OnRequest) | (OnRequest, Granular(a)) => Granular(a),
+        (Never, Granular(_)) | (Granular(_), Never) => Never,
+        _ => return Err(CodexErr::InvalidRequest("explicit child approval requirements cannot be safely combined with the resulting root policy".into())),
+    })
+}
+
+async fn persist_record(
+    session: &Session,
+    record: &ThreadSettingsOperationRecord,
+) -> CodexResult<()> {
+    let _guard = thread_settings::acquire_persistence_lock(session).await;
+    persist_record_locked(session, record).await
+}
+
+async fn persist_record_locked(
+    session: &Session,
+    record: &ThreadSettingsOperationRecord,
+) -> CodexResult<()> {
+    session
+        .live_thread_for_persistence("persist queued settings")
+        .map_err(|e| CodexErr::Fatal(e.to_string()))?
+        .append_items(&[codex_history::RolloutItem::EventMsg(
+            EventMsg::ThreadSettingsOperation(record.clone()),
+        )])
+        .await
+        .map_err(|e| CodexErr::Fatal(e.to_string()))?;
+    session.flush_rollout().await?;
+    let mut records = session
+        .settings_operations_snapshot
+        .write()
+        .unwrap_or_else(|e| e.into_inner());
+    match records
+        .iter_mut()
+        .find(|old| old.operation_id == record.operation_id)
+    {
+        Some(old) => *old = record.clone(),
+        None => records.push(record.clone()),
+    }
+    Ok(())
+}
+
+impl Session {
+    pub(crate) async fn new_security_task_turn(
+        &self,
+        sub_id: String,
+        options: super::turn_context::NewTurnContextOptions,
+    ) -> Option<Arc<super::turn_context::TurnContext>> {
+        let lease = match self
+            .services
+            .agent_control
+            .security_transitions
+            .admit(self, &sub_id)
+            .await
+        {
+            Ok(Some(lease)) => lease,
+            other => {
+                let message = match other { Err(error) => error.to_string(), _ => "PendingSettings: queued security settings must settle before new execution; input was not consumed".into() };
+                self.send_event_raw(Event {
+                    id: sub_id,
+                    msg: EventMsg::Error(codex_protocol::protocol::ErrorEvent {
+                        misalignment: None,
+                        message,
+                        codex_error_info: Some(
+                            codex_protocol::protocol::CodexErrorInfo::BadRequest,
+                        ),
+                    }),
+                })
+                .await;
+                return None;
+            }
+        };
+        let context = self.new_turn_with_default_settings(sub_id, options).await;
+        context
+            .security_execution
+            .lock()
+            .unwrap_or_else(|e| e.into_inner())
+            .replace(lease);
+        Some(context)
+    }
+
+    pub(crate) async fn finish_security_execution(
+        &self,
+        context: &super::turn_context::TurnContext,
+    ) {
+        let lease = context
+            .security_execution
+            .lock()
+            .unwrap_or_else(|e| e.into_inner())
+            .take();
+        if let Some(lease) = lease {
+            lease.release().await;
+        }
+    }
+
+    pub(crate) async fn preview_security_snapshot(
+        &self,
+        updates: &SessionSettingsUpdate,
+    ) -> CodexResult<ThreadSettingsSnapshot> {
+        let state = self.state.lock().await;
+        let configuration = self
+            .apply_session_settings(&state.session_configuration, updates)
+            .map_err(|e| CodexErr::InvalidRequest(e.to_string()))?;
+        let selections = updates.environments.as_ref().map_or_else(
+            || self.services.turn_environments.selections(),
+            |e| e.environments.clone(),
+        );
+        Ok(configuration.thread_settings_snapshot(&selections))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use codex_protocol::protocol::{AskForApproval, GranularApprovalConfig};
+
+    #[test]
+    fn explicit_approval_restrictions_are_never_guessed_from_enum_order() {
+        use AskForApproval::*;
+        assert_eq!(
+            bounded_approval_policy(UnlessTrusted, OnRequest).unwrap(),
+            UnlessTrusted
+        );
+        assert_eq!(bounded_approval_policy(OnRequest, Never).unwrap(), Never);
+        assert!(bounded_approval_policy(UnlessTrusted, Never).is_err());
+        assert!(bounded_approval_policy(Never, UnlessTrusted).is_err());
+        let a = GranularApprovalConfig {
+            sandbox_approval: false,
+            rules: true,
+            skill_approval: true,
+            request_permissions: false,
+            mcp_elicitations: true,
+        };
+        let b = GranularApprovalConfig {
+            sandbox_approval: true,
+            rules: false,
+            skill_approval: true,
+            request_permissions: true,
+            mcp_elicitations: false,
+        };
+        let Granular(actual) = bounded_approval_policy(Granular(a), Granular(b)).unwrap() else {
+            panic!("granular restriction lost")
+        };
+        assert_eq!(
+            actual,
+            GranularApprovalConfig {
+                sandbox_approval: false,
+                rules: false,
+                skill_approval: true,
+                request_permissions: false,
+                mcp_elicitations: false
+            }
+        );
+    }
+
+    #[test]
+    fn quiescent_journal_rejects_mixed_nonsecurity_settings() {
+        assert!(
+            SecurityPatch::from_overrides(ThreadSettingsOverrides {
+                model: Some("another-model".into()),
+                approval_policy: Some(AskForApproval::Never),
+                ..Default::default()
+            })
+            .is_err()
+        );
+        let patch = ThreadSettingsOverrides {
+            approval_policy: Some(AskForApproval::Never),
+            ..Default::default()
+        };
+        let persisted =
+            serde_json::to_value(SecurityPatch::from_overrides(patch.clone()).unwrap()).unwrap();
+        assert_eq!(
+            serde_json::from_value::<SecurityPatch>(persisted)
+                .unwrap()
+                .overrides(),
+            patch
+        );
+    }
+}
