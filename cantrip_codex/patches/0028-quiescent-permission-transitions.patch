+#[tokio::test]
+async fn quiescent_security_ack_is_pending_until_actual_turn_finishes() -> Result<()> {
+    use codex_app_server_protocol::{
+        AskForApproval, ClientRequest, ThreadSettingsAdmission, ThreadSettingsApplyAt,
+        ThreadSettingsReadParams, ThreadSettingsReadResponse,
+    };
+    use codex_protocol::protocol::ThreadSettingsOperationPhase;
+    let server = responses::start_mock_server().await;
+    let delayed = responses::sse_response(create_final_assistant_message_sse_response(
+        "finished old turn",
+    )?)
+    .set_delay(Duration::from_secs(3));
+    let _requests = responses::mount_response_sequence(&server, vec![delayed]).await;
+    let home = TempDir::new()?;
+    create_config_toml(home.path(), &server.uri())?;
+    let mut app = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    let thread = start_thread(&mut app).await?.thread;
+    let before: ThreadSettingsReadResponse = app
+        .request(|request_id| ClientRequest::ThreadSettingsRead {
+            request_id,
+            params: ThreadSettingsReadParams {
+                thread_id: thread.id.clone(),
+            },
+        })
+        .await?;
+    start_text_turn(&mut app, thread.id.clone()).await?;
+    app.read_stream_until_notification_message("turn/started")
+        .await?;
+    let receipt: ThreadSettingsUpdateResponse = app
+        .request(|request_id| ClientRequest::ThreadSettingsUpdate {
+            request_id,
+            params: ThreadSettingsUpdateParams {
+                thread_id: thread.id.clone(),
+                operation_id: Some("pending-security".into()),
+                apply_at: Some(ThreadSettingsApplyAt::Quiescent),
+                permissions: Some(":read-only".into()),
+                approval_policy: Some(AskForApproval::OnRequest),
+                ..Default::default()
+            },
+        })
+        .await?;
+    assert_eq!(receipt.admission, Some(ThreadSettingsAdmission::Queued));
+    assert!(receipt.resolved_security.is_some());
+    let pending = read_security_operation(&mut app, &thread.id, "pending-security").await?;
+    assert_eq!(pending.phase, ThreadSettingsOperationPhase::Pending);
+    assert!(pending.thread_settings.is_none());
+    let during: ThreadSettingsReadResponse = app
+        .request(|request_id| ClientRequest::ThreadSettingsRead {
+            request_id,
+            params: ThreadSettingsReadParams {
+                thread_id: thread.id.clone(),
+            },
+        })
+        .await?;
+    assert_eq!(
+        during.thread_settings.approval_policy,
+        before.thread_settings.approval_policy
+    );
+    assert_eq!(
+        during.thread_settings.sandbox_policy,
+        before.thread_settings.sandbox_policy
+    );
+    app.read_stream_until_notification_message("turn/completed")
+        .await?;
+    let updated = read_thread_settings_updated(&mut app).await?;
+    assert_eq!(updated.operation_id.as_deref(), Some("pending-security"));
+    assert_eq!(updated.resolved_security, receipt.resolved_security);
+    assert_eq!(updated.thread_settings.permission_profile.as_ref(), updated.resolved_security.as_ref().map(|security| &security.permission_profile));
