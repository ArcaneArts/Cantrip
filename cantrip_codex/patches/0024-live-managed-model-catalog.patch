+    pub(crate) async fn managed_model_catalog_update(
+        &self,
+        params: ManagedModelCatalogUpdateParams,
+    ) -> Result<Option<ClientResponsePayload>, JSONRPCErrorError> {
+        let revision = params.revision.parse::<u64>().map_err(|_| {
+            invalid_request("Managed catalog revision must be a canonical decimal u64.")
+        })?;
+        if revision.to_string() != params.revision {
+            return Err(invalid_request(
+                "Managed catalog revision must be a canonical decimal u64.",
+            ));
+        }
+        let changed = self
+            .thread_manager
+            .get_models_manager()
+            .replace_managed_catalog(revision, params.models)
+            .await
+            .map_err(invalid_request)?;
+        Ok(Some(
+            ManagedModelCatalogUpdateResponse {
+                revision: params.revision,
+                changed,
+            }
+            .into(),
+        ))
+    }
