+/// Complete replacement of the worker-managed static catalog, without changing
+/// thread selections, account defaults, provider routing or permission policy.
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+#[ts(export_to = "v2/")]
+pub struct ManagedModelCatalogUpdateParams {
+    /// Canonical decimal u64, monotonically increasing within this process.
+    pub revision: String,
+    #[schemars(schema_with = "managed_catalog_models_schema")]
+    pub models: Vec<codex_protocol::openai_models::ModelInfo>,
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, Eq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ManagedModelCatalogUpdateResponse {
+    pub revision: String,
+    /// False means this exact revision and content were already installed.
+    pub changed: bool,
+}
+
+// Core model metadata and the app-server both expose names such as
+// MultiAgentVersion with different wire representations. Keep the complete,
+// validated ModelInfo schema, but namespace its dependency definitions locally.
+#[cfg(test)]
+fn managed_catalog_models_schema(
+    generator: &mut schemars::r#gen::SchemaGenerator,
+) -> schemars::schema::Schema {
+    fn namespace_refs(value: &mut serde_json::Value) {
+        match value {
+            serde_json::Value::Object(object) => {
+                for (key, value) in object {
+                    if key == "$ref" {
+                        if let Some(reference) = value
+                            .as_str()
+                            .and_then(|value| value.strip_prefix("#/definitions/"))
+                        {
+                            *value = serde_json::Value::String(format!(
+                                "#/definitions/ManagedCatalog{reference}"
+                            ));
+                        }
+                    } else {
+                        namespace_refs(value);
+                    }
+                }
+            }
+            serde_json::Value::Array(values) => values.iter_mut().for_each(namespace_refs),
+            _ => {}
+        }
+    }
+    fn namespaced(schema: schemars::schema::Schema) -> schemars::schema::Schema {
+        let mut value = serde_json::to_value(schema).expect("model schema serializes");
+        namespace_refs(&mut value);
+        serde_json::from_value(value).expect("renamed model schema deserializes")
+    }
+    let mut local = schemars::r#gen::SchemaGenerator::default();
+    let schema = local.subschema_for::<Vec<codex_protocol::openai_models::ModelInfo>>();
+    for (name, schema) in local.take_definitions() {
+        generator
+            .definitions_mut()
+            .insert(format!("ManagedCatalog{name}"), namespaced(schema));
+    }
+    namespaced(schema)
+}
