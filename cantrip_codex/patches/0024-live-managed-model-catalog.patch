+
+    fn replace_managed_catalog(
+        &self,
+        revision: u64,
+        models: Vec<ModelInfo>,
+    ) -> ModelsManagerFuture<'_, Result<bool, String>> {
+        Box::pin(async move {
+            let mut slugs = HashSet::new();
+            if models.is_empty()
+                || models
+                    .iter()
+                    .any(|model| model.slug.trim().is_empty() || !slugs.insert(model.slug.as_str()))
+            {
+                return Err("Managed catalogs require nonempty, unique model slugs.".to_string());
+            }
+            let mut current = self
+                .catalog
+                .write()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            if let Some(prior) = current.revision {
+                if revision < prior {
+                    return Err("Managed catalog revision is stale.".to_string());
+                }
+                if revision == prior {
+                    return if current.models == models {
+                        Ok(false)
+                    } else {
+                        Err(
+                            "Managed catalog revision was reused with different content."
+                                .to_string(),
+                        )
+                    };
+                }
+            }
+            *current = ManagedStaticCatalog {
+                revision: Some(revision),
+                models,
+            };
+            Ok(true)
+        })
     }
 
