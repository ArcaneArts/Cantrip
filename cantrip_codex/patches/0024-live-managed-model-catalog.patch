+#[tokio::test]
+async fn managed_catalog_revisions_are_atomic_idempotent_and_reject_conflicts() {
+    let first = remote_model("first", "First", 1);
+    let next = remote_model("next", "Next", 1);
+    let manager = Arc::new(static_manager_for_tests(ModelsResponse {
+        models: vec![first.clone()],
+    }));
+    assert_eq!(
+        manager
+            .replace_managed_catalog(10, vec![next.clone()])
+            .await,
+        Ok(true)
+    );
+    assert_eq!(
+        manager
+            .replace_managed_catalog(10, vec![next.clone()])
+            .await,
+        Ok(false)
+    );
+    assert!(
+        manager
+            .replace_managed_catalog(9, vec![first.clone()])
+            .await
+            .is_err()
+    );
+    assert!(
+        manager
+            .replace_managed_catalog(10, vec![first.clone()])
+            .await
+            .is_err()
+    );
+    assert!(manager.replace_managed_catalog(11, vec![]).await.is_err());
+    assert!(
+        manager
+            .replace_managed_catalog(11, vec![next.clone(), next.clone()])
+            .await
+            .is_err()
+    );
+    assert_eq!(manager.get_remote_models().await, vec![next]);
+    let mut tasks = Vec::new();
+    for revision in 11..30 {
+        let manager = Arc::clone(&manager);
+        tasks.push(tokio::spawn(async move {
+            manager
+                .replace_managed_catalog(
+                    revision,
+                    vec![remote_model(&format!("model-{revision}"), "Model", 1)],
+                )
+                .await
+        }));
+    }
+    for task in tasks {
+        let _ = task.await.unwrap();
+    }
+    assert_eq!(manager.get_remote_models().await[0].slug, "model-29");
+}
