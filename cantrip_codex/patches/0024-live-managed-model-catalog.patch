+                ..Default::default()
+            },
+        })
+        .await?;
+    assert_eq!(
+        listed
+            .data
+            .iter()
+            .map(|m| (m.model.as_str(), m.display_name.as_str()))
+            .collect::<Vec<_>>(),
+        vec![
+            ("managed-next", "Managed next"),
+            ("managed-root", "Updated root metadata")
+        ]
+    );
+    for revision in ["01", "18446744073709551616", "1"] {
+        assert_catalog_rejected(&mut app, revision, models.clone()).await?;
+    }
+    assert_catalog_rejected(&mut app, "18446744073709551615", vec![next]).await?;
+    let after: ThreadSettingsReadResponse = app
+        .request(|request_id| ClientRequest::ThreadSettingsRead {
+            request_id,
+            params: ThreadSettingsReadParams {
+                thread_id: thread.thread.id.clone(),
+            },
+        })
+        .await?;
+    assert_eq!(before, after);
+    let new_thread: ThreadStartResponse = app
+        .request(|request_id| ClientRequest::ThreadStart {
+            request_id,
+            params: ThreadStartParams::default(),
+        })
+        .await?;
+    assert_eq!(new_thread.model, "managed-root");
+    assert_eq!(
+        std::fs::read(home.path().join("config.toml"))?,
+        config_before
+    );
+    assert!(
+        server
+            .received_requests()
+            .await
+            .unwrap_or_default()
+            .is_empty(),
+        "catalog updates must not submit model work"
+    );
+    Ok(())
+}
+
+async fn assert_catalog_rejected(
+    app: &mut TestAppServer,
+    revision: &str,
+    models: Vec<codex_protocol::openai_models::ModelInfo>,
+) -> Result<()> {
+    let request_id = app
+        .send_request(
+            "model/managedCatalog/update",
+            Some(serde_json::to_value(ManagedModelCatalogUpdateParams {
+                revision: revision.to_string(),
+                models,
+            })?),
+        )
+        .await?;
+    let error = tokio::time::timeout(
+        std::time::Duration::from_secs(10),
+        app.read_stream_until_error_message(RequestId::Integer(request_id)),
+    )
+    .await??;
+    assert_eq!(error.error.code, -32600);
+    Ok(())
+}
