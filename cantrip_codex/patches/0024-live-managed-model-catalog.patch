+#[tokio::test]
+async fn managed_catalog_updates_listing_without_changing_live_thread_or_defaults() -> Result<()> {
+    let server = MockServer::start().await;
+    let home = TempDir::new()?;
+    let mut root = codex_models_manager::bundled_models_response()?
+        .models
+        .remove(0);
+    root.slug = "managed-root".to_string();
+    root.supported_in_api = true;
+    root.priority = 1;
+    let catalog_path = home.path().join("models.json");
+    std::fs::write(
+        &catalog_path,
+        serde_json::to_vec(&ModelsResponse {
+            models: vec![root.clone()],
+        })?,
+    )?;
+    MockResponsesConfig::new(&server.uri())
+        .with_model("managed-root")
+        .with_root_config(&format!(
+            "model_catalog_json = {}",
+            serde_json::to_string(&catalog_path)?
+        ))
+        .with_provider_config("supports_websockets = false")
+        .write(home.path())?;
+    let config_before = std::fs::read(home.path().join("config.toml"))?;
+    let mut app = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    let thread: ThreadStartResponse = app
+        .request(|request_id| ClientRequest::ThreadStart {
+            request_id,
+            params: ThreadStartParams {
+                model: Some(root.slug.clone()),
+                ..Default::default()
+            },
+        })
+        .await?;
+    let before: ThreadSettingsReadResponse = app
+        .request(|request_id| ClientRequest::ThreadSettingsRead {
+            request_id,
+            params: ThreadSettingsReadParams {
+                thread_id: thread.thread.id.clone(),
+            },
+        })
+        .await?;
+    let mut next = root.clone();
+    next.slug = "managed-next".to_string();
+    next.display_name = "Managed next".to_string();
+    next.priority = 0;
+    root.display_name = "Updated root metadata".to_string();
+    let models = vec![next.clone(), root.clone()];
+    for changed in [true, false] {
+        let response: ManagedModelCatalogUpdateResponse = app
+            .request(|request_id| ClientRequest::ManagedModelCatalogUpdate {
+                request_id,
+                params: ManagedModelCatalogUpdateParams {
+                    revision: "18446744073709551615".to_string(),
+                    models: models.clone(),
+                },
+            })
+            .await?;
+        assert_eq!(
+            response,
+            ManagedModelCatalogUpdateResponse {
+                revision: "18446744073709551615".to_string(),
+                changed
+            }
+        );
+    }
+    let listed: ModelListResponse = app
+        .request(|request_id| ClientRequest::ModelList {
+            request_id,
+            params: ModelListParams {
+                include_hidden: Some(true),
+                ..Default::default()
+            },
+        })
+        .await?;
+    assert_eq!(
+        listed
+            .data
+            .iter()
+            .map(|m| (m.model.as_str(), m.display_name.as_str()))
+            .collect::<Vec<_>>(),
+        vec![
+            ("managed-next", "Managed next"),
+            ("managed-root", "Updated root metadata")
+        ]
+    );
+    for revision in ["01", "18446744073709551616", "1"] {
+        assert_catalog_rejected(&mut app, revision, models.clone()).await?;
+    }
+    assert_catalog_rejected(&mut app, "18446744073709551615", vec![next]).await?;
+    let after: ThreadSettingsReadResponse = app
+        .request(|request_id| ClientRequest::ThreadSettingsRead {
+            request_id,
+            params: ThreadSettingsReadParams {
+                thread_id: thread.thread.id.clone(),
+            },
+        })
+        .await?;
+    assert_eq!(before, after);
+    let new_thread: ThreadStartResponse = app
+        .request(|request_id| ClientRequest::ThreadStart {
+            request_id,
+            params: ThreadStartParams::default(),
+        })
+        .await?;
+    assert_eq!(new_thread.model, "managed-root");
+    assert_eq!(
+        std::fs::read(home.path().join("config.toml"))?,
+        config_before
+    );
+    assert!(
+        server
+            .received_requests()
+            .await
+            .unwrap_or_default()
+            .is_empty(),
+        "catalog updates must not submit model work"
+    );
+    Ok(())
+}
+
+async fn assert_catalog_rejected(
+    app: &mut TestAppServer,
+    revision: &str,
+    models: Vec<codex_protocol::openai_models::ModelInfo>,
+) -> Result<()> {
+    let request_id = app
+        .send_request(
+            "model/managedCatalog/update",
+            Some(serde_json::to_value(ManagedModelCatalogUpdateParams {
+                revision: revision.to_string(),
+                models,
+            })?),
+        )
+        .await?;
+    let error = tokio::time::timeout(
+        std::time::Duration::from_secs(10),
+        app.read_stream_until_error_message(RequestId::Integer(request_id)),
+    )
+    .await??;
+    assert_eq!(error.error.code, -32600);
+    Ok(())
+}
