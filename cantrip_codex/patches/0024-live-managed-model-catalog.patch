+        .await?;
+    let before: ThreadSettingsReadResponse = app
+        .request(|request_id| ClientRequest::ThreadSettingsRead {
+            request_id,
+            params: ThreadSettingsReadParams {
+                thread_id: thread.thread.id.clone(),
+            },
+        })
+        .await?;
+    let mut next = root.clone();
+    next.slug = "managed-next".to_string();
+    next.display_name = "Managed next".to_string();
+    next.priority = 0;
+    root.display_name = "Updated root metadata".to_string();
+    let models = vec![next.clone(), root.clone()];
+    for changed in [true, false] {
+        let response: ManagedModelCatalogUpdateResponse = app
+            .request(|request_id| ClientRequest::ManagedModelCatalogUpdate {
+                request_id,
+                params: ManagedModelCatalogUpdateParams {
+                    revision: "18446744073709551615".to_string(),
+                    models: models.clone(),
+                },
+            })
+            .await?;
+        assert_eq!(
+            response,
+            ManagedModelCatalogUpdateResponse {
+                revision: "18446744073709551615".to_string(),
+                changed
+            }
