+fn suspension_goal() -> codex_state::ThreadGoal {
+    let now = chrono::Utc::now();
+    codex_state::ThreadGoal {
+        thread_id: codex_protocol::ThreadId::from_string("00000000-0000-0000-0000-000000000123")
+            .expect("thread id"),
+        goal_id: "goal-1".into(),
+        configuration_revision: 1,
+        objective: "durable accounting fixture".into(),
+        status: ThreadGoalStatus::Active,
+        token_budget: Some(1000),
+        tokens_used: 10,
+        time_used_seconds: 5,
+        created_at: now,
+        updated_at: now,
+    }
+}
+
+fn suspended_accounting(goal: &codex_state::ThreadGoal) -> accounting::SavedGoalAccounting {
+    let state = GoalAccountingState::default();
+    state.start_turn("original-turn", ModeKind::Default, &TokenUsage::default());
+    state.mark_turn_goal_active("original-turn", goal.goal_id.clone());
+    state.record_token_usage("original-turn", &token_usage(40, 0, 2, 0, 42));
+    state.record_descendant_token_usage(&token_usage(5, 0, 0, 0, 5));
+    state.hold_suspension();
+    let saved = state
+        .suspension_snapshot(
+            &goal.thread_id.to_string(),
+            "original-turn",
+            true,
+            Some(goal),
+        )
+        .expect("capture");
+    let mut encoded = serde_json::to_value(saved).expect("encode");
+    // A real process can die with a fractional, still-unflushed clock balance.
+    encoded["inner"]["wall_clock"]["elapsed"] = serde_json::json!({"secs":3,"nanos":995_000_000});
+    serde_json::from_value(encoded).expect("decode original continuation")
+}
+
+#[test]
+fn durable_accounting_restores_unflushed_usage_and_excludes_offline_time() {
+    let goal = suspension_goal();
+    let restored = GoalAccountingState::default();
+    restored
+        .restore_suspension(
+            suspended_accounting(&goal),
+            &goal.thread_id.to_string(),
+            "original-turn",
+            true,
+            Some(&goal),
+        )
+        .expect("restore");
+    assert_eq!(Some("original-turn".into()), restored.current_turn_id());
+    assert!(restored.is_suspended());
+    std::thread::sleep(std::time::Duration::from_millis(20));
+    let pending = restored
+        .progress_snapshot("original-turn")
+        .expect("unflushed progress");
+    assert_eq!(47, pending.token_delta);
+    assert_eq!(3, pending.time_delta_seconds);
+    restored.resume_suspension();
+    std::thread::sleep(std::time::Duration::from_millis(20));
+    assert!(
+        restored
+            .progress_snapshot("original-turn")
+            .expect("resumed progress")
+            .time_delta_seconds
+            >= 4
+    );
+}
+
+#[test]
+fn durable_accounting_does_not_charge_a_post_capture_goal_mutation_twice() {
+    let mut goal = suspension_goal();
