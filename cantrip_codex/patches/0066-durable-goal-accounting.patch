new file mode 100644
index 0000000..159fae6
--- /dev/null
+++ b/codex-rs/ext/extension-api/src/durable_turn.rs
@@ -0,0 +1,103 @@
+//! Extension-owned bookkeeping at a host's durable turn boundary.
+
+use crate::ExtensionData;
+use crate::ExtensionFuture;
+use serde_json::Value;
+
+/// Data incompatibility may be retired only by explicit Stop, preserving its
+/// original bytes. A storage/preparation failure remains retryable instead.
+#[derive(Debug)]
+pub enum DurableTurnRestoreError {
+    Unrestorable(String),
+    Failed(String),
+}
+
+impl std::fmt::Display for DurableTurnRestoreError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Unrestorable(message) | Self::Failed(message) => f.write_str(message),
+        }
+    }
+}
+
+impl From<String> for DurableTurnRestoreError {
+    fn from(message: String) -> Self {
+        Self::Failed(message)
+    }
+}
+
+impl From<&str> for DurableTurnRestoreError {
+    fn from(message: &str) -> Self {
+        Self::Failed(message.into())
+    }
+}
+
+/// A lifetime-only guard retained during synchronous bookkeeping changes.
+/// Never retain this guard across an await.
+pub trait DurableTurnGuard {}
+
+impl<T> DurableTurnGuard for T {}
+
+/// The host's current turn/control generation, never serialized into a checkpoint.
+pub trait DurableTurnControl: Sync {
+    /// Locks and verifies the actual generation before applying prepared state.
+    fn acquire(&self) -> Result<Box<dyn DurableTurnGuard + '_>, String>;
+}
+
+#[derive(Clone, Copy)]
+pub struct DurableTurnInput<'a> {
+    pub thread_id: &'a str,
+    pub turn_id: &'a str,
+    pub thread_store: &'a ExtensionData,
+    pub control: &'a dyn DurableTurnControl,
+}
+
+/// Captures and restores bookkeeping without replaying turn-start callbacks.
+pub trait DurableTurnContributor: Send + Sync {
+    /// Stable extension-owned namespace. Payload versions belong to the extension.
+    fn key(&self) -> &'static str;
+
+    /// Freeze process-local bookkeeping, including when an expected record is
+    /// unreadable. This must not start work or perform I/O.
+    fn hold(&self, thread_store: &ExtensionData);
+
+    /// Drain accounting under the extension's real locks, then capture its state.
+    /// Acquire input.control after asynchronous preparation and retain it only
+    /// through synchronous mutation/serialization, so Stop fences late results.
+    fn capture<'a>(
+        &'a self,
+        input: DurableTurnInput<'a>,
+    ) -> ExtensionFuture<'a, Result<Value, String>>;
+
+    /// Restore a confirmed capture into a held runtime. The host serializes
+    /// restoration and calls this at most once successfully per capture/key.
+    fn restore<'a>(
+        &'a self,
+        input: DurableTurnInput<'a>,
+        payload: &'a Value,
+    ) -> ExtensionFuture<'a, Result<(), DurableTurnRestoreError>>;
+
+    /// Reconstruct only what cancellation needs, never live process resources.
+    /// Unlike Resume, this may settle original bookkeeping under changed settings.
+    fn prepare_discard<'a>(
+        &'a self,
+        input: DurableTurnInput<'a>,
+        payload: &'a Value,
+    ) -> ExtensionFuture<'a, Result<(), DurableTurnRestoreError>>;
+
+    /// Validate synchronously before any contributor is thawed or readiness is
+    /// acknowledged. The host holds its current admission/control lock.
+    fn validate_resume(&self, thread_store: &ExtensionData, turn_id: &str) -> Result<(), String>;
+
+    /// Thaw only after all validation and readiness ownership checks succeeded.
+    /// This cannot fail and must perform no I/O or turn-start callback.
+    fn resume(&self, thread_store: &ExtensionData);
+
+    /// Settle a cold held turn before the host commits terminal history and
+    /// retires its continuation. The host keeps new execution fenced and
+    /// serializes repeated Stop requests; failures retain the recovery data.
+    fn discard<'a>(
+        &'a self,
+        input: DurableTurnInput<'a>,
+    ) -> ExtensionFuture<'a, Result<(), String>>;
+}
