+async fn capture_extensions(
+    session: &Session,
+    owner: &DurableSuspension,
+    turn_id: &str,
+    epoch: u64,
+) -> Result<Vec<SavedExtension>> {
+    let control = ExtensionControl { owner, epoch };
+    let thread_id = session.thread_id.to_string();
+    let mut seen = std::collections::HashSet::new();
+    let mut states = Vec::new();
+    for contributor in session.services.extensions.durable_turn_contributors() {
+        if !seen.insert(contributor.key()) {
+            return Err(invalid("duplicate durable extension namespace"));
+        }
+        let payload = contributor
+            .capture(codex_extension_api::DurableTurnInput {
+                thread_id: &thread_id,
+                turn_id,
+                thread_store: &session.services.thread_extension_data,
+                control: &control,
+            })
+            .await
+            .map_err(|error| invalid(format!("{}: {error}", contributor.key())))?;
+        states.push(SavedExtension {
+            key: contributor.key().into(),
+            payload,
+        });
+    }
+    Ok(states)
