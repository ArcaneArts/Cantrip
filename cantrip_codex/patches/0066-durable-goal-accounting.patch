diff --git a/codex-rs/ext/goal/src/suspension.rs b/codex-rs/ext/goal/src/suspension.rs
new file mode 100644
index 0000000..6e07da7
--- /dev/null
+++ b/codex-rs/ext/goal/src/suspension.rs
@@ -0,0 +1,199 @@
+use super::GoalExtension;
+use super::goal_runtime_handle;
+use crate::accounting::SavedGoalAccounting;
+use codex_extension_api::DurableTurnContributor;
+use codex_extension_api::DurableTurnInput;
+use codex_extension_api::DurableTurnRestoreError;
+use codex_extension_api::ExtensionData;
+use codex_extension_api::ExtensionFuture;
+use serde_json::Value;
+
+impl<C: Send + Sync + 'static> DurableTurnContributor for GoalExtension<C> {
+    fn key(&self) -> &'static str {
+        "codex.goal.accounting"
+    }
+
+    fn hold(&self, thread_store: &ExtensionData) {
+        if let Some(runtime) = goal_runtime_handle(thread_store) {
+            runtime.accounting_state().hold_suspension();
+        }
+    }
+
+    fn capture<'a>(
+        &'a self,
+        input: DurableTurnInput<'a>,
+    ) -> ExtensionFuture<'a, Result<Value, String>> {
+        Box::pin(async move {
+            let runtime = goal_runtime_handle(input.thread_store)
+                .ok_or("Goal runtime is missing at the durable boundary")?;
+            if runtime.thread_id().to_string() != input.thread_id {
+                return Err("Goal runtime belongs to another native thread".into());
+            }
+            let accounting = runtime.accounting_state();
+            let _goal_permit = runtime.goal_state_permit().await?;
+            let _turn_permit = accounting
+                .turn_start_permit()
+                .await
+                .map_err(|e| e.to_string())?;
+            let _progress_permit = accounting
+                .progress_accounting_permit()
+                .await
+                .map_err(|e| e.to_string())?;
+            {
+                let _control = input.control.acquire()?;
+                accounting.hold_suspension();
+            }
+            let goal = self
+                .state_dbs
+                .thread_goals()
+                .get_thread_goal(runtime.thread_id())
+                .await
+                .map_err(|e| e.to_string())?;
+            let _control = input.control.acquire()?;
+            let saved = accounting.suspension_snapshot(
+                input.thread_id,
+                input.turn_id,
+                runtime.is_enabled(),
+                goal.as_ref(),
+            )?;
+            serde_json::to_value(saved).map_err(|e| e.to_string())
+        })
+    }
+
+    fn restore<'a>(
+        &'a self,
+        input: DurableTurnInput<'a>,
+        payload: &'a Value,
+    ) -> ExtensionFuture<'a, Result<(), DurableTurnRestoreError>> {
+        restore_goal(self, input, payload, false)
+    }
+
+    fn prepare_discard<'a>(
+        &'a self,
+        input: DurableTurnInput<'a>,
+        payload: &'a Value,
+    ) -> ExtensionFuture<'a, Result<(), DurableTurnRestoreError>> {
+        restore_goal(self, input, payload, true)
+    }
+
+    fn validate_resume(&self, thread_store: &ExtensionData, turn_id: &str) -> Result<(), String> {
+        let runtime =
+            goal_runtime_handle(thread_store).ok_or("Goal runtime is missing during admission")?;
+        let accounting = runtime.accounting_state();
+        if !accounting.is_suspended() {
+            return Ok(());
+        }
+        if runtime.is_enabled() && accounting.current_turn_id().as_deref() != Some(turn_id) {
+            return Err("Goal accounting no longer owns the resumed native turn".into());
+        }
+        Ok(())
+    }
+
+    fn resume(&self, thread_store: &ExtensionData) {
+        if let Some(runtime) = goal_runtime_handle(thread_store) {
+            runtime.accounting_state().resume_suspension();
+        }
+    }
+
+    fn discard<'a>(
+        &'a self,
+        input: DurableTurnInput<'a>,
+    ) -> ExtensionFuture<'a, Result<(), String>> {
+        Box::pin(async move {
+            let runtime = goal_runtime_handle(input.thread_store)
+                .ok_or("Goal runtime is missing during native cancellation")?;
+            let accounting = runtime.accounting_state();
+            let _goal_permit = runtime.goal_state_permit().await?;
+            let _turn_permit = accounting
+                .turn_start_permit()
+                .await
+                .map_err(|e| e.to_string())?;
+            // Stop ends this turn; reopening its still-active Goal must not
+            // launch a replacement. A later explicit active Goal mutation or
+            // ordinary turn start clears the persisted continuation hold.
+            self.state_dbs
+                .thread_goals()
+                .defer_thread_goal_continuation(runtime.thread_id())
+                .await
+                .map_err(|e| e.to_string())?;
+            match accounting.current_turn_id().as_deref() {
+                None => return Ok(()), // An unreadable/older capture has no reconstructible accounting.
+                Some(id) if id == input.turn_id => {}
+                Some(_) => return Err("Goal cancellation belongs to another native turn".into()),
+            }
+            {
+                let _control = input.control.acquire()?;
+            }
+            for mode in [
+                codex_state::GoalAccountingMode::ActiveOrComplete,
+                codex_state::GoalAccountingMode::ActiveOrStopped,
+            ] {
+                runtime
+                    .account_active_goal_progress(
+                        input.turn_id,
+                        &format!("{}:durable-discard", input.turn_id),
+                        mode,
+                        crate::accounting::BudgetLimitedGoalDisposition::ClearActive,
+                    )
+                    .await?;
+            }
+            let _control = input.control.acquire()?;
+            accounting.finish_turn(input.turn_id);
+            input.thread_store.remove::<codex_core::TurnStartOptions>();
+            Ok(())
+        })
+    }
+}
+
+fn restore_goal<'a, C: Send + Sync + 'static>(
+    extension: &'a GoalExtension<C>,
+    input: DurableTurnInput<'a>,
+    payload: &'a Value,
+    for_discard: bool,
+) -> ExtensionFuture<'a, Result<(), DurableTurnRestoreError>> {
+    Box::pin(async move {
+        let saved: SavedGoalAccounting = serde_json::from_value(payload.clone()).map_err(|e| {
+            DurableTurnRestoreError::Unrestorable(format!("invalid Goal continuation: {e}"))
+        })?;
+        let runtime = goal_runtime_handle(input.thread_store)
+            .ok_or("Goal runtime is missing during native restoration")?;
+        if runtime.thread_id().to_string() != input.thread_id {
+            return Err("Goal runtime belongs to another native thread".into());
+        }
+        let accounting = runtime.accounting_state();
+        let _goal_permit = runtime.goal_state_permit().await?;
+        let _turn_permit = accounting
+            .turn_start_permit()
+            .await
+            .map_err(|e| e.to_string())?;
+        let _progress_permit = accounting
+            .progress_accounting_permit()
+            .await
+            .map_err(|e| e.to_string())?;
+        let goal = extension
+            .state_dbs
+            .thread_goals()
+            .get_thread_goal(runtime.thread_id())
+            .await
+            .map_err(|e| e.to_string())?;
+        let _control = input.control.acquire()?;
+        let result = if for_discard {
+            accounting.restore_for_discard(
+                saved,
+                input.thread_id,
+                input.turn_id,
+                runtime.is_enabled(),
+                goal.as_ref(),
+            )
+        } else {
+            accounting.restore_suspension(
+                saved,
+                input.thread_id,
+                input.turn_id,
+                runtime.is_enabled(),
+                goal.as_ref(),
+            )
+        };
+        result.map_err(DurableTurnRestoreError::Unrestorable)
+    })
+}
