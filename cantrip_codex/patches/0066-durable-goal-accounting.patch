+}
+
+async fn prepare_extensions_for_discard(
+    session: &Session,
+    owner: &Arc<DurableSuspension>,
+    turn_id: &str,
+    epoch: u64,
+) -> Result<()> {
+    // Core-unreadable records keep the existing terminal-history archival path.
+    let Ok(Some(record)) = owner.read(session).await else {
+        return Ok(());
+    };
+    if !record.state.retains_continuation() || record.identity.turn_id != turn_id {
+        return Ok(());
+    }
+    let control = ExtensionControl { owner, epoch };
+    let _restoration = owner.restored_extensions.lock().await;
+    let saved = record
+        .continuation
+        .as_ref()
+        .ok_or_else(|| invalid("native continuation is missing"))?;
+    let contributors = session.services.extensions.durable_turn_contributors();
+    let keys: std::collections::HashSet<_> = saved
+        .extensions
+        .iter()
+        .map(|state| state.key.as_str())
+        .collect();
+    let mut problems = Vec::new();
+    if keys.len() != saved.extensions.len()
+        || keys.len() != contributors.len()
+        || contributors
+            .iter()
+            .any(|contributor| !keys.contains(contributor.key()))
+    {
+        problems.push("continuation extensions differ from the installed runtime".to_string());
+    }
+    {
+        let _control = control.acquire().map_err(invalid)?;
+        owner.mark_unrestorable_extension(&record.identity.checkpoint_id, false);
+    }
+    for contributor in contributors {
+        let states: Vec<_> = saved
+            .extensions
+            .iter()
+            .filter(|state| state.key == contributor.key())
+            .collect();
+        if states.len() != 1 {
+            continue;
+        }
+        match contributor
+            .prepare_discard(
+                codex_extension_api::DurableTurnInput {
+                    thread_id: &record.identity.thread_id,
+                    turn_id,
+                    thread_store: &session.services.thread_extension_data,
+                    control: &control,
+                },
+                &states[0].payload,
+            )
+            .await
+        {
+            Ok(()) => {}
+            Err(codex_extension_api::DurableTurnRestoreError::Unrestorable(error)) => {
+                problems.push(format!("{}: {error}", contributor.key()))
+            }
+            Err(codex_extension_api::DurableTurnRestoreError::Failed(error)) => {
+                return Err(invalid(format!("{}: {error}", contributor.key())));
+            }
+        }
+    }
+    if !problems.is_empty() {
+        {
+            let _control = control.acquire().map_err(invalid)?;
+            owner.mark_unrestorable_extension(&record.identity.checkpoint_id, true);
+        }
+        session.send_event_raw(codex_protocol::protocol::Event {
+            id: turn_id.into(),
+            msg: EventMsg::Warning(codex_protocol::protocol::WarningEvent {
+                message: format!("Stop will preserve unsupported continuation data for inspection; unreconstructible extension accounting cannot be settled: {}", problems.join("; ")),
+            }),
+        }).await;
+    }
+    Ok(())
+}
