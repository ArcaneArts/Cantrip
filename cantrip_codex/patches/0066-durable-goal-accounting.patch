+        .collect();
+    if keys.len() != saved.extensions.len()
+        || keys.len() != contributors.len()
+        || contributors
+            .iter()
+            .any(|contributor| !keys.contains(contributor.key()))
+    {
+        let _control = control.acquire().map_err(invalid)?;
