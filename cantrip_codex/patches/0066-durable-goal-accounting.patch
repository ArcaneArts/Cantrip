diff --git a/codex-rs/ext/goal/src/accounting_suspension.rs b/codex-rs/ext/goal/src/accounting_suspension.rs
new file mode 100644
index 0000000..e803b5a
--- /dev/null
+++ b/codex-rs/ext/goal/src/accounting_suspension.rs
@@ -0,0 +1,252 @@
+//! Goal bookkeeping belongs to the original turn, not to a replacement start.
+
+use super::*;
+use codex_state::ThreadGoal;
+use serde::Deserializer;
+use serde::Serializer;
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct SavedClock {
+    elapsed: Duration,
+    active_goal_id: Option<String>,
+}
+
+impl Serialize for GoalWallClockAccounting {
+    fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        SavedClock {
+            elapsed: self.elapsed(),
+            active_goal_id: self.active_goal_id.clone(),
+        }
+        .serialize(serializer)
+    }
+}
+
+impl<'de> Deserialize<'de> for GoalWallClockAccounting {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        let saved = SavedClock::deserialize(deserializer)?;
+        Ok(Self {
+            last_accounted_at: Instant::now(),
+            elapsed_before_start: saved.elapsed,
+            suspended: true,
+            active_goal_id: saved.active_goal_id,
+        })
+    }
+}
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct GoalWatermark {
+    goal_id: String,
+    configuration_revision: i64,
+    tokens_used: i64,
+    time_used_seconds: i64,
+}
+
+impl From<&ThreadGoal> for GoalWatermark {
+    fn from(goal: &ThreadGoal) -> Self {
+        Self {
+            goal_id: goal.goal_id.clone(),
+            configuration_revision: goal.configuration_revision,
+            tokens_used: goal.tokens_used,
+            time_used_seconds: goal.time_used_seconds,
+        }
+    }
+}
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct SavedGoalAccounting {
+    version: u32,
+    thread_id: String,
+    turn_id: String,
+    enabled: bool,
+    inner: GoalAccountingInner,
+    descendant_token_usage: i64,
+    goal: Option<GoalWatermark>,
+}
+
+impl GoalAccountingState {
+    pub(crate) fn hold_suspension(&self) {
+        self.inner().wall_clock.hold();
+    }
+
+    pub(crate) fn is_suspended(&self) -> bool {
+        self.inner().wall_clock.suspended
+    }
+
+    pub(crate) fn resume_suspension(&self) {
+        self.inner().wall_clock.resume();
+    }
+
+    /// Caller holds goal-state, turn-start and progress permits. The DB read and
+    /// this snapshot consequently see the same completed accounting operation.
+    pub(crate) fn suspension_snapshot(
+        &self,
+        thread_id: &str,
+        turn_id: &str,
+        enabled: bool,
+        goal: Option<&ThreadGoal>,
+    ) -> Result<SavedGoalAccounting, String> {
+        let inner = self.inner();
+        if !inner.wall_clock.suspended {
+            return Err("Goal accounting was not held at the durable boundary".into());
+        }
+        if enabled && inner.current_turn_id.as_deref() != Some(turn_id) {
+            return Err("Goal accounting does not own the suspended native turn".into());
+        }
+        Ok(SavedGoalAccounting {
+            version: 1,
+            thread_id: thread_id.into(),
+            turn_id: turn_id.into(),
+            enabled,
+            inner: inner.clone(),
+            descendant_token_usage: self.descendant_token_usage.load(Ordering::Relaxed),
+            goal: goal.map(GoalWatermark::from),
+        })
+    }
+
+    /// Validate all persisted evidence before replacing process-local state.
+    /// Goal mutations may have charged the held delta after checkpoint commit;
+    /// the atomic DB counters distinguish that from still-unflushed usage.
+    pub(crate) fn restore_suspension(
+        &self,
+        saved: SavedGoalAccounting,
+        thread_id: &str,
+        turn_id: &str,
+        enabled: bool,
+        current_goal: Option<&ThreadGoal>,
+    ) -> Result<(), String> {
+        self.restore_accounting(saved, thread_id, turn_id, enabled, current_goal, false)
+    }
+
+    pub(crate) fn restore_for_discard(
+        &self,
+        saved: SavedGoalAccounting,
+        thread_id: &str,
+        turn_id: &str,
+        enabled: bool,
+        current_goal: Option<&ThreadGoal>,
+    ) -> Result<(), String> {
+        self.restore_accounting(saved, thread_id, turn_id, enabled, current_goal, true)
+    }
+
+    fn restore_accounting(
+        &self,
+        mut saved: SavedGoalAccounting,
+        thread_id: &str,
+        turn_id: &str,
+        enabled: bool,
+        current_goal: Option<&ThreadGoal>,
+        for_discard: bool,
+    ) -> Result<(), String> {
+        if saved.version != 1 {
+            return Err(format!(
+                "unsupported Goal continuation version {}",
+                saved.version
+            ));
+        }
+        if saved.thread_id != thread_id || saved.turn_id != turn_id {
+            return Err("Goal continuation belongs to another native thread or turn".into());
+        }
+        if !for_discard && saved.enabled != enabled {
+            return Err("Goal runtime configuration differs from the suspended turn".into());
+        }
+        if saved
+            .inner
+            .current_turn_id
+            .as_deref()
+            .is_some_and(|id| id != turn_id)
+            || (saved.enabled
+                && (saved.inner.current_turn_id.as_deref() != Some(turn_id)
+                    || !saved.inner.turns.contains_key(turn_id)))
+        {
+            return Err("Goal continuation has inconsistent turn bookkeeping".into());
+        }
+        if saved.inner.wall_clock.elapsed().as_secs() > i64::MAX as u64 {
+            return Err("Goal continuation clock exceeds the accounting range".into());
+        }
+        let unflushed = goal_progress_snapshot(&saved.inner, turn_id, saved.descendant_token_usage);
+        let same_goal = saved
+            .goal
+            .as_ref()
+            .zip(current_goal)
+            .filter(|(old, current)| old.goal_id == current.goal_id);
+        if let Some((old, current)) = same_goal {
+            if old.tokens_used < 0 || old.time_used_seconds < 0 {
+                return Err("Goal continuation has invalid usage counters".into());
+            }
+            let token_delta = current.tokens_used.checked_sub(old.tokens_used);
+            let time_delta = current.time_used_seconds.checked_sub(old.time_used_seconds);
+            match (token_delta, time_delta) {
+                (Some(0), Some(0)) => {}
+                (Some(tokens), Some(seconds))
+                    if unflushed.as_ref().is_some_and(|pending| {
+                        pending.expected_goal_id == current.goal_id
+                            && tokens == pending.token_delta.max(0)
+                            && seconds == pending.time_delta_seconds.max(0)
+                    }) =>
+                {
+                    if let Some(pending) = unflushed.as_ref() {
+                        if let Some(turn) = saved.inner.turns.get_mut(turn_id) {
+                            turn.last_accounted_token_usage = pending.current_token_usage.clone();
+                        }
+                        saved.inner.last_accounted_descendant_token_usage =
+                            pending.current_descendant_token_usage;
+                        saved
+                            .inner
+                            .wall_clock
+                            .mark_accounted(pending.time_delta_seconds);
+                    }
+                }
+                _ => {
+                    return Err(
+                        "persisted Goal usage differs from the suspended accounting boundary"
+                            .into(),
+                    );
+                }
+            }
+        }
+        let configuration_changed = match (saved.goal.as_ref(), current_goal) {
+            (Some(old), Some(current)) => {
+                old.goal_id != current.goal_id
+                    || old.configuration_revision != current.configuration_revision
+            }
+            (None, None) => false,
+            _ => true,
+        };
+        let same_goal = saved
+            .goal
+            .as_ref()
+            .zip(current_goal)
+            .is_some_and(|(old, current)| old.goal_id == current.goal_id);
+        saved.inner.wall_clock.hold();
+        *self.inner() = saved.inner;
+        self.descendant_token_usage
+            .store(saved.descendant_token_usage, Ordering::Relaxed);
+        if configuration_changed {
+            self.reset_empty_responses();
+        }
+        if for_discard {
+            if !same_goal {
+                // No old usage is reassigned to a replacement or cleared Goal.
+                self.clear_active_goal();
+            }
+            return Ok(());
+        }
+        match current_goal {
+            Some(goal)
+                if matches!(
+                    goal.status,
+                    ThreadGoalStatus::Active | ThreadGoalStatus::BudgetLimited
+                ) =>
+            {
+                if configuration_changed {
+                    self.mark_current_turn_goal_active(goal.goal_id.clone());
+                }
+            }
+            _ => self.clear_active_goal(),
+        }
+        Ok(())
+    }
+}
