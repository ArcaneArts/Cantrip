+    pub(crate) async fn exec_resize(
+        &self,
+        params: ResizeParams,
+    ) -> Result<ResizeResponse, JSONRPCErrorError> {
+        if params.rows == 0 || params.cols == 0 || params.rows > 1000 || params.cols > 1000 {
+            return Err(invalid_params(
+                "PTY dimensions must be between 1 and 1000".to_string(),
+            ));
+        }
+        let processes = self.inner.processes.lock().await;
+        let Some(ProcessEntry::Running(process)) = processes.get(&params.process_id) else {
+            return Err(invalid_request(
+                "PTY process is unknown or still starting".to_string(),
+            ));
+        };
+        if !process.tty || process.closed || process.exit_code.is_some() {
+            return Err(invalid_request("Process has no live PTY".to_string()));
+        }
+        process
+            .session
+            .resize(TerminalSize {
+                rows: params.rows,
+                cols: params.cols,
+            })
+            .map_err(|err| internal_error(format!("failed to resize PTY: {err}")))?;
+        Ok(ResizeResponse {})
+    }
