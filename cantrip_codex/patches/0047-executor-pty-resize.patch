+    #[cfg(unix)]
+    #[tokio::test]
+    async fn resize_changes_the_actual_terminal_and_rejects_unknown_handles() {
+        let backend = LocalProcess::default();
+        let process_id = ProcessId::from("resize-test");
+        let mut params = test_exec_params(HashMap::new());
+        params.process_id = process_id.clone();
+        params.argv = vec![
+            "/bin/sh".to_string(),
+            "-c".to_string(),
+            "read line; stty size".to_string(),
+        ];
+        params.tty = true;
+        backend
+            .exec(params, ProcessTelemetry::default())
+            .await
+            .expect("start PTY");
+        assert!(
+            backend
+                .exec_resize(ResizeParams {
+                    process_id: process_id.clone(),
+                    rows: 0,
+                    cols: 100
+                })
+                .await
+                .is_err()
+        );
+        assert!(
+            backend
+                .exec_resize(ResizeParams {
+                    process_id: ProcessId::from("another-session"),
+                    rows: 33,
+                    cols: 101
+                })
+                .await
+                .is_err()
+        );
+        backend
+            .exec_resize(ResizeParams {
+                process_id: process_id.clone(),
+                rows: 33,
+                cols: 101,
+            })
+            .await
+            .expect("resize live PTY");
+        backend
+            .exec_write(WriteParams {
+                process_id: process_id.clone(),
+                write_id: "release-read".to_string(),
+                chunk: ByteChunk(b"\n".to_vec().into()),
+            })
+            .await
+            .expect("write PTY");
+        let mut output = Vec::new();
+        let mut after_seq = None;
+        loop {
+            let response = timeout(
+                Duration::from_secs(5),
+                read_process_until_change(&backend, &process_id, after_seq),
+            )
+            .await
+            .expect("PTY output");
+            for chunk in &response.chunks {
+                output.extend_from_slice(&chunk.chunk.0);
+            }
+            if response.closed {
+                assert_eq!(response.exit_code, Some(0));
+                break;
+            }
+            after_seq = response.next_seq.checked_sub(1);
+        }
+        assert!(String::from_utf8_lossy(&output).contains("33 101"));
+        backend.shutdown().await;
+    }
