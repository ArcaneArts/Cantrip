@@ -1012,6 +1012,9 @@ impl McpConnectionSet {
         };
 
         let effective_timeout = match (view.tool_timeout, requested_timeout) {
+            // Cantrip managed CUA: zero opts into the existing untimed client
+            // path. Execution cancellation still drops the in-flight call.
+            (Some(server_timeout), _) if server_timeout.is_zero() => None,
             (Some(server_timeout), Some(requested_timeout)) => {
                 Some(server_timeout.min(requested_timeout))
