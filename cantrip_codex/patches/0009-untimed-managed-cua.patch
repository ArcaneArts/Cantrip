diff --git a/codex-rs/codex-mcp/src/binding.rs b/codex-rs/codex-mcp/src/binding.rs
index ade3747..6140526 100644
--- a/codex-rs/codex-mcp/src/binding.rs
+++ b/codex-rs/codex-mcp/src/binding.rs
@@ -312,6 +312,9 @@ impl PreparedMcpCall {
         Fut: Future<Output = Result<(Option<JsonValue>, Option<JsonValue>)>>,
     {
         let effective_timeout = match (self.client.tool_timeout, requested_timeout) {
+            // Model-initiated calls use the frozen binding rather than the
+            // direct RPC path. Preserve the same managed untimed convention.
+            (Some(server_timeout), _) if server_timeout.is_zero() => None,
             (Some(server_timeout), Some(requested_timeout)) => {
                 Some(server_timeout.min(requested_timeout))
             }
