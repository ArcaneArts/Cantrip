     fn render_chat_widget_frame(&mut self, tui: &mut tui::Tui, screen_size: Size) -> Result<Rect> {
+        if self.chat_widget.has_active_view() && self.startup_protected_input_boundary {
+            if !self.startup_input_quarantined {
+                // Drain before painting the first actionable screen. Repeated startup
+                // renders must not discard a reply to a prompt that is already visible.
+                tui.discard_pending_input_before_interactive_screen()?;
+                self.startup_input_quarantined = true;
+            }
+            self.startup_pending_protected_request = false;
