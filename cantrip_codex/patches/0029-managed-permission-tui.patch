+#[tokio::test]
+async fn managed_permissions_version_fence_rejects_old_conflicting_and_retired_epoch_events()
+-> Result<()> {
+    let (mut app, thread_id) = attached_app().await;
+    let (server, fixture) = managed_permissions_fixture(&app, thread_id, false).await?;
+    let mut current = fixture.settings.clone();
+    current.settings_version = Some(codex_protocol::protocol::ThreadSettingsVersion {
+        epoch: "epoch-one".into(),
+        revision: "10".into(),
+    });
+    assert!(app.accept_native_settings_version(thread_id, &current, true));
+    let mut stale = current.clone();
+    stale.settings_version.as_mut().unwrap().revision = "9".into();
+    stale.model = "old-model".into();
+    assert!(!app.accept_native_settings_version(thread_id, &stale, false));
+    let mut conflict = current.clone();
+    conflict.model = "different-model-at-same-version".into();
+    assert!(!app.accept_native_settings_version(thread_id, &conflict, false));
+    assert!(app.accept_native_settings_version(thread_id, &current, false));
+    let mut replacement = current.clone();
+    replacement.settings_version.as_mut().unwrap().epoch = "epoch-two".into();
+    replacement.settings_version.as_mut().unwrap().revision = "1".into();
+    assert!(!app.accept_native_settings_version(thread_id, &replacement, false));
+    assert!(app.accept_native_settings_version(thread_id, &replacement, true));
+    assert!(!app.accept_native_settings_version(thread_id, &current, false));
+    let mut legacy = fixture.settings.clone();
+    legacy.settings_version = None;
+    assert!(!app.accept_native_settings_version(thread_id, &legacy, false));
+    assert_eq!(app.observed_native_settings[&thread_id], replacement);
+    server.shutdown().await?;
+    fixture.task.await?;
+    Ok(())
+}
