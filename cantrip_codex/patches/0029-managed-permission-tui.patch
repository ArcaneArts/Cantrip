diff --git a/codex-rs/tui/src/app/managed_permission_changes.rs b/codex-rs/tui/src/app/managed_permission_changes.rs
new file mode 100644
index 0000000..7600236
--- /dev/null
+++ b/codex-rs/tui/src/app/managed_permission_changes.rs
@@ -0,0 +1,529 @@
+//! Managed permission choices are native operations, not optimistic config edits.
+
+use super::*;
+use codex_app_server_protocol as api;
+use codex_protocol::protocol::ThreadSettingsOperationPhase;
+
+pub(super) const MANAGED_PERMISSION_ROOT_ONLY: &str = "Permission changes in this managed session are available only on its root thread. Return to the root thread to choose permissions.";
+
+#[derive(Clone, Debug)]
+pub(super) struct PendingPermissionChange {
+    thread_id: ThreadId,
+    operation_id: String,
+    submission_id: Option<String>,
+    display_label: String,
+}
+
+impl PendingPermissionChange {
+    fn matches(&self, thread_id: &str, operation_id: &str, submission_id: &str) -> bool {
+        self.thread_id.to_string() == thread_id
+            && self.operation_id == operation_id
+            && self
+                .submission_id
+                .as_deref()
+                .is_none_or(|id| id == submission_id)
+    }
+}
+
+fn security_matches(
+    settings: &api::ThreadSettings,
+    security: &api::ThreadSettingsResolvedSecurity,
+) -> bool {
+    settings.permission_profile.as_ref() == Some(&security.permission_profile)
+        && settings.approval_policy == security.approval_policy
+        && settings.approvals_reviewer == security.approvals_reviewer
+        && settings.sandbox_policy == security.sandbox_policy
+        && settings.active_permission_profile == security.active_permission_profile
+}
+
+impl App {
+    pub(super) fn pending_settings_input_disposition(
+        error: &codex_app_server_client::TypedRequestError,
+    ) -> Option<crate::managed_queue::PendingSettingsInputDisposition> {
+        use crate::managed_queue::PendingSettingsInputDisposition;
+        let codex_app_server_client::TypedRequestError::Server { method, source } = error else {
+            return None;
+        };
+        let data = source.data.as_ref()?;
+        if method != "turn/start"
+            || data.get("reason").and_then(serde_json::Value::as_str) != Some("pendingSettings")
+            || data
+                .get("inputConsumed")
+                .and_then(serde_json::Value::as_bool)
+                != Some(false)
+        {
+            return None;
+        }
+        if data
+            .get("queueRetention")
+            .and_then(serde_json::Value::as_str)
+            == Some("uncertain")
+        {
+            return Some(PendingSettingsInputDisposition::Uncertain {
+                client_user_message_id: data
+                    .get("clientUserMessageId")
+                    .and_then(serde_json::Value::as_str)
+                    .filter(|id| !id.is_empty())
+                    .map(str::to_string),
+            });
+        }
+        Some(
+            if data
+                .get("queueRetained")
+                .and_then(serde_json::Value::as_bool)
+                == Some(true)
+            {
+                PendingSettingsInputDisposition::Retained
+            } else {
+                PendingSettingsInputDisposition::NotRetained
+            },
+        )
+    }
+
+    pub(super) fn has_pending_permission_change_for_visible_thread(&self) -> bool {
+        self.pending_permission_changes
+            .values()
+            .any(|pending| self.chat_widget.thread_id() == Some(pending.thread_id))
+    }
+
+    fn permission_selection_settled(&self, thread_id: ThreadId) {
+        if self.chat_widget.thread_id() == Some(thread_id) {
+            self.app_event_tx.send(AppEvent::SettingsSelectionSettled);
+        }
+    }
+
+    pub(super) async fn submit_managed_permission_change(
+        &mut self,
+        app_server: &AppServerSession,
+        thread_id: ThreadId,
+        selection: PermissionProfileSelection,
+    ) {
+        let operation_id = uuid::Uuid::new_v4().to_string();
+        self.pending_permission_changes.insert(
+            operation_id.clone(),
+            PendingPermissionChange {
+                thread_id,
+                operation_id: operation_id.clone(),
+                submission_id: None,
+                display_label: selection.display_label.clone(),
+            },
+        );
+        let result = app_server
+            .request_handle()
+            .request_typed::<api::ThreadSettingsUpdateResponse>(
+                api::ClientRequest::ThreadSettingsUpdate {
+                    request_id: api::RequestId::String(uuid::Uuid::new_v4().to_string()),
+                    params: api::ThreadSettingsUpdateParams {
+                        thread_id: thread_id.to_string(),
+                        operation_id: Some(operation_id.clone()),
+                        apply_at: Some(api::ThreadSettingsApplyAt::Quiescent),
+                        permissions: Some(selection.profile_id),
+                        approval_policy: selection.approval_policy,
+                        approvals_reviewer: selection.approvals_reviewer.map(Into::into),
+                        ..Default::default()
+                    },
+                },
+            )
+            .await;
+        match result {
+            Ok(receipt)
+                if receipt.operation_id.as_deref() == Some(operation_id.as_str())
+                    && receipt.admission == Some(api::ThreadSettingsAdmission::Queued)
+                    && receipt.submission_id.is_some() =>
+            {
+                // The operation may already have settled through an early notification.
+                // Admission can correlate a pending record, never recreate an applied one.
+                if let Some(pending) = self.pending_permission_changes.get_mut(&operation_id) {
+                    pending.submission_id = receipt.submission_id;
+                    self.chat_widget.add_info_message(format!(
+                        "Permissions pending: {}. They apply when this thread and its agents are idle.",
+                        selection.display_label,
+                    ), None);
+                }
+            }
+            Err(error) if permission_admission_rejected(&error) => {
+                self.pending_permission_changes.remove(&operation_id);
+                self.permission_selection_settled(thread_id);
+                self.chat_widget.add_error_message(format!("Permission change rejected: {error}. Current permissions were not changed by this request."));
+            }
+            result => {
+                let detail = match result {
+                    Err(error) => error.to_string(),
+                    Ok(_) => "the response did not identify queued admission".to_string(),
+                };
+                self.chat_widget.add_error_message(format!(
+                    "Permission change is unconfirmed: {detail}. No input was resent; displayed permissions remain at the last confirmed state."
+                ));
+                // A lost reply is not a rejection. The stable ID can recover application
+                // without issuing another settings update.
+                self.reconcile_managed_permission_change(app_server, &operation_id)
+                    .await;
+            }
+        }
+    }
+
+    pub(super) async fn observe_managed_permission_notification(
+        &mut self,
+        app_server: &AppServerSession,
+        notification: &api::ServerNotification,
+    ) {
+        match notification {
+            api::ServerNotification::ThreadSettingsUpdated(update) => {
+                // GUI/native peers share the same confirmed runtime state, even when
+                // this TUI did not originate the permission operation.
+                if let Ok(thread_id) = ThreadId::from_string(&update.thread_id)
+                    && app_server.is_managed_gateway_thread(Some(thread_id))
+                    && !update
+                        .operation_id
+                        .as_ref()
+                        .is_some_and(|id| self.pending_permission_changes.contains_key(id))
+                    && let Some(security) = &update.resolved_security
+                    && security_matches(&update.thread_settings, security)
+                    && self.accept_native_settings_version(
+                        thread_id,
+                        &update.thread_settings,
+                        false,
+                    )
+                {
+                    self.apply_confirmed_managed_permissions(
+                        thread_id,
+                        &update.thread_settings,
+                        Some(security),
+                    )
+                    .await;
+                }
+                let Some(operation_id) = update.operation_id.as_deref() else {
+                    return;
+                };
+                let Some(pending) = self.pending_permission_changes.get(operation_id) else {
+                    return;
+                };
+                if pending.thread_id.to_string() != update.thread_id {
+                    return;
+                }
+                if let (Some(submission_id), Some(security)) =
+                    (&update.submission_id, &update.resolved_security)
+                    && pending.matches(&update.thread_id, operation_id, submission_id)
+                    && security_matches(&update.thread_settings, security)
+                {
+                    if !self.accept_native_settings_version(
+                        pending.thread_id,
+                        &update.thread_settings,
+                        false,
+                    ) {
+                        return;
+                    }
+                    let pending = self
+                        .pending_permission_changes
+                        .remove(operation_id)
+                        .expect("pending permission operation");
+                    self.apply_confirmed_managed_permissions(
+                        pending.thread_id,
+                        &update.thread_settings,
+                        Some(security),
+                    )
+                    .await;
+                    self.permission_change_applied(&pending);
+                } else {
+                    // Older/mixed notifications are not application evidence for this intent.
+                    self.reconcile_managed_permission_change(app_server, operation_id)
+                        .await;
+                }
+            }
+            api::ServerNotification::Error(error) if !error.will_retry => {
+                if let Some(api::CodexErrorInfo::ThreadSettingsUpdateFailed {
+                    operation_id: Some(operation_id),
+                }) = &error.error.codex_error_info
+                    && self
+                        .pending_permission_changes
+                        .get(operation_id)
+                        .is_some_and(|pending| pending.thread_id.to_string() == error.thread_id)
+                {
+                    if let Some(pending) = self.pending_permission_changes.remove(operation_id) {
+                        self.permission_selection_settled(pending.thread_id);
+                    }
+                    // The normal error notification renders the rejection. Actual state stays.
+                }
+            }
+            _ => {}
+        }
+    }
+
+    pub(super) async fn reconcile_managed_permission_changes(
+        &mut self,
+        app_server: &AppServerSession,
+    ) {
+        let operation_ids: Vec<String> = self.pending_permission_changes.keys().cloned().collect();
+        for operation_id in operation_ids {
+            self.reconcile_managed_permission_change(app_server, &operation_id)
+                .await;
+        }
+    }
+
+    async fn reconcile_managed_permission_change(
+        &mut self,
+        app_server: &AppServerSession,
+        operation_id: &str,
+    ) {
+        let Some(pending) = self.pending_permission_changes.get(operation_id).cloned() else {
+            return;
+        };
+        let result = app_server
+            .request_handle()
+            .request_typed::<api::ThreadSettingsOperationReadResponse>(
+                api::ClientRequest::ThreadSettingsOperationRead {
+                    request_id: api::RequestId::String(uuid::Uuid::new_v4().to_string()),
+                    params: api::ThreadSettingsOperationReadParams {
+                        thread_id: pending.thread_id.to_string(),
+                        operation_id: operation_id.to_string(),
+                    },
+                },
+            )
+            .await;
+        let receipt = match result {
+            Ok(receipt)
+                if pending.matches(
+                    &receipt.thread_id,
+                    &receipt.operation_id,
+                    &receipt.submission_id,
+                ) =>
+            {
+                receipt
+            }
+            Ok(_) => {
+                tracing::warn!(
+                    operation_id,
+                    "permission operation read returned a different identity"
+                );
+                return;
+            }
+            Err(error) => {
+                tracing::warn!(operation_id, %error, "permission operation remains unconfirmed");
+                return;
+            }
+        };
+        match receipt.phase {
+            ThreadSettingsOperationPhase::Pending => {
+                if let Some(pending) = self.pending_permission_changes.get_mut(operation_id) {
+                    pending.submission_id = Some(receipt.submission_id);
+                }
+            }
+            ThreadSettingsOperationPhase::Rejected => {
+                self.pending_permission_changes.remove(operation_id);
+                self.permission_selection_settled(pending.thread_id);
+                if self.chat_widget.thread_id() == Some(pending.thread_id) {
+                    self.chat_widget.add_error_message(format!(
+                        "Permission change rejected: {}",
+                        receipt
+                            .rejection
+                            .unwrap_or_else(|| "native settings update was rejected".into())
+                    ));
+                }
+            }
+            ThreadSettingsOperationPhase::Applied => {
+                let Some(applied) = receipt.thread_settings.as_ref() else {
+                    return;
+                };
+                if !security_matches(applied, &receipt.resolved_security) {
+                    return;
+                }
+                // The operation journal contains its historical application snapshot. Read
+                // current state so reconnect never restores an older model or permission tuple.
+                let current = app_server
+                    .request_handle()
+                    .request_typed::<api::ThreadSettingsReadResponse>(
+                        api::ClientRequest::ThreadSettingsRead {
+                            request_id: api::RequestId::String(uuid::Uuid::new_v4().to_string()),
+                            params: api::ThreadSettingsReadParams {
+                                thread_id: pending.thread_id.to_string(),
+                            },
+                        },
+                    )
+                    .await;
+                let Ok(current) = current else { return };
+                if current.thread_id != pending.thread_id.to_string() {
+                    return;
+                }
+                if !self.accept_native_settings_version(
+                    pending.thread_id,
+                    &current.thread_settings,
+                    true,
+                ) {
+                    return;
+                }
+                self.pending_permission_changes.remove(operation_id);
+                let security =
+                    security_matches(&current.thread_settings, &receipt.resolved_security)
+                        .then_some(&receipt.resolved_security);
+                self.apply_confirmed_managed_permissions(
+                    pending.thread_id,
+                    &current.thread_settings,
+                    security,
+                )
+                .await;
+                self.permission_change_applied(&pending);
+            }
+        }
+    }
+
+    async fn apply_confirmed_managed_permissions(
+        &mut self,
+        thread_id: ThreadId,
+        settings: &api::ThreadSettings,
+        security: Option<&api::ThreadSettingsResolvedSecurity>,
+    ) {
+        self.apply_thread_settings_to_cached_session(thread_id, settings)
+            .await;
+        if self.chat_widget.thread_id() != Some(thread_id) {
+            return;
+        }
+        self.chat_widget.apply_thread_settings(settings.clone());
+        if let Some(security) = security {
+            if let Err(error) = self.chat_widget.set_permission_profile_with_active_profile(
+                security.permission_profile.clone(),
+                security.active_permission_profile.clone().map(Into::into),
+            ) {
+                tracing::warn!(%error, "failed to apply resolved native permission profile");
+            }
+        }
+        let config = self.chat_widget.config_ref().clone();
+        self.config.permissions = config.permissions.clone();
+        self.set_approvals_reviewer_in_app_and_widget(config.approvals_reviewer);
+        self.runtime_approval_policy_override = Some(RuntimeApprovalPolicyOverride::Restored(
+            AskForApproval::from(config.permissions.approval_policy.value()),
+        ));
+        self.runtime_permission_profile_override =
+            Some(RuntimePermissionProfileOverride::from_config(&config));
+    }
+
+    fn permission_change_applied(&mut self, pending: &PendingPermissionChange) {
+        self.permission_selection_settled(pending.thread_id);
+        if self.chat_widget.thread_id() == Some(pending.thread_id) {
+            let profile = self
+                .chat_widget
+                .config_ref()
+                .permissions
+                .active_permission_profile()
+                .map(|profile| profile.id)
+                .unwrap_or_else(|| "custom".into());
+            self.chat_widget.add_info_message(format!("Permission request applied: {}. Current native profile: {profile}. /permissions shows its details.", pending.display_label), None);
+        }
+    }
+}
+
+impl App {
+    /// Only actual current-state reads can establish a replacement native epoch.
+    /// Replayed notifications can advance their current epoch, never resurrect an old one.
+    pub(super) fn accept_native_settings_version(
+        &mut self,
+        thread_id: ThreadId,
+        incoming: &api::ThreadSettings,
+        current_read: bool,
+    ) -> bool {
+        if incoming.settings_version.as_ref().is_some_and(|version| {
+            version.epoch.is_empty() || version.revision.parse::<u64>().is_err()
+        }) {
+            self.chat_widget.add_error_message(
+                "Native settings returned an invalid version; keeping the last confirmed settings."
+                    .into(),
+            );
+            return false;
+        }
+        if let Some(previous) = self.observed_native_settings.get(&thread_id) {
+            let decision = settings_version_decision(previous, incoming, current_read);
+            if decision != VersionDecision::Accept {
+                if decision == VersionDecision::Conflict {
+                    self.chat_widget.add_error_message("Native settings contained conflicting values at the same version; keeping the last confirmed settings.".into());
+                }
+                return false;
+            }
+        }
+        if incoming.settings_version.is_some() {
+            self.observed_native_settings
+                .insert(thread_id, incoming.clone());
+        }
+        true
+    }
+
+    pub(super) async fn refresh_current_managed_settings(
+        &mut self,
+        app_server: &AppServerSession,
+        thread_id: ThreadId,
+    ) {
+        let current = app_server
+            .request_handle()
+            .request_typed::<api::ThreadSettingsReadResponse>(
+                api::ClientRequest::ThreadSettingsRead {
+                    request_id: api::RequestId::String(uuid::Uuid::new_v4().to_string()),
+                    params: api::ThreadSettingsReadParams {
+                        thread_id: thread_id.to_string(),
+                    },
+                },
+            )
+            .await;
+        if let Ok(current) = current
+            && current.thread_id == thread_id.to_string()
+            && self.accept_native_settings_version(thread_id, &current.thread_settings, true)
+        {
+            self.apply_confirmed_managed_permissions(thread_id, &current.thread_settings, None)
+                .await;
+        }
+    }
+}
+
+#[derive(PartialEq, Debug)]
+enum VersionDecision {
+    Accept,
+    Stale,
+    Conflict,
+}
+
+fn settings_version_decision(
+    previous: &api::ThreadSettings,
+    incoming: &api::ThreadSettings,
+    current_read: bool,
+) -> VersionDecision {
+    let Some(prior) = &previous.settings_version else {
+        return VersionDecision::Accept;
+    };
+    let Some(next) = &incoming.settings_version else {
+        return VersionDecision::Stale;
+    };
+    if prior.epoch != next.epoch {
+        return if current_read {
+            VersionDecision::Accept
+        } else {
+            VersionDecision::Stale
+        };
+    }
+    let (Ok(prior_revision), Ok(next_revision)) =
+        (prior.revision.parse::<u64>(), next.revision.parse::<u64>())
+    else {
+        return VersionDecision::Conflict;
+    };
+    match next_revision.cmp(&prior_revision) {
+        std::cmp::Ordering::Less => VersionDecision::Stale,
+        std::cmp::Ordering::Equal if previous != incoming => VersionDecision::Conflict,
+        _ => VersionDecision::Accept,
+    }
+}
+
+fn permission_admission_rejected(error: &codex_app_server_client::TypedRequestError) -> bool {
+    let codex_app_server_client::TypedRequestError::Server { source, .. } = error else {
+        return false;
+    };
+    matches!(
+        source
+            .data
+            .as_ref()
+            .and_then(|data| data.get("code"))
+            .and_then(serde_json::Value::as_str),
+        Some(
+            "permission-transition-pending"
+                | "permission-revision-conflict"
+                | "permission-policy-replaced"
+                | "invalid-permission-transition"
+                | "settings-binding-replaced"
+        )
+    )
+}
