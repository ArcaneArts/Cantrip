+#[tokio::test]
+async fn managed_permissions_pending_turn_keeps_one_input_owner_and_never_replays() -> Result<()> {
+    for disposition in ["retained", "notRetained", "uncertain"] {
+        let queue_retained = disposition == "retained";
+        let (mut app, mut events, mut operations) = make_test_app_with_channels().await;
+        let thread_id = ThreadId::new();
+        app.active_thread_id = Some(thread_id);
+        app.primary_thread_id = Some(thread_id);
+        app.chat_widget
+            .handle_thread_session_quiet(test_thread_session(
+                thread_id,
+                app.config.cwd.to_path_buf(),
+            ));
+        let (mut server, fixture) = managed_permissions_fixture(&app, thread_id, false).await?;
+        *fixture.pending_turn.lock().unwrap() = Some(
+            json!({"reason":"pendingSettings","inputConsumed":false,"queueRetained":queue_retained,"queueRetention":disposition,"clientUserMessageId":"native-pending-input"}),
+        );
+        let mut tui = crate::tui::test_support::make_test_tui()?;
+        while operations.try_recv().is_ok() {}
+        app.chat_widget
+            .restore_user_message_to_composer(crate::chatwidget::UserMessage {
+                remote_image_urls: vec!["https://example.invalid/deferred-image.png".into()],
+                ..crate::chatwidget::UserMessage::from("original pending input")
+            });
+        app.chat_widget
+            .handle_key_event(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE));
+        let submitted = next_user_turn_op(&mut operations);
+        app.chat_widget
+            .apply_external_edit("queued followup".into());
+        app.chat_widget
+            .handle_key_event(KeyEvent::new(KeyCode::Enter, KeyModifiers::NONE));
+        app.chat_widget
+            .apply_external_edit("concurrent draft".into());
+        while events.try_recv().is_ok() {}
+        let result = app
+            .handle_event(&mut tui, &mut server, AppEvent::CodexOp(submitted))
+            .await?;
+        assert!(matches!(result, AppRunControl::Continue));
+        assert!(!app.chat_widget.is_user_turn_pending_or_running());
+        assert_eq!(
+            app.chat_widget.queued_user_message_texts(),
+            vec!["queued followup"]
+        );
+        let draft = app.chat_widget.composer_text_with_pending();
+        assert!(draft.contains("concurrent draft"));
+        assert_eq!(
+            draft.contains("original pending input"),
+            disposition == "notRetained"
+        );
+        if disposition == "notRetained" {
+            assert_eq!(
+                app.chat_widget.remote_image_urls(),
+                vec!["https://example.invalid/deferred-image.png"]
+            );
+            assert!(!app.chat_widget.maybe_send_next_queued_input());
+        }
+        assert!(
+            operations.try_recv().is_err(),
+            "no automatic local retry or next-input drain"
+        );
+        assert_eq!(
+            fixture
+                .requests
+                .lock()
+                .unwrap()
+                .iter()
+                .filter(|request| request["method"] == "turn/start")
+                .count(),
+            1
+        );
+        fixture.task.abort();
+    }
+    Ok(())
+}
