+fn operation_id(fixture: &Fixture) -> String {
+    fixture
+        .requests
+        .lock()
+        .unwrap()
+        .iter()
+        .find(|r| r["method"] == "thread/settings/update")
+        .unwrap()["params"]["operationId"]
+        .as_str()
+        .unwrap()
