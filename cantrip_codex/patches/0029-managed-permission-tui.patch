diff --git a/codex-rs/tui/src/app/tests/managed_permissions.rs b/codex-rs/tui/src/app/tests/managed_permissions.rs
new file mode 100644
index 0000000..8f17c42
--- /dev/null
+++ b/codex-rs/tui/src/app/tests/managed_permissions.rs
@@ -0,0 +1,718 @@
+use super::*;
+use crate::app_server_session::ThreadParamsMode;
+use codex_app_server_client::{
+    AppServerClient, RemoteAppServerClient, RemoteAppServerConnectArgs, RemoteAppServerEndpoint,
+};
+use codex_app_server_protocol as api;
+use futures::{SinkExt, StreamExt};
+use pretty_assertions::assert_eq;
+use serde_json::{Value, json};
+use tokio_tungstenite::tungstenite::Message;
+
+struct Fixture {
+    requests: Arc<std::sync::Mutex<Vec<Value>>>,
+    phase: Arc<std::sync::Mutex<String>>,
+    rejection_code: Arc<std::sync::Mutex<Option<String>>>,
+    pending_turn: Arc<std::sync::Mutex<Option<Value>>>,
+    task: tokio::task::JoinHandle<()>,
+    settings: api::ThreadSettings,
+    security: api::ThreadSettingsResolvedSecurity,
+}
+
+async fn managed_permissions_fixture(
+    app: &App,
+    thread_id: ThreadId,
+    fail_ack: bool,
+) -> Result<(AppServerSession, Fixture)> {
+    let mut collaboration = app.chat_widget.effective_collaboration_mode();
+    collaboration.settings.model = "applied-model".into();
+    let settings = api::ThreadSettings {
+        permission_profile: Some(PermissionProfile::read_only()),
+        multi_agent_enabled: false,
+        subagent_model: None,
+        subagent_reasoning_effort: None,
+        settings_version: Some(codex_protocol::protocol::ThreadSettingsVersion {
+            epoch: "fixture-epoch".into(),
+            revision: "1".into(),
+        }),
+        cwd: app.config.cwd.clone(),
+        approval_policy: api::AskForApproval::OnRequest,
+        approvals_reviewer: api::ApprovalsReviewer::User,
+        sandbox_policy: api::SandboxPolicy::ReadOnly {
+            network_access: false,
+        },
+        active_permission_profile: Some(api::ActivePermissionProfile::read_only()),
+        model: "applied-model".into(),
+        model_provider: "openai".into(),
+        service_tier: None,
+        effort: collaboration.settings.reasoning_effort.clone(),
+        summary: None,
+        collaboration_mode: collaboration,
+        multi_agent_mode: Default::default(),
+        personality: None,
+    };
+    let security = api::ThreadSettingsResolvedSecurity {
+        approval_policy: settings.approval_policy.clone(),
+        approvals_reviewer: settings.approvals_reviewer,
+        sandbox_policy: settings.sandbox_policy.clone(),
+        permission_profile: PermissionProfile::read_only(),
+        active_permission_profile: settings.active_permission_profile.clone(),
+    };
+    let requests = Arc::new(std::sync::Mutex::new(Vec::<Value>::new()));
+    let observed = requests.clone();
+    let phase = Arc::new(std::sync::Mutex::new("pending".to_string()));
+    let server_phase = phase.clone();
+    let rejection_code = Arc::new(std::sync::Mutex::new(None::<String>));
+    let server_rejection = rejection_code.clone();
+    let pending_turn = Arc::new(std::sync::Mutex::new(None::<Value>));
+    let server_pending_turn = pending_turn.clone();
+    let applied = settings.clone();
+    let resolved = security.clone();
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await?;
+    let address = listener.local_addr()?;
+    let task = tokio::spawn(async move {
+        let (socket, _) = listener.accept().await.unwrap();
+        let mut socket = tokio_tungstenite::accept_async(socket).await.unwrap();
+        while let Some(Ok(Message::Text(text))) = socket.next().await {
+            let request: Value = serde_json::from_str(&text).unwrap();
+            let Some(id) = request.get("id").cloned() else {
+                continue;
+            };
+            let method = request["method"].as_str().unwrap();
+            let result = match method {
+                "initialize" => {
+                    json!({"userAgent":"codex/0.153.4", "cantripManagedGateway":{"version":1,"threadId":thread_id.to_string(),"replyMethod":"cantrip/managed/reply"}})
+                }
+                "thread/settings/update" => {
+                    json!({"operationId":request["params"]["operationId"],"submissionId":"permission-submission","admission":"queued","resolvedSecurity":resolved})
+                }
+                "thread/settings/operation/read" => {
+                    let phase = server_phase.lock().unwrap().clone();
+                    json!({"threadId":thread_id.to_string(),"operationId":request["params"]["operationId"],"submissionId":"permission-submission","phase":phase,"resolvedSecurity":resolved,"threadSettings":if phase == "applied" { Some(&applied) } else { None },"rejection":if phase == "rejected" { Some("forced policy changed") } else { None }})
+                }
+                "thread/settings/read" => {
+                    let mut current = applied.clone();
+                    current.model = "newer-current-model".into();
+                    current.settings_version.as_mut().unwrap().revision = "2".into();
+                    current.collaboration_mode.settings.model = current.model.clone();
+                    json!({"threadId":thread_id.to_string(),"threadSettings":current})
+                }
+                _ => json!({}),
+            };
+            let rejection = server_rejection.lock().unwrap().clone();
+            let pending_turn = server_pending_turn.lock().unwrap().clone();
+            let response = if method == "turn/start" && pending_turn.is_some() {
+                json!({"id":id,"error":{"code":-32001,"message":"PendingSettings: input not consumed","data":pending_turn}})
+            } else if method == "thread/settings/update" && rejection.is_some() {
+                json!({"id":id,"error":{"code":-32001,"message":"permission admission rejected","data":{"code":rejection,"status":409}}})
+            } else if fail_ack && method == "thread/settings/update" {
+                json!({"id":id,"error":{"code":-32603,"message":"reply lost after admission"}})
+            } else {
+                json!({"id":id,"result":result})
+            };
+            observed.lock().unwrap().push(request);
+            socket
+                .send(Message::Text(response.to_string().into()))
+                .await
+                .unwrap();
+        }
+    });
+    let remote = RemoteAppServerClient::connect(RemoteAppServerConnectArgs {
+        endpoint: RemoteAppServerEndpoint::WebSocket {
+            websocket_url: format!("ws://{address}"),
+            auth_token: None,
+        },
+        client_name: "managed-permission-test".into(),
+        client_version: "1".into(),
+        experimental_api: true,
+        mcp_server_openai_form_elicitation: false,
+        opt_out_notification_methods: vec![],
+        channel_capacity: 16,
+    })
+    .await?;
+    Ok((
+        AppServerSession::new(AppServerClient::Remote(remote), ThreadParamsMode::Remote),
+        Fixture {
+            requests,
+            phase,
+            rejection_code,
+            pending_turn,
+            task,
+            settings,
+            security,
+        },
+    ))
+}
