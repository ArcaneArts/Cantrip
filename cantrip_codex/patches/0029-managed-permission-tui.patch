+#[tokio::test]
+async fn managed_permissions_queued_shortcut_and_picker_wait_for_correlated_application()
+-> Result<()> {
+    for shortcut in [true, false] {
+        let (mut app, thread_id) = attached_app().await;
+        let original = RuntimePermissionProfileOverride::from_config(app.chat_widget.config_ref());
+        let (mut server, fixture) = managed_permissions_fixture(&app, thread_id, false).await?;
+        let mut tui = crate::tui::test_support::make_test_tui()?;
+        if shortcut {
+            app.apply_permission_shortcut(&mut server, &mut tui, thread_id, selection())
+                .await;
+        } else {
+            app.handle_event(
+                &mut tui,
+                &mut server,
+                AppEvent::SelectPermissionProfile(selection()),
+            )
+            .await?;
+        }
+        assert_eq!(app.pending_permission_changes.len(), 1);
+        assert_eq!(
+            RuntimePermissionProfileOverride::from_config(app.chat_widget.config_ref()),
+            original
+        );
+        assert!(app.runtime_permission_profile_override.is_none());
+        let id = operation_id(&fixture);
+        let requests = fixture.requests.lock().unwrap().clone();
+        let writes: Vec<_> = requests
+            .iter()
+            .filter(|r| r["method"] != "initialize")
+            .collect();
+        assert_eq!(
+            writes.len(),
+            1,
+            "queued admission must not trigger config writes or a second native override"
+        );
+        assert_eq!(writes[0]["params"]["applyAt"], "quiescent");
+        assert_eq!(writes[0]["params"]["permissions"], ":read-only");
+        assert!(!id.is_empty());
+        let mut update = api::ThreadSettingsUpdatedNotification {
+            operation_id: Some(id.clone()),
+            submission_id: Some("wrong-submission".into()),
+            resolved_security: Some(fixture.security.clone()),
+            thread_id: thread_id.to_string(),
+            thread_settings: fixture.settings.clone(),
+        };
+        app.observe_managed_permission_notification(
+            &server,
+            &api::ServerNotification::ThreadSettingsUpdated(update.clone()),
+        )
+        .await;
+        assert_eq!(
+            RuntimePermissionProfileOverride::from_config(app.chat_widget.config_ref()),
+            original
+        );
+        assert_eq!(app.pending_permission_changes.len(), 1);
+        update.submission_id = Some("permission-submission".into());
+        app.observe_managed_permission_notification(
+            &server,
+            &api::ServerNotification::ThreadSettingsUpdated(update.clone()),
+        )
+        .await;
+        assert!(app.pending_permission_changes.is_empty());
+        assert_eq!(
+            app.chat_widget
+                .config_ref()
+                .permissions
+                .active_permission_profile(),
+            Some(ActivePermissionProfile::new(":read-only"))
+        );
+        assert!(app.runtime_permission_profile_override.is_some());
+        // A duplicate applied notification is not another pending intent or write.
+        app.observe_managed_permission_notification(
+            &server,
+            &api::ServerNotification::ThreadSettingsUpdated(update),
+        )
+        .await;
+        assert!(app.pending_permission_changes.is_empty());
+        assert_eq!(
+            fixture
+                .requests
+                .lock()
+                .unwrap()
+                .iter()
+                .filter(|r| r["method"] == "thread/settings/update")
+                .count(),
+            1
+        );
+        server.shutdown().await?;
+        fixture.task.await?;
+    }
+    Ok(())
+}
