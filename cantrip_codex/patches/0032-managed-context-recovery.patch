+fn context_only_checkpoint_preserves_legacy_default_and_round_trips() -> Result<()> {
+    let legacy = json!({ "message": "checkpoint", "replacement_history": [] });
+    let mut item: CompactedItem = serde_json::from_value(legacy)?;
+    assert!(!item.context_reset);
+    assert!(serde_json::to_value(&item)?.get("context_reset").is_none());
+    item.context_reset = true;
+    let encoded = serde_json::to_value(&item)?;
+    assert_eq!(encoded["context_reset"], json!(true));
+    let decoded: CompactedItem = serde_json::from_value(encoded)?;
+    assert!(decoded.context_reset);
+    assert!(decoded.replacement_history.as_ref().unwrap().is_empty());
