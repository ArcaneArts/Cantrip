diff --git a/codex-rs/core/src/session/managed_context.rs b/codex-rs/core/src/session/managed_context.rs
new file mode 100644
index 0000000..be6cf38
--- /dev/null
+++ b/codex-rs/core/src/session/managed_context.rs
@@ -0,0 +1,78 @@
+//! Explicit idle recovery of rejected model context. Durable presentation history
+//! remains append-only; no synthetic turn, settings change or queue mutation occurs.
+use super::*;
+
+impl Session {
+    pub(crate) async fn reset_managed_model_context(
+        &self,
+        expected_last_turn_id: Option<&str>,
+    ) -> CodexResult<()> {
+        // Hold the actual turn lock through persistence and replacement so another
+        // native input source cannot start using the old context during the reset.
+        let active = self.active_turn.lock().await;
+        if active.is_some() {
+            return Err(CodexErr::InvalidRequest(
+                "cannot reset model context during an active turn".to_string(),
+            ));
+        }
+        let live = self
+            .live_thread_for_persistence("reset model context")
+            .map_err(|err| CodexErr::Io(std::io::Error::other(err)))?;
+        live.flush()
+            .await
+            .map_err(|err| CodexErr::Io(std::io::Error::other(err)))?;
+        let last_turn = live
+            .last_recorded_turn_id(true)
+            .await
+            .map_err(|err| CodexErr::Io(std::io::Error::other(err)))?;
+        if last_turn.as_deref() != expected_last_turn_id {
+            return Err(CodexErr::InvalidRequest(
+                "model context recovery targets a stale native turn".to_string(),
+            ));
+        }
+        let _settings_guard = thread_settings::acquire_persistence_lock(self).await;
+        let settings = thread_settings::applied_event(self).await;
+        let mut state = self.state.lock().await;
+        let previous_ids = state.auto_compact_window_ids();
+        let number = state
+            .auto_compact_window_number()
+            .checked_add(1)
+            .ok_or_else(|| {
+                CodexErr::InvalidRequest("context window counter exhausted".to_string())
+            })?;
+        let ids = AutoCompactWindowIds {
+            first_window_id: previous_ids.first_window_id,
+            previous_window_id: Some(previous_ids.window_id),
+            window_id: Uuid::now_v7(),
+        };
+        let mut retained_history = state.clone_history();
+        retained_history.replace_compacted(Vec::new());
+        let checkpoint = CompactedItem {
+            context_reset: true,
+            message: "Managed model context recovery".to_string(),
+            replacement_history: Some(Vec::new()),
+            guardian_history: retained_history.guardian_history_checkpoint(),
+            mcp_resource_origins: None,
+            window_number: Some(number),
+            first_window_id: Some(ids.first_window_id.to_string()),
+            previous_window_id: ids.previous_window_id.map(|id| id.to_string()),
+            window_id: Some(ids.window_id.to_string()),
+            compaction_response_id: None,
+            latest_token_usage_record: state.latest_token_usage_record.clone(),
+        };
+        // Unlike best-effort activity logging, recovery requires actual append and
+        // flush success before changing the live context or acknowledging success.
+        live.append_items(&[
+            RolloutItem::Compacted(checkpoint),
+            RolloutItem::EventMsg(settings),
+        ])
+        .await
+        .map_err(|err| CodexErr::Io(std::io::Error::other(err)))?;
+        live.flush()
+            .await
+            .map_err(|err| CodexErr::Io(std::io::Error::other(err)))?;
+        state.replace_annotated_history(Vec::new(), None, HistoryReplacement::Compaction);
+        state.restore_auto_compact_window(number, ids);
+        Ok(())
+    }
+}
diff --git a/codex-rs/core/src/session/managed_context_tests.rs b/codex-rs/core/src/session/managed_context_tests.rs
new file mode 100644
index 0000000..ab6a047
--- /dev/null
+++ b/codex-rs/core/src/session/managed_context_tests.rs
@@ -0,0 +1,97 @@
+use super::*;
+use codex_protocol::protocol::TurnStartedEvent;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn managed_context_reset_preserves_history_and_requires_current_idle_boundary() {
+    for mode in [
+        codex_protocol::protocol::ThreadHistoryMode::Legacy,
+        codex_protocol::protocol::ThreadHistoryMode::Paginated,
+    ] {
+        let (mut session, _) = make_session_and_context().await;
+        let config = session.get_config().await;
+        let state_db = codex_state::StateRuntime::init(
+            config.sqlite.clone(),
+            config.model_provider_id.clone(),
+        )
+        .await
+        .unwrap();
+        session.services.thread_store = Arc::new(LocalThreadStore::new(
+            codex_thread_store::LocalThreadStoreConfig::from_config(config.as_ref()),
+            Some(state_db),
+        ));
+        let path = open_thread_persistence_with_mode(&mut session, mode).await;
+        session
+            .replace_history(vec![user_message("old model context")], None)
+            .await;
+        session
+            .send_event_raw(Event {
+                id: "last-turn".into(),
+                msg: EventMsg::TurnStarted(TurnStartedEvent {
+                    initial_settings: None,
+                    turn_id: "last-turn".into(),
+                    canonical_items: true,
+                    trace_id: None,
+                    started_at: None,
+                    model_context_window: None,
+                    collaboration_mode_kind: Default::default(),
+                }),
+            })
+            .await;
+        session.flush_rollout().await.unwrap();
+        let original = session.clone_history().await;
+        let retained_authorization = original.clone().into_raw_items();
+        assert!(
+            session
+                .reset_managed_model_context(Some("stale-turn"))
+                .await
+                .is_err()
+        );
+        assert_eq!(
+            session.clone_history().await.into_raw_items(),
+            original.into_raw_items()
+        );
+        *session.active_turn.lock().await = Some(crate::state::ActiveTurn::default());
+        assert!(
+            session
+                .reset_managed_model_context(Some("last-turn"))
+                .await
+                .is_err()
+        );
+        *session.active_turn.lock().await = None;
+        let before = RolloutRecorder::load_rollout_items(&path).await.unwrap().0;
+        session
+            .reset_managed_model_context(Some("last-turn"))
+            .await
+            .unwrap();
+        let recovered = session.clone_history().await;
+        assert_eq!(
+            recovered.guardian_history_checkpoint().unwrap().0,
+            retained_authorization
+        );
+        assert!(recovered.into_raw_items().is_empty());
+        let after = RolloutRecorder::load_rollout_items(&path).await.unwrap().0;
+        assert_eq!(
+            serde_json::to_value(&after[..before.len()]).unwrap(),
+            serde_json::to_value(&before).unwrap()
+        );
+        assert!(after.iter().any(|item| matches!(item, RolloutItem::Compacted(c) if c.context_reset && c.replacement_history.as_ref().is_some_and(Vec::is_empty) && c.guardian_history.as_ref().is_some_and(|history| history.0 == retained_authorization))));
+        assert!(after.iter().any(|item| matches!(item, RolloutItem::EventMsg(EventMsg::TurnStarted(t)) if t.turn_id == "last-turn")));
+    }
+}
+
+#[tokio::test]
+async fn managed_context_reset_keeps_live_context_on_actual_persistence_failure() {
+    let (mut session, _) = make_session_and_context().await;
+    open_thread_persistence(&mut session).await;
+    session
+        .replace_history(vec![user_message("retained on failure")], None)
+        .await;
+    let before = session.clone_history().await;
+    session.live_thread().unwrap().shutdown().await.unwrap();
+    assert!(session.reset_managed_model_context(None).await.is_err());
+    assert_eq!(
+        session.clone_history().await.into_raw_items(),
+        before.into_raw_items()
+    );
+}
