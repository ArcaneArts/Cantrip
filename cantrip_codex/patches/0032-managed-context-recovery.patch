@@ -0,0 +1,97 @@
+use super::*;
+use codex_protocol::protocol::TurnStartedEvent;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn managed_context_reset_preserves_history_and_requires_current_idle_boundary() {
+    for mode in [
+        codex_protocol::protocol::ThreadHistoryMode::Legacy,
+        codex_protocol::protocol::ThreadHistoryMode::Paginated,
+    ] {
+        let (mut session, _) = make_session_and_context().await;
+        let config = session.get_config().await;
+        let state_db = codex_state::StateRuntime::init(
+            config.sqlite.clone(),
+            config.model_provider_id.clone(),
+        )
+        .await
+        .unwrap();
+        session.services.thread_store = Arc::new(LocalThreadStore::new(
+            codex_thread_store::LocalThreadStoreConfig::from_config(config.as_ref()),
+            Some(state_db),
+        ));
+        let path = open_thread_persistence_with_mode(&mut session, mode).await;
+        session
+            .replace_history(vec![user_message("old model context")], None)
+            .await;
+        session
+            .send_event_raw(Event {
+                id: "last-turn".into(),
+                msg: EventMsg::TurnStarted(TurnStartedEvent {
+                    initial_settings: None,
+                    turn_id: "last-turn".into(),
+                    canonical_items: true,
+                    trace_id: None,
+                    started_at: None,
+                    model_context_window: None,
+                    collaboration_mode_kind: Default::default(),
+                }),
+            })
+            .await;
+        session.flush_rollout().await.unwrap();
+        let original = session.clone_history().await;
+        let retained_authorization = original.clone().into_raw_items();
+        assert!(
+            session
+                .reset_managed_model_context(Some("stale-turn"))
+                .await
+                .is_err()
+        );
+        assert_eq!(
+            session.clone_history().await.into_raw_items(),
+            original.into_raw_items()
+        );
+        *session.active_turn.lock().await = Some(crate::state::ActiveTurn::default());
+        assert!(
+            session
+                .reset_managed_model_context(Some("last-turn"))
+                .await
+                .is_err()
+        );
+        *session.active_turn.lock().await = None;
+        let before = RolloutRecorder::load_rollout_items(&path).await.unwrap().0;
+        session
+            .reset_managed_model_context(Some("last-turn"))
+            .await
+            .unwrap();
+        let recovered = session.clone_history().await;
+        assert_eq!(
+            recovered.guardian_history_checkpoint().unwrap().0,
+            retained_authorization
+        );
+        assert!(recovered.into_raw_items().is_empty());
+        let after = RolloutRecorder::load_rollout_items(&path).await.unwrap().0;
+        assert_eq!(
+            serde_json::to_value(&after[..before.len()]).unwrap(),
+            serde_json::to_value(&before).unwrap()
+        );
+        assert!(after.iter().any(|item| matches!(item, RolloutItem::Compacted(c) if c.context_reset && c.replacement_history.as_ref().is_some_and(Vec::is_empty) && c.guardian_history.as_ref().is_some_and(|history| history.0 == retained_authorization))));
+        assert!(after.iter().any(|item| matches!(item, RolloutItem::EventMsg(EventMsg::TurnStarted(t)) if t.turn_id == "last-turn")));
+    }
+}
+
+#[tokio::test]
+async fn managed_context_reset_keeps_live_context_on_actual_persistence_failure() {
+    let (mut session, _) = make_session_and_context().await;
+    open_thread_persistence(&mut session).await;
+    session
+        .replace_history(vec![user_message("retained on failure")], None)
+        .await;
+    let before = session.clone_history().await;
+    session.live_thread().unwrap().shutdown().await.unwrap();
+    assert!(session.reset_managed_model_context(None).await.is_err());
+    assert_eq!(
+        session.clone_history().await.into_raw_items(),
+        before.into_raw_items()
+    );
+}
