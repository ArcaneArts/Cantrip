diff --git a/codex-rs/core/src/session/managed_context.rs b/codex-rs/core/src/session/managed_context.rs
new file mode 100644
index 0000000000000000000000000000000000000000..be6cf3828a4c40d3c79dc414e119a1a026900b5f
--- /dev/null
+++ b/codex-rs/core/src/session/managed_context.rs
@@ -0,0 +1,78 @@
+//! Explicit idle recovery of rejected model context. Durable presentation history
+//! remains append-only; no synthetic turn, settings change or queue mutation occurs.
+use super::*;
+
+impl Session {
+    pub(crate) async fn reset_managed_model_context(
+        &self,
+        expected_last_turn_id: Option<&str>,
+    ) -> CodexResult<()> {
+        // Hold the actual turn lock through persistence and replacement so another
+        // native input source cannot start using the old context during the reset.
+        let active = self.active_turn.lock().await;
+        if active.is_some() {
+            return Err(CodexErr::InvalidRequest(
+                "cannot reset model context during an active turn".to_string(),
+            ));
+        }
+        let live = self
+            .live_thread_for_persistence("reset model context")
+            .map_err(|err| CodexErr::Io(std::io::Error::other(err)))?;
+        live.flush()
+            .await
+            .map_err(|err| CodexErr::Io(std::io::Error::other(err)))?;
+        let last_turn = live
+            .last_recorded_turn_id(true)
+            .await
+            .map_err(|err| CodexErr::Io(std::io::Error::other(err)))?;
+        if last_turn.as_deref() != expected_last_turn_id {
+            return Err(CodexErr::InvalidRequest(
+                "model context recovery targets a stale native turn".to_string(),
+            ));
+        }
+        let _settings_guard = thread_settings::acquire_persistence_lock(self).await;
+        let settings = thread_settings::applied_event(self).await;
+        let mut state = self.state.lock().await;
+        let previous_ids = state.auto_compact_window_ids();
+        let number = state
+            .auto_compact_window_number()
+            .checked_add(1)
+            .ok_or_else(|| {
+                CodexErr::InvalidRequest("context window counter exhausted".to_string())
+            })?;
+        let ids = AutoCompactWindowIds {
+            first_window_id: previous_ids.first_window_id,
+            previous_window_id: Some(previous_ids.window_id),
+            window_id: Uuid::now_v7(),
+        };
+        let mut retained_history = state.clone_history();
+        retained_history.replace_compacted(Vec::new());
+        let checkpoint = CompactedItem {
+            context_reset: true,
+            message: "Managed model context recovery".to_string(),
+            replacement_history: Some(Vec::new()),
+            guardian_history: retained_history.guardian_history_checkpoint(),
+            mcp_resource_origins: None,
+            window_number: Some(number),
+            first_window_id: Some(ids.first_window_id.to_string()),
+            previous_window_id: ids.previous_window_id.map(|id| id.to_string()),
+            window_id: Some(ids.window_id.to_string()),
+            compaction_response_id: None,
+            latest_token_usage_record: state.latest_token_usage_record.clone(),
+        };
+        // Unlike best-effort activity logging, recovery requires actual append and
+        // flush success before changing the live context or acknowledging success.
+        live.append_items(&[
+            RolloutItem::Compacted(checkpoint),
+            RolloutItem::EventMsg(settings),
+        ])
+        .await
+        .map_err(|err| CodexErr::Io(std::io::Error::other(err)))?;
+        live.flush()
+            .await
+            .map_err(|err| CodexErr::Io(std::io::Error::other(err)))?;
+        state.replace_annotated_history(Vec::new(), None, HistoryReplacement::Compaction);
+        state.restore_auto_compact_window(number, ids);
+        Ok(())
+    }
+}
