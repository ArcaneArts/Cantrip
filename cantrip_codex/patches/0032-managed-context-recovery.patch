+    /// Read the current durable turn boundary using the thread's storage format.
+    /// Paginated threads deliberately reject the legacy full-history API.
+    pub async fn last_recorded_turn_id(
+        &self,
+        include_archived: bool,
+    ) -> ThreadStoreResult<Option<String>> {
+        if self.history_mode == ThreadHistoryMode::Paginated {
+            let page = self
+                .thread_store
+                .list_turns(crate::ListTurnsParams {
+                    thread_id: self.thread_id,
+                    include_archived,
+                    cursor: None,
+                    page_size: 1,
+                    sort_direction: crate::SortDirection::Desc,
+                    items_view: crate::StoredTurnItemsView::NotLoaded,
+                })
+                .await?;
+            return Ok(page.turns.into_iter().next().map(|turn| turn.turn_id));
+        }
+        let history = self.load_history(include_archived).await?;
+        Ok(history.items.into_iter().rev().find_map(|item| match item {
+            RolloutItem::EventMsg(codex_protocol::protocol::EventMsg::TurnStarted(turn)) => {
+                Some(turn.turn_id)
+            }
+            _ => None,
+        }))
+    }
