+use crate::JsonSchema;
+use crate::TS;
+use serde::{Deserialize, Serialize};
+
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+#[ts(export_to = "v2/")]
+pub struct ManagedExecutionGateConfig {
+    pub runner_generation: String,
+}
+
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+#[ts(export_to = "v2/")]
+pub struct ManagedExecutionBindParams {
+    pub thread_id: String,
+    pub runner_generation: String,
+    #[serde(deserialize_with = "Option::deserialize")]
+    #[schemars(
+        required,
+        schema_with = "crate::protocol::serde_helpers::nullable_string_schema"
+    )]
+    #[ts(type = "string | null")]
+    pub expected_runner_generation: Option<String>,
+}
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+#[ts(export_to = "v2/")]
+pub struct ManagedExecutionResolveParams {
+    pub thread_id: String,
+    pub runner_generation: String,
+    pub attempt_id: String,
+    #[serde(deserialize_with = "Option::deserialize")]
+    #[schemars(
+        required,
+        schema_with = "crate::protocol::serde_helpers::nullable_string_schema"
+    )]
+    #[ts(type = "string | null")]
+    pub operation_generation: Option<String>,
+    pub allow: bool,
+}
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+#[ts(export_to = "v2/")]
+pub struct ManagedExecutionInvalidateParams {
+    pub thread_id: String,
+    pub runner_generation: String,
+}
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ManagedExecutionBindResponse {
+    pub bound: bool,
+}
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ManagedExecutionResolveResponse {
+    pub accepted: bool,
+}
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ManagedExecutionInvalidateResponse {
+    pub invalidated: bool,
+}
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ManagedExecutionRequestedNotification {
+    pub thread_id: String,
+    pub runner_generation: String,
+    pub attempt_id: String,
+    pub turn_id: String,
+    pub trigger: String,
+    #[ts(type = "JsonValue")]
+    pub input: serde_json::Value,
+}
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, JsonSchema, TS)]
+#[serde(rename_all = "camelCase")]
+#[ts(export_to = "v2/")]
+pub struct ManagedExecutionDeclinedNotification {
+    pub thread_id: String,
+    pub runner_generation: String,
+    pub attempt_id: String,
+    pub turn_id: String,
+    pub operation_generation: Option<String>,
+    pub reason: String,
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+    #[test]
+    fn managed_execution_protocol_requires_explicit_nullable_generation_and_rejects_unknown_fields()
+    {
+        let valid = json!({"threadId":"thread","runnerGeneration":"runner","attemptId":"attempt","operationGeneration":null,"allow":false});
+        assert!(serde_json::from_value::<ManagedExecutionResolveParams>(valid.clone()).is_ok());
+        let mut missing = valid.clone();
+        missing
+            .as_object_mut()
+            .unwrap()
+            .remove("operationGeneration");
+        assert!(serde_json::from_value::<ManagedExecutionResolveParams>(missing).is_err());
+        let mut unknown = valid;
+        unknown["ownerConnectionId"] = json!(1);
+        assert!(serde_json::from_value::<ManagedExecutionResolveParams>(unknown).is_err());
+        let schema =
+            serde_json::to_value(schemars::schema_for!(ManagedExecutionResolveParams)).unwrap();
+        assert!(
+            schema["required"]
+                .as_array()
+                .unwrap()
+                .contains(&json!("operationGeneration"))
+        );
+        assert!(
+            serde_json::from_value::<ManagedExecutionBindParams>(
+                json!({"threadId":"thread","runnerGeneration":"new"})
+            )
+            .is_err()
+        );
+    }
+}
