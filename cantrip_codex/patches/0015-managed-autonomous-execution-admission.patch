diff --git a/codex-rs/app-server/src/request_processors/managed_execution.rs b/codex-rs/app-server/src/request_processors/managed_execution.rs
new file mode 100644
index 0000000..7d300af
--- /dev/null
+++ b/codex-rs/app-server/src/request_processors/managed_execution.rs
@@ -0,0 +1,264 @@
+use super::*;
+use codex_app_server_protocol::{
+    ManagedExecutionBindParams, ManagedExecutionBindResponse, ManagedExecutionDeclinedNotification,
+    ManagedExecutionInvalidateParams, ManagedExecutionInvalidateResponse,
+    ManagedExecutionRequestedNotification, ManagedExecutionResolveParams,
+    ManagedExecutionResolveResponse, ServerNotification,
+};
+use codex_core::managed_execution::{ManagedExecutionEvent, ManagedExecutionGate};
+
+impl OutgoingMessageSender {
+    pub(crate) fn create_managed_execution_gate(
+        self: &Arc<Self>,
+        owner: crate::outgoing_message::ConnectionId,
+        generation: String,
+    ) -> Result<Arc<ManagedExecutionGate>, JSONRPCErrorError> {
+        if generation.trim().is_empty() {
+            return Err(invalid_params(
+                "managed runner generation must not be empty",
+            ));
+        }
+        let mut gates = self
+            .managed_execution_gates
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if let Some((existing_owner, gate)) = gates.get(&generation) {
+            if *existing_owner != owner {
+                return Err(invalid_params(
+                    "managed runner belongs to another connection",
+                ));
+            }
+            return Ok(gate.clone());
+        }
+        let (events, mut receiver) = tokio::sync::mpsc::unbounded_channel();
+        let gate = ManagedExecutionGate::new(generation.clone(), events);
+        gates.insert(generation, (owner, gate.clone()));
+        let outgoing = Arc::downgrade(self);
+        tokio::spawn(async move {
+            while let Some(event) = receiver.recv().await {
+                let notification = match event {
+                    ManagedExecutionEvent::Requested {
+                        thread_id,
+                        runner_generation,
+                        attempt_id,
+                        turn_id,
+                        trigger,
+                        input,
+                    } => ServerNotification::ManagedExecutionRequested(
+                        ManagedExecutionRequestedNotification {
+                            thread_id: thread_id.to_string(),
+                            runner_generation,
+                            attempt_id,
+                            turn_id,
+                            trigger,
+                            input,
+                        },
+                    ),
+                    ManagedExecutionEvent::Declined {
+                        thread_id,
+                        runner_generation,
+                        attempt_id,
+                        turn_id,
+                        operation_generation,
+                        reason,
+                    } => ServerNotification::ManagedExecutionDeclined(
+                        ManagedExecutionDeclinedNotification {
+                            thread_id: thread_id.to_string(),
+                            runner_generation,
+                            attempt_id,
+                            turn_id,
+                            operation_generation,
+                            reason,
+                        },
+                    ),
+                };
+                let Some(outgoing) = outgoing.upgrade() else {
+                    break;
+                };
+                outgoing
+                    .send_managed_execution_notification(owner, notification)
+                    .await;
+            }
+        });
+        Ok(gate)
+    }
+    pub(crate) fn check_managed_execution_owner(
+        &self,
+        generation: &str,
+        owner: crate::outgoing_message::ConnectionId,
+        allow_disconnected: bool,
+    ) -> Result<(), JSONRPCErrorError> {
+        let gates = self
+            .managed_execution_gates
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        match gates.get(generation) {
+            Some((existing_owner, _)) if *existing_owner == owner => Ok(()),
+            None if allow_disconnected => Ok(()),
+            _ => Err(invalid_params(
+                "managed runner belongs to another or disconnected connection",
+            )),
+        }
+    }
+}
+impl TurnRequestProcessor {
+    pub(crate) async fn managed_execution_bind(
+        &self,
+        request_id: &ConnectionRequestId,
+        params: ManagedExecutionBindParams,
+    ) -> Result<Option<ClientResponsePayload>, JSONRPCErrorError> {
+        let (_, thread) = self.load_thread(&params.thread_id).await?;
+        let previous = thread.managed_execution_gate().await;
+        if let Some(previous) = &previous {
+            if previous.runner_generation == params.runner_generation
+                && previous.is_same_rearm(&params.expected_runner_generation)
+            {
+                self.outgoing.check_managed_execution_owner(
+                    &previous.runner_generation,
+                    request_id.connection_id,
+                    false,
+                )?;
+                return Ok(Some(ManagedExecutionBindResponse { bound: true }.into()));
+            }
+        }
+        if previous
+            .as_ref()
+            .filter(|gate| !gate.is_inherited())
+            .map(|gate| gate.runner_generation.as_str())
+            != params.expected_runner_generation.as_deref()
+        {
+            return Err(invalid_params("managed runner generation changed"));
+        }
+        if let Some(previous) = &previous {
+            if previous.runner_generation == params.runner_generation {
+                return Err(invalid_params("rearm requires fresh runner generation"));
+            }
+            self.outgoing.check_managed_execution_owner(
+                &previous.runner_generation,
+                request_id.connection_id,
+                true,
+            )?;
+        }
+        let gate = self
+            .outgoing
+            .create_managed_execution_gate(request_id.connection_id, params.runner_generation)?;
+        gate.record_rearm(params.expected_runner_generation.clone())
+            .map_err(invalid_params)?;
+        thread
+            .bind_managed_execution_gate(gate, params.expected_runner_generation.as_deref())
+            .await
+            .map_err(invalid_params)?;
+        Ok(Some(ManagedExecutionBindResponse { bound: true }.into()))
+    }
+    pub(crate) async fn managed_execution_resolve(
+        &self,
+        request_id: &ConnectionRequestId,
+        params: ManagedExecutionResolveParams,
+    ) -> Result<Option<ClientResponsePayload>, JSONRPCErrorError> {
+        let (thread_id, thread) = self.load_thread(&params.thread_id).await?;
+        let gate = thread
+            .managed_execution_gate()
+            .await
+            .ok_or_else(|| invalid_params("thread has no managed runner"))?;
+        if gate.runner_generation != params.runner_generation {
+            return Err(invalid_params("stale managed runner generation"));
+        }
+        self.outgoing.check_managed_execution_owner(
+            &params.runner_generation,
+            request_id.connection_id,
+            false,
+        )?;
+        gate.resolve(
+            thread_id,
+            &params.attempt_id,
+            params.operation_generation,
+            params.allow,
+        )
+        .map_err(invalid_params)?;
+        Ok(Some(
+            ManagedExecutionResolveResponse { accepted: true }.into(),
+        ))
+    }
+    pub(crate) async fn managed_execution_invalidate(
+        &self,
+        request_id: &ConnectionRequestId,
+        params: ManagedExecutionInvalidateParams,
+    ) -> Result<Option<ClientResponsePayload>, JSONRPCErrorError> {
+        let (_, thread) = self.load_thread(&params.thread_id).await?;
+        let gate = thread
+            .managed_execution_gate()
+            .await
+            .ok_or_else(|| invalid_params("thread has no managed runner"))?;
+        if gate.runner_generation != params.runner_generation {
+            return Err(invalid_params("stale managed runner generation"));
+        }
+        self.outgoing.check_managed_execution_owner(
+            &params.runner_generation,
+            request_id.connection_id,
+            false,
+        )?;
+        gate.invalidate();
+        Ok(Some(
+            ManagedExecutionInvalidateResponse { invalidated: true }.into(),
+        ))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::outgoing_message::{ConnectionId, OutgoingEnvelope};
+    #[tokio::test]
+    async fn managed_execution_owner_is_connection_scoped_and_disconnect_cancels_wait() {
+        let (outbound, mut messages) = tokio::sync::mpsc::channel(16);
+        let outgoing = Arc::new(OutgoingMessageSender::new(
+            outbound,
+            codex_analytics::AnalyticsEventsClient::disabled(),
+        ));
+        let gate = outgoing
+            .create_managed_execution_gate(ConnectionId(1), "runner".into())
+            .unwrap();
+        assert!(
+            outgoing
+                .create_managed_execution_gate(ConnectionId(2), "runner".into())
+                .is_err()
+        );
+        assert!(
+            outgoing
+                .check_managed_execution_owner("runner", ConnectionId(2), false)
+                .is_err()
+        );
+        let pending = {
+            let gate = gate.clone();
+            tokio::spawn(async move {
+                gate.request(
+                    ThreadId::new(),
+                    "turn".into(),
+                    "queue".into(),
+                    serde_json::json!({"private":"fixture"}),
+                )
+                .await
+            })
+        };
+        let notification = messages.recv().await.unwrap();
+        assert!(matches!(
+            notification,
+            OutgoingEnvelope::ToConnection {
+                connection_id: ConnectionId(1),
+                ..
+            }
+        ));
+        outgoing.invalidate_managed_execution_connection(ConnectionId(1));
+        assert!(pending.await.unwrap().is_err());
+        assert!(
+            outgoing
+                .check_managed_execution_owner("runner", ConnectionId(1), false)
+                .is_err()
+        );
+        assert!(
+            outgoing
+                .check_managed_execution_owner("runner", ConnectionId(2), true)
+                .is_ok()
+        );
+    }
+}
