+    config
+        .as_table_mut()
+        .unwrap()
+        .entry("features")
+        .or_insert_with(|| toml::Value::Table(Default::default()))
+        .as_table_mut()
+        .unwrap()
+        .insert("goals".into(), toml::Value::Boolean(true));
+    std::fs::write(config_path, toml::to_string(&config)?)?;
+    let mut app = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .without_managed_config()
+        .build_initialized()
+        .await?;
+    let thread = app.start_thread(serde_json::from_value(json!({"managedConfig":{
+        "mcpServers":{},"developerInstructions":null,"multiAgentEnabled":false,
+        "subagentModel":null,"subagentReasoningEffort":null,"executionGate":{"runnerGeneration":"goal-runner"}
+    }}))?).await?.thread;
+    let set = app
+        .send_raw_request(
+            "thread/goal/set",
+            Some(json!({"threadId":thread.id,"objective":"exact managed objective"})),
+        )
+        .await?;
+    let _: Value = timeout(READ_TIMEOUT, app.read_response(set)).await??;
+    let proposed: ManagedExecutionRequestedNotification = timeout(
+        READ_TIMEOUT,
+        app.read_notification("thread/managedExecution/requested"),
+    )
+    .await??;
+    assert_eq!(proposed.trigger, "goal");
+    assert_eq!(proposed.input["threadSettings"], json!({}));
+    assert!(
+        proposed.input["input"]["ResponseItem"]
+            .to_string()
+            .contains("exact managed objective")
+    );
+    assert!(server.received_requests().await.unwrap().is_empty());
+    let denied = app.send_raw_request("thread/managedExecution/resolve", Some(json!({"threadId":thread.id,"runnerGeneration":"goal-runner","attemptId":proposed.attempt_id,"operationGeneration":null,"allow":false}))).await?;
+    let _: Value = timeout(READ_TIMEOUT, app.read_response(denied)).await??;
+    let declined: ManagedExecutionDeclinedNotification = timeout(
+        READ_TIMEOUT,
+        app.read_notification("thread/managedExecution/declined"),
+    )
+    .await??;
+    assert_eq!(declined.turn_id, proposed.turn_id);
+    assert!(server.received_requests().await.unwrap().is_empty());
+    Ok(())
+}
