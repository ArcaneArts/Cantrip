+#[cfg(test)]
+mod inheritance_tests {
+    use super::*;
+    #[tokio::test]
+    async fn managed_execution_fork_gate_is_closed_and_never_invalidates_parent() {
+        let (events, mut received) = mpsc::unbounded_channel();
+        let parent = ManagedExecutionGate::new("parent".into(), events);
+        let parent_id = ThreadId::new();
+        parent.bind_thread(parent_id).unwrap();
+        let fork_id = ThreadId::new();
+        let fork = ManagedExecutionGate::inherited_closed(fork_id);
+        assert!(fork.is_inherited());
+        fork.invalidate();
+        assert!(
+            fork.request(
+                fork_id,
+                "fork-turn".into(),
+                "goal".into(),
+                serde_json::json!({})
+            )
+            .await
+            .is_err()
+        );
+        let pending = {
+            let parent = parent.clone();
+            tokio::spawn(async move {
+                parent
+                    .request(
+                        parent_id,
+                        "parent-turn".into(),
+                        "queue".into(),
+                        serde_json::json!({}),
+                    )
+                    .await
+            })
+        };
+        let ManagedExecutionEvent::Requested { attempt_id, .. } = received.recv().await.unwrap()
+        else {
+            panic!("expected parent request")
+        };
+        parent
+            .resolve(
+                parent_id,
+                &attempt_id,
+                Some("parent-operation".into()),
+                true,
+            )
+            .unwrap();
+        assert!(pending.await.unwrap().is_ok());
+        parent.consume("parent-turn").unwrap();
+    }
+}
