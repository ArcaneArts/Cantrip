+#[tokio::test]
+async fn managed_execution_queue_waits_for_owner_admission_and_requires_rearm() -> Result<()> {
+    use codex_app_server_protocol::{
+        ManagedExecutionDeclinedNotification, ManagedExecutionRequestedNotification,
+    };
+    let (mut app, _home, server) = queue_app(vec![create_final_assistant_message_sse_response(
+        "authorized queue",
+    )?])
+    .await?;
+    let thread = app.start_thread(serde_json::from_value(json!({"managedConfig":{
+        "mcpServers":{},"developerInstructions":null,"multiAgentEnabled":false,
+        "subagentModel":null,"subagentReasoningEffort":null,"executionGate":{"runnerGeneration":"runner-one"}
+    }}))?).await?.thread;
+    let queued = app
+        .send_raw_request(
+            "thread/queue/add",
+            Some(serde_json::to_value(submission(
+                &thread.id,
+                "exact queued input",
+            ))?),
+        )
+        .await?;
+    let proposed: ManagedExecutionRequestedNotification = timeout(
+        READ_TIMEOUT,
+        app.read_notification("thread/managedExecution/requested"),
+    )
+    .await??;
+    assert_eq!(proposed.runner_generation, "runner-one");
+    assert_eq!(
+        proposed.input["input"]["UserInput"]["content"][0]["text"],
+        "exact queued input"
+    );
+    assert!(server.received_requests().await.unwrap().is_empty());
+    let invalidate = app
+        .send_raw_request(
+            "thread/managedExecution/invalidate",
+            Some(json!({"threadId":thread.id,"runnerGeneration":"runner-one"})),
+        )
+        .await?;
+    let _: Value = timeout(READ_TIMEOUT, app.read_response(invalidate)).await??;
+    let declined: ManagedExecutionDeclinedNotification = timeout(
+        READ_TIMEOUT,
+        app.read_notification("thread/managedExecution/declined"),
+    )
+    .await??;
+    assert_eq!(declined.attempt_id, proposed.attempt_id);
+    assert_eq!(declined.operation_generation, None);
+    // The queue RPC may report the failed wake, but the durable item is retained.
+    let _ = timeout(
+        READ_TIMEOUT,
+        app.read_response::<ThreadQueueAddResponse>(queued),
+    )
+    .await?;
+    let stale = app.send_raw_request("thread/managedExecution/resolve", Some(json!({"threadId":thread.id,"runnerGeneration":"runner-one","attemptId":proposed.attempt_id,"operationGeneration":"stale","allow":true}))).await?;
+    timeout(
+        READ_TIMEOUT,
+        app.read_stream_until_error_message(RequestId::Integer(stale)),
+    )
+    .await??;
+    let rearm = app.send_raw_request("thread/managedExecution/bind", Some(json!({"threadId":thread.id,"runnerGeneration":"runner-two","expectedRunnerGeneration":"runner-one"}))).await?;
+    let _: Value = timeout(READ_TIMEOUT, app.read_response(rearm)).await??;
+    let same_bind = app.send_raw_request("thread/managedExecution/bind", Some(json!({"threadId":thread.id,"runnerGeneration":"runner-two","expectedRunnerGeneration":"runner-one"}))).await?;
+    let _: Value = timeout(READ_TIMEOUT, app.read_response(same_bind)).await??;
+    let start = app
+        .send_raw_request("thread/queue/start", Some(json!({"threadId":thread.id})))
+        .await?;
+    let proposed: ManagedExecutionRequestedNotification = timeout(
+        READ_TIMEOUT,
+        app.read_notification("thread/managedExecution/requested"),
+    )
+    .await??;
+    assert_eq!(proposed.runner_generation, "runner-two");
+    let allowed = app.send_raw_request("thread/managedExecution/resolve", Some(json!({"threadId":thread.id,"runnerGeneration":"runner-two","attemptId":proposed.attempt_id,"operationGeneration":"operation-two","allow":true}))).await?;
+    let _: Value = timeout(READ_TIMEOUT, app.read_response(allowed)).await??;
+    let started: ThreadQueueStartResponse =
+        timeout(READ_TIMEOUT, app.read_response(start)).await??;
+    assert_eq!(started.turn.id, proposed.turn_id);
+    let completed: TurnCompletedNotification =
+        timeout(READ_TIMEOUT, app.read_notification("turn/completed")).await??;
+    assert_eq!(completed.turn.id, proposed.turn_id);
+    assert_eq!(server.received_requests().await.unwrap().len(), 1);
+    Ok(())
+}
