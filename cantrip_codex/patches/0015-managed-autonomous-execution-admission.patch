--- /dev/null
+++ b/codex-rs/core/src/managed_execution.rs
@@ -0,0 +1,433 @@
+//! In-memory eligibility and one-use admission for autonomous managed turns.
+//! Input is sent only to the connection owner and never logged or persisted here.
+use codex_protocol::ThreadId;
+use serde_json::Value;
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex};
+use tokio::sync::{mpsc, oneshot};
+
+#[derive(Clone)]
+pub enum ManagedExecutionEvent {
+    Requested {
+        thread_id: ThreadId,
+        runner_generation: String,
+        attempt_id: String,
+        turn_id: String,
+        trigger: String,
+        input: Value,
+    },
+    Declined {
+        thread_id: ThreadId,
+        runner_generation: String,
+        attempt_id: String,
+        turn_id: String,
+        operation_generation: Option<String>,
+        reason: String,
+    },
+}
+struct Attempt {
+    thread_id: ThreadId,
+    turn_id: String,
+    operation_generation: Option<String>,
+    reply: Option<oneshot::Sender<bool>>,
+    approved: bool,
+    consumed: bool,
+}
+#[derive(Default)]
+struct GateState {
+    closed: bool,
+    inherited: bool,
+    rearm_expected: Option<Option<String>>,
+    thread_id: Option<ThreadId>,
+    attempts: HashMap<String, Attempt>,
+}
+pub struct ManagedExecutionGate {
+    pub runner_generation: String,
+    state: Mutex<GateState>,
+    events: mpsc::UnboundedSender<ManagedExecutionEvent>,
+}
+impl std::fmt::Debug for ManagedExecutionGate {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("ManagedExecutionGate")
+            .field("runner_generation", &self.runner_generation)
+            .finish_non_exhaustive()
+    }
+}
+impl PartialEq for ManagedExecutionGate {
+    fn eq(&self, other: &Self) -> bool {
+        std::ptr::eq(self, other)
+    }
+}
+impl ManagedExecutionGate {
+    pub fn new(
+        runner_generation: String,
+        events: mpsc::UnboundedSender<ManagedExecutionEvent>,
+    ) -> Arc<Self> {
+        Arc::new(Self {
+            runner_generation,
+            state: Mutex::new(GateState::default()),
+            events,
+        })
+    }
+    /// Fork eligibility is independent and closed until its own worker adopts it.
+    pub fn inherited_closed(thread_id: ThreadId) -> Arc<Self> {
+        let (events, _) = mpsc::unbounded_channel();
+        Arc::new(Self {
+            runner_generation: format!("inherited:{thread_id}"),
+            state: Mutex::new(GateState {
+                closed: true,
+                inherited: true,
+                thread_id: Some(thread_id),
+                ..Default::default()
+            }),
+            events,
+        })
+    }
+    pub fn is_inherited(&self) -> bool {
+        self.state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .inherited
+    }
+    pub fn record_rearm(&self, expected: Option<String>) -> Result<(), String> {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if state
+            .rearm_expected
+            .as_ref()
+            .is_some_and(|previous| previous != &expected)
+        {
+            return Err("runner generation already used for another rearm".into());
+        }
+        state.rearm_expected = Some(expected);
+        Ok(())
+    }
+    pub fn is_same_rearm(&self, expected: &Option<String>) -> bool {
+        self.state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .rearm_expected
+            .as_ref()
+            == Some(expected)
+    }
+    pub fn bind_thread(&self, thread_id: ThreadId) -> Result<(), String> {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if state.thread_id.is_some_and(|id| id != thread_id) {
+            return Err("managed runner belongs to another thread".into());
+        }
+        state.thread_id = Some(thread_id);
+        Ok(())
+    }
+    pub async fn request(
+        &self,
+        thread_id: ThreadId,
+        turn_id: String,
+        trigger: String,
+        input: Value,
+    ) -> Result<String, String> {
+        self.bind_thread(thread_id)?;
+        let attempt_id = uuid::Uuid::new_v4().to_string();
+        let (reply, receive) = oneshot::channel();
+        {
+            let mut state = self
+                .state
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            if state.closed {
+                return Err("managed runner requires explicit rearm".into());
+            }
+            state.attempts.insert(
+                attempt_id.clone(),
+                Attempt {
+                    thread_id,
+                    turn_id: turn_id.clone(),
+                    operation_generation: None,
+                    reply: Some(reply),
+                    approved: false,
+                    consumed: false,
+                },
+            );
+        }
+        if self
+            .events
+            .send(ManagedExecutionEvent::Requested {
+                thread_id,
+                runner_generation: self.runner_generation.clone(),
+                attempt_id: attempt_id.clone(),
+                turn_id,
+                trigger,
+                input,
+            })
+            .is_err()
+        {
+            self.finish(&attempt_id, false, "managed owner disconnected");
+            return Err("managed owner disconnected".into());
+        }
+        if receive.await.unwrap_or(false) {
+            Ok(attempt_id)
+        } else {
+            self.finish(&attempt_id, false, "managed attempt denied or invalidated");
+            Err("managed attempt denied or invalidated".into())
+        }
+    }
+    pub fn resolve(
+        &self,
+        thread_id: ThreadId,
+        attempt_id: &str,
+        operation_generation: Option<String>,
+        allow: bool,
+    ) -> Result<(), String> {
+        if allow && operation_generation.as_deref().is_none_or(str::is_empty) {
+            return Err("allowed attempt requires operation generation".into());
+        }
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if state.closed {
+            return Err("managed runner invalidated".into());
+        }
+        let attempt = state
+            .attempts
+            .get_mut(attempt_id)
+            .ok_or("unknown managed attempt")?;
+        if attempt.thread_id != thread_id {
+            return Err("foreign managed attempt".into());
+        }
+        let reply = attempt
+            .reply
+            .take()
+            .ok_or("managed attempt already resolved")?;
+        attempt.operation_generation = operation_generation;
+        attempt.approved = allow;
+        if reply.send(allow).is_err() {
+            let attempt = state.attempts.remove(attempt_id);
+            drop(state);
+            if let Some(attempt) = attempt {
+                self.declined(
+                    attempt_id.to_string(),
+                    attempt,
+                    "managed attempt caller disconnected",
+                );
+            }
+            return Err("managed attempt no longer pending".into());
+        }
+        Ok(())
+    }
+    /// Synchronous commit point, called inside Core's ordered start decision before settings.
+    pub fn consume(&self, turn_id: &str) -> Result<(), String> {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if state.closed {
+            return Err("managed runner invalidated before start".into());
+        }
+        let attempt = state
+            .attempts
+            .values_mut()
+            .find(|attempt| attempt.turn_id == turn_id)
+            .ok_or("autonomous turn lacks managed admission")?;
+        if !attempt.approved || attempt.consumed {
+            return Err("managed admission unavailable or already consumed".into());
+        }
+        attempt.consumed = true;
+        Ok(())
+    }
+    pub fn finish(&self, attempt_id: &str, started: bool, reason: &str) {
+        let attempt = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .attempts
+            .remove(attempt_id);
+        if !started && let Some(attempt) = attempt {
+            self.declined(attempt_id.to_string(), attempt, reason);
+        }
+    }
+    fn declined(&self, attempt_id: String, attempt: Attempt, reason: &str) {
+        let _ = self.events.send(ManagedExecutionEvent::Declined {
+            thread_id: attempt.thread_id,
+            runner_generation: self.runner_generation.clone(),
+            attempt_id,
+            turn_id: attempt.turn_id,
+            operation_generation: attempt.operation_generation,
+            reason: reason.to_string(),
+        });
+        if let Some(reply) = attempt.reply {
+            let _ = reply.send(false);
+        }
+    }
+    pub fn invalidate(&self) {
+        let attempts = {
+            let mut state = self
+                .state
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            state.closed = true;
+            // A consumed ticket has already committed an admitted start in Core's ordered loop.
+            // Its actual turn terminal owns completion; Stop separately interrupts that turn.
+            let pending: Vec<_> = state
+                .attempts
+                .iter()
+                .filter(|(_, a)| !a.consumed)
+                .map(|(id, _)| id.clone())
+                .collect();
+            pending
+                .into_iter()
+                .filter_map(|id| state.attempts.remove(&id).map(|a| (id, a)))
+                .collect::<Vec<_>>()
+        };
+        for (id, attempt) in attempts {
+            self.declined(id, attempt, "managed runner invalidated");
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[tokio::test]
+    async fn managed_execution_ticket_is_one_use_and_invalidation_cannot_rearm() {
+        let (events, mut received) = mpsc::unbounded_channel();
+        let gate = ManagedExecutionGate::new("runner".into(), events);
+        let thread = ThreadId::new();
+        let pending = {
+            let gate = gate.clone();
+            tokio::spawn(async move {
+                gate.request(
+                    thread,
+                    "turn".into(),
+                    "queue".into(),
+                    serde_json::json!({"sensitive":"fixture"}),
+                )
+                .await
+            })
+        };
+        let ManagedExecutionEvent::Requested { attempt_id, .. } = received.recv().await.unwrap()
+        else {
+            panic!("expected request")
+        };
+        assert!(
+            gate.resolve(ThreadId::new(), &attempt_id, Some("operation".into()), true)
+                .is_err()
+        );
+        assert!(gate.resolve(thread, &attempt_id, None, true).is_err());
+        gate.resolve(thread, &attempt_id, Some("operation".into()), true)
+            .unwrap();
+        assert_eq!(pending.await.unwrap().unwrap(), attempt_id);
+        gate.consume("turn").unwrap();
+        assert!(gate.consume("turn").is_err());
+        gate.finish(&attempt_id, true, "");
+        gate.invalidate();
+        assert!(
+            gate.request(
+                thread,
+                "later".into(),
+                "queue".into(),
+                serde_json::json!({})
+            )
+            .await
+            .is_err()
+        );
+        assert!(received.try_recv().is_err());
+    }
+    #[tokio::test]
+    async fn managed_execution_pending_and_approved_tickets_decline_exactly_once() {
+        for approve in [false, true] {
+            let (events, mut received) = mpsc::unbounded_channel();
+            let gate = ManagedExecutionGate::new("runner".into(), events);
+            let thread = ThreadId::new();
+            let pending = {
+                let gate = gate.clone();
+                tokio::spawn(async move {
+                    gate.request(thread, "turn".into(), "goal".into(), serde_json::json!({}))
+                        .await
+                })
+            };
+            let ManagedExecutionEvent::Requested { attempt_id, .. } =
+                received.recv().await.unwrap()
+            else {
+                panic!("expected request")
+            };
+            if approve {
+                gate.resolve(thread, &attempt_id, Some("operation".into()), true)
+                    .unwrap();
+            }
+            gate.invalidate();
+            let _ = pending.await.unwrap();
+            assert!(gate.consume("turn").is_err());
+            gate.finish(&attempt_id, false, "late duplicate");
+            let ManagedExecutionEvent::Declined {
+                operation_generation,
+                ..
+            } = received.recv().await.unwrap()
+            else {
+                panic!("expected decline")
+            };
+            assert_eq!(
+                operation_generation,
+                approve.then(|| "operation".to_string())
+            );
+            assert!(received.try_recv().is_err());
+        }
+    }
+}
