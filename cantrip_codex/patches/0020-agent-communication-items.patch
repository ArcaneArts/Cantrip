+#[test]
+fn inter_agent_communication_items_preserve_identity_and_encrypted_payload_boundaries() {
+    use codex_protocol::items::InterAgentCommunicationItem;
+    use codex_protocol::protocol::InterAgentCommunication;
+    let author = codex_protocol::AgentPath::root();
+    let recipient = author.join("worker").unwrap();
+    for encrypted in [false, true] {
+        let communication = if encrypted {
+            InterAgentCommunication::new_encrypted(
+                author.clone(),
+                recipient.clone(),
+                vec![],
+                "ciphertext-only".into(),
+                true,
+            )
+        } else {
+            InterAgentCommunication::new(
+                author.clone(),
+                recipient.clone(),
+                vec![],
+                "exact child request\n".into(),
+                true,
+            )
+        };
+        let item = ThreadItem::from(TurnItem::InterAgentCommunication(
+            InterAgentCommunicationItem {
+                id: "communication-id".into(),
+                communication,
+            },
+        ));
+        let value = serde_json::to_value(&item).unwrap();
+        assert_eq!(value["type"], "interAgentCommunication");
+        assert_eq!(value["id"], "communication-id");
+        assert_eq!(value["author"], "/root");
+        assert_eq!(value["recipient"], "/root/worker");
+        assert_eq!(value["triggerTurn"], true);
+        if encrypted {
+            assert_eq!(value["text"], serde_json::Value::Null);
+            assert_eq!(value["encryptedContent"], "ciphertext-only");
+        } else {
+            assert_eq!(value["text"], "exact child request\n");
+            assert_eq!(value["encryptedContent"], serde_json::Value::Null);
+        }
+        assert_eq!(serde_json::from_value::<ThreadItem>(value).unwrap(), item);
+    }
+}
