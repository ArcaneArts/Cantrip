+#[cfg(test)]
+mod communication_tests {
+    use super::*;
+
+    #[test]
+    fn communication_transcripts_label_text_and_hide_opaque_payloads() {
+        let cwd = AbsolutePathBuf::try_from(std::env::current_dir().unwrap()).unwrap();
+        for encrypted in [false, true] {
+            let item = ThreadItem::InterAgentCommunication {
+                id: "communication".into(),
+                author: "/root".into(),
+                recipient: "/root/worker".into(),
+                other_recipients: vec!["/root/reviewer".into()],
+                text: Some("exact request".into()),
+                encrypted_content: encrypted.then(|| "ciphertext-only".into()),
+                trigger_turn: true,
+            };
+            let cells = thread_items_to_transcript_cells(
+                None,
+                &cwd,
+                vec![item],
+                RawReasoningVisibility::Hidden,
+                None,
+            );
+            assert_eq!(cells.len(), 1);
+            let text = cells[0]
+                .display_lines(120)
+                .iter()
+                .flat_map(|line| line.spans.iter().map(|span| span.content.as_ref()))
+                .collect::<String>();
+            assert!(text.contains("Agent task"));
+            assert!(text.contains("/root/reviewer"));
+            assert_eq!(text.contains("exact request"), !encrypted);
+            assert!(text.contains("/root/worker"));
+            assert!(!text.contains("ciphertext-only"));
+            assert!(text.contains(if encrypted {
+                "Encrypted agent message"
+            } else {
+                "exact request"
+            }));
+        }
+    }
+}
