+pub(crate) fn agent_communication_text(
+    author: &str,
+    recipient: &str,
+    other_recipients: &[String],
+    text: Option<&str>,
+    encrypted: bool,
+    trigger_turn: bool,
+) -> String {
+    let recipients = std::iter::once(recipient)
+        .chain(other_recipients.iter().map(String::as_str))
+        .collect::<Vec<_>>()
+        .join(", ");
+    let kind = if trigger_turn {
+        "Agent task"
+    } else {
+        "Agent message"
+    };
+    let content = if encrypted {
+        "Encrypted agent message; text unavailable."
+    } else {
+        text.unwrap_or("Agent message text unavailable.")
+    };
+    format!("{kind} · {author} → {recipients}\n{content}")
+}
