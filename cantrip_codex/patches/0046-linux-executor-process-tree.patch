 #[cfg(all(unix, not(target_os = "macos")))]
 /// Kill a specific process group ID (best-effort).
 pub fn kill_process_group(process_group_id: u32) -> io::Result<()> {
+    #[cfg(target_os = "linux")]
+    if std::env::var_os("CANTRIP_EXECUTOR_PROCESS_TREE").as_deref()
+        == Some(std::ffi::OsStr::new("1"))
+    {
+        // The optional CantripOS executor retains CAP_KILL; ordinary child
+        // commands still execute as the workspace account without that cap.
+        // Capture detached descendants before killing their original parents.
+        let tree = crate::linux_process_tree::kill(process_group_id);
+        let group = signal_process_group_id(process_group_id as libc::pid_t, libc::SIGKILL);
+        return tree.and(group.map(|_| ()));
+    }
     signal_process_group_id(process_group_id as libc::pid_t, libc::SIGKILL).map(|_| ())
 }
 
