+    pub(crate) async fn managed_execution_handoff(
+        &self,
+        request_id: &ConnectionRequestId,
+        params: codex_app_server_protocol::ManagedExecutionHandoffParams,
+    ) -> Result<Option<ClientResponsePayload>, JSONRPCErrorError> {
+        let gate = {
+            let gates = self
+                .outgoing
+                .managed_execution_gates
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            gates
+                .get(&params.runner_generation)
+                .and_then(|(owner, gate)| {
+                    (*owner == request_id.connection_id).then(|| gate.clone())
+                })
+                .ok_or_else(|| invalid_params("handoff has no current native gate owner"))?
+        };
+        let thread_id = codex_protocol::ThreadId::from_string(&params.thread_id)
+            .map_err(|_| invalid_params("invalid handoff thread id"))?;
+        let expected = params
+            .expected_revision
+            .as_deref()
+            .map(str::parse::<u64>)
+            .transpose()
+            .map_err(|_| invalid_params("invalid handoff revision"))?;
+        let (revision, held_by) = gate
+            .handoff_control(
+                thread_id,
+                &params.action,
+                params.operation_id.as_deref(),
+                expected,
+            )
+            .map_err(invalid_params)?;
+        if params.action == "release" && held_by.is_none() {
+            let (_, thread) = self.load_thread(&params.thread_id).await?;
+            thread.wake_managed_tree_after_handoff().await;
+        }
+        Ok(Some(
+            codex_app_server_protocol::ManagedExecutionHandoffResponse {
+                revision: revision.to_string(),
+                held_by,
+            }
+            .into(),
+        ))
+    }
