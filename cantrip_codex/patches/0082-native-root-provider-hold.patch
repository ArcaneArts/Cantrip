+    pub fn seal_handoff_export(&self, thread_id: ThreadId) -> Result<(), String> {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if state.thread_id != Some(thread_id) || state.inherited {
+            return Err("history export targets another native root".into());
+        }
+        if state.handoff_operation.is_some() {
+            state.handoff_export_sealed = true;
+        }
+        Ok(())
+    }
+
+    pub fn handoff_export_sealed(&self) -> bool {
+        self.state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .handoff_export_sealed
+    }
