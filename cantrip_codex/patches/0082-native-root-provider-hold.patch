+    /// A root producer hold leaves child inference and live task settlement
+    /// intact. Its monotonic revision fences delayed holds after cancellation.
+    pub fn handoff_control(
+        &self,
+        thread_id: ThreadId,
+        action: &str,
+        operation: Option<&str>,
+        expected: Option<u64>,
+    ) -> Result<(u64, Option<String>), String> {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if state.thread_id != Some(thread_id) || state.inherited {
+            return Err("handoff targets another native root".into());
+        }
+        if action == "read" {
+            return Ok((state.handoff_revision, state.handoff_operation.clone()));
+        }
+        let operation = operation
+            .filter(|id| !id.is_empty() && id.len() <= 255)
+            .ok_or("handoff requires an operation identity")?;
+        let expected = expected.ok_or("handoff requires its observed revision")?;
+        match action {
+            "hold" => {
+                if state.handoff_operation.as_deref() == Some(operation) {
+                    return Ok((state.handoff_revision, state.handoff_operation.clone()));
+                }
+                if state.closed
+                    || state.handoff_operation.is_some()
+                    || state.handoff_revision != expected
+                {
+                    return Err("native root handoff ownership changed".into());
+                }
+                let next = state
+                    .handoff_revision
+                    .checked_add(1)
+                    .ok_or("handoff revision exhausted")?;
+                state.handoff_operation = Some(operation.to_owned());
+                state.handoff_export_sealed = false;
+                state.handoff_revision = next;
+            }
+            "release" => {
+                if state
+                    .handoff_operation
+                    .as_deref()
+                    .is_some_and(|id| id != operation)
+                {
+                    return Err("another handoff holds this native root".into());
+                }
+                if state.handoff_operation.is_some() {
+                    if state.handoff_revision != expected {
+                        return Err("native handoff revision changed".into());
+                    }
+                    let next = state
+                        .handoff_revision
+                        .checked_add(1)
+                        .ok_or("handoff revision exhausted")?;
+                    state.handoff_operation = None;
+                    state.handoff_export_sealed = false;
+                    state.handoff_revision = next;
+                } else if state.handoff_revision == expected {
+                    // A hold request may still be in flight. Retire its exact
+                    // revision even when it has not acquired this hold yet.
+                    state.handoff_revision = state
+                        .handoff_revision
+                        .checked_add(1)
+                        .ok_or("handoff revision exhausted")?;
+                } else if state.handoff_revision < expected {
+                    return Err("native handoff revision is from another lifetime".into());
+                }
+            }
+            _ => return Err("unknown native handoff action".into()),
+        }
+        Ok((state.handoff_revision, state.handoff_operation.clone()))
+    }
