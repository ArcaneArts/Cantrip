+
+#[tokio::test]
+async fn committed_start_retains_initial_settings_after_thread_and_step_change() {
+    use codex_protocol::config_types::ModeKind;
+    use codex_protocol::openai_models::ReasoningEffort;
+    let (mut session, mut context) = make_session_and_context().await;
+    let store = attach_in_memory_thread_store(&mut session).await;
+    let mut selected = context.initial_settings.selected().clone();
+    selected.collaboration_mode.settings.model = "initial-model".into();
+    selected.collaboration_mode.settings.reasoning_effort = None;
+    selected.collaboration_mode.mode = ModeKind::Plan;
+    selected.service_tier = Some("fast".into());
+    let mut model = (*context.initial_settings.model_info).clone();
+    model.slug = "initial-model".into();
+    model.default_reasoning_level = Some(ReasoningEffort::High);
+    context.initial_settings = Arc::new(ResolvedStepSettings::new(
+        Arc::new(selected.clone()),
+        Arc::new(model.clone()),
+        false,
+    ));
+    Arc::make_mut(&mut context.config).model_provider_id = "initial-provider".into();
+    // A newer thread selection and a newer live step are not the captured start.
+    selected.collaboration_mode.settings.model = "later-model".into();
+    selected.collaboration_mode.mode = ModeKind::Default;
+    selected.collaboration_mode.settings.reasoning_effort = Some(ReasoningEffort::Low);
+    selected.service_tier = None;
+    model.slug = "later-model".into();
+    context
+        .current_settings
+        .store(Arc::new(ResolvedStepSettings::new(
+            Arc::new(selected.clone()),
+            Arc::new(model),
+            false,
+        )));
+    session
+        .state
+        .lock()
+        .await
+        .session_configuration
+        .step_settings = Arc::new(selected);
+    session
+        .send_event(
+            &context,
+            EventMsg::TurnStarted(TurnStartedEvent {
+                initial_settings: None,
+                canonical_items: false,
+                turn_id: context.sub_id.clone(),
+                trace_id: None,
+                started_at: None,
+                model_context_window: None,
+                collaboration_mode_kind: ModeKind::Plan,
+            }),
+        )
+        .await;
+    let history = store
+        .load_history(LoadThreadHistoryParams {
+            thread_id: session.thread_id,
+            include_archived: true,
+        })
+        .await
+        .unwrap();
+    let initial = history
+        .items
+        .iter()
+        .find_map(|record| match record {
+            RolloutItem::EventMsg(EventMsg::TurnStarted(start)) => start.initial_settings.as_ref(),
+            _ => None,
+        })
+        .expect("real committed event retains initial capture");
+    assert_eq!(initial.model, "initial-model");
+    assert_eq!(initial.model_provider, "initial-provider");
+    assert_eq!(initial.reasoning_effort, None);
+    assert_eq!(
+        initial.effective_reasoning_effort,
+        Some(ReasoningEffort::High)
+    );
+    assert_eq!(initial.service_tier.as_deref(), Some("fast"));
+    assert_eq!(initial.effective_service_tier, None);
+    assert_eq!(initial.collaboration_mode, ModeKind::Plan);
+}
