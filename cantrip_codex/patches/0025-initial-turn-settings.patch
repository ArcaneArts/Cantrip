+#[cfg(test)]
+mod initial_settings_tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn initial_settings_are_exact_scoped_and_conflicts_do_not_guess() {
+        let mut thread: Thread = serde_json::from_value(json!({
+            "id":"thread", "sessionId":"thread", "preview":"", "ephemeral":false,
+            "modelProvider":"later-provider", "createdAt":1, "updatedAt":1,
+            "status":{"type":"idle"}, "cwd":"/tmp", "cliVersion":"test", "source":"cli",
+            "turns":[{"id":"one","items":[],"status":"completed","error":null},
+                {"id":"two","items":[],"status":"completed","error":null}]
+        }))
+        .unwrap();
+        let event: EventMsg = serde_json::from_value(json!({
+            "type":"turn_started", "turn_id":"one", "model_context_window":null,
+            "initial_settings": {"model":"initial", "modelProvider":"provider",
+                "reasoningEffort":null, "effectiveReasoningEffort":"high",
+                "serviceTier":"default", "effectiveServiceTier":null, "collaborationMode":"plan"}
+        }))
+        .unwrap();
+        let records = vec![RolloutItem::EventMsg(event.clone())];
+        let metadata = build_history_metadata(&thread, &records, None, false);
+        let initial = metadata.turns[0].initial_settings.as_ref().unwrap();
+        assert_eq!(initial.model, "initial");
+        assert_eq!(initial.model_provider, "provider");
+        assert!(metadata.turns[1].initial_settings.is_none());
+        assert!(
+            serde_json::to_value(&metadata).unwrap()["turns"][1]
+                .get("initialSettings")
+                .is_none()
+        );
+        // JSON round trip represents cold storage and keeps selected/effective null distinction.
+        let restored: EventMsg =
+            serde_json::from_value(serde_json::to_value(&event).unwrap()).unwrap();
+        thread.model_provider = "another-current-provider".into();
+        assert_eq!(
+            build_history_metadata(&thread, &[RolloutItem::EventMsg(restored)], None, false).turns
+                [0]
+            .initial_settings,
+            metadata.turns[0].initial_settings
+        );
+        let mut canonical = event.clone();
+        let EventMsg::TurnStarted(start) = &mut canonical else {
+            unreachable!()
+        };
+        start.canonical_items = true;
+        let records = vec![RolloutItem::CanonicalHistory {
+            turn_id: "one".into(),
+            sequence: 0,
+            event: canonical.clone(),
+        }];
+        assert_eq!(
+            build_history_metadata(&thread, &records, None, false).turns[0].initial_settings,
+            metadata.turns[0].initial_settings
+        );
+        // A copied mismatched canonical wrapper cannot attribute another turn's capture.
+        let records = vec![RolloutItem::CanonicalHistory {
+            turn_id: "two".into(),
+            sequence: 0,
+            event: canonical,
+        }];
+        assert!(
+            build_history_metadata(&thread, &records, None, false).turns[1]
+                .initial_settings
+                .is_none()
+        );
+        let mut conflicting = event.clone();
+        let EventMsg::TurnStarted(start) = &mut conflicting else {
+            unreachable!()
+        };
+        start.initial_settings.as_mut().unwrap().model = "conflicting".into();
+        let records = vec![
+            RolloutItem::EventMsg(event.clone()),
+            RolloutItem::EventMsg(conflicting),
+            RolloutItem::EventMsg(event),
+        ];
+        assert!(
+            build_history_metadata(&thread, &records, None, false).turns[0]
+                .initial_settings
+                .is_none()
+        );
+        assert_eq!(
+            build_history_metadata(&thread, &records, None, false).turns[0]
+                .initial_settings_conflict,
+            Some(true)
+        );
+    }
+}
