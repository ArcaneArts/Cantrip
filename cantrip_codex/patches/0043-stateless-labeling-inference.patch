diff --git a/codex-rs/core/src/cantrip_inference.rs b/codex-rs/core/src/cantrip_inference.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5bb73fa39e17f05c8139719ee2744aef34dcd242
--- /dev/null
+++ b/codex-rs/core/src/cantrip_inference.rs
@@ -0,0 +1,138 @@
+//! A single bounded model request, without a Codex thread, tools, or startup context.
+use crate::client::ModelClient;
+use crate::client_common::{Prompt, ResponseEvent};
+use crate::config::Config;
+use crate::responses_metadata::CodexResponsesMetadata;
+use codex_features::Feature;
+use codex_login::AuthManager;
+use codex_login::auth::AgentIdentityAuthPolicy;
+use codex_otel::SessionTelemetry;
+use codex_protocol::ThreadId;
+use codex_protocol::config_types::ReasoningSummary;
+use codex_protocol::models::{
+    BaseInstructions, ContentItem, ResponseItem, plaintext_agent_message_content,
+};
+use codex_protocol::openai_models::{ModelInfo, ReasoningEffort};
+use codex_protocol::protocol::SessionSource;
+use codex_rollout_trace::InferenceTraceContext;
+use futures::StreamExt;
+use std::sync::Arc;
+
+pub async fn infer(
+    config: &Config,
+    auth: Arc<AuthManager>,
+    model: &ModelInfo,
+    instructions: String,
+    input: String,
+    effort: Option<ReasoningEffort>,
+) -> anyhow::Result<String> {
+    // This ID only correlates the transport request. No thread or rollout is created.
+    let id = ThreadId::new();
+    let source = SessionSource::Custom("cantrip_labeling".into());
+    let client = ModelClient::new(
+        Some(auth),
+        if config.features.enabled(Feature::UseAgentIdentity) {
+            AgentIdentityAuthPolicy::ChatGptAuth
+        } else {
+            AgentIdentityAuthPolicy::JwtOnly
+        },
+        id,
+        config.model_provider.clone(),
+        source.clone(),
+        "cantrip".into(),
+        None,
+        false,
+        false,
+        config.features.enabled(Feature::EnableRequestCompression),
+        false,
+        None,
+        false,
+        None,
+        config.http_client_factory(),
+        config.workspace_routing_context(),
+        Vec::new(),
+    );
+    let prompt = Prompt {
+        base_instructions: BaseInstructions {
+            text: instructions,
+            provenance: None,
+        },
+        input: vec![ResponseItem::Message {
+            id: None,
+            role: "user".into(),
+            content: vec![ContentItem::InputText { text: input }],
+            phase: None,
+            internal_chat_message_metadata_passthrough: None,
+        }],
+        ..Default::default()
+    };
+    let telemetry = SessionTelemetry::new(
+        id,
+        &model.slug,
+        &model.slug,
+        None,
+        None,
+        None,
+        "cantrip".into(),
+        false,
+        "labeling".into(),
+        source,
+    );
+    let metadata =
+        CodexResponsesMetadata::new(String::new(), id.to_string(), id.to_string(), String::new());
+    let mut session = client.new_session();
+    let mut stream = session
+        .stream(
+            &prompt,
+            model,
+            &telemetry,
+            effort.or(config.model_reasoning_effort.clone()),
+            ReasoningSummary::None,
+            None,
+            &metadata,
+            &InferenceTraceContext::disabled(),
+        )
+        .await?;
+    let mut text = String::new();
+    let mut complete = false;
+    while let Some(event) = stream.next().await {
+        match event? {
+            ResponseEvent::OutputItemDone(ResponseItem::Message { role, content, .. })
+                if role == "assistant" =>
+            {
+                for item in content {
+                    if let ContentItem::OutputText { text: value } = item {
+                        text.push_str(&value);
+                        anyhow::ensure!(text.len() <= 4096, "Inference output exceeded its limit");
+                    }
+                }
+            }
+            ResponseEvent::OutputItemDone(ResponseItem::AgentMessage {
+                author,
+                recipient,
+                content,
+                ..
+            }) if author == "assistant" && recipient == "all" => {
+                if let Some(value) = plaintext_agent_message_content(&content) {
+                    text.push_str(&value);
+                    anyhow::ensure!(text.len() <= 4096, "Inference output exceeded its limit");
+                }
+            }
+            ResponseEvent::OutputItemDone(
+                ResponseItem::FunctionCall { .. } | ResponseItem::LocalShellCall { .. },
+            ) => {
+                anyhow::bail!("Tools are not available for stateless inference");
+            }
+            ResponseEvent::Completed { .. } => {
+                complete = true;
+                break;
+            }
+            _ => {}
+        }
+    }
+    anyhow::ensure!(
+        complete && !text.trim().is_empty(),
+        "Incomplete inference response"
+    );
+    Ok(text)
+}
