 impl CatalogRequestProcessor {
+    pub(crate) async fn cantrip_inference(
+        &self,
+        params: codex_app_server_protocol::CantripInferenceParams,
+    ) -> Result<Option<ClientResponsePayload>, JSONRPCErrorError> {
+        if params.model.is_empty()
+            || params.model.len() > 200
+            || params.input.trim().is_empty()
+            || params.input.len() > 24_000
+            || params.instructions.trim().is_empty()
+            || params.instructions.len() > 4096
+        {
+            return Err(invalid_params("Invalid bounded inference input"));
+        }
+        let config = self
+            .config_manager
+            .load_non_project_config()
+            .await
+            .map_err(|_| {
+                crate::error_code::internal_error("Inference configuration unavailable")
+            })?;
+        let model = self
+            .thread_manager
+            .get_models_manager()
+            .get_model_info(&params.model, &config.to_models_manager_config())
+            .await;
+        let request = codex_core::cantrip_inference::infer(
+            &config,
+            self.thread_manager.auth_manager(),
+            &model,
+            params.instructions,
+            params.input,
+            params.reasoning_effort,
+        );
+        let text = tokio::time::timeout(std::time::Duration::from_secs(25), request)
+            .await
+            .map_err(|_| crate::error_code::internal_error("Inference timed out"))?
+            .map_err(|_| crate::error_code::internal_error("Inference failed"))?;
+        Ok(Some(
+            codex_app_server_protocol::CantripInferenceResponse { text }.into(),
+        ))
+    }
