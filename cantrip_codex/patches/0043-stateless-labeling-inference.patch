+#[test]
+fn stateless_inference_is_exported_only_with_experimental_api() -> Result<()> {
+    let experimental = decode_precomputed_exports(true)?;
+    let stable = decode_precomputed_exports(false)?;
+    assert!(experimental.typescript["ClientRequest.ts"].contains("\"cantrip/inference\""));
+    assert!(!stable.typescript["ClientRequest.ts"].contains("\"cantrip/inference\""));
+    let params = &experimental.typescript["v2/CantripInferenceParams.ts"];
+    assert!(params.contains("instructions: string"));
+    assert!(params.contains("input: string"));
+    assert!(params.contains("reasoningEffort: ReasoningEffort | null"));
+    assert!(experimental.typescript["v2/CantripInferenceResponse.ts"].contains("text: string"));
+    assert!(experimental.json_schema["ClientRequest.json"].contains("cantrip/inference"));
+    assert!(!stable.json_schema["ClientRequest.json"].contains("cantrip/inference"));
+    Ok(())
+}
