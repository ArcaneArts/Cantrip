+++ b/codex-rs/tui/src/app/tests/managed_gateway_defaults.rs
@@ -0,0 +1,154 @@
+use super::*;
+use crate::app_server_session::ThreadParamsMode;
+use codex_app_server_client::AppServerClient;
+use codex_app_server_client::RemoteAppServerClient;
+use codex_app_server_client::RemoteAppServerConnectArgs;
+use codex_app_server_client::RemoteAppServerEndpoint;
+use futures::SinkExt;
+use futures::StreamExt;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use tokio_tungstenite::tungstenite::Message;
+
+#[tokio::test]
+async fn managed_gateway_picker_settings_keep_real_requests_without_implicit_default_writes()
+-> Result<()> {
+    for managed in [true, false] {
+        let mut app = make_test_app().await;
+        let thread_id = ThreadId::new();
+        app.active_thread_id = Some(thread_id);
+        app.primary_thread_id = Some(thread_id);
+        app.chat_widget
+            .handle_thread_session(test_thread_session(thread_id, app.config.cwd.to_path_buf()));
+        let requests = Arc::new(std::sync::Mutex::new(Vec::<serde_json::Value>::new()));
+        let observed = requests.clone();
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await?;
+        let address = listener.local_addr()?;
+        let server = tokio::spawn(async move {
+            let (socket, _) = listener.accept().await.unwrap();
+            let mut socket = tokio_tungstenite::accept_async(socket).await.unwrap();
+            while let Some(Ok(Message::Text(text))) = socket.next().await {
+                let request: serde_json::Value = serde_json::from_str(&text).unwrap();
+                let Some(id) = request.get("id").cloned() else {
+                    continue;
+                };
+                let method = request["method"].as_str().unwrap();
+                let mut result = match method {
+                    "initialize" => json!({"userAgent":"codex/0.153.4"}),
+                    "config/batchWrite" => {
+                        json!({"status":"ok","version":"1","filePath":"/fixture/config.toml","overriddenMetadata":null})
+                    }
+                    _ => json!({}),
+                };
+                if managed && method == "initialize" {
+                    result["cantripManagedGateway"] = json!({"version":1,"threadId":thread_id.to_string(),"replyMethod":"cantrip/managed/reply"});
+                }
+                let response = if method == "thread/settings/update"
+                    && request["params"]["model"] == "unsupported-fixture"
+                {
+                    json!({"id":id,"error":{"code":-32601,"message":"method not found"}})
+                } else {
+                    json!({"id":id,"result":result})
+                };
+                observed.lock().unwrap().push(request);
+                socket
+                    .send(Message::Text(response.to_string().into()))
+                    .await
+                    .unwrap();
+            }
+        });
+        let remote = RemoteAppServerClient::connect(RemoteAppServerConnectArgs {
+            endpoint: RemoteAppServerEndpoint::WebSocket {
+                websocket_url: format!("ws://{address}"),
+                auth_token: None,
+            },
+            client_name: "managed-default-test".into(),
+            client_version: "1".into(),
+            experimental_api: true,
+            mcp_server_openai_form_elicitation: false,
+            opt_out_notification_methods: vec![],
+            channel_capacity: 16,
+        })
+        .await?;
+        let mut app_server =
+            AppServerSession::new(AppServerClient::Remote(remote), ThreadParamsMode::Remote);
+        assert_eq!(
+            app_server.is_managed_gateway_thread(Some(thread_id)),
+            managed
+        );
+        assert!(!app_server.is_managed_gateway_thread(Some(ThreadId::new())));
+        let mut tui = crate::tui::test_support::make_test_tui()?;
+        for event in [
+            AppEvent::UpdateReasoningEffort(Some(ReasoningEffortConfig::Low)),
+            AppEvent::UpdatePlanModeReasoningEffort(Some(ReasoningEffortConfig::Low)),
+            AppEvent::PersistPlanModeReasoningEffort(Some(ReasoningEffortConfig::Low)),
+            AppEvent::CodexOp(AppCommand::override_turn_context(
+                None,
+                None,
+                Some(ApprovalsReviewer::User),
+                None,
+                None,
+                None,
+                None,
+                None,
+                None,
+                None,
+                None,
+                None,
+            )),
+            AppEvent::UpdateApprovalsReviewer(ApprovalsReviewer::User),
+            AppEvent::PersistModelSelection {
+                model: "gpt-test".into(),
+                effort: Some(ReasoningEffortConfig::Low),
+            },
+            AppEvent::PersistPersonalitySelection {
+                personality: Personality::Pragmatic,
+            },
+            AppEvent::PersistServiceTierSelection {
+                service_tier: Some("flex".into()),
+            },
+        ] {
+            app.handle_event(&mut tui, &mut app_server, event).await?;
+        }
+        let recorded = requests.lock().unwrap().clone();
+        assert!(
+            recorded
+                .iter()
+                .any(|request| request["method"] == "thread/settings/update")
+        );
+        assert!(recorded.iter().any(|request| {
+            request["method"] == "thread/settings/update"
+                && request["params"]["approvalsReviewer"] == "user"
+        }));
+        let default_writes = recorded
+            .iter()
+            .filter(|request| request["method"] == "config/batchWrite")
+            .count();
+        assert_eq!(default_writes, if managed { 0 } else { 5 });
+        assert_eq!(app.config.service_tier.as_deref(), Some("flex"));
+        // A negotiated managed gateway must surface rejected settings. Ordinary
+        // older remote servers retain their existing capability downgrade.
+        for _ in 0..2 {
+            let rejected = app_server
+                .thread_settings_update(serde_json::from_value(json!({
+                    "threadId": thread_id.to_string(), "model": "unsupported-fixture"
+                }))?)
+                .await;
+            if managed {
+                assert!(rejected.is_err());
+            } else {
+                assert!(!rejected?);
+            }
+        }
+        let unsupported_requests = requests
+            .lock()
+            .unwrap()
+            .iter()
+            .filter(|request| request["params"]["model"] == "unsupported-fixture")
+            .count();
+        assert_eq!(unsupported_requests, if managed { 2 } else { 1 });
+        app_server.shutdown().await?;
+        server.await?;
+    }
+    Ok(())
+}
