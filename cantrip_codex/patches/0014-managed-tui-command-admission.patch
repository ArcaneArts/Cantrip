diff --git a/codex-rs/app-server-client/src/managed_gateway_tests.rs b/codex-rs/app-server-client/src/managed_gateway_tests.rs
new file mode 100644
index 0000000..ee833fe
--- /dev/null
+++ b/codex-rs/app-server-client/src/managed_gateway_tests.rs
@@ -0,0 +1,150 @@
+use super::*;
+use tokio_tungstenite::tungstenite::protocol::Role;
+
+async fn fixture(managed: bool) -> RemoteAppServerClient {
+    let (client_io, server_io) = tokio::io::duplex(65536);
+    tokio::spawn(async move {
+        let mut server = WebSocketStream::from_raw_socket(server_io, Role::Server, None).await;
+        let init: JSONRPCRequest = match server.next().await.unwrap().unwrap() {
+            Message::Text(text) => serde_json::from_str(&text).unwrap(),
+            _ => panic!("expected initialization"),
+        };
+        let mut result = serde_json::json!({"userAgent":"codex/0.153.4", "codexHome":"/fixture"});
+        if managed {
+            result["cantripManagedGateway"] = serde_json::json!({
+                "version":1,"replyMethod":"cantrip/managed/reply","threadId":"bound-thread"
+            });
+        }
+        server
+            .send(Message::Text(
+                serde_json::to_string(&JSONRPCResponse {
+                    id: init.id,
+                    result,
+                })
+                .unwrap()
+                .into(),
+            ))
+            .await
+            .unwrap();
+        let _initialized = server.next().await.unwrap().unwrap();
+        for index in 0..4 {
+            let frame: JSONRPCMessage = match server.next().await.unwrap().unwrap() {
+                Message::Text(text) => serde_json::from_str(&text).unwrap(),
+                _ => panic!("expected reply"),
+            };
+            if managed {
+                let JSONRPCMessage::Request(request) = frame else {
+                    panic!("managed reply must request acknowledgment")
+                };
+                assert_eq!(request.method, "cantrip/managed/reply");
+                let params = request.params.unwrap();
+                assert_eq!(params["requestId"], serde_json::json!(index));
+                assert_eq!(params.get("error").is_some(), index == 1);
+                let response = if index == 2 {
+                    JSONRPCMessage::Error(JSONRPCError {
+                        id: request.id,
+                        error: JSONRPCErrorError {
+                            code: -32001,
+                            message: "stale operation generation".to_string(),
+                            data: None,
+                        },
+                    })
+                } else {
+                    JSONRPCMessage::Response(JSONRPCResponse {
+                        id: request.id,
+                        result: if index == 3 {
+                            serde_json::json!({"delivered":true})
+                        } else {
+                            serde_json::json!({"delivered":true,"operationGeneration":"fresh-generation"})
+                        },
+                    })
+                };
+                server
+                    .send(Message::Text(
+                        serde_json::to_string(&response).unwrap().into(),
+                    ))
+                    .await
+                    .unwrap();
+            } else {
+                assert!(matches!(
+                    frame,
+                    JSONRPCMessage::Response(_) | JSONRPCMessage::Error(_)
+                ));
+            }
+        }
+        let _ = server.next().await;
+    });
+    let stream = WebSocketStream::from_raw_socket(client_io, Role::Client, None).await;
+    RemoteAppServerClient::connect_with_stream(
+        16,
+        "ws://fixture".to_string(),
+        stream,
+        serde_json::from_value(serde_json::json!({"clientInfo":{"name":"test","version":"1"}}))
+            .unwrap(),
+    )
+    .await
+    .unwrap()
+}
+
+#[tokio::test]
+async fn managed_gateway_replies_wait_for_authorized_ack_and_surface_errors() {
+    let client = fixture(true).await;
+    assert_eq!(client.managed_gateway_thread_id(), Some("bound-thread"));
+    client
+        .resolve_server_request(
+            RequestId::Integer(0),
+            serde_json::json!({"decision":"accept"}),
+        )
+        .await
+        .unwrap();
+    client
+        .reject_server_request(
+            RequestId::Integer(1),
+            JSONRPCErrorError {
+                code: -1,
+                message: "declined".to_string(),
+                data: None,
+            },
+        )
+        .await
+        .unwrap();
+    let error = client
+        .resolve_server_request(RequestId::Integer(2), serde_json::json!({}))
+        .await
+        .unwrap_err();
+    assert!(error.to_string().contains("stale operation generation"));
+    let error = client
+        .resolve_server_request(RequestId::Integer(3), serde_json::json!({}))
+        .await
+        .unwrap_err();
+    assert_eq!(error.kind(), ErrorKind::InvalidData);
+    client.shutdown().await.unwrap();
+}
+
+#[tokio::test]
+async fn ordinary_remote_replies_keep_native_wire_without_managed_ack() {
+    let client = fixture(false).await;
+    assert_eq!(client.managed_gateway_thread_id(), None);
+    for id in 0..4 {
+        client
+            .resolve_server_request(RequestId::Integer(id), serde_json::json!({}))
+            .await
+            .unwrap();
+    }
+    client.shutdown().await.unwrap();
+}
+
+#[test]
+fn managed_gateway_capability_rejects_partial_or_unknown_contracts() {
+    assert_eq!(parse_managed_gateway(&serde_json::json!({})).unwrap(), None);
+    for capability in [
+        serde_json::json!({"version":2,"replyMethod":"cantrip/managed/reply","threadId":"thread"}),
+        serde_json::json!({"version":1,"replyMethod":"other","threadId":"thread"}),
+        serde_json::json!({"version":1,"replyMethod":"cantrip/managed/reply"}),
+    ] {
+        assert!(
+            parse_managed_gateway(&serde_json::json!({"cantripManagedGateway":capability}))
+                .is_err()
+        );
+    }
+}
