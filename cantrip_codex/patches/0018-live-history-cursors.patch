diff --git a/codex-rs/app-server/src/live_history.rs b/codex-rs/app-server/src/live_history.rs
new file mode 100644
index 0000000..6b25969
--- /dev/null
+++ b/codex-rs/app-server/src/live_history.rs
@@ -0,0 +1,323 @@
+//! Materialized public item notifications, independent of connected presentations.
+//! The epoch and item predecessor cursor describe transient ordering, never item identity
+//! or durable delivery. Only turns that actually opt into canonical history are retained.
+use codex_app_server_protocol::{
+    LiveHistoryCursor, LiveHistoryItem, LiveHistorySnapshot, ServerNotification,
+};
+use serde_json::{Map, Value, json};
+use std::collections::{BTreeMap, HashMap, HashSet};
+
+#[derive(Default)]
+pub(crate) struct LiveHistory {
+    threads: HashMap<String, ThreadHistory>,
+}
+struct ThreadHistory {
+    epoch: String,
+    sequence: u64,
+    turns: HashSet<String>,
+    items: BTreeMap<(String, String), LiveHistoryItem>,
+    order: Vec<(String, String)>,
+}
+impl LiveHistory {
+    pub(crate) fn reset(&mut self, thread_id: &str) {
+        self.threads.remove(thread_id);
+    }
+    pub(crate) fn start_turn(&mut self, thread_id: &str, turn_id: &str) {
+        self.threads
+            .entry(thread_id.into())
+            .or_insert_with(|| ThreadHistory {
+                epoch: uuid::Uuid::now_v7().to_string(),
+                sequence: 0,
+                turns: HashSet::new(),
+                items: BTreeMap::new(),
+                order: Vec::new(),
+            })
+            .turns
+            .insert(turn_id.into());
+    }
+    pub(crate) fn snapshot(&self, thread_id: &str) -> Option<LiveHistorySnapshot> {
+        let thread = self.threads.get(thread_id)?;
+        Some(LiveHistorySnapshot {
+            epoch: thread.epoch.clone(),
+            through_sequence: thread.sequence.to_string(),
+            items: thread
+                .order
+                .iter()
+                .filter_map(|key| thread.items.get(key).cloned())
+                .collect(),
+        })
+    }
+    pub(crate) fn observe(
+        &mut self,
+        notification: &ServerNotification,
+    ) -> Option<LiveHistoryCursor> {
+        let value = serde_json::to_value(notification).ok()?;
+        self.observe_value(&value)
+    }
+    fn observe_value(&mut self, value: &Value) -> Option<LiveHistoryCursor> {
+        let method = value.get("method")?.as_str()?;
+        if !matches!(
+            method,
+            "item/started"
+                | "item/completed"
+                | "item/agentMessage/delta"
+                | "item/commandExecution/outputDelta"
+                | "item/reasoning/summaryTextDelta"
+                | "item/reasoning/summaryPartAdded"
+                | "item/fileChange/patchUpdated"
+        ) {
+            return None;
+        }
+        let params = value.get("params")?;
+        let thread_id = params.get("threadId")?.as_str()?;
+        let turn_id = params.get("turnId")?.as_str()?;
+        let thread = self.threads.get_mut(thread_id)?;
+        if !thread.turns.contains(turn_id) {
+            return None;
+        }
+        let lifecycle = matches!(method, "item/started" | "item/completed");
+        let item_id = if lifecycle {
+            params.get("item")?.get("id")?
+        } else {
+            params.get("itemId")?
+        }
+        .as_str()?;
+        let key = (turn_id.to_owned(), item_id.to_owned());
+        let old = thread.items.get(&key);
+        // A missing start is not a complete stream base. Do not invent its prefix.
+        if !lifecycle && old.is_none() {
+            return None;
+        }
+        let sequence = thread.sequence.checked_add(1)?;
+        let cursor = LiveHistoryCursor {
+            epoch: thread.epoch.clone(),
+            sequence: sequence.to_string(),
+            previous_sequence: old.map(|item| item.cursor.sequence.clone()),
+        };
+        // Validate the actual delta shape before modifying the accumulated body.
+        if !lifecycle {
+            match method {
+                "item/fileChange/patchUpdated" => {
+                    params.get("changes")?.as_array()?;
+                }
+                "item/reasoning/summaryPartAdded" => {
+                    params.get("summaryIndex")?.as_u64()?;
+                }
+                "item/reasoning/summaryTextDelta" => {
+                    params.get("summaryIndex")?.as_u64()?;
+                    params.get("delta")?.as_str()?;
+                }
+                _ => {
+                    params.get("delta")?.as_str()?;
+                }
+            }
+        }
+        if old.is_none() {
+            thread.order.push(key.clone());
+        }
+        let next = thread.items.entry(key).or_insert_with(|| LiveHistoryItem {
+            turn_id: turn_id.into(),
+            item: params["item"].clone(),
+            state: "started".into(),
+            cursor: cursor.clone(),
+            started_at_ms: None,
+            completed_at_ms: None,
+        });
+        if lifecycle {
+            if method == "item/completed" {
+                next.item = params.get("item")?.clone();
+                next.state = "completed".into();
+            }
+            if next.started_at_ms.is_none() {
+                next.started_at_ms = params
+                    .get("startedAtMs")
+                    .and_then(Value::as_i64)
+                    .filter(|time| *time != 0);
+            }
+            if method == "item/completed" {
+                next.completed_at_ms = params
+                    .get("completedAtMs")
+                    .and_then(Value::as_i64)
+                    .filter(|time| *time != 0)
+                    .or(next.completed_at_ms);
+            }
+        } else if next.state != "completed" {
+            let body = next.item.as_object_mut()?;
+            match method {
+                "item/agentMessage/delta" => append(body, "text", params.get("delta")?.as_str()?),
+                "item/commandExecution/outputDelta" => {
+                    append(body, "aggregatedOutput", params.get("delta")?.as_str()?)
+                }
+                "item/fileChange/patchUpdated" => {
+                    let changes = params.get("changes")?.as_array()?;
+                    body.insert("changes".into(), Value::Array(changes.clone()));
+                }
+                _ => {
+                    let index = params.get("summaryIndex")?.as_u64()?.to_string();
+                    if !body.contains_key("summaryParts") {
+                        let parts: Map<String, Value> = body
+                            .get("summary")
+                            .and_then(Value::as_array)
+                            .into_iter()
+                            .flatten()
+                            .enumerate()
+                            .map(|(index, text)| (index.to_string(), text.clone()))
+                            .collect();
+                        body.insert("summaryParts".into(), Value::Object(parts));
+                    }
+                    let parts = body.get_mut("summaryParts")?.as_object_mut()?;
+                    if method == "item/reasoning/summaryTextDelta" {
+                        append(parts, &index, params.get("delta")?.as_str()?);
+                    } else {
+                        parts.entry(index).or_insert(json!(""));
+                    }
+                }
+            }
+        }
+        next.cursor = cursor.clone();
+        thread.sequence = sequence;
+        Some(cursor)
+    }
+}
+fn append(body: &mut Map<String, Value>, field: &str, delta: &str) {
+    let entry = body.entry(field.to_owned()).or_insert(json!(""));
+    if let Value::String(text) = entry {
+        text.push_str(delta);
+    } else {
+        *entry = json!(delta);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn input(method: &str, extra: Value) -> Value {
+        let mut params = json!({"threadId":"thread", "turnId":"turn"});
+        params
+            .as_object_mut()
+            .unwrap()
+            .extend(extra.as_object().unwrap().clone());
+        json!({"method": method, "params": params})
+    }
+    #[test]
+    fn reconnect_snapshot_has_exact_prefix_and_predecessor_without_retaining_delta_frames() {
+        let mut history = LiveHistory::default();
+        let start = input(
+            "item/started",
+            json!({"item":{"id":"answer","type":"agentMessage","text":""}}),
+        );
+        assert!(history.observe_value(&start).is_none());
+        history.start_turn("thread", "turn");
+        let first = history.observe_value(&start).unwrap();
+        let delta = input(
+            "item/agentMessage/delta",
+            json!({"itemId":"answer", "delta":"α🎹"}),
+        );
+        let second = history.observe_value(&delta).unwrap();
+        assert_eq!(second.previous_sequence.as_ref(), Some(&first.sequence));
+        let snapshot = history.snapshot("thread").unwrap();
+        assert_eq!(snapshot.items.len(), 1);
+        assert_eq!(snapshot.items[0].item["text"], "α🎹");
+        assert_eq!(snapshot.items[0].cursor, second);
+        let third = history.observe_value(&delta).unwrap();
+        assert_eq!(third.previous_sequence.as_ref(), Some(&second.sequence));
+        assert_eq!(snapshot.items[0].item["text"], "α🎹");
+        assert_eq!(
+            history.snapshot("thread").unwrap().items[0].item["text"],
+            "α🎹α🎹"
+        );
+        assert!(history.snapshot("other").is_none());
+    }
+    #[test]
+    fn creation_order_and_reset_follow_native_observation_not_item_names_or_late_updates() {
+        let mut history = LiveHistory::default();
+        history.start_turn("thread", "turn");
+        for id in ["z-first", "a-second"] {
+            history
+                .observe_value(&input(
+                    "item/started",
+                    json!({"item":{"id":id,"type":"agentMessage","text":""},"startedAtMs":0}),
+                ))
+                .unwrap();
+        }
+        history
+            .observe_value(&input(
+                "item/agentMessage/delta",
+                json!({"itemId":"z-first","delta":"later"}),
+            ))
+            .unwrap();
+        let snapshot = history.snapshot("thread").unwrap();
+        assert_eq!(
+            snapshot
+                .items
+                .iter()
+                .map(|item| item.item["id"].as_str().unwrap())
+                .collect::<Vec<_>>(),
+            vec!["z-first", "a-second"]
+        );
+        assert_eq!(snapshot.items[0].item["text"], "later");
+        assert_eq!(snapshot.items[0].started_at_ms, None);
+        history.reset("thread");
+        assert!(history.snapshot("thread").is_none());
+        assert!(
+            history
+                .observe_value(&input(
+                    "item/agentMessage/delta",
+                    json!({"itemId":"z-first","delta":"old"})
+                ))
+                .is_none()
+        );
+        history.start_turn("thread", "replacement");
+        let replacement = history.snapshot("thread").unwrap();
+        assert_ne!(snapshot.epoch, replacement.epoch);
+        assert!(replacement.items.is_empty());
+    }
+    #[test]
+    fn completion_survives_late_start_and_delta_and_sparse_summary_does_not_allocate_a_vector() {
+        let mut history = LiveHistory::default();
+        history.start_turn("thread", "turn");
+        history
+            .observe_value(&input(
+                "item/started",
+                json!({"item":{"id":"reason", "type":"reasoning", "summary":[]}}),
+            ))
+            .unwrap();
+        history
+            .observe_value(&input(
+                "item/reasoning/summaryTextDelta",
+                json!({"itemId":"reason", "summaryIndex":1000000000u64, "delta":"summary"}),
+            ))
+            .unwrap();
+        assert_eq!(
+            history.snapshot("thread").unwrap().items[0].item["summaryParts"]["1000000000"],
+            "summary"
+        );
+        let completed = json!({"id":"reason", "type":"reasoning", "summary":["done"]});
+        history
+            .observe_value(&input("item/completed", json!({"item":completed})))
+            .unwrap();
+        history
+            .observe_value(&input(
+                "item/started",
+                json!({"item":{"id":"reason","type":"reasoning","summary":[]}}),
+            ))
+            .unwrap();
+        history
+            .observe_value(&input(
+                "item/reasoning/summaryTextDelta",
+                json!({"itemId":"reason", "summaryIndex":0, "delta":"late"}),
+            ))
+            .unwrap();
+        let snapshot = history.snapshot("thread").unwrap();
+        assert_eq!(snapshot.items[0].item, completed);
+        assert_eq!(snapshot.items[0].state, "completed");
+        assert!(
+            history
+                .observe_value(&input(
+                    "item/agentMessage/delta",
+                    json!({"itemId":"missing","delta":"tail"})
+                ))
+                .is_none()
+        );
+    }
+}
