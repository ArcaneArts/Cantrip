+#[test]
+fn full_restore_accepts_only_latest_owned_snapshot_not_foreign_or_ownerless_history() {
+    use super::latest_owned_thread_settings;
+    use super::latest_persisted_resume_settings_for_owner;
+    let owner = codex_protocol::ThreadId::new();
+    let foreign = codex_protocol::ThreadId::new();
+    let owned = full_snapshot();
+    let mut other = owned.clone();
+    other.model = "must-not-restore".to_string();
+    let item = |thread_id, snapshot| {
+        RolloutItem::EventMsg(EventMsg::ThreadSettingsApplied(
+            ThreadSettingsAppliedEvent {
+                thread_id,
+                thread_settings: snapshot,
+            },
+        ))
+    };
+    let foreign_history = vec![
+        item(Some(foreign), other.clone()),
+        item(None, other.clone()),
+    ];
+    assert!(latest_owned_thread_settings(&foreign_history, owner).is_none());
+    assert!(latest_persisted_resume_settings_for_owner(&foreign_history, Some(owner)).is_none());
+    let mut history = vec![item(Some(owner), owned.clone())];
+    history.extend(foreign_history);
+    // A frozen turn-context following a root settings update does not replace it.
+    history.push(turn_context_item(
+        "frozen",
+        AskForApproval::Never,
+        None,
+        None,
+    ));
+    assert_eq!(latest_owned_thread_settings(&history, owner), Some(&owned));
+    let mut latest = owned.clone();
+    latest.service_tier = None;
+    history.push(item(Some(owner), latest.clone()));
+    assert_eq!(latest_owned_thread_settings(&history, owner), Some(&latest));
+}
