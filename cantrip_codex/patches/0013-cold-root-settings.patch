+#[tokio::test]
+async fn cold_collaboration_mode_is_scoped_to_matching_root_resume() {
+    let owner = ThreadId::new();
+    let other = ThreadId::new();
+    let mut config = test_config().await;
+    config.model_reasoning_effort = Some(ReasoningEffortConfig::Low);
+    let plan = CollaborationMode {
+        mode: ModeKind::Plan,
+        settings: Settings {
+            model: "old-model".to_string(),
+            reasoning_effort: Some(ReasoningEffortConfig::High),
+            developer_instructions: Some("preserved plan instructions".to_string()),
+        },
+    };
+    config.resumed_collaboration_mode = Some((owner, plan.clone()));
+    let resumed = |conversation_id| {
+        InitialHistory::Resumed(ResumedHistory {
+            conversation_id,
+            history: Arc::new(Vec::new()),
+            rollout_path: None,
+        })
+    };
+    let restored = initial_collaboration_mode(
+        &config,
+        &resumed(owner),
+        &SessionSource::Exec,
+        "caller-model",
+    );
+    assert_eq!(restored.mode, ModeKind::Plan);
+    assert_eq!(
+        restored.settings.developer_instructions,
+        plan.settings.developer_instructions
+    );
+    assert_eq!(restored.settings.model, "caller-model");
+    assert_eq!(
+        restored.settings.reasoning_effort,
+        Some(ReasoningEffortConfig::Low)
+    );
+    for history in [
+        InitialHistory::New,
+        InitialHistory::Cleared,
+        InitialHistory::Forked(Vec::new()),
+        resumed(other),
+    ] {
+        let mode =
+            initial_collaboration_mode(&config, &history, &SessionSource::Exec, "child-model");
+        assert_eq!(mode.mode, ModeKind::Default);
+        assert_eq!(mode.settings.developer_instructions, None);
+    }
+    let child_source = SessionSource::SubAgent(SubAgentSource::Other("child".to_string()));
+    let mode = initial_collaboration_mode(&config, &resumed(owner), &child_source, "child-model");
+    assert_eq!(mode.mode, ModeKind::Default);
+    assert_eq!(mode.settings.developer_instructions, None);
+}
+
+#[tokio::test]
+async fn cold_selected_service_tier_is_owned_and_independent_of_request_support() {
+    let owner = ThreadId::new();
+    let mut config = test_config().await;
+    config.service_tier = None;
+    // Tier ownership does not depend on a collaboration-mode restoration marker.
+    config.resumed_collaboration_mode = None;
+    let model = model_with_default_service_tier(None);
+    let resumed = |conversation_id| {
+        InitialHistory::Resumed(ResumedHistory {
+            conversation_id,
+            history: Arc::new(Vec::new()),
+            rollout_path: None,
+        })
+    };
+    for selected in [None, Some("default"), Some("flex"), Some("priority")] {
+        let selected = selected.map(str::to_string);
+        config.resumed_service_tier = Some((owner, selected.clone()));
+        for fast_mode_enabled in [false, true] {
+            let restored = initial_service_tier(
+                &config,
+                &resumed(owner),
+                &SessionSource::Exec,
+                fast_mode_enabled,
+                &model,
+            );
+            assert_eq!(restored, selected);
+            let settings = Arc::new(StepSettings {
+                collaboration_mode: initial_collaboration_mode(
+                    &config,
+                    &resumed(owner),
+                    &SessionSource::Exec,
+                    "gpt-5.4",
+                ),
+                reasoning_summary: None,
+                service_tier: restored,
+                personality: None,
+                approval_policy: codex_config::Constrained::allow_any(AskForApproval::Never),
+                approvals_reviewer: ApprovalsReviewer::User,
+            });
+            let resolved =
+                ResolvedStepSettings::new(settings, Arc::new(model.clone()), fast_mode_enabled);
+            let expected_request = if fast_mode_enabled && selected.as_deref() != Some("flex") {
+                selected.clone()
+            } else {
+                None
+            };
+            assert_eq!(resolved.service_tier, expected_request);
+        }
+        for history in [
+            InitialHistory::New,
+            InitialHistory::Cleared,
+            InitialHistory::Forked(Vec::new()),
+            resumed(ThreadId::new()),
+        ] {
+            assert_eq!(
+                initial_service_tier(&config, &history, &SessionSource::Exec, true, &model),
+                None
+            );
+        }
+        assert_eq!(
+            initial_service_tier(
+                &config,
+                &resumed(owner),
+                &SessionSource::SubAgent(SubAgentSource::Other("child".to_string())),
+                true,
+                &model
+            ),
+            None
+        );
+    }
+}
