+/// The post-load portion preserves explicit null/default choices that cannot be
+/// represented by inserting an omitted TOML value into config overrides.
+pub(super) struct OwnedResumeSettings {
+    owner: codex_protocol::ThreadId,
+    snapshot: codex_protocol::protocol::ThreadSettingsSnapshot,
+    selected_service_tier: Option<String>,
+    restore_effort: bool,
+    restore_summary: bool,
+    restore_personality: bool,
+    restore_permissions: bool,
+}
+
+pub(super) fn merge_owned_resume_settings(
+    owner: codex_protocol::ThreadId,
+    snapshot: &codex_protocol::protocol::ThreadSettingsSnapshot,
+    request: &mut Option<std::collections::HashMap<String, serde_json::Value>>,
+    overrides: &mut codex_core::config::ConfigOverrides,
+) -> OwnedResumeSettings {
+    let contains = |key: &str| {
+        request
+            .as_ref()
+            .is_some_and(|values| values.contains_key(key))
+    };
+    // Preserve the selected value before config loading filters unsupported Fast
+    // selections. Explicit null chooses the default request tier; a saved None
+    // remains unset. Typed caller overrides take precedence over raw config.
+    let requested_service_tier = overrides.service_tier.clone().or_else(|| {
+        request
+            .as_ref()?
+            .get("service_tier")
+            .and_then(|value| serde_json::from_value::<Option<String>>(value.clone()).ok())
+    });
+    let selected_service_tier = match requested_service_tier {
+        Some(tier) => Some(tier.unwrap_or_else(|| {
+            codex_protocol::config_types::SERVICE_TIER_DEFAULT_REQUEST_VALUE.to_string()
+        })),
+        None => snapshot.service_tier.clone(),
+    }
+    .map(|tier| {
+        codex_protocol::config_types::ServiceTier::from_request_value(&tier)
+            .map_or(tier, |tier| tier.request_value().to_string())
+    });
+    let restore_effort = !contains("model_reasoning_effort");
+    let restore_summary = !contains("model_reasoning_summary");
+    let restore_personality = overrides.personality.is_none() && !contains("personality");
+    let permission_config_override = request.as_ref().is_some_and(|values| {
+        values.keys().any(|key| {
+            key == "permissions"
+                || key.starts_with("permissions.")
+                || key == "sandbox_workspace_write"
+                || key.starts_with("sandbox_workspace_write.")
+        })
+    });
+    let restore_permissions = overrides.sandbox_mode.is_none()
+        && overrides.permission_profile.is_none()
+        && overrides.default_permissions.is_none()
+        && !contains("sandbox_mode")
+        && !contains("default_permissions")
+        && !permission_config_override;
+    if overrides.model.is_none() && !contains("model") {
+        overrides.model = Some(snapshot.model.clone());
+    }
+    if overrides.model_provider.is_none() && !contains("model_provider") {
+        overrides.model_provider = Some(snapshot.model_provider_id.clone());
+    }
+    if overrides.service_tier.is_none() && !contains("service_tier") {
+        overrides.service_tier = Some(snapshot.service_tier.clone());
+    }
+    if overrides.cwd.is_none() && !contains("cwd") {
+        overrides.cwd = Some(snapshot.cwd.to_path_buf());
+    }
+    if overrides.workspace_roots.is_none() && !contains("workspace_roots") {
+        overrides.workspace_roots = snapshot.workspace_roots.clone();
+    }
+    if overrides.approval_policy.is_none() && !contains("approval_policy") {
+        overrides.approval_policy = Some(snapshot.approval_policy);
+    }
+    if overrides.approvals_reviewer.is_none() && !contains("approvals_reviewer") {
+        overrides.approvals_reviewer = Some(snapshot.approvals_reviewer);
+    }
+    if restore_permissions {
+        // Validate the exact persisted permission value through ordinary config
+        // requirements. A changed named-profile definition cannot silently replace it.
+        overrides.permission_profile = Some(
+            snapshot
+                .base_permission_profile
+                .as_ref()
+                .unwrap_or(&snapshot.permission_profile)
+                .clone(),
+        );
+    }
+    if restore_personality {
+        overrides.personality = snapshot.personality;
+    }
+    if restore_effort && let Some(effort) = snapshot.reasoning_effort.as_ref() {
+        request.get_or_insert_with(Default::default).insert(
+            "model_reasoning_effort".to_string(),
+            serde_json::to_value(effort).expect("reasoning effort is serializable"),
+        );
+    }
+    if restore_summary && let Some(summary) = snapshot.reasoning_summary.as_ref() {
+        request.get_or_insert_with(Default::default).insert(
+            "model_reasoning_summary".to_string(),
+            serde_json::to_value(summary).expect("reasoning summary is serializable"),
+        );
+    }
+    OwnedResumeSettings {
+        owner,
+        snapshot: snapshot.clone(),
+        selected_service_tier,
+        restore_effort,
+        restore_summary,
+        restore_personality,
+        restore_permissions,
+    }
+}
+
+impl OwnedResumeSettings {
+    pub(super) fn apply(self, config: &mut codex_core::config::Config) -> std::io::Result<()> {
+        if self.restore_effort {
+            config.model_reasoning_effort = self.snapshot.reasoning_effort;
+        }
+        if self.restore_summary {
+            config.model_reasoning_summary = self.snapshot.reasoning_summary;
+        }
+        if self.restore_personality {
+            config.personality = self.snapshot.personality;
+        }
+        if self.restore_permissions {
+            use codex_protocol::models::PermissionProfileSnapshot;
+            let profile = self
+                .snapshot
+                .base_permission_profile
+                .unwrap_or(self.snapshot.permission_profile);
+            let snapshot = match self.snapshot.active_permission_profile {
+                Some(active) => PermissionProfileSnapshot::active_with_profile_workspace_roots(
+                    profile,
+                    active,
+                    self.snapshot.profile_workspace_roots.unwrap_or_default(),
+                ),
+                None => PermissionProfileSnapshot::legacy(profile),
+            };
+            config.restore_persisted_permission_snapshot(snapshot)?;
+        }
+        config.resumed_service_tier = Some((self.owner, self.selected_service_tier));
+        config.resumed_collaboration_mode = Some((self.owner, self.snapshot.collaboration_mode));
+        Ok(())
+    }
+}
