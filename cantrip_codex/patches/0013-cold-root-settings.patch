+#[tokio::test]
+async fn full_restore_clears_omitted_snapshot_defaults_and_rejects_current_permission_constraints()
+{
+    use super::merge_owned_resume_settings;
+    use codex_core::config::{ConfigBuilder, ConfigOverrides, Constrained, Permissions};
+    let home = tempfile::tempdir().unwrap();
+    let mut config = ConfigBuilder::default()
+        .loader_overrides(codex_config::LoaderOverrides::without_managed_config_for_tests())
+        .codex_home(home.path().to_path_buf())
+        .harness_overrides(ConfigOverrides {
+            cwd: Some(home.path().to_path_buf()),
+            ..Default::default()
+        })
+        .build()
+        .await
+        .unwrap();
+    let owner = codex_protocol::ThreadId::new();
+    let mut snapshot = full_snapshot();
+    snapshot.service_tier = None;
+    snapshot.reasoning_effort = None;
+    snapshot.reasoning_summary = None;
+    snapshot.personality = None;
+    let mut overrides = ConfigOverrides::default();
+    let restore = merge_owned_resume_settings(owner, &snapshot, &mut None, &mut overrides);
+    assert_eq!(overrides.service_tier, Some(None));
+    config.model_reasoning_effort = Some(codex_protocol::openai_models::ReasoningEffort::Low);
+    config.model_reasoning_summary = Some(codex_protocol::config_types::ReasoningSummary::Detailed);
+    config.personality = Some(codex_protocol::config_types::Personality::Pragmatic);
+    restore.apply(&mut config).unwrap();
+    assert_eq!(config.model_reasoning_effort, None);
+    assert_eq!(config.model_reasoning_summary, None);
+    assert_eq!(config.personality, None);
+    assert_eq!(
+        config.resumed_collaboration_mode,
+        Some((owner, snapshot.collaboration_mode.clone()))
+    );
+    assert_eq!(
+        config.permissions.active_permission_profile(),
+        snapshot.active_permission_profile
+    );
+
+    // Explicit runtime roots replace old materialized grants. Persisted canonical
+    // symbolic grants must survive so subsequent root changes also remain correct.
+    let old_root = AbsolutePathBuf::from_absolute_path(home.path().join("old")).unwrap();
+    let new_root = AbsolutePathBuf::from_absolute_path(home.path().join("new")).unwrap();
+    let canonical = PermissionProfile::workspace_write();
+    snapshot.base_permission_profile = Some(canonical.clone());
+    snapshot.permission_profile = canonical
+        .clone()
+        .materialize_project_roots_with_workspace_roots(&[old_root]);
+    config.workspace_roots = vec![new_root.clone()];
+    config
+        .permissions
+        .set_workspace_roots(vec![new_root.clone()]);
+    let mut overrides = ConfigOverrides {
+        workspace_roots: Some(vec![new_root.clone()]),
+        ..Default::default()
+    };
+    let restore = merge_owned_resume_settings(owner, &snapshot, &mut None, &mut overrides);
+    assert_eq!(overrides.permission_profile, Some(canonical.clone()));
+    restore.apply(&mut config).unwrap();
+    assert_eq!(config.permissions.permission_profile(), &canonical);
+    assert_eq!(
+        config.permissions.effective_permission_profile(),
+        canonical.materialize_project_roots_with_workspace_roots(&[new_root])
+    );
+    snapshot.base_permission_profile = None;
+
+    // The snapshot is current and owned, but present managed constraints remain
+    // authoritative. Restoring cannot turn a read-only-only profile into full access.
+    config.permissions = Permissions::from_approval_and_profile(
+        Constrained::allow_any(AskForApproval::OnRequest),
+        Constrained::allow_only(PermissionProfile::read_only()),
+    )
+    .unwrap();
+    snapshot.permission_profile = PermissionProfile::Disabled;
+    let restore =
+        merge_owned_resume_settings(owner, &snapshot, &mut None, &mut ConfigOverrides::default());
+    assert!(restore.apply(&mut config).is_err());
+    assert_eq!(
+        config.permissions.permission_profile(),
+        &PermissionProfile::read_only()
+    );
+}
