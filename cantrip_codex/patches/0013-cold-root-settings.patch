+    let preserved = match (history, config.resumed_collaboration_mode.as_ref()) {
+        (InitialHistory::Resumed(resumed), Some((owner, mode)))
+            if resumed.conversation_id == *owner && !source.is_non_root_agent() =>
+        {
+            Some(mode.clone())
+        }
+        _ => None,
+    };
+    let mut mode = preserved.unwrap_or_else(|| CollaborationMode {
+        mode: ModeKind::Default,
+        settings: Settings {
+            model: model.to_string(),
+            reasoning_effort: config.model_reasoning_effort.clone(),
+            developer_instructions: None,
+        },
+    });
