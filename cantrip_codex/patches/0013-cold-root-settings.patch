+/// Full snapshots have authority only over the logical thread that emitted them.
+/// Imported/fork prefixes and old ownerless snapshots never configure a root.
+pub(super) fn latest_owned_thread_settings(
+    history: &[RolloutItem],
+    owner: codex_protocol::ThreadId,
+) -> Option<&codex_protocol::protocol::ThreadSettingsSnapshot> {
+    history.iter().rev().find_map(|item| match item {
+        RolloutItem::EventMsg(EventMsg::ThreadSettingsApplied(event))
+            if event.thread_id == Some(owner) =>
+        {
+            Some(&event.thread_settings)
+        }
+        _ => None,
+    })
+}
