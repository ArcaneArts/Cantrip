+fn full_snapshot() -> ThreadSettingsSnapshot {
+    let RolloutItem::EventMsg(EventMsg::ThreadSettingsApplied(event)) = settings_item(
+        AskForApproval::OnRequest,
+        ApprovalsReviewer::User,
+        Some(ActivePermissionProfile::read_only()),
+    ) else {
+        unreachable!()
+    };
+    let mut snapshot = event.thread_settings;
+    snapshot.model = "persisted-model".to_string();
+    snapshot.model_provider_id = "persisted-provider".to_string();
+    snapshot.service_tier = Some("priority".to_string());
+    snapshot.reasoning_effort = Some(codex_protocol::openai_models::ReasoningEffort::High);
+    snapshot.reasoning_summary = Some(codex_protocol::config_types::ReasoningSummary::Detailed);
+    snapshot.workspace_roots = Some(vec![cwd()]);
+    snapshot.profile_workspace_roots = Some(vec![cwd()]);
+    snapshot.collaboration_mode.mode = ModeKind::Plan;
+    snapshot
