new file mode 100644
--- /dev/null
+++ b/codex-rs/core/src/managed_inference.rs
@@ -0,0 +1,174 @@
+//! Worker-owned inference tickets. Core supplies actual execution boundaries;
+//! it never chooses provider capacity or stores a second input queue.
+use crate::managed_execution::ManagedExecutionGate;
+use codex_protocol::ThreadId;
+use codex_protocol::error::{CodexErr, Result as CodexResult};
+use std::sync::{
+    Arc,
+    atomic::{AtomicBool, AtomicUsize, Ordering},
+};
+use tokio::sync::Mutex;
+use tokio_util::sync::CancellationToken;
+
+pub(crate) struct ManagedInferenceTurn {
+    gate: Arc<ManagedExecutionGate>,
+    thread_id: ThreadId,
+    turn_id: String,
+    cancellation: CancellationToken,
+    held: Mutex<bool>,
+    sampling: AtomicUsize,
+    waits: AtomicUsize,
+    finished: AtomicBool,
+}
+
+pub(crate) struct InferenceLifetime(pub Arc<ManagedInferenceTurn>);
+impl Drop for InferenceLifetime {
+    fn drop(&mut self) {
+        if !self.0.finished.swap(true, Ordering::SeqCst) {
+            self.0
+                .gate
+                .notify_inference(self.0.thread_id, &self.0.turn_id, "finish", None);
+        }
+    }
+}
+
+pub(crate) struct SamplingActivity(Arc<ManagedInferenceTurn>);
+impl Drop for SamplingActivity {
+    fn drop(&mut self) {
+        self.0.sampling.fetch_sub(1, Ordering::SeqCst);
+        self.0.maybe_suspend();
+    }
+}
+
+pub(crate) struct InferenceWait(Arc<ManagedInferenceTurn>);
+impl Drop for InferenceWait {
+    fn drop(&mut self) {
+        self.0.waits.fetch_sub(1, Ordering::SeqCst);
+    }
+}
+
+impl ManagedInferenceTurn {
+    pub(crate) async fn begin(
+        gate: Arc<ManagedExecutionGate>,
+        thread_id: ThreadId,
+        turn_id: String,
+        cancellation: CancellationToken,
+    ) -> CodexResult<InferenceLifetime> {
+        let turn = Arc::new(Self {
+            gate,
+            thread_id,
+            turn_id,
+            cancellation,
+            held: Mutex::new(false),
+            sampling: AtomicUsize::new(0),
+            waits: AtomicUsize::new(0),
+            finished: AtomicBool::new(false),
+        });
+        // Own cleanup before awaiting the grant: cancellation can win after
+        // the worker grants but before Core receives that exact reply.
+        let lifetime = InferenceLifetime(turn);
+        lifetime.0.phase("begin").await?;
+        *lifetime.0.held.lock().await = true;
+        Ok(lifetime)
+    }
+
+    async fn phase(&self, phase: &str) -> CodexResult<()> {
+        tokio::select! {
+            result = self.gate.request_inference(self.thread_id, &self.turn_id, phase) =>
+                result.map_err(|_| CodexErr::TurnAborted),
+            _ = self.cancellation.cancelled() => Err(CodexErr::TurnAborted),
+        }
+    }
+
+    pub(crate) async fn resume(&self) -> CodexResult<()> {
+        let mut held = self.held.lock().await;
+        if self.finished.load(Ordering::SeqCst) || self.cancellation.is_cancelled() {
+            return Err(CodexErr::TurnAborted);
+        }
+        if !*held {
+            self.phase("resume").await?;
+            *held = true;
+        }
+        Ok(())
+    }
+
+    pub(crate) async fn suspend(&self) -> CodexResult<()> {
+        let mut held = self.held.lock().await;
+        if self.finished.load(Ordering::SeqCst) {
+            return Ok(());
+        }
+        // Tool output can overlap a model stream. Only the last actual sampling
+        // activity may expose a suspension boundary to the worker.
+        if *held && self.sampling.load(Ordering::SeqCst) == 0 {
+            self.phase("suspend").await?;
+            *held = false;
+        }
+        Ok(())
+    }
+
+    pub(crate) async fn sampling(self: &Arc<Self>) -> CodexResult<SamplingActivity> {
+        let mut held = self.held.lock().await;
+        if self.finished.load(Ordering::SeqCst) || self.cancellation.is_cancelled() {
+            return Err(CodexErr::TurnAborted);
+        }
+        if !*held {
+            self.phase("resume").await?;
+            *held = true;
+        }
+        self.sampling.fetch_add(1, Ordering::SeqCst);
+        Ok(SamplingActivity(Arc::clone(self)))
+    }
+
+    pub(crate) fn waiting(self: &Arc<Self>) -> InferenceWait {
+        self.waits.fetch_add(1, Ordering::SeqCst);
+        self.maybe_suspend();
+        InferenceWait(Arc::clone(self))
+    }
+
+    fn maybe_suspend(self: &Arc<Self>) {
+        if self.waits.load(Ordering::SeqCst) == 0
+            || self.sampling.load(Ordering::SeqCst) != 0
+            || self.finished.load(Ordering::SeqCst)
+        {
+            return;
+        }
+        let turn = Arc::clone(self);
+        tokio::spawn(async move {
+            if turn.waits.load(Ordering::SeqCst) != 0 && turn.suspend().await.is_err() {
+                // Losing admission cannot leave Core free to make another model
+                // request. Its normal cancellation path settles the current turn.
+                turn.cancellation.cancel();
+            }
+        });
+    }
+}
+
+pub(crate) fn is_dependency_wait(name: &str) -> bool {
+    matches!(
+        name.rsplit("__").next().unwrap_or(name),
+        "wait" | "wait_agent" | "wait_threads" | "task_wait" | "request_user_input"
+    )
+}
+
+/// Capacity for an independently concurrent internal request. The final owner
+/// must retain this through transport cancellation/draining, not just early output.
+pub struct IndependentInference {
+    _lifetime: InferenceLifetime,
+}
+
+/// Core supplies identity and lifetime; the worker remains the admission authority.
+pub async fn begin_independent(
+    gate: Arc<ManagedExecutionGate>,
+    thread_id: ThreadId,
+    operation: String,
+) -> CodexResult<IndependentInference> {
+    Ok(IndependentInference {
+        _lifetime: ManagedInferenceTurn::begin(
+            gate,
+            thread_id,
+            operation,
+            CancellationToken::new(),
+        )
+        .await?,
+    })
+}
