+//! Actual saved spawn topology, including closed edges and graph-only children.
+use super::StateRuntime;
+use codex_protocol::ThreadId;
+use serde::{Deserialize, Serialize};
+use sqlx::Row;
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct PortableThreadSpawnEdge {
+    pub parent_thread_id: ThreadId,
+    pub child_thread_id: ThreadId,
+    pub status: String,
+}
+
+impl StateRuntime {
+    /// Both directions let an attached member retain its original incoming
+    /// spawn relationship without exporting an unrelated parent's history.
+    pub async fn portable_thread_spawn_edges(
+        &self,
+        thread: ThreadId,
+    ) -> anyhow::Result<Vec<PortableThreadSpawnEdge>> {
+        let rows = sqlx::query("SELECT parent_thread_id,child_thread_id,status FROM thread_spawn_edges WHERE parent_thread_id=? OR child_thread_id=? ORDER BY child_thread_id")
+            .bind(thread.to_string()).bind(thread.to_string())
+            .fetch_all(self.pool.as_ref()).await?;
+        rows.into_iter()
+            .map(|row| {
+                Ok(PortableThreadSpawnEdge {
+                    parent_thread_id: ThreadId::try_from(
+                        row.try_get::<String, _>("parent_thread_id")?,
+                    )?,
+                    child_thread_id: ThreadId::try_from(
+                        row.try_get::<String, _>("child_thread_id")?,
+                    )?,
+                    status: row.try_get("status")?,
+                })
+            })
+            .collect()
+    }
+
+    /// An import may insert its exact missing topology or observe its own
+    /// interrupted publication. It must never reopen or retarget a newer edge.
+    pub async fn restore_portable_thread_spawn_edges(
+        &self,
+        edges: &[PortableThreadSpawnEdge],
+    ) -> anyhow::Result<()> {
+        let mut tx = self.pool.begin_with("BEGIN IMMEDIATE").await?;
+        for edge in edges {
+            anyhow::ensure!(!edge.status.is_empty(), "empty transferred spawn status");
+            sqlx::query("INSERT INTO thread_spawn_edges(parent_thread_id,child_thread_id,status) VALUES(?,?,?) ON CONFLICT(child_thread_id) DO NOTHING")
+                .bind(edge.parent_thread_id.to_string()).bind(edge.child_thread_id.to_string()).bind(&edge.status)
+                .execute(&mut *tx).await?;
+            let actual = sqlx::query(
+                "SELECT parent_thread_id,status FROM thread_spawn_edges WHERE child_thread_id=?",
+            )
+            .bind(edge.child_thread_id.to_string())
+            .fetch_one(&mut *tx)
+            .await?;
+            anyhow::ensure!(
+                actual.try_get::<String, _>("parent_thread_id")?
+                    == edge.parent_thread_id.to_string()
+                    && actual.try_get::<String, _>("status")? == edge.status,
+                "destination spawn relationship already differs"
+            );
+        }
+        tx.commit().await?;
+        Ok(())
+    }
+}
