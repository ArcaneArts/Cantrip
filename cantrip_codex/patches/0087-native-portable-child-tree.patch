+/// Called while Core retains the actual tree execution/export admission guard.
+/// Persisted descendants need not have a live Session in that coordinator.
+pub(super) async fn export_tree(
+    store: &LocalThreadStore,
+    params: LoadThreadHistoryParams,
+) -> ThreadStoreResult<PortableThreadHistory> {
+    use std::collections::{BTreeMap, HashSet, VecDeque};
+    let root = params.thread_id;
+    let mut snapshot = export(store, params).await?;
+    super::portable_history_tree::ensure_settled(&snapshot)?;
+    let database = store
+        .state_db()
+        .await
+        .ok_or_else(|| storage_error("metadata database is unavailable"))?;
+    let mut visited = HashSet::from([root]);
+    let mut pending = VecDeque::from([root]);
+    let mut edges = BTreeMap::new();
+    while let Some(parent) = pending.pop_front() {
+        let observed = database
+            .portable_thread_spawn_edges(parent)
+            .await
+            .map_err(storage_error)?;
+        let mut children = database
+            .list_attached_thread_ids(parent)
+            .await
+            .map_err(storage_error)?;
+        for edge in observed {
+            if edge.parent_thread_id == parent {
+                children.push(edge.child_thread_id);
+            }
+            if let Some(prior) = edges.insert(edge.child_thread_id.to_string(), edge.clone())
+                && prior != edge
+            {
+                return Err(storage_error(
+                    "spawn topology changed during history capture",
+                ));
+            }
+        }
+        children.sort_by_key(ToString::to_string);
+        children.dedup();
+        for child in children {
+            if !visited.insert(child) {
+                continue;
+            }
+            // Attempt the actual history export, rather than treating lack of a
+            // cached/live Session as proof that a child has no durable history.
+            let metadata = database.get_thread(child).await.map_err(storage_error)?;
+            match export(
+                store,
+                LoadThreadHistoryParams {
+                    thread_id: child,
+                    include_archived: true,
+                },
+            )
+            .await
+            {
+                Ok(child) => {
+                    super::portable_history_tree::ensure_settled(&child)?;
+                    snapshot.descendants.push(child);
+                }
+                Err(ThreadStoreError::ThreadNotFound { thread_id })
+                    if thread_id == child && metadata.is_none() =>
+                {
+                    // Ephemeral/deleted graph-only identity: preserve its real
+                    // edge and status, without inventing a conversation/turn.
+                }
+                Err(error) => return Err(error),
+            }
+            pending.push_back(child);
+        }
+    }
+    snapshot.version = 3;
+    snapshot.spawn_edges = edges.into_values().collect();
+    // The same structural validation is used by the actual destination import.
+    super::portable_history_tree::validate_topology(&snapshot)?;
+    Ok(snapshot)
+}
