+#[tokio::test]
+async fn paused_turn_waits_for_resume_at_boundary() {
+    let (session, _) = crate::session::tests::make_session_and_context().await;
+    let session = Arc::new(session);
+    session.set_turn_paused(true);
+    let mut pause_rx = session.subscribe_turn_pause_state();
+    let mut pause_boundary = session.subscribe_turn_pause_boundary_state();
+    let cancellation_token = CancellationToken::new();
+    let waiting_session = Arc::clone(&session);
+    let wait = tokio::spawn(async move {
+        wait_for_turn_resume(&waiting_session, &mut pause_rx, &cancellation_token).await
+    });
+
+    tokio::time::timeout(std::time::Duration::from_secs(1), async {
+        while !*pause_boundary.borrow() {
+            pause_boundary
+                .changed()
+                .await
+                .expect("pause boundary sender should remain available");
+        }
+    })
+    .await
+    .expect("pause gate should acknowledge its durable boundary");
+    assert!(!wait.is_finished());
+    session.set_turn_paused(false);
+
+    tokio::time::timeout(std::time::Duration::from_secs(1), wait)
+        .await
+        .expect("pause gate should resume")
+        .expect("pause gate task should finish")
+        .expect("pause gate should succeed");
+}
