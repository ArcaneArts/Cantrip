+    /// Wait for a requested turn pause to reach a durable model/tool boundary.
+    /// If the turn finishes first, its terminal rollout flush is also a safe boundary.
+    pub async fn wait_until_turn_pause_boundary(&self) -> CodexResult<()> {
+        let mut pause_boundary = self.session.subscribe_turn_pause_boundary_state();
+        let mut agent_status = self.io.agent_status.clone();
+        loop {
+            if *pause_boundary.borrow() {
+                return Ok(());
+            }
+            if !matches!(&*agent_status.borrow(), AgentStatus::Running) {
+                self.flush_rollout().await?;
+                return Ok(());
+            }
+            tokio::select! {
+                changed = pause_boundary.changed() => {
+                    if changed.is_err() {
+                        return Err(CodexErr::InternalAgentDied);
+                    }
+                }
+                changed = agent_status.changed() => {
+                    if changed.is_err() {
+                        return Err(CodexErr::InternalAgentDied);
+                    }
+                }
+            }
+        }
+    }
