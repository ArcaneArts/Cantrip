+async fn wait_for_turn_resume(
+    turn_pause_state: &mut tokio::sync::watch::Receiver<bool>,
+    cancellation_token: &CancellationToken,
+) -> CodexResult<()> {
+    while *turn_pause_state.borrow() {
+        tokio::select! {
+            changed = turn_pause_state.changed() => {
+                if changed.is_err() {
+                    return Err(CodexErr::TurnAborted);
+                }
+            }
+            _ = cancellation_token.cancelled() => {
+                return Err(CodexErr::TurnAborted);
+            }
+        }
+    }
+    Ok(())
+}
