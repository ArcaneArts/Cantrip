+async fn paused_turn_waits_for_resume_at_boundary() {
+    let (pause_tx, mut pause_rx) = tokio::sync::watch::channel(true);
+    let cancellation_token = CancellationToken::new();
+    let wait =
+        tokio::spawn(async move { wait_for_turn_resume(&mut pause_rx, &cancellation_token).await });
+
+    tokio::task::yield_now().await;
+    assert!(!wait.is_finished());
+    pause_tx.send_replace(false);
+
+    tokio::time::timeout(std::time::Duration::from_secs(1), wait)
+        .await
+        .expect("pause gate should resume")
+        .expect("pause gate task should finish")
+        .expect("pause gate should succeed");
+}
