+    sess: &Session,
+    turn_pause_state: &mut tokio::sync::watch::Receiver<bool>,
+    cancellation_token: &CancellationToken,
+) -> CodexResult<()> {
+    if *turn_pause_state.borrow() {
+        sess.flush_rollout().await?;
+        sess.set_turn_pause_boundary_reached(true);
+    }
+    let result = loop {
+        if !*turn_pause_state.borrow() {
+            break Ok(());
+        }
+        tokio::select! {
+            changed = turn_pause_state.changed() => {
+                if changed.is_err() {
+                    break Err(CodexErr::TurnAborted);
+                }
+            }
+            _ = cancellation_token.cancelled() => {
+                break Err(CodexErr::TurnAborted);
+            }
+        }
+    };
+    sess.set_turn_pause_boundary_reached(false);
+    result
+}
