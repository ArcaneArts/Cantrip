+            turn_id,
+            paused,
+        } = params;
+        let (thread_uuid, thread) = self.load_thread(&thread_id).await?;
+        let thread_state = self.thread_state_manager.thread_state(thread_uuid).await;
+        let thread_state = thread_state.lock().await;
+        let Some(active_turn) = thread_state.active_turn_snapshot() else {
+            return Err(invalid_request("no active turn to pause"));
+        };
+        if active_turn.id != turn_id {
+            return Err(invalid_request(format!(
+                "expected active turn id {turn_id} but found {}",
+                active_turn.id
+            )));
+        }
+        drop(thread_state);
+        self.submit_core_op(request_id, thread.as_ref(), Op::SetTurnPaused { paused })
+            .await
+            .map_err(|err| internal_error(format!("failed to update turn pause state: {err}")))?;
+        Ok(TurnPauseResponse { paused })
+    }
