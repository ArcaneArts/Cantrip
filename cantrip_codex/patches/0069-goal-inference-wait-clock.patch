diff --git a/codex-rs/ext/extension-api/src/inference_queue_clock.rs b/codex-rs/ext/extension-api/src/inference_queue_clock.rs
new file mode 100644
index 0000000000000000000000000000000000000000..598dbce290b4d612797c254bd26cb70addd2e0cd
--- /dev/null
+++ b/codex-rs/ext/extension-api/src/inference_queue_clock.rs
@@ -0,0 +1,54 @@
+//! Monotonic observation of actual worker-admission waits. This clock never
+//! grants capacity and keeps no history of completed requests.
+use std::sync::{Arc, Mutex, PoisonError};
+use std::time::{Duration, Instant};
+
+#[derive(Debug, Default)]
+pub struct InferenceQueueClock {
+    state: Mutex<ClockState>,
+}
+
+#[derive(Debug, Default)]
+struct ClockState {
+    completed: Duration,
+    started: Option<Instant>,
+    waiters: usize,
+}
+
+pub struct InferenceQueueWait(Arc<InferenceQueueClock>);
+
+impl InferenceQueueClock {
+    /// The owner enters this only at a non-inferencing admission boundary.
+    pub fn waiting(self: &Arc<Self>) -> InferenceQueueWait {
+        let mut state = self.state.lock().unwrap_or_else(PoisonError::into_inner);
+        if state.waiters == 0 {
+            state.started = Some(Instant::now());
+        }
+        state.waiters += 1;
+        InferenceQueueWait(Arc::clone(self))
+    }
+
+    /// Overlapping waits count once. Live progress reads include the current
+    /// wait rather than charging it until the admission future finishes.
+    pub fn elapsed_at(&self, now: Instant) -> Duration {
+        let state = self.state.lock().unwrap_or_else(PoisonError::into_inner);
+        state.completed.saturating_add(
+            state
+                .started
+                .map(|started| now.saturating_duration_since(started))
+                .unwrap_or(Duration::ZERO),
+        )
+    }
+}
+
+impl Drop for InferenceQueueWait {
+    fn drop(&mut self) {
+        let mut state = self.0.state.lock().unwrap_or_else(PoisonError::into_inner);
+        state.waiters -= 1;
+        if state.waiters == 0 {
+            if let Some(started) = state.started.take() {
+                state.completed = state.completed.saturating_add(started.elapsed());
+            }
+        }
+    }
+}
