+//! Adapt advertised namespaces at the provider boundary, retaining exact runtime identities.
+use codex_tools::ResponsesApiNamespaceTool;
+use codex_tools::ToolName;
+use codex_tools::ToolSpec;
+use sha1::Digest;
+use sha1::Sha1;
+use std::collections::BTreeMap;
+use std::collections::BTreeSet;
+use std::sync::Arc;
+
+pub(crate) struct PortableNamespaces {
+    pub specs: Arc<[ToolSpec]>,
+    aliases: BTreeMap<String, ToolName>,
+}
+
+impl PortableNamespaces {
+    pub fn new(specs: &[ToolSpec]) -> Self {
+        let reserved: BTreeSet<String> = specs
+            .iter()
+            .filter_map(|spec| match spec {
+                ToolSpec::Namespace(_) => None,
+                _ => Some(spec.name().to_owned()),
+            })
+            .collect();
+        let mut used = reserved.clone();
+        let mut candidates = BTreeMap::<String, usize>::new();
+        for spec in specs {
+            if let ToolSpec::Namespace(namespace) = spec {
+                for tool in &namespace.tools {
+                    let name = match tool {
+                        ResponsesApiNamespaceTool::Function(tool) => &tool.name,
+                        ResponsesApiNamespaceTool::Custom(tool) => &tool.name,
+                    };
+                    *candidates
+                        .entry(format!("{}__{name}", namespace.name))
+                        .or_default() += 1;
+                }
+            }
+        }
+        // Reserve every simple alias before assigning hashed fallbacks. Adding
+        // a long name cannot steal a short name from a later namespace.
+        used.extend(candidates.keys().cloned());
+        let mut aliases = BTreeMap::new();
+        let mut result = Vec::new();
+        for spec in specs {
+            let ToolSpec::Namespace(namespace) = spec else {
+                result.push(spec.clone());
+                continue;
+            };
+            for tool in &namespace.tools {
+                let (name, mut flattened) = match tool {
+                    ResponsesApiNamespaceTool::Function(tool) => {
+                        (tool.name.clone(), ToolSpec::Function(tool.clone()))
+                    }
+                    ResponsesApiNamespaceTool::Custom(tool) => {
+                        (tool.name.clone(), ToolSpec::Freeform(tool.clone()))
+                    }
+                };
+                let canonical = ToolName::namespaced(&namespace.name, &name);
+                let candidate = format!("{}__{name}", namespace.name);
+                let standalone_collision = reserved.contains(&candidate);
+                let alias = if candidate.len() <= 64
+                    && candidate
+                        .bytes()
+                        .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'_' | b'-'))
+                    && candidates.get(&candidate) == Some(&1)
+                    && !standalone_collision
+                {
+                    candidate
+                } else {
+                    let prefix: String = candidate
+                        .chars()
+                        .map(|ch| {
+                            if ch.is_ascii_alphanumeric() || matches!(ch, '_' | '-') {
+                                ch
+                            } else {
+                                '_'
+                            }
+                        })
+                        .take(23)
+                        .collect();
+                    let mut salt = 0_u64;
+                    loop {
+                        let mut hash = Sha1::new();
+                        hash.update((namespace.name.len() as u64).to_be_bytes());
+                        hash.update(namespace.name.as_bytes());
+                        hash.update((name.len() as u64).to_be_bytes());
+                        hash.update(name.as_bytes());
+                        hash.update(salt.to_be_bytes());
+                        let alias = format!("{prefix}_{:x}", hash.finalize());
+                        if used.insert(alias.clone()) {
+                            break alias;
+                        }
+                        salt += 1;
+                    }
+                };
+                let (tool_name, description) = match &mut flattened {
+                    ToolSpec::Function(tool) => (&mut tool.name, &mut tool.description),
+                    ToolSpec::Freeform(tool) => (&mut tool.name, &mut tool.description),
+                    _ => unreachable!("only callable namespace children are flattened"),
+                };
+                *tool_name = alias.clone();
+                if !namespace.description.trim().is_empty() {
+                    *description = format!("{}\n\n{}", namespace.description, description);
+                }
+                aliases.insert(alias, canonical);
+                result.push(flattened);
+            }
+        }
+        Self {
+            specs: result.into(),
+            aliases,
+        }
+    }
+
+    pub fn resolve(&self, name: &ToolName) -> ToolName {
+        if name.is_default_namespace() {
+            self.aliases
+                .get(&name.name)
+                .cloned()
+                .unwrap_or_else(|| name.clone())
+        } else {
+            name.clone()
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use codex_tools::ResponsesApiNamespace;
+    use codex_tools::ResponsesApiTool;
+    use serde_json::json;
+
+    fn function(name: &str) -> codex_tools::ResponsesApiTool {
+        ResponsesApiTool {
+            name: name.into(), description: "call help".into(), strict: false,
+            defer_loading: None, output_schema: None,
+            parameters: serde_json::from_value(json!({"type":"object", "properties":{"value":{"type":"string"}}, "required":["value"]})).unwrap(),
+        }
+    }
+    fn namespace(name: &str, tool: &str) -> ToolSpec {
+        ToolSpec::Namespace(ResponsesApiNamespace {
+            name: name.into(),
+            description: "namespace help".into(),
+            tools: vec![ResponsesApiNamespaceTool::Function(function(tool))],
+        })
+    }
+    #[test]
+    fn preserves_schema_and_resolves_only_advertised_aliases() {
+        let input = [
+            namespace("mcp__cantrip_cua", "js"),
+            ToolSpec::Function(function("exec_command")),
+        ];
+        let portable = PortableNamespaces::new(&input);
+        let ToolSpec::Function(tool) = &portable.specs[0] else {
+            panic!("expected function")
+        };
+        assert_eq!(tool.name, "mcp__cantrip_cua__js");
+        assert_eq!(tool.parameters, function("js").parameters);
+        assert_eq!(tool.description, "namespace help\n\ncall help");
+        assert_eq!(portable.specs[1], input[1]);
+        assert_eq!(
+            portable.resolve(&ToolName::plain(&tool.name)),
+            ToolName::namespaced("mcp__cantrip_cua", "js")
+        );
+        let foreign = ToolName::namespaced("other", &tool.name);
+        assert_eq!(portable.resolve(&foreign), foreign);
+        let hidden = ToolName::plain("mcp__cantrip_cua__hidden");
+        assert_eq!(portable.resolve(&hidden), hidden);
+    }
+    #[test]
+    fn disambiguates_delimiters_standalone_names_and_long_unicode_names() {
+        let input = [
+            namespace("a__b", "c"),
+            namespace("a", "b__c"),
+            namespace("mcp", "js"),
+            ToolSpec::Function(function("mcp__js")),
+            namespace(&"界".repeat(80), "js"),
+        ];
+        let portable = PortableNamespaces::new(&input);
+        let names: BTreeSet<_> = portable.specs.iter().map(ToolSpec::name).collect();
+        assert_eq!(names.len(), input.len());
+        assert!(names.iter().all(|name| name.len() <= 64 && name.is_ascii()));
+        assert_eq!(portable.specs, PortableNamespaces::new(&input).specs);
+        let mut reversed = input.clone();
+        reversed.reverse();
+        assert_eq!(portable.aliases, PortableNamespaces::new(&reversed).aliases);
+        assert_eq!(
+            portable.resolve(&ToolName::plain(portable.specs[0].name())),
+            ToolName::namespaced("a__b", "c")
+        );
+        assert_eq!(
+            portable.resolve(&ToolName::plain(portable.specs[1].name())),
+            ToolName::namespaced("a", "b__c")
+        );
+        assert_eq!(
+            portable.resolve(&ToolName::plain("mcp__js")),
+            ToolName::plain("mcp__js")
+        );
+    }
+}
