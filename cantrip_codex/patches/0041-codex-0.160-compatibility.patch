diff --git a/codex-rs/app-server-protocol/schema/json/v2/ThreadManagedConfigUpdateParams.json b/codex-rs/app-server-protocol/schema/json/v2/ThreadManagedConfigUpdateParams.json
new file mode 100644
index 0000000000000000000000000000000000000000..e6ea47584ce54f6e86d503e4128af8ba00057507
--- /dev/null
+++ b/codex-rs/app-server-protocol/schema/json/v2/ThreadManagedConfigUpdateParams.json
@@ -0,0 +1,96 @@
+{
+  "$schema": "http://json-schema.org/draft-07/schema#",
+  "additionalProperties": false,
+  "definitions": {
+    "ManagedExecutionGateConfig": {
+      "additionalProperties": false,
+      "properties": {
+        "runnerGeneration": {
+          "type": "string"
+        }
+      },
+      "required": [
+        "runnerGeneration"
+      ],
+      "type": "object"
+    },
+    "ReasoningEffort": {
+      "description": "A non-empty reasoning effort value advertised by the model.",
+      "minLength": 1,
+      "type": "string"
+    }
+  },
+  "description": "Complete replacement of the managed configuration on an already loaded thread. Root model, permissions, collaboration mode, and other thread settings are preserved.",
+  "properties": {
+    "canonicalHistory": {
+      "description": "Opt in future turns without changing legacy history or thread identity.",
+      "type": [
+        "boolean",
+        "null"
+      ]
+    },
+    "developerInstructions": {
+      "type": [
+        "string",
+        "null"
+      ]
+    },
+    "executionGate": {
+      "anyOf": [
+        {
+          "$ref": "#/definitions/ManagedExecutionGateConfig"
+        },
+        {
+          "type": "null"
+        }
+      ],
+      "description": "Optional connection-owned gate. Omission preserves an existing live guard."
+    },
+    "mcpServers": {
+      "additionalProperties": true,
+      "description": "Full native MCP server map. An empty map removes all configured servers.",
+      "type": "object"
+    },
+    "multiAgentEnabled": {
+      "description": "Updates both features.multi_agent and agents.enabled.",
+      "type": "boolean"
+    },
+    "preserveSubagentSettings": {
+      "default": null,
+      "description": "Preserve current native child defaults when refreshing the managed profile.",
+      "type": [
+        "boolean",
+        "null"
+      ]
+    },
+    "subagentModel": {
+      "type": [
+        "string",
+        "null"
+      ]
+    },
+    "subagentReasoningEffort": {
+      "anyOf": [
+        {
+          "$ref": "#/definitions/ReasoningEffort"
+        },
+        {
+          "type": "null"
+        }
+      ]
+    },
+    "threadId": {
+      "type": "string"
+    }
+  },
+  "required": [
+    "developerInstructions",
+    "mcpServers",
+    "multiAgentEnabled",
+    "subagentModel",
+    "subagentReasoningEffort",
+    "threadId"
+  ],
+  "title": "ThreadManagedConfigUpdateParams",
+  "type": "object"
+}
