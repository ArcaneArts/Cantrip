+#[test]
+fn detached_session_retention_is_explicit_and_positive() {
+    assert_eq!(
+        exec_server_from_args(&[]).detached_session_retention_seconds,
+        None
+    );
+    assert_eq!(
+        exec_server_from_args(&["--detached-session-retention-seconds", "86400"])
+            .detached_session_retention_seconds,
+        Some(86400)
+    );
+    for invalid in ["0", "-1", "1.5", "4294967296"] {
+        assert!(
+            ExecServerCli::try_parse_from([
+                "codex-exec-server",
+                "--detached-session-retention-seconds",
+                invalid,
+            ])
+            .is_err(),
+            "invalid retention {invalid}"
+        );
+    }
+}
