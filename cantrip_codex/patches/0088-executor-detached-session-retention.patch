+#[cfg(test)]
+mod retention_tests {
+    use super::*;
+    use tokio::sync::mpsc;
+
+    async fn attach(
+        registry: &Arc<SessionRegistry>,
+        id: Option<String>,
+    ) -> Result<SessionHandle, JSONRPCErrorError> {
+        let (sender, _receiver) = mpsc::channel(16);
+        registry
+            .attach(
+                id,
+                RpcNotificationSender::new(sender),
+                ExecServerRuntimeOptions::new(
+                    std::env::current_exe().expect("current executable"),
+                    None,
+                )
+                .expect("runtime paths"),
+            )
+            .await
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn configured_retention_keeps_identity_and_rejects_stale_detach_timers() {
+        let registry = SessionRegistry::with_retention(
+            ExecServerTelemetry::default(),
+            Some(Duration::from_secs(3600)),
+        );
+        let first = attach(&registry, None).await.expect("first attachment");
+        let id = first.session_id().to_owned();
+        first.detach().await;
+        tokio::task::yield_now().await;
+        tokio::time::advance(Duration::from_secs(1800)).await;
+        let second = attach(&registry, Some(id.clone()))
+            .await
+            .expect("same session after ordinary TTL");
+        assert_eq!(second.session_id(), id);
+        let error = attach(&registry, Some(id.clone()))
+            .await
+            .err()
+            .expect("exclusive attachment");
+        assert_eq!(error.code, crate::rpc::SESSION_ALREADY_ATTACHED_ERROR_CODE);
+        // A stale carrier cannot detach the replacement connection.
+        first.detach().await;
+        assert!(second.is_session_attached());
+        second.detach().await;
+        tokio::task::yield_now().await;
+        // First connection's timer fires while the new connection is detached.
+        tokio::time::advance(Duration::from_secs(1801)).await;
+        tokio::task::yield_now().await;
+        let third = attach(&registry, Some(id.clone()))
+            .await
+            .expect("stale timer must not evict new owner");
+        assert_eq!(third.session_id(), id);
+        third.detach().await;
+        tokio::task::yield_now().await;
+        tokio::time::advance(Duration::from_secs(3601)).await;
+        tokio::task::yield_now().await;
+        let error = attach(&registry, Some(id.clone()))
+            .await
+            .err()
+            .expect("configured TTL expires");
+        assert_eq!(error.message, format!("unknown session id {id}"));
+        assert!(registry.sessions.lock().await.is_empty());
+        registry.shutdown().await;
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn default_retention_still_expires_detached_sessions() {
+        let registry = SessionRegistry::new(ExecServerTelemetry::default());
+        let first = attach(&registry, None).await.expect("first attachment");
+        let id = first.session_id().to_owned();
+        first.detach().await;
+        tokio::task::yield_now().await;
+        tokio::time::advance(DETACHED_SESSION_TTL + Duration::from_millis(1)).await;
+        tokio::task::yield_now().await;
+        let error = attach(&registry, Some(id.clone()))
+            .await
+            .err()
+            .expect("ordinary TTL expires");
+        assert_eq!(error.message, format!("unknown session id {id}"));
+        assert!(registry.sessions.lock().await.is_empty());
+    }
+}
