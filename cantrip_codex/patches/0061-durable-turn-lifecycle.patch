+#[test]
+fn prepared_continuations_survive_retries_and_keep_runtime_validation() {
+    let directory = tempfile::tempdir().unwrap();
+    let owner = store(directory.path());
+    owner.commit(None, &checkpoint(1)).unwrap();
+    let mut prepared = checkpoint(2);
+    prepared.state = CheckpointState::Resuming;
+    owner.commit(Some(1), &prepared).unwrap();
+    drop(owner);
+    let typed =
+        LockedCheckpoint::<String>::acquire(directory.path(), "thread/with/unsafe/path").unwrap();
+    assert!(
+        typed
+            .read("different-runtime")
+            .unwrap_err()
+            .to_string()
+            .contains("runtime version")
+    );
+    assert_eq!(
+        typed.read_metadata().unwrap().unwrap().state,
+        CheckpointState::Resuming
+    );
+    drop(typed);
+    let owner = store(directory.path());
+    assert_eq!(owner.read("fixture-runtime-1").unwrap(), Some(prepared));
+    let mut retry = checkpoint(3);
+    retry.state = CheckpointState::Resuming;
+    owner.commit(Some(2), &retry).unwrap();
+    let mut invalid = checkpoint(4);
+    invalid.state = CheckpointState::Resuming;
+    invalid.continuation = None;
+    assert!(owner.commit(Some(3), &invalid).is_err());
+    assert_eq!(owner.read("fixture-runtime-1").unwrap(), Some(retry));
+    invalid.state = CheckpointState::Invalidated;
+    owner.commit(Some(3), &invalid).unwrap();
+    let mut stale = checkpoint(5);
+    stale.state = CheckpointState::Resuming;
+    assert!(owner.commit(Some(4), &stale).is_err());
+}
