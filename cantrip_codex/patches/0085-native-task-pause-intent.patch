+    /// Task controls retain native turn state; they neither grant model capacity
+    /// nor create input authority. Only the owning inference-only gate may apply.
+    pub async fn set_task_pause_intent(
+        &self,
+        runner_generation: &str,
+        revision: u64,
+        paused: bool,
+        wait_boundary: bool,
+    ) -> Result<(u64, bool)> {
+        let gate = self
+            .managed_execution_gate()
+            .await
+            .ok_or_else(|| invalid("Task pause has no private native gate"))?;
+        if gate.runner_generation != runner_generation {
+            return Err(invalid("Task pause belongs to another native gate"));
+        }
+        let owner = coordinator(&self.session);
+        let mut resume = None;
+        let applied = gate
+            .task_pause_control(self.thread_id(), revision, paused, || {
+                if !paused && owner.has_live_suspension() {
+                    resume = Some(
+                        owner
+                            .begin_live_resume()
+                            .map_err(|error| error.to_string())?,
+                    );
+                }
+                if *self.session.subscribe_turn_pause_state().borrow() != paused {
+                    self.session.set_turn_paused(paused);
+                }
+                Ok(())
+            })
+            .map_err(invalid)?;
+        if applied.0 != revision || !wait_boundary {
+            return Ok(applied);
+        }
+        let Some(changed) = gate
+            .task_pause_change(self.thread_id(), revision)
+            .map_err(invalid)?
+        else {
+            return gate.task_pause_state(self.thread_id()).map_err(invalid);
+        };
+        if paused {
+            tokio::select! {
+                result = self.wait_until_turn_pause_boundary() => result?,
+                _ = changed => {},
+            }
+        } else if let Some(resume) = resume {
+            tokio::select! {
+                result = resume.wait() => result?,
+                _ = changed => {},
+            }
+        }
+        gate.task_pause_state(self.thread_id()).map_err(invalid)
+    }
