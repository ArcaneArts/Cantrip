+    /// Revision comparison and the actual native watch mutation share this lock.
+    /// A late request cannot apply an older intent after a newer Resume/Pause.
+    pub fn task_pause_control(
+        &self,
+        thread_id: ThreadId,
+        revision: u64,
+        paused: bool,
+        apply: impl FnOnce() -> Result<(), String>,
+    ) -> Result<(u64, bool), String> {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if state.closed
+            || state.inherited
+            || state.thread_id != Some(thread_id)
+            || !self.inference_only
+        {
+            return Err("Task pause does not own the current private root".into());
+        }
+        if revision < state.task_pause_revision {
+            return Ok((state.task_pause_revision, state.task_paused));
+        }
+        if revision == state.task_pause_revision && paused != state.task_paused {
+            return Err("Task pause revision changed its intent".into());
+        }
+        apply()?;
+        if revision != state.task_pause_revision {
+            state.task_pause_revision = revision;
+            state.task_paused = paused;
+            for waiter in std::mem::take(&mut state.task_pause_waiters) {
+                let _ = waiter.send(());
+            }
+        }
+        Ok((state.task_pause_revision, state.task_paused))
+    }
+
+    pub fn task_pause_state(&self, thread_id: ThreadId) -> Result<(u64, bool), String> {
+        let state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if state.closed
+            || state.inherited
+            || state.thread_id != Some(thread_id)
+            || !self.inference_only
+        {
+            return Err("Task pause root was replaced".into());
+        }
+        Ok((state.task_pause_revision, state.task_paused))
+    }
+
+    /// Subscribe before waiting for a boundary or a live checkpoint resumption.
+    /// A newer intent wakes old observers; waking is never settlement evidence.
+    pub fn task_pause_change(
+        &self,
+        thread_id: ThreadId,
+        revision: u64,
+    ) -> Result<Option<oneshot::Receiver<()>>, String> {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if state.closed
+            || state.inherited
+            || state.thread_id != Some(thread_id)
+            || !self.inference_only
+        {
+            return Err("Task pause root was replaced".into());
+        }
+        if state.task_pause_revision != revision {
+            return Ok(None);
+        }
+        state
+            .task_pause_waiters
+            .retain(|waiter| !waiter.is_closed());
+        let (send, receive) = oneshot::channel();
+        state.task_pause_waiters.push(send);
+        Ok(Some(receive))
+    }
