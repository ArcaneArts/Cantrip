diff --git a/codex-rs/code-mode-host/tests/stored_state.rs b/codex-rs/code-mode-host/tests/stored_state.rs
new file mode 100644
index 0000000..b9ee93f
--- /dev/null
+++ b/codex-rs/code-mode-host/tests/stored_state.rs
@@ -0,0 +1,362 @@
+//! Real child hosts, fresh gRPC providers, no cell replay during data import.
+use std::process::Stdio;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+use anyhow::{Context, Result};
+use codex_code_mode::{
+    CellId, CodeModeNestedToolCall, CodeModeSession, CodeModeSessionDelegate,
+    CodeModeSessionProvider, CodeModeToolKind, ExecuteRequest, FunctionCallOutputContentItem,
+    GrpcCodeModeSessionProvider, NotificationFuture, RuntimeResponse, ToolDefinition,
+    ToolInvocationFuture, WaitOutcome, WaitRequest,
+};
+use codex_protocol::ToolName;
+use serde_json::json;
+use tokio::io::{AsyncBufReadExt, BufReader};
+use tokio::process::{Child, Command};
+use tokio::sync::mpsc;
+use tokio_util::sync::CancellationToken;
+
+async fn host() -> Result<(Child, GrpcCodeModeSessionProvider)> {
+    let (child, provider, _) = host_at("grpc://127.0.0.1:0").await?;
+    Ok((child, provider))
+}
+
+async fn host_at(listen: &str) -> Result<(Child, GrpcCodeModeSessionProvider, String)> {
+    let mut child = Command::new(codex_utils_cargo_bin::cargo_bin("codex-code-mode-host")?)
+        .args(["--listen", listen])
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::inherit())
+        .kill_on_drop(true)
+        .spawn()?;
+    let endpoint = BufReader::new(child.stdout.take().context("host stdout")?)
+        .lines()
+        .next_line()
+        .await?
+        .context("host ended before publishing endpoint")?;
+    Ok((
+        child,
+        GrpcCodeModeSessionProvider::new(endpoint.clone()),
+        endpoint,
+    ))
+}
+
+struct Delegate {
+    closed: mpsc::UnboundedSender<CellId>,
+    calls: AtomicUsize,
+    tools: mpsc::UnboundedSender<()>,
+    release: tokio::sync::Notify,
+}
+impl CodeModeSessionDelegate for Delegate {
+    fn invoke_tool<'a>(
+        &'a self,
+        _: CodeModeNestedToolCall,
+        cancelled: CancellationToken,
+    ) -> ToolInvocationFuture<'a> {
+        Box::pin(async move {
+            self.calls.fetch_add(1, Ordering::SeqCst);
+            self.tools.send(()).unwrap();
+            tokio::select! {
+                _ = self.release.notified() => Ok(json!({"finished": true})),
+                _ = cancelled.cancelled() => Err("cancelled".into()),
+            }
+        })
+    }
+    fn notify<'a>(
+        &'a self,
+        _: String,
+        _: CellId,
+        _: String,
+        _: CancellationToken,
+    ) -> NotificationFuture<'a> {
+        Box::pin(async { Ok(()) })
+    }
+    fn cell_closed(&self, id: &CellId) {
+        let _ = self.closed.send(id.clone());
+    }
+}
+fn delegate() -> (
+    Arc<Delegate>,
+    mpsc::UnboundedReceiver<CellId>,
+    mpsc::UnboundedReceiver<()>,
+) {
+    let (closed, closed_rx) = mpsc::unbounded_channel();
+    let (tools, tools_rx) = mpsc::unbounded_channel();
+    (
+        Arc::new(Delegate {
+            closed,
+            tools,
+            calls: AtomicUsize::new(0),
+            release: tokio::sync::Notify::new(),
+        }),
+        closed_rx,
+        tools_rx,
+    )
+}
+fn request(source: &str) -> ExecuteRequest {
+    ExecuteRequest {
+        tool_call_id: "state-test".into(),
+        enabled_tools: vec![],
+        source: source.into(),
+        yield_time_ms: Some(60_000),
+        max_output_tokens: Some(1000),
+    }
+}
+async fn run(session: &Arc<dyn CodeModeSession>, source: &str) -> Result<RuntimeResponse> {
+    let (delegate, mut closed, _) = delegate();
+    let response = session
+        .execute(request(source), delegate.clone(), None)
+        .await
+        .map_err(anyhow::Error::msg)?
+        .initial_response()
+        .await
+        .map_err(anyhow::Error::msg)?;
+    closed.recv().await.context("cell closure")?;
+    assert_eq!(delegate.calls.load(Ordering::SeqCst), 0);
+    assert!(
+        matches!(
+            &response,
+            RuntimeResponse::Result {
+                error_text: None,
+                ..
+            }
+        ),
+        "{response:?}"
+    );
+    Ok(response)
+}
+
+#[tokio::test]
+async fn finalized_json_survives_host_kill_and_fresh_provider_without_replay_or_id_alias()
+-> Result<()> {
+    let (mut child, provider) = host().await?;
+    let spare = provider
+        .create_session()
+        .await
+        .map_err(anyhow::Error::msg)?;
+    let session = provider
+        .create_session()
+        .await
+        .map_err(anyhow::Error::msg)?;
+    spare.shutdown().await.map_err(anyhow::Error::msg)?;
+    let first = run(
+        &session,
+        r#"store("answer", {items:[null,true,2.5], text:"héllo", count:1}); text("saved");"#,
+    )
+    .await?;
+    assert!(matches!(first, RuntimeResponse::Result { cell_id, .. } if cell_id.as_str() == "g2:1"));
+    let state = session.export_state().await.map_err(anyhow::Error::msg)?;
+    assert_eq!(state.next_cell_id, 2);
+    assert_eq!(state.cell_id_generation, 2);
+    assert_eq!(
+        state.stored_values["answer"],
+        json!({"items":[null,true,2.5], "text":"héllo", "count":1})
+    );
+    child.kill().await?;
+    assert!(
+        session.export_state().await.is_err(),
+        "a dead host must not become an empty new snapshot"
+    );
+
+    let (mut fresh_child, fresh_provider) = host().await?;
+    let probe = fresh_provider
+        .create_session()
+        .await
+        .map_err(anyhow::Error::msg)?;
+    let empty = run(&probe, r#"text(String(load("answer")));"#).await?;
+    assert!(
+        matches!(empty, RuntimeResponse::Result { content_items, .. } if content_items == vec![FunctionCallOutputContentItem::InputText { text: "undefined".into() }])
+    );
+    probe.shutdown().await.map_err(anyhow::Error::msg)?;
+    let fresh = fresh_provider
+        .create_session()
+        .await
+        .map_err(anyhow::Error::msg)?;
+    let mut invalid = state.clone();
+    invalid.format_version = 99;
+    assert!(fresh.import_state(invalid).await.is_err());
+    fresh
+        .import_state(state.clone())
+        .await
+        .map_err(anyhow::Error::msg)?;
+    fresh
+        .import_state(state.clone())
+        .await
+        .map_err(anyhow::Error::msg)?;
+    assert_eq!(
+        fresh.export_state().await.map_err(anyhow::Error::msg)?,
+        state,
+        "import must not execute any cell"
+    );
+    let read = run(
+        &fresh,
+        r#"text(JSON.stringify(load("answer"))); store("answer", {count:2});"#,
+    )
+    .await?;
+    assert!(
+        matches!(read, RuntimeResponse::Result { cell_id, content_items, .. } if cell_id.as_str() == "g2:2" && content_items == vec![FunctionCallOutputContentItem::InputText { text: serde_json::to_string(&state.stored_values["answer"])? }])
+    );
+    assert!(
+        fresh.import_state(state).await.is_err(),
+        "stale import cannot roll back execution"
+    );
+    let after = fresh.export_state().await.map_err(anyhow::Error::msg)?;
+    assert_eq!(after.next_cell_id, 3);
+    assert_eq!(after.stored_values["answer"], json!({"count":2}));
+    assert!(matches!(
+        fresh
+            .wait(
+                WaitRequest {
+                    cell_id: CellId::new("g2:1".into()),
+                    yield_time_ms: 0,
+                    max_output_tokens: None
+                },
+                None
+            )
+            .await
+            .map_err(anyhow::Error::msg)?,
+        WaitOutcome::MissingCell(_)
+    ));
+    let other = fresh_provider
+        .create_session()
+        .await
+        .map_err(anyhow::Error::msg)?;
+    let other_result = run(&other, "text('new namespace');").await?;
+    assert!(
+        matches!(other_result, RuntimeResponse::Result { cell_id, .. } if cell_id.as_str() == "g3:1")
+    );
+    fresh.shutdown().await.map_err(anyhow::Error::msg)?;
+    other.shutdown().await.map_err(anyhow::Error::msg)?;
+    fresh_child.kill().await?;
+    Ok(())
+}
+
+#[tokio::test]
+async fn active_cells_refuse_capture_without_replaying_or_stopping_their_tools() -> Result<()> {
+    let (mut child, provider) = host().await?;
+    let session = provider
+        .create_session()
+        .await
+        .map_err(anyhow::Error::msg)?;
+    let (delegate, mut closed, mut tools) = delegate();
+    let mut execute = request(r#"await tools.hold({}); store("finished", true); text("done");"#);
+    execute.enabled_tools.push(ToolDefinition {
+        name: "hold".into(),
+        tool_name: ToolName::plain("hold"),
+        description: String::new(),
+        kind: CodeModeToolKind::Function,
+        input_schema: None,
+        input_schema_max_bytes: None,
+        output_schema: None,
+    });
+    let preempt = CancellationToken::new();
+    let started = session
+        .execute(execute, delegate.clone(), Some(preempt.clone()))
+        .await
+        .map_err(anyhow::Error::msg)?;
+    let id = started.cell_id.clone();
+    tools.recv().await.context("tool admission")?;
+    preempt.cancel();
+    assert!(matches!(
+        started
+            .initial_response()
+            .await
+            .map_err(anyhow::Error::msg)?,
+        RuntimeResponse::Yielded { .. }
+    ));
+    let error = session.export_state().await.unwrap_err();
+    assert!(error.contains("cells and unconsumed results"), "{error}");
+    assert_eq!(delegate.calls.load(Ordering::SeqCst), 1);
+    delegate.release.notify_one();
+    let result = session
+        .wait(
+            WaitRequest {
+                cell_id: id,
+                yield_time_ms: 60_000,
+                max_output_tokens: None,
+            },
+            None,
+        )
+        .await
+        .map_err(anyhow::Error::msg)?;
+    assert!(matches!(
+        result,
+        WaitOutcome::LiveCell(RuntimeResponse::Result {
+            error_text: None,
+            ..
+        })
+    ));
+    closed.recv().await.context("closed cell")?;
+    let state = session.export_state().await.map_err(anyhow::Error::msg)?;
+    assert_eq!(state.stored_values["finished"], json!(true));
+    assert_eq!(delegate.calls.load(Ordering::SeqCst), 1);
+    session.shutdown().await.map_err(anyhow::Error::msg)?;
+    child.kill().await?;
+    Ok(())
+}
+
+#[tokio::test]
+async fn explicit_import_recovers_a_lost_host_without_replacing_state_during_export() -> Result<()>
+{
+    let (mut child, provider, endpoint) = host_at("grpc://127.0.0.1:0").await?;
+    let session = provider
+        .create_session()
+        .await
+        .map_err(anyhow::Error::msg)?;
+    run(&session, "store('retained', 7);").await?;
+    let state = session.export_state().await.map_err(anyhow::Error::msg)?;
+    child.kill().await?;
+    let listen = endpoint.replacen("http://", "grpc://", 1);
+    let (mut replacement, _, _) = host_at(&listen).await?;
+    // The dead session ID cannot export empty replacement data. This actual RPC
+    // or its lease closure marks the missing binding; no execution is replayed.
+    assert!(session.export_state().await.is_err());
+    session
+        .import_state(state.clone())
+        .await
+        .map_err(anyhow::Error::msg)?;
+    assert_eq!(
+        session.export_state().await.map_err(anyhow::Error::msg)?,
+        state
+    );
+    let result = run(&session, "text(String(load('retained')));").await?;
+    assert!(
+        matches!(result, RuntimeResponse::Result { cell_id, content_items, .. }
+        if cell_id.as_str() == "2" && content_items == vec![FunctionCallOutputContentItem::InputText { text: "7".into() }])
+    );
+    session.shutdown().await.map_err(anyhow::Error::msg)?;
+    replacement.kill().await?;
+    Ok(())
+}
+
+#[tokio::test]
+async fn imported_generation_cannot_wrap_and_alias_old_cells() -> Result<()> {
+    let (mut child, provider) = host().await?;
+    let session = provider
+        .create_session()
+        .await
+        .map_err(anyhow::Error::msg)?;
+    let mut state = session.export_state().await.map_err(anyhow::Error::msg)?;
+    state.cell_id_generation = u64::MAX - 1;
+    session
+        .import_state(state)
+        .await
+        .map_err(anyhow::Error::msg)?;
+    let error = provider
+        .create_session()
+        .await
+        .err()
+        .context("exhausted generation must fail")?;
+    assert!(
+        error.contains("exhausted its host generation space"),
+        "{error}"
+    );
+    let result = run(&session, "text('same namespace');").await?;
+    assert!(
+        matches!(result, RuntimeResponse::Result { cell_id, .. } if cell_id.as_str() == format!("g{}:1", u64::MAX - 1))
+    );
+    session.shutdown().await.map_err(anyhow::Error::msg)?;
+    child.kill().await?;
+    Ok(())
+}
