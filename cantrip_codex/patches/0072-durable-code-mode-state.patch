+#[tokio::test]
+async fn stored_state_joins_real_producers_and_reopens_after_cancelled_capture() {
+    use futures::FutureExt;
+    let runtime = SessionRuntime::new();
+    let (release, released) = tokio::sync::oneshot::channel::<()>();
+    runtime.inner.cell_tasks.spawn(async {
+        released.await.unwrap();
+    });
+    let mut capture = Box::pin(runtime.export_state());
+    assert!(capture.as_mut().now_or_never().is_none());
+    assert!(runtime.inner.cell_tasks.is_closed());
+    drop(capture);
+    assert!(!runtime.inner.cell_tasks.is_closed());
+    release.send(()).unwrap();
+    assert_eq!(runtime.export_state().await.unwrap().next_cell_id, 1);
+    assert!(!runtime.inner.cell_tasks.is_closed());
+}
