+/// Finalized JSON data only: no source, isolate, callbacks, tools, or authority.
+/// The caller must keep execution held from capture through durable pause.
+#[derive(Clone, Debug, Deserialize, PartialEq, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct CodeModeSessionState {
+    pub format_version: u32,
+    pub next_cell_id: u64,
+    pub cell_id_generation: u64,
+    pub stored_values: BTreeMap<String, JsonValue>,
+}
+
+impl CodeModeSessionState {
+    pub const MAX_BYTES: usize = 32 * 1024 * 1024;
+
+    pub fn validate(&self) -> Result<(), String> {
+        if self.format_version != 1
+            || self.next_cell_id == 0
+            || self.cell_id_generation == 0
+            || self.cell_id_generation == u64::MAX
+        {
+            return Err("code-mode stored-state version or cell identity is unsupported".into());
+        }
+        let bytes =
+            serde_json::to_vec(self).map_err(|_| "code-mode stored state could not be encoded")?;
+        if bytes.len() > Self::MAX_BYTES {
+            return Err("code-mode stored state exceeds the durable resource limit".into());
+        }
+        Ok(())
+    }
+}
+
 /// A durable code-mode session owned by one Codex thread.
 ///
 /// Cells executed in the same session share stored values. Separate sessions
@@ -210,6 +242,22 @@ pub trait CodeModeSession: Send + Sync {
         request: TerminateRequest,
     ) -> CodeModeSessionResultFuture<'a, WaitOutcome>;
 
+    /// Captures a quiescent, already-open session. Must never reconnect to an
+    /// empty replacement host or omit state when the actual host is unavailable.
+    fn export_state(&self) -> CodeModeSessionResultFuture<'_, CodeModeSessionState> {
+        Box::pin(async {
+            Err("this code-mode provider does not support durable stored state; live Resume and Stop remain available".into())
+        })
+    }
+
+    /// Imports data into a pristine session, without executing a cell. Retrying
+    /// the same import before execution is idempotent; replacing used state fails.
+    fn import_state(&self, _state: CodeModeSessionState) -> CodeModeSessionResultFuture<'_, ()> {
+        Box::pin(async {
+            Err("this code-mode provider does not support durable stored-state restoration".into())
+        })
+    }
+
     fn shutdown<'a>(&'a self) -> CodeModeSessionResultFuture<'a, ()>;
 }
 
