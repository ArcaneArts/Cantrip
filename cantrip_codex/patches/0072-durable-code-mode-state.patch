+    let started = runtime
+        .execute(
+            execute_request("store('v', 7);"),
+            ObserveMode::PendingFrontier,
+            Arc::new(PanickingClosedDelegate),
+        )
+        .await
+        .unwrap();
+    started.initial_event().await.unwrap();
+    failure_rx.recv().await.unwrap();
+    for _ in 0..2 {
+        assert!(
+            runtime
+                .export_state()
+                .await
+                .unwrap_err()
+                .contains("producer failed")
+        );
+    }
+}
