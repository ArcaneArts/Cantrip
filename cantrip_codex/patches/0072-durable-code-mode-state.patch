+#[tokio::test]
+async fn stored_state_import_is_atomic_and_rejects_replacement_after_execution() {
+    let runtime = SessionRuntime::new();
+    let original = CodeModeSessionState {
+        format_version: 1,
+        next_cell_id: 42,
+        cell_id_generation: 1,
+        stored_values: [(
+            "value".into(),
+            serde_json::json!({"nested": [true, null, 2.5]}),
+        )]
+        .into(),
+    };
+    runtime.import_state(original.clone()).await.unwrap();
+    runtime.import_state(original.clone()).await.unwrap();
+    assert_eq!(runtime.export_state().await.unwrap(), original);
+    let mut changed = original.clone();
+    changed.stored_values.clear();
+    assert!(
+        runtime
+            .import_state(changed)
+            .await
+            .unwrap_err()
+            .contains("pristine")
+    );
+    assert_eq!(runtime.export_state().await.unwrap(), original);
+    let started = runtime
+        .execute(
+            execute_request("text(String(load('value').nested[2]));"),
+            ObserveMode::PendingFrontier,
+            Arc::new(RecordingDelegate),
+        )
+        .await
+        .unwrap();
+    assert_eq!(started.cell_id.as_str(), "42");
+    assert!(matches!(
+        started.initial_event().await.unwrap(),
+        CellEvent::Completed {
+            error_text: None,
+            ..
+        }
+    ));
+    // Shutdown joins the actual producer; inspect its committed counter directly.
+    runtime.shutdown().await.unwrap();
+    assert_eq!(runtime.inner.next_cell_id.load(Ordering::Relaxed), 43);
+    assert!(
+        runtime
+            .import_state(original)
+            .await
+            .unwrap_err()
+            .contains("shutting down")
+    );
+}
