+    /// Releases this thread's real clients without permanently closing its router.
+    /// Callers serialize publication and fence interaction registration first.
+    pub fn suspend(
+        &self,
+    ) -> impl std::future::Future<Output = Result<(), tokio::task::JoinError>> + Send + 'static
+    {
+        let current = self.current.load_full();
+        let prefix = current
+            .config
+            .as_ref()
+            .is_none_or(|config| config.prefix_mcp_tool_names);
+        let empty = Self::empty(prefix);
+        let current = self.current.swap(empty.current.load_full());
+        let superseded = std::mem::take(
+            &mut *self
+                .superseded_connections
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner),
+        );
+        {
+            let mut cancellation = self
+                .event_stream_cancellation
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            cancellation.event_server_available = false;
+            cancellation
+                .cancel_event_streams_on_server_removal
+                .send_replace(());
+            if let Some(retained) = &cancellation.retained_subscription_cancellation {
+                retained.send_replace(());
+            }
+        }
+        let mut connections = superseded
+            .into_iter()
+            .filter_map(|connections| connections.upgrade())
+            .collect::<Vec<_>>();
+        connections.push(Arc::clone(&current.connections));
+        for connection in &connections {
+            connection.fence_suspension();
+        }
+        self.reconnect_on_next_refresh();
+        self.invalidate_resource_caches();
+        // Detach publication and revoke callbacks synchronously under the
+        // owner's control fence. Actual cleanup survives caller cancellation.
+        let cleanup = tokio::spawn(async move {
+            for connection in connections {
+                connection.suspend().await;
+            }
+        });
+        async move { cleanup.await }
+    }
