+#[test]
+fn suspension_fences_new_mcp_requests_without_losing_existing_responders() {
+    let service = ElicitationService::new();
+    let existing = service.try_register().expect("live request");
+    assert!(
+        !service.suspend(),
+        "an actual pending request refuses the boundary"
+    );
+    assert!(
+        service.try_register().is_err(),
+        "no later request can race the boundary"
+    );
+    drop(existing);
+    assert!(
+        service.suspend(),
+        "the answered request releases the boundary"
+    );
+    assert!(service.try_register().is_err());
+    service.resume();
+    let _fresh = service
+        .try_register()
+        .expect("explicit resumption reopens requests");
+}
+
+#[test]
+fn repeated_hold_and_resume_does_not_change_the_outstanding_count() {
+    let service = ElicitationService::new();
+    assert!(service.suspend());
+    assert!(service.suspend());
+    service.resume();
+    service.resume();
+    let active = service.try_register().expect("fresh interaction");
+    assert!(!service.suspend());
+    drop(active);
+    assert!(service.suspend());
+}
