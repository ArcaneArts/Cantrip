+#[derive(Default)]
+enum CheckpointOwner {
+    #[default]
+    Unacquired,
+    Acquired(LockedCheckpoint<SavedTurn>),
+    Released,
+}
+
+/// A terminated runtime must release the OS lock before a replacement is
+/// attached, even while its app-server request still holds references to it.
+pub(super) fn release_checkpoint_on_shutdown(session: &Session) {
+    if let Some(owner) = session
+        .services
+        .thread_extension_data
+        .get::<DurableSuspension>()
+    {
+        *owner
+            .store
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner) = CheckpointOwner::Released;
+    }
 }
 
