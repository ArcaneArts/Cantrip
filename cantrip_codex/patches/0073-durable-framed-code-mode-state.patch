+#[test]
+fn stored_state_identity_survives_json_consumers_without_number_rounding() {
+    use crate::CodeModeSessionState;
+    let state = CodeModeSessionState {
+        format_version: 2,
+        next_cell_id: 9_007_199_254_740_993,
+        cell_id_generation: u64::MAX - 1,
+        stored_values: [("ordinaryJson".into(), serde_json::json!([true, null, 2.5]))].into(),
+    };
+    state.validate().unwrap();
+    let json = serde_json::to_value(&state).unwrap();
+    assert_eq!(json["nextCellId"], "9007199254740993");
+    assert_eq!(json["cellIdGeneration"], "18446744073709551614");
+    let decoded: CodeModeSessionState = serde_json::from_value(json.clone()).unwrap();
+    assert_eq!(decoded, state);
+    for invalid in [
+        serde_json::json!(9007199254740992_u64),
+        serde_json::json!("09007199254740993"),
+        serde_json::json!("18446744073709551616"),
+    ] {
+        let mut invalid_json = json.clone();
+        invalid_json["nextCellId"] = invalid;
+        assert!(serde_json::from_value::<CodeModeSessionState>(invalid_json).is_err());
+    }
+    let legacy = CodeModeSessionState {
+        format_version: 1,
+        ..state
+    };
+    assert!(legacy.validate().unwrap_err().contains("unsupported"));
+}
