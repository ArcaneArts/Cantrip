+#[tokio::test]
+async fn framed_stored_state_refuses_active_cells_and_retains_live_controls() {
+    let provider = ProcessOwnedCodeModeSessionProvider::with_host_program(
+        codex_utils_cargo_bin::cargo_bin("codex-code-mode-host").unwrap(),
+    );
+    let session = provider.create_session().await.unwrap();
+    let (delegate, mut events) = CancellationDelegate::new();
+    let signal = CancellationToken::new();
+    let mut request =
+        execute_request("await tools.tool_call_fast(); store('finished',true); text('done');");
+    request.enabled_tools = vec![ToolDefinition {
+        name: "tool_call_fast".into(),
+        tool_name: ToolName::plain("tool_call_fast"),
+        description: String::new(),
+        kind: CodeModeToolKind::Function,
+        input_schema: None,
+        input_schema_max_bytes: None,
+        output_schema: None,
+    }];
+    request.yield_time_ms = Some(60_000);
+    let started = session
+        .execute(request, delegate.clone(), Some(signal.clone()))
+        .await
+        .unwrap();
+    let id = started.cell_id.clone();
+    assert_eq!(
+        events.recv().await.unwrap(),
+        CallbackEvent::Started("tool_call_fast".into())
+    );
+    signal.cancel();
+    assert!(matches!(
+        started.initial_response().await.unwrap(),
+        RuntimeResponse::Yielded { .. }
+    ));
+    let error = session.export_state().await.unwrap_err();
+    assert!(error.contains("cells and unconsumed results"), "{error}");
+    delegate.fast_tool_release.add_permits(1);
+    let outcome = session
+        .wait(
+            WaitRequest {
+                cell_id: id,
+                yield_time_ms: 60_000,
+                max_output_tokens: None,
+            },
+            None,
+        )
+        .await
+        .unwrap();
+    assert!(matches!(
+        outcome,
+        WaitOutcome::LiveCell(RuntimeResponse::Result {
+            error_text: None,
+            ..
+        })
+    ));
+    assert!(matches!(
+        events.recv().await.unwrap(),
+        CallbackEvent::CellClosed(_)
+    ));
+    let state = session.export_state().await.unwrap();
+    assert_eq!(state.stored_values["finished"], json!(true));
+    session.shutdown().await.unwrap();
+}
+
+#[tokio::test]
+async fn framed_stored_state_rejects_unsupported_data_and_prevents_generation_wrap() {
+    let provider = ProcessOwnedCodeModeSessionProvider::with_host_program(
+        codex_utils_cargo_bin::cargo_bin("codex-code-mode-host").unwrap(),
+    );
+    let session = provider.create_session().await.unwrap();
+    let original = session.export_state().await.unwrap();
+    let mut invalid = original.clone();
+    invalid.format_version = 99;
+    assert!(session.import_state(invalid).await.is_err());
+    assert_eq!(session.export_state().await.unwrap(), original);
+    let mut state = original;
+    state.cell_id_generation = u64::MAX - 1;
+    session.import_state(state).await.unwrap();
+    let error = provider
+        .create_session()
+        .await
+        .err()
+        .expect("generation exhaustion must fail");
+    assert!(
+        error.contains("exhausted its host generation space"),
+        "{error}"
+    );
+    let result = stored_state_run(&session, "text('retained namespace');").await;
+    assert!(
+        matches!(result, RuntimeResponse::Result { cell_id, .. } if cell_id.as_str() == format!("g{}:1",u64::MAX-1))
+    );
+    session.shutdown().await.unwrap();
+}
