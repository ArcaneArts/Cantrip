+#[tokio::test]
+async fn stored_state_old_host_refuses_new_controls_without_breaking_live_session() {
+    let mut harness = DriverHarness::start();
+    let session = remote_session();
+    let _cleanup = harness.open(session.clone()).await;
+    let connection = Connection {
+        command_tx: harness.command_tx.clone(),
+        execute_claim_tx: harness.execute_claim_tx.clone(),
+        alive: Arc::clone(&harness.alive),
+        failure: Arc::clone(&harness.failure),
+        cancellation: harness.cancellation.clone(),
+        capabilities: CapabilitySet::empty(),
+    };
+    assert!(
+        connection
+            .export_state(session.clone())
+            .await
+            .unwrap_err()
+            .contains("does not support durable stored state")
+    );
+    assert!(
+        connection
+            .import_state(session.clone(), saved_state(1))
+            .await
+            .unwrap_err()
+            .contains("does not support durable stored state")
+    );
+    assert!(matches!(
+        harness.outgoing_rx.try_recv(),
+        Err(mpsc::error::TryRecvError::Empty)
+    ));
+    let started = harness
+        .start_cell(session, 2, "1", Arc::new(RecordingDelegate::default()))
+        .await;
+    assert_eq!(started.cell_id.as_str(), "1");
+    assert!(harness.alive.load(Ordering::Acquire));
+}
