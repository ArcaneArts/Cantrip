+#[cfg(unix)]
+#[tokio::test]
+async fn framed_stored_state_survives_process_death_with_fresh_and_surviving_providers() {
+    let host = codex_utils_cargo_bin::cargo_bin("codex-code-mode-host").expect("host");
+    let directory = tempfile::tempdir().expect("fixture storage");
+    let program = directory.path().join("state-host.sh");
+    let pid_file = directory.path().join("host.pid");
+    let quote = |value: &std::path::Path| {
+        format!("'{}'", value.display().to_string().replace('\'', "'\\''"))
+    };
+    codex_utils_cargo_bin::write_executable(
+        &program,
+        &format!(
+            "#!/bin/sh\nprintf '%s\\n' \"$$\" >> {}\nexec {} \"$@\"\n",
+            quote(&pid_file),
+            quote(&host)
+        ),
+    )
+    .expect("host wrapper");
+    let provider = ProcessOwnedCodeModeSessionProvider::with_host_program(program.clone());
+    let spare = provider.create_session().await.expect("first namespace");
+    let session = provider.create_session().await.expect("original session");
+    spare.shutdown().await.unwrap();
+    let first = stored_state_run(
+        &session,
+        r#"store("private", {nested:[null,true,2.5],text:"héllo",count:1}); text("saved");"#,
+    )
+    .await;
+    assert!(matches!(first, RuntimeResponse::Result { cell_id, .. } if cell_id.as_str() == "g2:1"));
+    let state = session
+        .export_state()
+        .await
+        .expect("capture actual finalized data");
+    assert_eq!(state.cell_id_generation, 2);
+    assert_eq!(state.next_cell_id, 2);
+    let pid_text = std::fs::read_to_string(&pid_file).expect("wrapper wrote before session opened");
+    let pid = pid_text.lines().last().expect("actual child PID");
+    assert!(
+        tokio::process::Command::new("kill")
+            .args(["-KILL", pid])
+            .status()
+            .await
+            .unwrap()
+            .success()
+    );
+    assert!(session.export_state().await.is_err());
+    assert_eq!(
+        std::fs::read_to_string(&pid_file).unwrap(),
+        pid_text,
+        "export must not start a replacement"
+    );
+
+    let fresh_provider = ProcessOwnedCodeModeSessionProvider::with_host_program(program);
+    let fresh = fresh_provider
+        .create_session()
+        .await
+        .expect("fresh process/session");
+    fresh
+        .import_state(state.clone())
+        .await
+        .expect("import saved namespace into new transport lease");
+    fresh
+        .import_state(state.clone())
+        .await
+        .expect("idempotent lost-ACK retry");
+    assert_eq!(fresh.export_state().await.unwrap(), state);
+    let result = stored_state_run(
+        &fresh,
+        "text(String(load('private').count)); store('private', {count:2});",
+    )
+    .await;
+    assert!(
+        matches!(result, RuntimeResponse::Result { cell_id, content_items, .. }
+        if cell_id.as_str() == "g2:2" && content_items == vec![FunctionCallOutputContentItem::InputText { text:"1".into() }])
+    );
+    assert!(
+        fresh.import_state(state.clone()).await.is_err(),
+        "stale import cannot reset executed state"
+    );
+    let after = fresh.export_state().await.unwrap();
+    assert_eq!(after.next_cell_id, 3);
+    assert_eq!(after.stored_values["private"], json!({"count":2}));
+    let missing = fresh
+        .wait(
+            WaitRequest {
+                cell_id: cell_id("g2:1"),
+                yield_time_ms: 0,
+                max_output_tokens: None,
+            },
+            None,
+        )
+        .await
+        .unwrap();
+    assert!(
+        matches!(missing, WaitOutcome::MissingCell(RuntimeResponse::Result { cell_id, .. }) if cell_id.as_str() == "g2:1")
+    );
+    let other = fresh_provider.create_session().await.unwrap();
+    let other_result = stored_state_run(&other, "text(String(load('private')));").await;
+    assert!(
+        matches!(other_result, RuntimeResponse::Result { cell_id, content_items, .. }
+        if cell_id.as_str() == "g3:1" && content_items == vec![FunctionCallOutputContentItem::InputText { text:"undefined".into() }])
+    );
+
+    session
+        .import_state(state.clone())
+        .await
+        .expect("explicit recovery of lost shared host");
+    assert_eq!(session.export_state().await.unwrap(), state);
+    let restored = stored_state_run(&session, "text(String(load('private').count));").await;
+    assert!(
+        matches!(restored, RuntimeResponse::Result { cell_id, content_items, .. }
+        if cell_id.as_str() == "g2:2" && content_items == vec![FunctionCallOutputContentItem::InputText { text:"1".into() }])
+    );
+    assert_eq!(
+        std::fs::read_to_string(pid_file).unwrap().lines().count(),
+        3
+    );
+    session.shutdown().await.unwrap();
+    fresh.shutdown().await.unwrap();
+    other.shutdown().await.unwrap();
+}
