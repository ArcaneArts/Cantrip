+#[tokio::test]
+async fn stored_state_rejects_foreign_export_response_without_accepting_empty_state() {
+    let mut harness = DriverHarness::start();
+    let session = remote_session();
+    let _cleanup = harness.open(session.clone()).await;
+    let (reply, receiver) = oneshot::channel();
+    harness
+        .command_tx
+        .send(DriverCommand::ExportState {
+            session,
+            caller_cancellation: CancellationToken::new(),
+            response_tx: reply,
+        })
+        .await
+        .unwrap();
+    harness.outgoing_rx.recv().await.unwrap();
+    harness
+        .event_tx
+        .send(DriverEvent::HostMessage(HostToClient::Response {
+            id: RequestId::new(2),
+            result: WireResult::Ok {
+                value: HostResponse::StateExported {
+                    session_id: SessionId::new("foreign-session").unwrap(),
+                    state: saved_state(1),
+                },
+            },
+        }))
+        .await
+        .unwrap();
+    assert!(
+        receiver
+            .await
+            .unwrap()
+            .unwrap_err()
+            .contains("invalid state export response")
+    );
+}
