+#[tokio::test]
+async fn stored_state_lost_import_reply_commits_namespace_without_changing_live_lease() {
+    let mut harness = DriverHarness::start();
+    let session = remote_session();
+    let _cleanup = harness.open(session.clone()).await;
+    let cancellation = CancellationToken::new();
+    let (reply, receiver) = oneshot::channel();
+    harness
+        .command_tx
+        .send(DriverCommand::ImportState {
+            session: session.clone(),
+            state: saved_state(9),
+            caller_cancellation: cancellation.clone(),
+            response_tx: reply,
+        })
+        .await
+        .unwrap();
+    let frame = harness.outgoing_rx.recv().await.unwrap();
+    assert!(
+        matches!(EncodedFrame::decode_framed::<ClientToHost>(&frame.into_framed_bytes()).unwrap(),
+        ClientToHost::Request { id, request: HostRequest::ImportState { state, .. } }
+        if id == RequestId::new(2) && state.cell_id_generation == 1)
+    );
+    // Cancel after the host accepted the operation, before its reply arrives.
+    // The late successful reply must settle driver metadata even with no caller.
+    drop(receiver);
+    cancellation.cancel();
+    let frame = harness.outgoing_rx.recv().await.unwrap();
+    assert!(
+        matches!(EncodedFrame::decode_framed::<ClientToHost>(&frame.into_framed_bytes()).unwrap(),
+        ClientToHost::CancelRequest { id } if id == RequestId::new(2))
+    );
+    harness
+        .event_tx
+        .send(DriverEvent::HostMessage(HostToClient::Response {
+            id: RequestId::new(2),
+            result: WireResult::Ok {
+                value: HostResponse::StateImported {
+                    session_id: session.id.clone(),
+                },
+            },
+        }))
+        .await
+        .unwrap();
+
+    let (reply, receiver) = oneshot::channel();
+    harness
+        .command_tx
+        .send(DriverCommand::ExportState {
+            session: session.clone(),
+            caller_cancellation: CancellationToken::new(),
+            response_tx: reply,
+        })
+        .await
+        .unwrap();
+    let frame = harness.outgoing_rx.recv().await.unwrap();
+    assert!(
+        matches!(EncodedFrame::decode_framed::<ClientToHost>(&frame.into_framed_bytes()).unwrap(),
+        ClientToHost::Request { id, request: HostRequest::ExportState { .. } } if id == RequestId::new(3))
+    );
+    harness
+        .event_tx
+        .send(DriverEvent::HostMessage(HostToClient::Response {
+            id: RequestId::new(3),
+            result: WireResult::Ok {
+                value: HostResponse::StateExported {
+                    session_id: session.id.clone(),
+                    state: saved_state(1),
+                },
+            },
+        }))
+        .await
+        .unwrap();
+    assert_eq!(receiver.await.unwrap().unwrap(), saved_state(9));
+    let (reply, receiver) = oneshot::channel();
+    harness
+        .command_tx
+        .send(DriverCommand::ImportState {
+            session: session.clone(),
+            state: saved_state(9),
+            caller_cancellation: CancellationToken::new(),
+            response_tx: reply,
+        })
+        .await
+        .unwrap();
+    harness.outgoing_rx.recv().await.unwrap();
+    harness
+        .event_tx
+        .send(DriverEvent::HostMessage(HostToClient::Response {
+            id: RequestId::new(4),
+            result: WireResult::Ok {
+                value: HostResponse::StateImported {
+                    session_id: session.id.clone(),
+                },
+            },
+        }))
+        .await
+        .unwrap();
+    receiver.await.unwrap().unwrap();
+    let started = harness
+        .start_cell(
+            session.clone(),
+            5,
+            "42",
+            Arc::new(RecordingDelegate::default()),
+        )
+        .await;
+    assert_eq!(started.cell_id.as_str(), "g9:42");
+    harness
+        .event_tx
+        .send(DriverEvent::HostMessage(HostToClient::InitialResponse {
+            id: RequestId::new(5),
+            result: WireResult::Ok {
+                value: WireRuntimeResponse::Yielded {
+                    cell_id: CellId::new("42".into()).into(),
+                    content_items: vec![],
+                    code_mode_host_duration_ns: 1,
+                },
+            },
+        }))
+        .await
+        .unwrap();
+    assert!(
+        matches!(started.initial_response().await.unwrap(), codex_code_mode_protocol::RuntimeResponse::Yielded { cell_id, .. } if cell_id.as_str() == "g9:42")
+    );
+    assert!(harness.alive.load(Ordering::Acquire));
+}
