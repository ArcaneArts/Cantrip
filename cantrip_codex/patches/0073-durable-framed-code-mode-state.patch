+async fn stored_state_run(session: &Arc<dyn CodeModeSession>, source: &str) -> RuntimeResponse {
+    let (delegate, mut events) = CancellationDelegate::new();
+    let response = execute(session, execute_request(source), delegate).await;
+    assert!(
+        matches!(
+            &response,
+            RuntimeResponse::Result {
+                error_text: None,
+                ..
+            }
+        ),
+        "{response:?}"
+    );
+    assert!(matches!(
+        events.recv().await.expect("actual cell closure"),
+        CallbackEvent::CellClosed(_)
+    ));
+    response
+}
