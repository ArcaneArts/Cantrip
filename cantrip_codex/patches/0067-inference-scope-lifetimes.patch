+    /// Only the live pending request can originate worker-owned admission.
+    /// Resolution/cancellation removes this authority; no completed-request
+    /// cache or retention window participates in this decision.
+    pub fn claim_inference(
+        &self,
+        thread_id: ThreadId,
+        turn_id: &str,
+        scope_id: &str,
+        attempt_id: &str,
+    ) -> Result<bool, String> {
+        let state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if state.closed {
+            return Ok(false);
+        }
+        let Some((expected_thread, expected_turn, expected_scope, reply)) =
+            state.inference_requests.get(attempt_id)
+        else {
+            return Ok(false);
+        };
+        if *expected_thread != thread_id
+            || expected_turn.as_str() != turn_id
+            || expected_scope.as_str() != scope_id
+        {
+            return Err("inference request no longer owns this scope".into());
+        }
+        Ok(!reply.is_closed())
+    }
