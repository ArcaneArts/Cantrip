@@ -191,3 +191,41 @@
+    pub(crate) async fn managed_execution_inference_claim(
+        &self,
+        request_id: &ConnectionRequestId,
+        params: codex_app_server_protocol::ManagedExecutionInferenceClaimParams,
+    ) -> Result<Option<ClientResponsePayload>, JSONRPCErrorError> {
+        // Children need not be public UI threads. The connection-owned gate's
+        // actual pending map is the authority, rather than load_thread or a
+        // cached claim that can outlive this particular native request.
+        let gate = {
+            let gates = self
+                .outgoing
+                .managed_execution_gates
+                .lock()
+                .unwrap_or_else(std::sync::PoisonError::into_inner);
+            gates
+                .get(&params.runner_generation)
+                .and_then(|(owner, gate)| {
+                    (*owner == request_id.connection_id).then(|| gate.clone())
+                })
+        };
+        let thread_id = codex_protocol::ThreadId::from_string(&params.thread_id)
+            .map_err(|_| invalid_params("invalid inference thread id"))?;
+        let claimed = if let Some(gate) = gate {
+            gate.claim_inference(
+                thread_id,
+                &params.turn_id,
+                &params.scope_id,
+                &params.attempt_id,
+            )
+            .map_err(invalid_params)?
+        } else {
+            false
+        };
+        Ok(Some(
+            codex_app_server_protocol::ManagedExecutionInferenceClaimResponse { claimed }.into(),
+        ))
+    }
+
