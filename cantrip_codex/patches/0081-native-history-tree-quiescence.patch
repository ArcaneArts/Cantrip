+/// Retains the tree's actual execution admission lock through export.
+/// Provider ticket suspension does not establish native tree quiescence.
+pub(crate) struct HistoryExportGuard<'a> {
+    _state: tokio::sync::MutexGuard<'a, TransitionState>,
+}
+
 impl SecurityTransitions {
+    pub(crate) async fn history_export_guard(&self) -> CodexResult<HistoryExportGuard<'_>> {
+        let state = self.state.lock().await;
+        if !state.active.is_empty() {
+            return Err(CodexErr::InvalidRequest(
+                "cannot migrate history while the native agent tree is executing".into(),
+            ));
+        }
+        if state
+            .operations
+            .iter()
+            .any(|operation| operation.phase == ThreadSettingsOperationPhase::Pending)
+        {
+            return Err(CodexErr::InvalidRequest(
+                "cannot migrate history with pending native security settings".into(),
+            ));
+        }
+        if state.sessions.values().filter_map(Weak::upgrade).any(|session| {
+            session
+                .services
+                .thread_extension_data
+                .get::<crate::session::durable_suspension::DurableSuspension>()
+                .is_some_and(|suspension| {
+                    suspension.frozen.load(std::sync::atomic::Ordering::Acquire)
+                })
+        }) {
+            return Err(CodexErr::InvalidRequest(
+                "cannot migrate history while a native tree continuation is suspended".into(),
+            ));
+        }
+        Ok(HistoryExportGuard { _state: state })
+    }
+
     pub(crate) async fn register(
