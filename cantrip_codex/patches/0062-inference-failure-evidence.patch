+// The observation outlives the provider stream, not its UI consumer. Closing
+// before a completed/output event is a failed/cancelled stream, including EOF.
+struct InferenceStreamObservation(Option<Arc<crate::managed_inference::ManagedInferenceTurn>>);
+impl InferenceStreamObservation {
+    fn observe(&self, event: &std::result::Result<ResponseEvent, ApiError>) {
+        if let Some(owner) = &self.0 {
+            match event {
+                Err(_) => owner.model_failed(),
+                Ok(
+                    ResponseEvent::Created { .. }
+                    | ResponseEvent::SafetyBuffering(_)
+                    | ResponseEvent::ServerModel(_)
+                    | ResponseEvent::ModelVerifications(_)
+                    | ResponseEvent::TurnModerationMetadata(_)
+                    | ResponseEvent::ServerReasoningIncluded(_)
+                    | ResponseEvent::RateLimits(_)
+                    | ResponseEvent::ModelsEtag(_),
+                ) => {}
+                Ok(_) => owner.model_output(),
+            }
+        }
+    }
+}
+impl Drop for InferenceStreamObservation {
+    fn drop(&mut self) {
+        if let Some(owner) = &self.0 {
+            owner.model_failed();
+        }
+    }
+}
