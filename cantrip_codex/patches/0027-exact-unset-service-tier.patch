+    let standard = session
+        .update_settings(SessionSettingsUpdate {
+            step_settings: StepSettingsUpdate {
+                service_tier: Some(None),
+                ..Default::default()
+            },
+            ..Default::default()
+        })
+        .await
+        .unwrap();
+    assert_eq!(standard.snapshot.service_tier.as_deref(), Some("default"));
+    let unset = session
+        .update_settings(SessionSettingsUpdate {
+            unset_service_tier: true,
+            ..Default::default()
+        })
+        .await
+        .unwrap();
+    assert_eq!(unset.snapshot.service_tier, None);
+    let retained = session.restorable_thread_settings().await;
+    assert!(retained.unset_service_tier);
+    assert_eq!(retained.service_tier, None);
+    let (replacement, _) = make_session_and_context().await;
+    replacement
+        .update_settings(SessionSettingsUpdate {
+            step_settings: StepSettingsUpdate {
+                service_tier: Some(Some("priority".into())),
+                ..Default::default()
+            },
+            ..Default::default()
+        })
+        .await
+        .unwrap();
+    replacement
+        .update_settings(SessionSettingsUpdate {
+            unset_service_tier: retained.unset_service_tier,
+            step_settings: StepSettingsUpdate {
+                service_tier: retained.service_tier,
+                ..Default::default()
+            },
+            ..Default::default()
+        })
+        .await
+        .unwrap();
+    assert_eq!(
+        replacement.thread_settings_snapshot().await.service_tier,
+        None
+    );
+    let unchanged = session
+        .update_settings(SessionSettingsUpdate::default())
+        .await
+        .unwrap();
+    assert_eq!(unchanged.snapshot, unset.snapshot);
+    for tier in [None, Some("priority".to_string())] {
+        assert!(
