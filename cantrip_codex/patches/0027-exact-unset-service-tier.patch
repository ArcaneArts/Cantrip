+#[test]
+fn unset_service_tier_wire_preserves_standard_null_and_omission() {
+    let omitted: ThreadSettingsUpdateParams =
+        serde_json::from_value(serde_json::json!({"threadId":"t"})).unwrap();
+    assert_eq!(omitted.unset_service_tier, None);
+    assert_eq!(omitted.service_tier, None);
+    let standard: ThreadSettingsUpdateParams =
+        serde_json::from_value(serde_json::json!({"threadId":"t","serviceTier":null})).unwrap();
+    assert_eq!(standard.service_tier, Some(None));
+    let unset: ThreadSettingsUpdateParams =
+        serde_json::from_value(serde_json::json!({"threadId":"t","unsetServiceTier":true}))
+            .unwrap();
+    assert_eq!(unset.unset_service_tier, Some(true));
+    assert_eq!(unset.service_tier, None);
+    let value = serde_json::to_value(unset).unwrap();
+    assert_eq!(value["unsetServiceTier"], true);
+    assert!(!value.as_object().unwrap().contains_key("serviceTier"));
+}
