diff --git a/codex-rs/app-server/tests/suite/v2/thread_settings_update.rs b/codex-rs/app-server/tests/suite/v2/thread_settings_update.rs
index ce863d3..324a594 100644
--- a/codex-rs/app-server/tests/suite/v2/thread_settings_update.rs
+++ b/codex-rs/app-server/tests/suite/v2/thread_settings_update.rs
@@ -586,3 +586,171 @@ async fn sparse_child_settings_and_effort_clear_emit_exact_native_receipts() ->
     assert!(server.received_requests().await.unwrap().is_empty());
     Ok(())
 }
+
+#[tokio::test]
+async fn exact_unset_service_tier_is_distinct_durable_and_rejects_conflicts() -> Result<()> {
+    use codex_app_server_protocol::{
+        ClientRequest, ThreadResumeParams, ThreadResumeResponse, ThreadSettingsReadParams,
+        ThreadSettingsReadResponse,
+    };
+    let server = create_mock_responses_server_sequence_unchecked(vec![
+        create_final_assistant_message_sse_response("done")?,
+        create_final_assistant_message_sse_response("done")?,
+    ])
+    .await;
+    let home = TempDir::new()?;
+    create_config_toml(home.path(), &server.uri())?;
+    let mut app = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    let thread = start_thread(&mut app).await?.thread;
+    send_thread_settings_update(
+        &mut app,
+        ThreadSettingsUpdateParams {
+            thread_id: thread.id.clone(),
+            service_tier: Some(Some("priority".into())),
+            ..Default::default()
+        },
+    )
+    .await?;
+    assert_eq!(
+        read_thread_settings_updated(&mut app)
+            .await?
+            .thread_settings
+            .service_tier
+            .as_deref(),
+        Some("priority")
+    );
+    start_text_turn(&mut app, thread.id.clone()).await?;
+    timeout(
+        DEFAULT_TIMEOUT,
+        app.read_stream_until_notification_message("turn/completed"),
+    )
+    .await??;
+    send_thread_settings_update(
+        &mut app,
+        ThreadSettingsUpdateParams {
+            thread_id: thread.id.clone(),
+            service_tier: Some(None),
+            ..Default::default()
+        },
+    )
+    .await?;
+    assert_eq!(
+        read_thread_settings_updated(&mut app)
+            .await?
+            .thread_settings
+            .service_tier
+            .as_deref(),
+        Some("default")
+    );
+    send_thread_settings_update(
+        &mut app,
+        ThreadSettingsUpdateParams {
+            thread_id: thread.id.clone(),
+            unset_service_tier: Some(true),
+            operation_id: Some("exact-unset".into()),
+            ..Default::default()
+        },
+    )
+    .await?;
+    let unset = read_thread_settings_updated(&mut app).await?;
+    assert_eq!(unset.operation_id.as_deref(), Some("exact-unset"));
+    assert_eq!(unset.thread_settings.service_tier, None);
+    for tier in [None, Some("priority".to_string())] {
+        let id = app
+            .send_thread_settings_update_request(ThreadSettingsUpdateParams {
+                thread_id: thread.id.clone(),
+                unset_service_tier: Some(true),
+                service_tier: Some(tier),
+                ..Default::default()
+            })
+            .await?;
+        let error: JSONRPCError = timeout(
+            DEFAULT_TIMEOUT,
+            app.read_stream_until_error_message(RequestId::Integer(id)),
+        )
+        .await??;
+        assert!(
+            error
+                .error
+                .message
+                .contains("unsetServiceTier cannot be combined")
+        );
+        let current: ThreadSettingsReadResponse = app
+            .request(|request_id| ClientRequest::ThreadSettingsRead {
+                request_id,
+                params: ThreadSettingsReadParams {
+                    thread_id: thread.id.clone(),
+                },
+            })
+            .await?;
+        assert_eq!(current.thread_settings, unset.thread_settings);
+    }
+    for flag in [None, Some(false)] {
+        send_thread_settings_update(
+            &mut app,
+            ThreadSettingsUpdateParams {
+                thread_id: thread.id.clone(),
+                unset_service_tier: flag,
+                operation_id: Some("no-tier-edit".into()),
+                ..Default::default()
+            },
+        )
+        .await?;
+        assert_eq!(
+            read_thread_settings_updated(&mut app)
+                .await?
+                .thread_settings,
+            unset.thread_settings
+        );
+    }
+    let id = app
+        .send_thread_unsubscribe_request(ThreadUnsubscribeParams {
+            thread_id: thread.id.clone(),
+        })
+        .await?;
+    let response: ThreadUnsubscribeResponse =
+        timeout(DEFAULT_TIMEOUT, app.read_response(id)).await??;
+    assert_eq!(response.status, ThreadUnsubscribeStatus::Unsubscribed);
+    drop(app);
+    // A new native process must recover raw absence from this thread's owned history.
+    let mut app = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .build_initialized()
+        .await?;
+    let id = app
+        .send_thread_resume_request(ThreadResumeParams {
+            thread_id: thread.id.clone(),
+            ..Default::default()
+        })
+        .await?;
+    let _: ThreadResumeResponse = timeout(DEFAULT_TIMEOUT, app.read_response(id)).await??;
+    let resumed: ThreadSettingsReadResponse = app
+        .request(|request_id| ClientRequest::ThreadSettingsRead {
+            request_id,
+            params: ThreadSettingsReadParams {
+                thread_id: thread.id.clone(),
+            },
+        })
+        .await?;
+    assert_eq!(resumed.thread_settings.service_tier, None);
+    start_text_turn(&mut app, thread.id).await?;
+    timeout(
+        DEFAULT_TIMEOUT,
+        app.read_stream_until_notification_message("turn/completed"),
+    )
+    .await??;
+    let bodies = received_response_bodies(&server).await?;
+    assert_eq!(bodies.len(), 2);
+    assert!(
+        !bodies
+            .last()
+            .unwrap()
+            .as_object()
+            .unwrap()
+            .contains_key("service_tier")
+    );
+    Ok(())
+}
