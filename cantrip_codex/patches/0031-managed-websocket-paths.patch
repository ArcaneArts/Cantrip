+    fn resolve_remote_addr_preserves_websocket_gateway_paths() {
+        for (address, normalized) in [
+            (
+                "ws://127.0.0.1:4500/managed/capability",
+                "ws://127.0.0.1:4500/managed/capability",
+            ),
+            (
+                "wss://example.com:443/managed/capability",
+                "wss://example.com/managed/capability",
+            ),
+            (
+                "ws://[::1]:80/managed/capability",
+                "ws://[::1]/managed/capability",
+            ),
+            (
+                "wss://example.com:4500/a%20b/session",
+                "wss://example.com:4500/a%20b/session",
+            ),
+        ] {
+            assert_eq!(
+                resolve_remote_addr(address).expect("WebSocket paths should be preserved"),
+                RemoteAppServerEndpoint::WebSocket {
+                    websocket_url: normalized.to_string(),
+                    auth_token: None,
+                }
+            );
