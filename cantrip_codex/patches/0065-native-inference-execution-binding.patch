+/// Physical correlation only; a bound begin is not proof that inference ran.
+#[derive(Clone, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct NativeExecution {
+    thread_id: String,
+    turn_id: String,
+    scope_id: String,
+}
+
+impl NativeExecution {
+    fn validate(&self) -> anyhow::Result<()> {
+        anyhow::ensure!(
+            !self.thread_id.is_empty()
+                && self.thread_id.chars().count() <= 4096
+                && !self.turn_id.is_empty()
+                && self.turn_id.chars().count() <= 4096
+                && !self.scope_id.is_empty()
+                && self.scope_id.chars().count() <= 4096,
+            "invalid native inference binding"
+        );
+        Ok(())
+    }
+}
