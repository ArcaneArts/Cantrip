@@ -0,0 +1,350 @@
+use super::*;
+use crate::{LoadThreadHistoryParams, StoredPaginatedHistorySnapshot};
+use pretty_assertions::assert_eq;
+
+fn retained(turn_id: &str, sequence: u64, item: RolloutItem) -> RolloutItem {
+    let RolloutItem::EventMsg(mut event) = item else {
+        panic!("event required");
+    };
+    if let EventMsg::TurnStarted(start) = &mut event {
+        start.canonical_items = true;
+    }
+    RolloutItem::CanonicalHistory {
+        turn_id: turn_id.into(),
+        sequence,
+        event,
+    }
+}
+fn sample_records(thread: ThreadId, turn: &str) -> Vec<RolloutItem> {
+    vec![
+        retained(turn, 0, turn_started(turn)),
+        turn_started(turn),
+        retained(
+            turn,
+            1,
+            completed_item(
+                thread,
+                turn,
+                agent_message("actual-item", MessagePhase::FinalAnswer),
+            ),
+        ),
+        retained(turn, 2, turn_completed(turn)),
+        turn_completed(turn),
+    ]
+}
+async fn snapshot(store: &LocalThreadStore, thread_id: ThreadId) -> StoredPaginatedHistorySnapshot {
+    store
+        .read_paginated_history_snapshot(LoadThreadHistoryParams {
+            thread_id,
+            include_archived: true,
+        })
+        .await
+        .expect("read paginated snapshot")
+}
+async fn append(store: &LocalThreadStore, thread_id: ThreadId, items: Vec<RolloutItem>) {
+    store
+        .append_items(AppendThreadItemsParams { thread_id, items })
+        .await
+        .unwrap();
+    store
+        .persist_thread(thread_id, PersistContext::Standard)
+        .await
+        .unwrap();
+    // Core normally publishes host metadata separately from opening the rollout writer.
+    let recorder = store
+        .live_recorders
+        .lock()
+        .await
+        .get(&thread_id)
+        .unwrap()
+        .recorder
+        .clone();
+    let mut metadata = codex_state::ThreadMetadataBuilder::new(
+        thread_id,
+        recorder.rollout_path().to_path_buf(),
+        Utc::now(),
+        SessionSource::Exec,
+    );
+    metadata.history_mode = ThreadHistoryMode::Paginated;
+    store
+        .state_db()
+        .await
+        .unwrap()
+        .upsert_thread(&metadata.build("test-provider"))
+        .await
+        .unwrap();
+}
+#[tokio::test]
+async fn paginated_snapshot_preserves_live_and_cold_items_and_retention() {
+    let home = TempDir::new().unwrap();
+    let store = projection_store(home.path()).await;
+    let thread = ThreadId::new();
+    create_paginated_thread(&store, thread).await;
+    let records = sample_records(thread, "turn");
+    append(&store, thread, records.clone()).await;
+    let live = snapshot(&store, thread).await;
+    assert_eq!(live.turns.len(), 1);
+    assert_eq!(live.turns[0].status, StoredTurnStatus::Completed);
+    assert_eq!(live.items.len(), 1);
+    assert_eq!(live.items[0].item_id, "actual-item");
+    assert_eq!(
+        serde_json::to_value(&live.records).unwrap(),
+        serde_json::to_value(&records).unwrap()
+    );
+    store.shutdown_thread(thread).await.unwrap();
+    let cold_store = projection_store(home.path()).await;
+    let cold = snapshot(&cold_store, thread).await;
+    assert_eq!(
+        serde_json::to_value(cold.turns).unwrap(),
+        serde_json::to_value(live.turns).unwrap()
+    );
+    assert_eq!(cold.items, live.items);
+    assert_eq!(
+        serde_json::to_value(cold.records).unwrap(),
+        serde_json::to_value(live.records).unwrap()
+    );
+}
+#[tokio::test]
+async fn paginated_snapshot_late_start_does_not_replace_completed_content() {
+    use codex_protocol::protocol::ItemStartedEvent;
+    let home = TempDir::new().unwrap();
+    let store = projection_store(home.path()).await;
+    let thread = ThreadId::new();
+    create_paginated_thread(&store, thread).await;
+    let mut stale = agent_message("actual-item", MessagePhase::FinalAnswer);
+    if let TurnItem::AgentMessage(item) = &mut stale {
+        item.content.clear();
+    }
+    let start = RolloutItem::EventMsg(EventMsg::ItemStarted(ItemStartedEvent {
+        thread_id: thread,
+        turn_id: "turn".into(),
+        item: stale,
+        started_at_ms: 0,
+    }));
+    append(
+        &store,
+        thread,
+        vec![
+            retained("turn", 0, turn_started("turn")),
+            turn_started("turn"),
+            retained("turn", 1, start.clone()),
+        ],
+    )
+    .await;
+    let active = snapshot(&store, thread).await;
+    assert_eq!(active.items.len(), 1);
+    let mut completed = completed_item(
+        thread,
+        "turn",
+        agent_message("actual-item", MessagePhase::FinalAnswer),
+    );
+    if let RolloutItem::EventMsg(EventMsg::ItemCompleted(item)) = &mut completed {
+        item.completed_at_ms = 0;
+    }
+    append(
+        &store,
+        thread,
+        vec![
+            retained("turn", 2, completed),
+            retained("turn", 3, turn_completed("turn")),
+            turn_completed("turn"),
+        ],
+    )
+    .await;
+    let before = snapshot(&store, thread).await;
+    assert_ne!(before.items[0].item_json, active.items[0].item_json);
+    append(&store, thread, vec![retained("turn", 4, start)]).await;
+    let after = snapshot(&store, thread).await;
+    assert_eq!(after.items, before.items);
+    assert_eq!(after.records.len(), before.records.len() + 1);
+    store.shutdown_thread(thread).await.unwrap();
+    let cold = projection_store(home.path()).await;
+    assert_eq!(snapshot(&cold, thread).await.items, before.items);
+}
+
+#[tokio::test]
+async fn paginated_snapshot_does_not_read_evidence_past_projection_checkpoint() {
+    let home = TempDir::new().unwrap();
+    let store = projection_store(home.path()).await;
+    let thread = ThreadId::new();
+    create_paginated_thread(&store, thread).await;
+    append(
+        &store,
+        thread,
+        vec![
+            retained("turn", 0, turn_started("turn")),
+            turn_started("turn"),
+        ],
+    )
+    .await;
+    let recorder = store
+        .live_recorders
+        .lock()
+        .await
+        .get(&thread)
+        .unwrap()
+        .recorder
+        .clone();
+    // Durable JSONL advances while its rebuildable SQLite projection remains behind.
+    recorder
+        .record_canonical_items(&[
+            retained("turn", 1, turn_completed("turn")),
+            turn_completed("turn"),
