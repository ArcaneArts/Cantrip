+use super::*;
+use codex_protocol::items::{TurnItem, UserMessageItem};
+use codex_protocol::protocol::{ErrorEvent, UserMessageEvent};
+
+fn start(id: &str, canonical: bool) -> RolloutItem {
+    RolloutItem::EventMsg(EventMsg::TurnStarted(TurnStartedEvent {
+        canonical_items: canonical,
+        turn_id: id.into(),
+        trace_id: None,
+        started_at: None,
+        model_context_window: None,
+        collaboration_mode_kind: Default::default(),
+    }))
+}
+
+fn end(id: &str) -> RolloutItem {
+    RolloutItem::EventMsg(EventMsg::TurnComplete(TurnCompleteEvent {
+        turn_id: id.into(),
+        last_agent_message: None,
+        error: None,
+        started_at: None,
+        completed_at: None,
+        duration_ms: None,
+        time_to_first_token_ms: None,
+    }))
+}
+
+fn user() -> RolloutItem {
+    RolloutItem::EventMsg(EventMsg::UserMessage(UserMessageEvent {
+        message: "identical input".into(),
+        ..Default::default()
+    }))
+}
+
+fn item(turn_id: &str, id: &str, completed: bool, client_id: &str) -> RolloutItem {
+    let item = TurnItem::UserMessage(UserMessageItem {
+        id: id.into(),
+        client_id: Some(client_id.into()),
+        content: Vec::new(),
+    });
+    let thread_id = codex_protocol::ThreadId::new();
+    let event = if completed {
+        EventMsg::ItemCompleted(ItemCompletedEvent {
+            thread_id,
+            turn_id: turn_id.into(),
+            item,
+            started_at_ms: None,
+            completed_at_ms: 0,
+        })
+    } else {
+        EventMsg::ItemStarted(ItemStartedEvent {
+            thread_id,
+            turn_id: turn_id.into(),
+            item,
+            started_at_ms: 0,
+        })
+    };
+    RolloutItem::CanonicalHistory {
+        turn_id: turn_id.into(),
+        sequence: 1,
+        event,
+    }
+}
+
+fn replay(records: &[RolloutItem]) -> Vec<Turn> {
+    let mut builder = ThreadHistoryBuilder::new();
+    for record in records {
+        builder.handle_rollout_item(record);
+    }
+    builder.finish()
+}
