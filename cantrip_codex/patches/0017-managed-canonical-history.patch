+fn canonical_overlay_preserves_legacy_ids_through_rollback_and_disable() {
+    let records = vec![
+        start("old", false),
+        user(),
+        end("old"),
+        start("canonical", true),
+        user(),
+        user(),
+        item("canonical", "real-user", true, "real-client"),
+        end("canonical"),
+        start("removed", false),
+        user(),
+        end("removed"),
+        RolloutItem::EventMsg(EventMsg::ThreadRolledBack(ThreadRolledBackEvent {
+            num_turns: 1,
+        })),
+        start("later-legacy", false),
+        user(),
+        end("later-legacy"),
+    ];
+    let baseline = records
+        .iter()
+        .filter_map(|record| match record {
+            RolloutItem::CanonicalHistory { .. } => None,
+            RolloutItem::EventMsg(EventMsg::TurnStarted(start)) => {
+                let mut start = start.clone();
+                start.canonical_items = false;
+                Some(RolloutItem::EventMsg(EventMsg::TurnStarted(start)))
+            }
+            record => Some(record.clone()),
+        })
+        .collect::<Vec<_>>();
+    let actual = replay(&records);
+    let legacy = replay(&baseline);
+    assert_eq!(actual.len(), 3);
+    assert_eq!(actual[0], legacy[0]);
+    assert_eq!(actual[2], legacy[2]);
+    assert_eq!(actual[1].items.len(), 1);
+    assert_eq!(actual[1].items[0].id(), "real-user");
+    assert_eq!(legacy[1].items.len(), 2);
+}
