+use super::*;
+use pretty_assertions::assert_eq;
+
+fn companion(turn_id: &str, sequence: u64, item: RolloutItem) -> RolloutItem {
+    let RolloutItem::EventMsg(mut event) = item else {
+        panic!("event required");
+    };
+    if let EventMsg::TurnStarted(start) = &mut event {
+        start.canonical_items = true;
+    }
+    RolloutItem::CanonicalHistory {
+        turn_id: turn_id.into(),
+        sequence,
+        event,
+    }
+}
+
+#[tokio::test]
+async fn migration_does_not_duplicate_retained_items_with_legacy_aliases() {
+    let home = TempDir::new().unwrap();
+    let thread = ThreadId::new();
+    let records = vec![
+        started("old"),
+        user_message("old question"),
+        completed("old"),
+        companion("managed", 0, started("managed")),
+        started("managed"),
+        companion("managed", 1, item_completed("managed", "native-one")),
+        agent_message("same text"),
+        companion("managed", 2, item_completed("managed", "native-two")),
+        agent_message("same text"),
+        companion("managed", 3, completed("managed")),
+        completed("managed"),
+        started("later"),
+        user_message("later question"),
+        completed("later"),
+    ];
+    write_rollout(home.path(), thread, SessionSource::Cli, records);
+    let store = indexed_store(home.path()).await;
+    let report = store.migrate_rollouts(apply_options()).await.unwrap();
+    assert_eq!(report.outcomes[0].status, RolloutMigrationStatus::Migrated);
+    let snapshot = store
+        .read_paginated_history_snapshot(LoadThreadHistoryParams {
+            thread_id: thread,
+            include_archived: true,
+        })
+        .await
+        .unwrap();
+    assert_eq!(
+        snapshot
+            .items
+            .iter()
+            .filter(|item| item.turn_id == "managed")
+            .map(|item| item.item_id.as_str())
+            .collect::<Vec<_>>(),
+        vec!["native-one", "native-two"]
+    );
+    assert_eq!(
+        snapshot
+            .turns
+            .iter()
+            .map(|turn| turn.turn_id.as_str())
+            .collect::<Vec<_>>(),
+        vec!["old", "managed", "later"]
+    );
+    assert_eq!(
+        snapshot
+            .items
+            .iter()
+            .find(|item| item.turn_id == "old")
+            .unwrap()
+            .item_id,
+        "item-1"
+    );
+    assert_eq!(
+        snapshot
+            .items
+            .iter()
+            .find(|item| item.turn_id == "later")
+            .unwrap()
+            .item_id,
+        "item-4"
+    );
+    assert_eq!(
+        snapshot
+            .records
+            .iter()
+            .filter(|item| matches!(item, RolloutItem::CanonicalHistory { .. }))
+            .count(),
+        4
+    );
+}
+
+#[tokio::test]
+async fn migration_rolls_back_retention_markers_but_keeps_late_surviving_items() {
+    let home = TempDir::new().unwrap();
+    let thread = ThreadId::new();
+    write_rollout(
+        home.path(),
+        thread,
+        SessionSource::Cli,
+        vec![
+            companion("kept", 0, started("kept")),
+            started("kept"),
+            user_message("keep"),
+            companion("kept", 1, item_completed("kept", "kept-item")),
+            companion("kept", 2, completed("kept")),
+            completed("kept"),
+            companion("removed", 0, started("removed")),
+            started("removed"),
+            user_message("remove"),
+            companion("removed", 1, item_completed("removed", "removed-item")),
+            companion("removed", 2, completed("removed")),
+            completed("removed"),
+            companion("kept", 3, item_completed("kept", "late-kept-item")),
+            RolloutItem::EventMsg(EventMsg::ThreadRolledBack(ThreadRolledBackEvent {
+                num_turns: 1,
+            })),
+        ],
+    );
+    let store = indexed_store(home.path()).await;
+    let report = store.migrate_rollouts(apply_options()).await.unwrap();
+    assert_eq!(report.outcomes[0].status, RolloutMigrationStatus::Migrated);
+    let result = store
+        .read_paginated_history_snapshot(LoadThreadHistoryParams {
+            thread_id: thread,
+            include_archived: true,
+        })
+        .await
+        .unwrap();
+    assert_eq!(
+        result
+            .turns
+            .iter()
+            .map(|turn| turn.turn_id.as_str())
+            .collect::<Vec<_>>(),
+        vec!["kept"]
+    );
+    assert_eq!(
+        result
+            .items
+            .iter()
+            .map(|item| item.item_id.as_str())
+            .collect::<Vec<_>>(),
+        vec!["kept-item", "late-kept-item"]
+    );
+    assert!(!result.records.iter().any(|item| matches!(item,
+        RolloutItem::CanonicalHistory { turn_id, .. } if turn_id == "removed")));
+}
diff --git a/codex-rs/thread-store/src/local/history_snapshot.rs b/codex-rs/thread-store/src/local/history_snapshot.rs
new file mode 100644
index 0000000..f43f5c6
--- /dev/null
+++ b/codex-rs/thread-store/src/local/history_snapshot.rs
@@ -0,0 +1,123 @@
+use super::LocalThreadStore;
+use super::thread_history;
+use super::thread_history::segment_paging::{page_item_rows, page_turn_rows};
+use super::thread_history_materialization;
+use crate::{
+    ItemSortKey, ListItemsParams, LoadThreadHistoryParams, SortDirection,
+    StoredPaginatedHistorySnapshot, StoredTurn, StoredTurnItemsView, ThreadStoreError,
+    ThreadStoreResult,
+};
+
+/// A snapshot uses the ordinary paginated projection, including synthetic fork-boundary turns.
+/// Read transactions keep item revisions and rollout checkpoints consistent without a database
+/// write lock. Evidence reads stop at those checkpoints, not at the possibly newer file length.
+pub(super) async fn read(
+    store: &LocalThreadStore,
+    params: LoadThreadHistoryParams,
+) -> ThreadStoreResult<StoredPaginatedHistorySnapshot> {
+    // Keep the requested lineage stable across local resume/revert/archive operations.
+    let _writer_guard = store.live_writer_locks.lock(params.thread_id).await;
+    thread_history::validate_thread_for_paginated_reads(
+        store,
+        params.thread_id,
+        params.include_archived,
+        "read_paginated_history_snapshot",
+    )
+    .await?;
+    let lineage = store.resolve_rollout_lineage(params.thread_id).await?;
+    let pool = store.thread_history_db().await?;
+    let mut transaction = pool.begin().await.map_err(snapshot_error)?;
+    let mut bounds = Vec::new();
+    // This first read establishes the same SQLite snapshot subsequently used by all page reads.
+    for segment in lineage.segments() {
+        let offset = sqlx::query_scalar::<_, i64>(
+            "SELECT next_rollout_byte_offset FROM thread_history_projection_state WHERE thread_id = ?")
+            .bind(segment.rollout_id().to_string()).fetch_optional(&mut *transaction)
+            .await.map_err(snapshot_error)?;
+        let offset = offset
+            .map(u64::try_from)
+            .transpose()
+            .map_err(snapshot_error)?;
+        bounds.push(offset.map(|offset| {
+            segment
+                .end
+                .map_or(offset, |end| offset.min(end.end_byte_offset))
+        }));
+    }
+    let mut turns = Vec::new();
+    let mut cursor = None;
+    loop {
+        let page = page_turn_rows(
+            &mut transaction,
+            params.thread_id,
+            &lineage,
+            cursor.as_deref(),
+            512,
+            SortDirection::Asc,
+            StoredTurnItemsView::NotLoaded,
+        )
+        .await?;
+        turns.extend(page.rows.into_iter().map(|turn| StoredTurn {
+            turn_id: turn.turn_id,
+            items: Vec::new(),
+            items_view: StoredTurnItemsView::NotLoaded,
+            status: turn.status,
+            error: turn.error,
+            started_at: turn.started_at,
+            completed_at: turn.completed_at,
+            duration_ms: turn.duration_ms,
+        }));
+        let Some(next) = page.next_cursor else {
+            break;
+        };
+        cursor = Some(next);
+    }
+    let mut items = Vec::new();
+    let mut item_params = ListItemsParams {
+        thread_id: params.thread_id,
+        turn_id: None,
+        include_archived: params.include_archived,
+        cursor: None,
+        page_size: 512,
+        sort_direction: SortDirection::Asc,
+        sort_key: ItemSortKey::CreatedAtOrdinal,
+        after_updated_at_ordinal: None,
+    };
+    loop {
+        let page = page_item_rows(&mut transaction, &lineage, &item_params).await?;
+        items.extend(page.rows.into_iter().map(|row| row.item));
+        let Some(next) = page.next_cursor else {
+            break;
+        };
+        item_params.cursor = Some(next);
+    }
+    transaction.commit().await.map_err(snapshot_error)?;
+    let mut records = Vec::new();
+    for (segment, offset) in lineage.segments().iter().zip(bounds) {
+        let Some(offset) = offset else {
+            continue;
+        };
+        let evidence = thread_history_materialization::read_evidence(
+            &segment.rollout_path,
+            segment.rollout_id(),
+            offset,
+        )
+        .await?;
+        records.extend(evidence.into_iter().filter_map(|(ordinal, item)| {
+            (ordinal >= segment.start_ordinal()
+                && segment.end_ordinal().is_none_or(|end| ordinal < end))
+            .then_some(item)
+        }));
+    }
+    Ok(StoredPaginatedHistorySnapshot {
+        turns,
+        items,
+        records,
+    })
+}
+
+fn snapshot_error(error: impl std::fmt::Display) -> ThreadStoreError {
+    ThreadStoreError::Internal {
+        message: format!("failed to read paginated history snapshot: {error}"),
+    }
+}
diff --git a/codex-rs/thread-store/src/local/history_snapshot_tests.rs b/codex-rs/thread-store/src/local/history_snapshot_tests.rs
