+        item,
+        RolloutItem::CanonicalHistory {
+            event: EventMsg::TurnComplete(_),
+            ..
+        }
+    )));
+    store.flush_thread(thread).await.unwrap();
+    let recovered = snapshot(&store, thread).await;
+    assert_eq!(recovered.turns[0].status, StoredTurnStatus::Completed);
+    assert!(recovered.records.iter().any(|item| matches!(
+        item,
+        RolloutItem::CanonicalHistory {
+            event: EventMsg::TurnComplete(_),
+            ..
+        }
+    )));
+    store.shutdown_thread(thread).await.unwrap();
+}
+#[tokio::test]
+async fn paginated_snapshot_respects_fork_cutoff_and_own_suffix() {
+    let home = TempDir::new().unwrap();
+    let store = projection_store(home.path()).await;
+    let source = ThreadId::new();
+    create_paginated_thread(&store, source).await;
+    append(&store, source, sample_records(source, "inherited")).await;
+    let prepared = prepare_paginated_fork(&store, source, ForkBoundary::Latest).await;
+    let child = ThreadId::new();
+    create_paginated_subagent_thread(&store, child, prepared.history_base, None).await;
+    append(&store, child, sample_records(child, "own")).await;
+    drop(prepared);
+    append(&store, source, sample_records(source, "beyond-cutoff")).await;
+    let result = snapshot(&store, child).await;
+    assert_eq!(
+        result
+            .turns
+            .iter()
+            .map(|turn| turn.turn_id.as_str())
+            .collect::<Vec<_>>(),
+        vec!["inherited", "own"]
+    );
+    assert_eq!(
+        result
+            .items
+            .iter()
+            .map(|item| item.turn_id.as_str())
+            .collect::<Vec<_>>(),
+        vec!["inherited", "own"]
+    );
+    assert_eq!(
+        result
+            .records
+            .iter()
+            .filter_map(|item| match item {
+                RolloutItem::CanonicalHistory {
+                    turn_id,
+                    sequence: 0,
+                    ..
+                } => Some(turn_id.as_str()),
+                _ => None,
+            })
+            .collect::<Vec<_>>(),
+        vec!["inherited", "own"]
+    );
+    store.shutdown_thread(child).await.unwrap();
+    store.shutdown_thread(source).await.unwrap();
+}
+#[tokio::test]
+async fn paginated_snapshot_excludes_copied_subagent_prefix_from_evidence_and_items() {
+    let home = TempDir::new().unwrap();
+    let store = projection_store(home.path()).await;
+    let thread = ThreadId::new();
+    let copied = sample_records(thread, "copied");
+    create_paginated_subagent_thread(&store, thread, None, Some(1 + copied.len() as u64)).await;
+    let mut records = copied;
+    records.extend(sample_records(thread, "own"));
+    append(&store, thread, records).await;
+    let result = snapshot(&store, thread).await;
+    assert_eq!(
+        result
+            .turns
+            .iter()
+            .map(|turn| turn.turn_id.as_str())
+            .collect::<Vec<_>>(),
+        vec!["own"]
+    );
+    assert_eq!(result.items.len(), 1);
+    assert!(!result.records.iter().any(|item| matches!(item,
+        RolloutItem::CanonicalHistory { turn_id, .. } if turn_id == "copied")));
+    store.shutdown_thread(thread).await.unwrap();
+}
+
+#[tokio::test]
+async fn paginated_snapshot_keeps_partial_fork_outcome_separate_from_source_completion() {
+    use codex_protocol::protocol::{TurnAbortReason, TurnAbortedEvent};
+    let home = TempDir::new().unwrap();
+    let store = projection_store(home.path()).await;
+    let source = ThreadId::new();
+    create_paginated_thread(&store, source).await;
+    let mut prefix = sample_records(source, "shared");
+    prefix.truncate(3);
+    append(&store, source, prefix).await;
+    let prepared = prepare_paginated_fork(&store, source, ForkBoundary::Latest).await;
+    let child = ThreadId::new();
+    create_paginated_subagent_thread(&store, child, prepared.history_base, None).await;
+    append(
+        &store,
+        child,
+        vec![RolloutItem::EventMsg(EventMsg::TurnAborted(
+            TurnAbortedEvent {
+                turn_id: Some("shared".into()),
+                reason: TurnAbortReason::Interrupted,
+                started_at: Some(10),
+                completed_at: Some(15),
+                duration_ms: Some(5_000),
+            },
+        ))],
+    )
+    .await;
+    drop(prepared);
+    append(
+        &store,
+        source,
+        vec![
+            retained("shared", 2, turn_completed("shared")),
+            turn_completed("shared"),
+        ],
+    )
+    .await;
+    let fork = snapshot(&store, child).await;
+    let original = snapshot(&store, source).await;
+    assert_eq!(fork.turns.len(), 1);
+    assert_eq!(fork.turns[0].status, StoredTurnStatus::Interrupted);
+    assert_eq!(original.turns[0].status, StoredTurnStatus::Completed);
+    assert_eq!(fork.items, original.items);
+    assert!(!fork.records.iter().any(|item| matches!(
+        item,
+        RolloutItem::CanonicalHistory {
+            event: EventMsg::TurnComplete(_),
+            ..
+        }
+    )));
+    assert!(original.records.iter().any(|item| matches!(
+        item,
+        RolloutItem::CanonicalHistory {
+            event: EventMsg::TurnComplete(_),
+            ..
+        }
+    )));
+    store.shutdown_thread(child).await.unwrap();
+    store.shutdown_thread(source).await.unwrap();
+}
