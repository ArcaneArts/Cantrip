+//! Exact retained history evidence. Presentation identity and execution ownership are distinct:
+//! copied fork usage retains its original thread provenance and is never billed to the fork.
+use crate::protocol::v2::*;
+use codex_protocol::protocol::{EventMsg, TokenUsage, TokenUsageRecord};
+use codex_rollout::RolloutItem;
+use std::collections::{BTreeMap, HashMap};
+
+#[derive(Default)]
+struct TurnEvidence<'a> {
+    marked: bool,
+    invalid: bool,
+    canonical: BTreeMap<u64, &'a EventMsg>,
+    ordinary_items: Vec<&'a EventMsg>,
+    usage: Vec<&'a TokenUsageRecord>,
+}
+
+pub fn build_history_metadata(
+    thread: &Thread,
+    records: &[RolloutItem],
+    current_turn_id: Option<String>,
+    live: bool,
+) -> ThreadHistoryMetadata {
+    // Group once: reading a long history must not rescan its complete rollout for every turn.
+    let mut evidence: HashMap<&str, TurnEvidence<'_>> = HashMap::new();
+    for record in records {
+        match record {
+            RolloutItem::CanonicalHistory {
+                turn_id,
+                sequence,
+                event,
+            } => {
+                let turn = evidence.entry(turn_id).or_default();
+                if let Some(previous) = turn.canonical.get(sequence) {
+                    // An exact repeated record is harmless. Conflicting records at the same
+                    // sequence are incomplete evidence, even if a terminal checkpoint survived.
+                    if serde_json::to_value(previous).ok() != serde_json::to_value(event).ok() {
+                        turn.invalid = true;
+                    }
+                } else {
+                    turn.canonical.insert(*sequence, event);
+                }
+                if matches!(event, EventMsg::TurnStarted(start) if start.turn_id == *turn_id && start.canonical_items)
+                {
+                    turn.marked = true;
+                }
+                if !matches_scope(event, turn_id) {
+                    turn.invalid = true;
+                }
+            }
+            RolloutItem::EventMsg(EventMsg::TurnStarted(start)) if start.canonical_items => {
+                evidence.entry(&start.turn_id).or_default().marked = true;
+            }
+            RolloutItem::EventMsg(event) => {
+                let turn_id = match event {
+                    EventMsg::ItemStarted(item) => &item.turn_id,
+                    EventMsg::ItemCompleted(item) => &item.turn_id,
+                    _ => continue,
+                };
+                evidence
+                    .entry(turn_id)
+                    .or_default()
+                    .ordinary_items
+                    .push(event);
+            }
+            RolloutItem::TokenUsageRecord(usage) => {
+                evidence
+                    .entry(&usage.turn_id)
+                    .or_default()
+                    .usage
+                    .push(usage);
+            }
+            _ => {}
+        }
+    }
+    let turns = thread
+        .turns
+        .iter()
+        .map(|turn| {
+            let evidence = evidence.remove(turn.id.as_str()).unwrap_or_default();
+            metadata_for_turn(&thread.id, turn, thread.history_mode, evidence)
+        })
+        .collect();
+    ThreadHistoryMetadata {
+        version: 1,
+        current_turn_id,
+        current_turn_state: if live { "live" } else { "notLoaded" }.into(),
+        turns,
+    }
+}
+
+fn matches_scope(event: &EventMsg, turn_id: &str) -> bool {
+    match event {
+        EventMsg::TurnStarted(start) => start.turn_id == turn_id && start.canonical_items,
+        EventMsg::ItemStarted(item) => item.turn_id == turn_id,
+        EventMsg::ItemCompleted(item) => item.turn_id == turn_id,
+        EventMsg::TurnComplete(complete) => complete.turn_id == turn_id,
+        EventMsg::TurnAborted(aborted) => aborted.turn_id.as_deref() == Some(turn_id),
+        EventMsg::Warning(_) | EventMsg::Error(_) => true,
+        _ => false,
+    }
+}
+
+fn metadata_for_turn(
+    thread_id: &str,
+    turn: &Turn,
+    history_mode: ThreadHistoryMode,
+    evidence: TurnEvidence<'_>,
+) -> ThreadHistoryTurnMetadata {
+    let has_marker = matches!(evidence.canonical.get(&0), Some(EventMsg::TurnStarted(start))
+        if start.turn_id == turn.id && start.canonical_items);
+    let contiguous = !evidence.invalid
+        && has_marker
+        && evidence
+            .canonical
+            .keys()
+            .enumerate()
+            .all(|(index, sequence)| u64::try_from(index) == Ok(*sequence));
+    let checkpoint = evidence.canonical.values().any(|event| match event {
+        EventMsg::TurnComplete(complete) => complete.turn_id == turn.id,
+        EventMsg::TurnAborted(aborted) => aborted.turn_id.as_deref() == Some(turn.id.as_str()),
+        _ => false,
+    });
+    let canonical = evidence.marked || !evidence.canonical.is_empty();
+    let retention = if contiguous && checkpoint {
+        "complete"
+    } else if canonical {
+        "partial"
+    } else {
+        "unavailable"
+    };
+    let mut lifecycle = HashMap::new();
+    let mut warnings = Vec::new();
+    let mut errors = Vec::new();
+    // The ordinary compatibility stream cannot repair a missing canonical record. It can
+    // still supply exact item timing in an older, unmarked paginated history.
+    let events: Vec<&EventMsg> = if canonical {
+        evidence.canonical.values().copied().collect()
+    } else {
+        evidence.ordinary_items
+    };
+    for event in events {
+        if !matches_scope(event, &turn.id) {
+            continue;
+        }
+        match event {
+            EventMsg::ItemStarted(item) => {
+                let entry = lifecycle
+                    .entry(item.item.id())
+                    .or_insert(ThreadHistoryItemMetadata {
+                        item_id: item.item.id(),
+                        state: "started".into(),
+                        started_at_ms: None,
+                        completed_at_ms: None,
+                    });
+                // A late/repeated start may fill missing timing but never reopen a completed item.
+                if entry.started_at_ms.is_none() {
+                    entry.started_at_ms = (item.started_at_ms != 0).then_some(item.started_at_ms);
+                }
+            }
+            EventMsg::ItemCompleted(item) => {
+                let entry = lifecycle
+                    .entry(item.item.id())
+                    .or_insert(ThreadHistoryItemMetadata {
+                        item_id: item.item.id(),
+                        state: "completed".into(),
+                        started_at_ms: None,
+                        completed_at_ms: None,
+                    });
+                entry.state = "completed".into();
+                entry.started_at_ms = item
+                    .started_at_ms
+                    .filter(|time| *time != 0)
+                    .or(entry.started_at_ms);
+                entry.completed_at_ms = (item.completed_at_ms != 0)
+                    .then_some(item.completed_at_ms)
+                    .or(entry.completed_at_ms);
+            }
+            EventMsg::Warning(warning) => warnings.push(warning.message.clone()),
+            EventMsg::Error(error) => errors.push(TurnError {
+                misalignment: error.misalignment.clone().map(Into::into),
+                message: error.message.clone(),
+                codex_error_info: error.codex_error_info.clone().map(Into::into),
+                additional_details: None,
+            }),
+            _ => {}
+        }
+    }
+    ThreadHistoryTurnMetadata {
+        turn_id: turn.id.clone(),
+        source: if canonical || matches!(history_mode, ThreadHistoryMode::Paginated) {
+            "canonical"
+        } else {
+            "legacy"
+        }
+        .into(),
+        retention: retention.into(),
+        items: turn
+            .items
+            .iter()
+            .map(|item| {
+                lifecycle
+                    .remove(item.id())
+                    .unwrap_or_else(|| ThreadHistoryItemMetadata {
+                        item_id: item.id().to_owned(),
+                        state: "unknown".into(),
+                        started_at_ms: None,
+                        completed_at_ms: None,
+                    })
+            })
+            .collect(),
+        usage: usage_for_turn(thread_id, evidence.usage),
+        // A contiguous live prefix has known observations so far, but a gap (or no
+        // retention contract) cannot distinguish no warnings/errors from lost ones.
+        warnings: contiguous.then_some(warnings),
+        errors: contiguous.then_some(errors),
+    }
+}
+
+fn usage_for_turn(thread_id: &str, records: Vec<&TokenUsageRecord>) -> Option<ThreadHistoryUsage> {
+    let mut responses: Vec<ThreadHistoryResponseUsage> = Vec::new();
+    let mut indexes: HashMap<(String, String), Vec<usize>> = HashMap::new();
+    let mut conflicting_response_ids = Vec::new();
+    let mut total = Some(TokenUsage::default());
+    for record in records {
+        let response = ThreadHistoryResponseUsage {
+            response_id: record.response_id.clone(),
+            thread_id: record.thread_id.to_string(),
+            session_id: record.session_id.to_string(),
+            root_turn_id: record.root_turn_id.clone(),
+            usage: record.usage.clone().into(),
+        };
+        let key = (response.thread_id.clone(), response.response_id.clone());
+        let variants = indexes.entry(key).or_default();
+        if variants.iter().any(|index| responses[*index] == response) {
+            continue;
+        }
+        if !variants.is_empty() {
+            if !conflicting_response_ids.contains(&response.response_id) {
+                conflicting_response_ids.push(response.response_id.clone());
+            }
+            total = None;
+        } else if response.thread_id == thread_id {
+            // Preserve copied source evidence, but never label it newly executed usage here.
+            total = total.and_then(|sum| checked_usage_sum(sum, &record.usage));
+        }
+        variants.push(responses.len());
+        responses.push(response);
+    }
+    (!responses.is_empty()).then(|| ThreadHistoryUsage {
+        responses,
+        total: total.map(Into::into),
+        conflicting_response_ids,
+    })
+}
+
+fn checked_usage_sum(a: TokenUsage, b: &TokenUsage) -> Option<TokenUsage> {
+    Some(TokenUsage {
+        total_tokens: a.total_tokens.checked_add(b.total_tokens)?,
+        input_tokens: a.input_tokens.checked_add(b.input_tokens)?,
+        cached_input_tokens: a.cached_input_tokens.checked_add(b.cached_input_tokens)?,
+        cache_write_input_tokens: a
+            .cache_write_input_tokens
+            .checked_add(b.cache_write_input_tokens)?,
+        output_tokens: a.output_tokens.checked_add(b.output_tokens)?,
+        reasoning_output_tokens: a
+            .reasoning_output_tokens
+            .checked_add(b.reasoning_output_tokens)?,
+        ..Default::default()
+    })
+}
+
