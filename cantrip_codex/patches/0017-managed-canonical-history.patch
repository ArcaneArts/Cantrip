diff --git a/codex-rs/core/src/session/canonical_history.rs b/codex-rs/core/src/session/canonical_history.rs
new file mode 100644
index 0000000..1686308
--- /dev/null
+++ b/codex-rs/core/src/session/canonical_history.rs
@@ -0,0 +1,54 @@
+//! Per-turn retention eligibility and ordinal evidence, independent of current configuration.
+//! Raw late child activity must use its original turn's opt-in, never the next turn's profile.
+use super::*;
+
+#[derive(Default)]
+pub(super) struct CanonicalHistoryState {
+    next: HashMap<String, u64>,
+}
+impl CanonicalHistoryState {
+    pub(super) fn from_records(records: &[RolloutItem]) -> Self {
+        let mut state = Self::default();
+        for record in records {
+            match record {
+                RolloutItem::EventMsg(EventMsg::TurnStarted(started))
+                    if started.canonical_items =>
+                {
+                    state.next.entry(started.turn_id.clone()).or_default();
+                }
+                RolloutItem::CanonicalHistory {
+                    turn_id, sequence, ..
+                } => {
+                    let next = state.next.entry(turn_id.clone()).or_default();
+                    *next = (*next).max(sequence.saturating_add(1));
+                }
+                _ => {}
+            }
+        }
+        state
+    }
+
+    pub(super) fn record(&mut self, event: &Event) -> Option<RolloutItem> {
+        let turn_id = match &event.msg {
+            EventMsg::TurnStarted(started) if started.canonical_items => {
+                self.next.entry(started.turn_id.clone()).or_default();
+                started.turn_id.as_str()
+            }
+            EventMsg::ItemStarted(item) => item.turn_id.as_str(),
+            EventMsg::ItemCompleted(item) => item.turn_id.as_str(),
+            EventMsg::TurnComplete(turn) => turn.turn_id.as_str(),
+            EventMsg::TurnAborted(turn) => turn.turn_id.as_deref()?,
+            EventMsg::Warning(_) | EventMsg::Error(_) => event.id.as_str(),
+            _ => return None,
+        };
+        let next = self.next.get_mut(turn_id)?;
+        let sequence = *next;
+        // Advance even when the append fails: a later durable checkpoint exposes the gap.
+        *next = next.saturating_add(1);
+        Some(RolloutItem::CanonicalHistory {
+            turn_id: turn_id.to_owned(),
+            sequence,
+            event: event.msg.clone(),
+        })
+    }
+}
diff --git a/codex-rs/core/src/session/canonical_history_failure_tests.rs b/codex-rs/core/src/session/canonical_history_failure_tests.rs
new file mode 100644
index 0000000..c1dddd7
--- /dev/null
+++ b/codex-rs/core/src/session/canonical_history_failure_tests.rs
@@ -0,0 +1,109 @@
+use super::*;
+use codex_protocol::protocol::{TurnCompleteEvent, TurnStartedEvent, WarningEvent};
+use codex_thread_store::ResumeThreadParams;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn failed_native_append_remains_a_visible_gap_after_writer_recovery() {
+    let (mut session, _) = make_session_and_context().await;
+    let path = open_thread_persistence(&mut session).await;
+    session
+        .send_event_raw(Event {
+            id: "retained-turn".into(),
+            msg: EventMsg::TurnStarted(TurnStartedEvent {
+                turn_id: "retained-turn".into(),
+                canonical_items: true,
+                trace_id: None,
+                started_at: None,
+                model_context_window: None,
+                collaboration_mode_kind: Default::default(),
+            }),
+        })
+        .await;
+    session.live_thread().unwrap().shutdown().await.unwrap();
+
+    // A real closed LocalThreadStore writer rejects the append. This does not
+    // mock a successful write or edit the rollout to manufacture a missing record.
+    let warning = EventMsg::Warning(WarningEvent {
+        message: "lost during writer failure".into(),
+    });
+    assert!(
+        session
+            .live_thread()
+            .unwrap()
+            .append_items(&[RolloutItem::EventMsg(warning.clone())])
+            .await
+            .is_err()
+    );
+    session
+        .send_event_raw(Event {
+            id: "retained-turn".into(),
+            msg: warning,
+        })
+        .await;
+
+    let config = session.get_config().await;
+    session.services.live_thread = Some(
+        LiveThread::resume(
+            Arc::clone(&session.services.thread_store),
+            codex_protocol::protocol::ThreadHistoryMode::Legacy,
+            ResumeThreadParams {
+                thread_id: session.thread_id,
+                rollout_path: Some(path.clone()),
+                history: None,
+                include_archived: true,
+                metadata: ThreadPersistenceMetadata {
+                    cwd: Some(config.cwd.to_path_buf()),
+                    model_provider: config.model_provider_id.clone(),
+                    memory_mode: ThreadMemoryMode::Disabled,
+                },
+            },
+        )
+        .await
+        .unwrap(),
+    );
+    session
+        .send_event_raw(Event {
+            id: "retained-turn".into(),
+            msg: EventMsg::TurnComplete(TurnCompleteEvent {
+                turn_id: "retained-turn".into(),
+                last_agent_message: None,
+                error: None,
+                started_at: None,
+                completed_at: None,
+                duration_ms: None,
+                time_to_first_token_ms: None,
+            }),
+        })
+        .await;
+    session.live_thread().unwrap().shutdown().await.unwrap();
+    let (records, id, parse_errors) = RolloutRecorder::load_rollout_items(&path).await.unwrap();
+    assert_eq!(id, Some(session.thread_id));
+    assert_eq!(parse_errors, 0);
+    assert_eq!(
+        records
+            .iter()
+            .filter_map(|record| match record {
+                RolloutItem::CanonicalHistory { sequence, .. } => Some(*sequence),
+                _ => None,
+            })
+            .collect::<Vec<_>>(),
+        vec![0, 2]
+    );
+    let mut builder = codex_app_server_protocol::ThreadHistoryBuilder::new();
+    for record in &records {
+        builder.handle_rollout_item(record);
+    }
+    let thread: codex_app_server_protocol::Thread = serde_json::from_value(json!({
+        "id": session.thread_id.to_string(), "sessionId": session.session_id().to_string(),
+        "preview": "", "ephemeral": false, "modelProvider": "fixture",
+        "createdAt": 1, "updatedAt": 1, "status": {"type":"notLoaded"},
+        "cwd": "/tmp", "cliVersion": "test", "source": "cli", "turns": builder.finish(),
+    }))
+    .unwrap();
+    let metadata =
+        codex_app_server_protocol::build_history_metadata(&thread, &records, None, false);
+    assert_eq!(metadata.turns.len(), 1);
+    assert_eq!(metadata.turns[0].retention, "partial");
+    assert!(metadata.turns[0].warnings.is_none());
+}
diff --git a/codex-rs/core/src/session/canonical_history_tests.rs b/codex-rs/core/src/session/canonical_history_tests.rs
new file mode 100644
index 0000000..a73a85c
--- /dev/null
+++ b/codex-rs/core/src/session/canonical_history_tests.rs
@@ -0,0 +1,85 @@
+use super::*;
+use codex_protocol::items::{TurnItem, UserMessageItem};
+use codex_protocol::protocol::{ItemCompletedEvent, TurnStartedEvent};
+use codex_thread_store::{LoadThreadHistoryParams, ThreadStore};
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn raw_late_items_keep_their_original_turn_retention() {
+    let (mut session, _) = make_session_and_context().await;
+    let store = attach_in_memory_thread_store(&mut session).await;
+    for (id, canonical) in [("original", true), ("new-unmanaged", false)] {
+        session
+            .send_event_raw(Event {
+                id: id.into(),
+                msg: EventMsg::TurnStarted(TurnStartedEvent {
+                    turn_id: id.into(),
+                    canonical_items: canonical,
+                    trace_id: None,
+                    started_at: None,
+                    model_context_window: None,
+                    collaboration_mode_kind: Default::default(),
+                }),
+            })
+            .await;
+    }
+    // AgentControl publishes late subagent lifecycle through this same raw path,
+    // after the original producer's TurnContext may have disappeared.
+    for id in ["original", "new-unmanaged"] {
+        session
+            .send_event_raw(Event {
+                id: id.into(),
+                msg: EventMsg::ItemCompleted(ItemCompletedEvent {
+                    thread_id: session.thread_id,
+                    turn_id: id.into(),
+                    item: TurnItem::UserMessage(UserMessageItem {
+                        id: format!("item-{id}"),
+                        client_id: None,
+                        content: Vec::new(),
+                    }),
+                    started_at_ms: None,
+                    completed_at_ms: 0,
+                }),
+            })
+            .await;
+    }
+    let history = store
+        .load_history(LoadThreadHistoryParams {
+            thread_id: session.thread_id,
+            include_archived: true,
+        })
+        .await
+        .unwrap();
+    let retained = history
+        .items
+        .iter()
+        .filter_map(|item| match item {
+            RolloutItem::CanonicalHistory {
+                turn_id,
+                sequence,
+                event,
+            } => Some((turn_id.as_str(), *sequence, event)),
+            _ => None,
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(retained.len(), 2);
+    assert_eq!((retained[0].0, retained[0].1), ("original", 0));
+    assert_eq!((retained[1].0, retained[1].1), ("original", 1));
+    assert!(
+        matches!(retained[1].2, EventMsg::ItemCompleted(item) if item.item.id() == "item-original")
+    );
+    let mut restored =
+        crate::session::canonical_history::CanonicalHistoryState::from_records(&history.items);
+    let next = restored
+        .record(&Event {
+            id: "original".into(),
+            msg: EventMsg::Warning(codex_protocol::protocol::WarningEvent {
+                message: "late after reload".into(),
+            }),
+        })
+        .unwrap();
+    assert!(matches!(
+        next,
+        RolloutItem::CanonicalHistory { sequence: 2, .. }
+    ));
+}
