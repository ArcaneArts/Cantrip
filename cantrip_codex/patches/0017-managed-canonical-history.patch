+    #[test]
+    fn usage_retains_every_distinct_conflicting_variant_without_a_false_total() {
+        let thread = thread(&["turn"]);
+        let records = [3, 4, 5, 4, 5, 3]
+            .into_iter()
+            .map(|tokens| usage(THREAD, "turn", "response", tokens))
+            .collect::<Vec<_>>();
+        let metadata = build_history_metadata(&thread, &records, None, false);
+        let usage = metadata.turns[0].usage.as_ref().unwrap();
+        assert_eq!(
+            usage
+                .responses
+                .iter()
+                .map(|response| response.usage.total_tokens)
+                .collect::<Vec<_>>(),
+            vec![3, 4, 5]
+        );
+        assert_eq!(usage.conflicting_response_ids, vec!["response"]);
+        assert!(usage.total.is_none());
+    }
+
+    #[test]
+    fn usage_overflow_retains_responses_and_reports_no_total() {
+        let thread = thread(&["turn"]);
+        let records = vec![
+            usage(THREAD, "turn", "first", i64::MAX),
+            usage(THREAD, "turn", "second", 1),
+        ];
+        let metadata = build_history_metadata(&thread, &records, None, false);
+        let usage = metadata.turns[0].usage.as_ref().unwrap();
+        assert_eq!(usage.responses.len(), 2);
+        assert!(usage.total.is_none());
+        assert!(usage.conflicting_response_ids.is_empty());
+    }
+}
