+use super::*;
+use crate::LoadThreadHistoryParams;
+use crate::ThreadMetadataPatch;
+use crate::UpdateThreadMetadataParams;
+use crate::{ItemSortKey, ListItemsParams};
+use pretty_assertions::assert_eq;
+
+async fn portable_turns(store: &LocalThreadStore, thread_id: ThreadId) -> serde_json::Value {
+    let page = store
+        .list_turns(ListTurnsParams {
+            thread_id,
+            include_archived: false,
+            cursor: None,
+            page_size: 100,
+            sort_direction: SortDirection::Asc,
+            items_view: StoredTurnItemsView::Summary,
+        })
+        .await
+        .unwrap();
+    let mut value = serde_json::to_value(page.turns).unwrap();
+    for turn in value.as_array_mut().unwrap() {
+        for item in turn["items"].as_array_mut().unwrap() {
+            // Physical offsets are rebuilt; durable item IDs and timestamps must match.
+            item.as_object_mut().unwrap().remove("updated_at_ordinal");
+        }
+    }
+    let page = store
+        .list_items(ListItemsParams {
+            thread_id,
+            turn_id: None,
+            include_archived: false,
+            cursor: None,
+            page_size: 100,
+            sort_direction: SortDirection::Asc,
+            sort_key: ItemSortKey::CreatedAtOrdinal,
+            after_updated_at_ordinal: None,
+        })
+        .await
+        .unwrap();
+    assert!(page.next_cursor.is_none());
+    let mut items = serde_json::to_value(page.items).unwrap();
+    for item in items.as_array_mut().unwrap() {
+        item.as_object_mut().unwrap().remove("updated_at_ordinal");
+    }
+    serde_json::json!({ "turns": value, "items": items })
+}
+
+#[tokio::test]
+async fn portable_history_preserves_nested_frozen_ancestry_and_child_visibility() {
+    for child_only in [false, true] {
+        let home = TempDir::new().unwrap();
+        let destination = TempDir::new().unwrap();
+        let store = projection_store(home.path()).await;
+        let ancestor = ThreadId::new();
+        create_paginated_thread(&store, ancestor).await;
+        store
+            .persist_thread(ancestor, PersistContext::Standard)
+            .await
+            .unwrap();
+        store
+            .append_items(AppendThreadItemsParams {
+                thread_id: ancestor,
+                items: vec![
+                    turn_started("ancestor-turn"),
+                    user_message("ancestor before cutoff"),
+                    completed_item(
+                        ancestor,
+                        "ancestor-turn",
+                        agent_message("ancestor-answer", MessagePhase::FinalAnswer),
+                    ),
+                    turn_completed("ancestor-turn"),
+                ],
+            })
+            .await
+            .unwrap();
+        let ancestor_base = prepare_paginated_fork(&store, ancestor, ForkBoundary::Latest)
+            .await
+            .history_base
+            .unwrap();
+        store
+            .append_items(AppendThreadItemsParams {
+                thread_id: ancestor,
+                items: vec![
+                    turn_started("later-turn"),
+                    user_message("must not cross the frozen cutoff"),
+                    turn_completed("later-turn"),
+                ],
+            })
+            .await
+            .unwrap();
+        let ancestor_path = store.live_rollout_path(ancestor).await.unwrap();
+        store.shutdown_thread(ancestor).await.unwrap();
+        let middle = ThreadId::new();
+        create_paginated_subagent_thread(&store, middle, Some(ancestor_base), None).await;
+        store
+            .persist_thread(middle, PersistContext::Standard)
+            .await
+            .unwrap();
+        store
+            .append_items(AppendThreadItemsParams {
+                thread_id: middle,
+                items: vec![
+                    turn_started("middle-turn"),
+                    user_message("middle history"),
+                    completed_item(
+                        middle,
+                        "middle-turn",
+                        agent_message("middle-answer", MessagePhase::FinalAnswer),
+                    ),
+                    turn_completed("middle-turn"),
+                ],
+            })
+            .await
+            .unwrap();
+        let middle_base = prepare_paginated_fork(&store, middle, ForkBoundary::Latest)
+            .await
+            .history_base
+            .unwrap();
+        let middle_path = store.live_rollout_path(middle).await.unwrap();
+        store.shutdown_thread(middle).await.unwrap();
+        let leaf = ThreadId::new();
+        create_paginated_subagent_thread(
+            &store,
+            leaf,
+            Some(middle_base),
+            child_only.then_some(middle_base.end_ordinal_exclusive + 1),
+        )
+        .await;
+        store
+            .persist_thread(leaf, PersistContext::Standard)
+            .await
+            .unwrap();
+        store
+            .append_items(AppendThreadItemsParams {
+                thread_id: leaf,
+                items: vec![
+                    turn_started("leaf-turn"),
+                    user_message("leaf history"),
+                    completed_item(
+                        leaf,
+                        "leaf-turn",
+                        agent_message("leaf-answer", MessagePhase::FinalAnswer),
+                    ),
+                    turn_completed("leaf-turn"),
+                ],
+            })
+            .await
+            .unwrap();
+        store.flush_thread(leaf).await.unwrap();
+        store
+            .update_thread_metadata(UpdateThreadMetadataParams {
+                thread_id: leaf,
+                include_archived: false,
+                patch: ThreadMetadataPatch {
+                    name: Some(Some("Retained name".into())),
+                    ..Default::default()
+                },
+            })
+            .await
+            .unwrap();
+        let queued = store
+            .state_db()
+            .await
+            .unwrap()
+            .thread_queue()
+            .enqueue(leaf, r#"{"input":[{"type":"text","text":"pending"}]}"#)
+            .await
+            .unwrap();
+        compress_rollout(&ancestor_path);
+        compress_rollout(&middle_path);
+        let before = portable_turns(&store, leaf).await;
+        let snapshot = store
+            .export_portable_history(LoadThreadHistoryParams {
+                thread_id: leaf,
+                include_archived: false,
+            })
+            .await
+            .unwrap();
+        assert_eq!(snapshot.queue, vec![queued]);
+        assert_eq!(snapshot.metadata.name.as_deref(), Some("Retained name"));
+        let encoded = serde_json::to_string(&snapshot).unwrap();
+        assert!(encoded.contains("ancestor before cutoff"));
+        assert!(encoded.contains("middle history"));
+        assert!(!encoded.contains("must not cross the frozen cutoff"));
+        assert_eq!(snapshot.segments.len(), 3);
+        let target = projection_store(destination.path()).await;
+        let transfer_id = ThreadId::new();
+        // Real filesystem failure: the staging root is a file. No history
+        // metadata becomes visible and retry does not require a fresh runtime.
+        let staging_root = destination.path().join("managed-history-staging");
+        fs::write(&staging_root, b"blocked by fixture").unwrap();
+        assert!(
+            target
+                .import_portable_history(transfer_id, snapshot.clone())
+                .await
+                .is_err()
+        );
+        assert!(
+            target
+                .state_db()
+                .await
+                .unwrap()
+                .get_thread(leaf)
+                .await
+                .unwrap()
+                .is_none()
+        );
+        fs::remove_file(&staging_root).unwrap();
+        // An interrupted write left an incomplete unpublished manifest. The
+        // same operation repairs only its matching prefix and retains queue IDs.
+        let stage = staging_root.join(transfer_id.to_string());
+        fs::create_dir_all(&stage).unwrap();
+        let manifest = serde_json::to_vec(&snapshot).unwrap();
+        fs::write(stage.join("snapshot.json"), &manifest[..manifest.len() / 2]).unwrap();
+        // A real conflicting destination queue fails after files/projections
+        // were published. Clearing the fixture conflict permits an exact retry.
+        let conflict = target
+            .state_db()
+            .await
+            .unwrap()
+            .thread_queue()
+            .enqueue(leaf, "other pending input")
+            .await
+            .unwrap();
+        assert!(
+            target
+                .import_portable_history(transfer_id, snapshot.clone())
+                .await
+                .is_err()
+        );
+        assert!(
+            target
+                .state_db()
+                .await
+                .unwrap()
+                .get_thread(leaf)
+                .await
+                .unwrap()
+                .is_none()
+        );
+        target
+            .state_db()
+            .await
+            .unwrap()
+            .thread_queue()
+            .delete(leaf, &conflict.id)
+            .await
+            .unwrap();
+        let path = target
+            .import_portable_history(transfer_id, snapshot.clone())
+            .await
+            .unwrap();
+        assert_eq!(
+            target
+                .import_portable_history(transfer_id, snapshot.clone())
+                .await
+                .unwrap(),
+            path
+        );
+        let queue = target
+            .state_db()
+            .await
+            .unwrap()
+            .thread_queue()
+            .list_page(leaf, 0, 100)
+            .await
+            .unwrap();
+        assert_eq!(queue, snapshot.queue);
+        let metadata = target
+            .state_db()
+            .await
+            .unwrap()
+            .get_thread(leaf)
+            .await
+            .unwrap()
+            .unwrap();
+        assert_eq!(metadata.name, snapshot.metadata.name);
+        assert_eq!(metadata.model, snapshot.metadata.model);
+        assert_eq!(metadata.cwd, snapshot.metadata.cwd);
+        assert_eq!(metadata.tokens_used, snapshot.metadata.tokens_used);
+        assert!(
+            target
+                .import_portable_history(ThreadId::new(), snapshot.clone())
+                .await
+                .is_err()
+        );
+        let mut conflicting = snapshot.clone();
+        conflicting.metadata.title = "different transfer".into();
+        assert!(
+            target
+                .import_portable_history(transfer_id, conflicting)
+                .await
+                .is_err()
+        );
+        assert_eq!(portable_turns(&target, leaf).await, before);
+    }
+}
