diff --git a/codex-rs/thread-store/src/local/portable_history.rs b/codex-rs/thread-store/src/local/portable_history.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/thread-store/src/local/portable_history.rs
@@ -0,0 +1,125 @@
+use std::io::Read;
+use std::path::Path;
+
+use codex_protocol::protocol::ThreadHistoryMode;
+use codex_rollout::RolloutItem;
+use codex_rollout::RolloutLine;
+
+use super::LocalThreadStore;
+use super::thread_rollout_resolver;
+use crate::LoadThreadHistoryParams;
+use crate::PortableRolloutSegment;
+use crate::PortableThreadHistory;
+use crate::ThreadStoreError;
+use crate::ThreadStoreResult;
+
+fn storage_error(error: impl std::fmt::Display) -> ThreadStoreError {
+    ThreadStoreError::Internal {
+        message: format!("portable history capture failed: {error}"),
+    }
+}
+
+pub(super) async fn export(
+    store: &LocalThreadStore,
+    params: LoadThreadHistoryParams,
+) -> ThreadStoreResult<PortableThreadHistory> {
+    let _local_writer = store.live_writer_locks.lock(params.thread_id).await;
+    // The live recorder owns its interprocess lock. Offline reads acquire it so
+    // another process cannot mutate/revert this conversation during capture.
+    let _writer = store.acquire_writer_locks(&[params.thread_id]).await?;
+    let selected = if params.include_archived {
+        thread_rollout_resolver::resolve_current_including_archived(store, params.thread_id).await?
+    } else {
+        thread_rollout_resolver::resolve_current(store, params.thread_id).await?
+    }
+    .ok_or(ThreadStoreError::ThreadNotFound {
+        thread_id: params.thread_id,
+    })?;
+    let database = store
+        .state_db()
+        .await
+        .ok_or_else(|| storage_error("metadata database is unavailable"))?;
+    let metadata = database
+        .get_thread(params.thread_id)
+        .await
+        .map_err(storage_error)?
+        .ok_or_else(|| storage_error("thread metadata is absent"))?;
+    let segments = if metadata.history_mode == ThreadHistoryMode::Paginated {
+        store
+            .resolve_rollout_lineage(params.thread_id)
+            .await?
+            .segments()
+            .iter()
+            .map(|segment| {
+                (
+                    segment.rollout_id,
+                    segment.rollout_path.clone(),
+                    segment.end.map(|end| end.end_byte_offset),
+                )
+            })
+            .collect::<Vec<_>>()
+    } else {
+        vec![(selected.rollout_id, selected.path.clone(), None)]
+    };
+    let thread_id = params.thread_id;
+    let segments = tokio::task::spawn_blocking(move || {
+        let mut output = Vec::new();
+        for (rollout_id, path, end) in segments {
+            let content = read_segment(&path, end)?;
+            output.push(PortableRolloutSegment {
+                rollout_id,
+                content,
+            });
+        }
+        let root = output
+            .last()
+            .ok_or_else(|| storage_error("empty lineage"))?;
+        let head: RolloutLine = serde_json::from_str(root.content.lines().next().unwrap_or(""))
+            .map_err(storage_error)?;
+        if !matches!(head.item, RolloutItem::SessionMeta(meta) if meta.meta.id == thread_id) {
+            return Err(storage_error("selected rollout belongs to another thread"));
+        }
+        Ok(output)
+    })
+    .await
+    .map_err(storage_error)??;
+    let mut queue = Vec::new();
+    loop {
+        let page = database
+            .thread_queue()
+            .list_page(params.thread_id, queue.len(), 1000)
+            .await
+            .map_err(storage_error)?;
+        let count = page.len();
+        queue.extend(page);
+        if count < 1000 {
+            break;
+        }
+    }
+    Ok(PortableThreadHistory {
+        version: 1,
+        thread_id: params.thread_id,
+        metadata,
+        segments,
+        queue,
+    })
+}
+
+fn read_segment(path: &Path, end: Option<u64>) -> ThreadStoreResult<String> {
+    let input = codex_rollout::open_rollout_seekable_reader(path).map_err(storage_error)?;
+    let mut bytes = Vec::new();
+    input
+        .take(end.unwrap_or(u64::MAX))
+        .read_to_end(&mut bytes)
+        .map_err(storage_error)?;
+    if end.is_some_and(|end| end != bytes.len() as u64) || !bytes.ends_with(b"\n") {
+        return Err(storage_error("history prefix is truncated or incomplete"));
+    }
+    let content = String::from_utf8(bytes).map_err(storage_error)?;
+    // Do not reserialize: HistoryPosition includes exact byte offsets. Reject
+    // malformed input rather than acknowledging an incomplete conversation.
+    for line in content.lines().filter(|line| !line.trim().is_empty()) {
+        serde_json::from_str::<RolloutLine>(line).map_err(storage_error)?;
+    }
+    Ok(content)
+}
diff --git a/codex-rs/thread-store/src/local/portable_history_import.rs b/codex-rs/thread-store/src/local/portable_history_import.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/thread-store/src/local/portable_history_import.rs
@@ -0,0 +1,306 @@
+//! Destination-side publication. Staged files contain only the selected bounded
+//! ancestry. No account configuration, credentials or unrelated database is copied.
+use std::collections::HashSet;
+use std::fs;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+
+use codex_protocol::ThreadId;
+use codex_protocol::protocol::ThreadHistoryMode;
+use codex_rollout::RolloutItem;
+use codex_rollout::RolloutLine;
+
+use super::LocalThreadStore;
+use crate::PortableThreadHistory;
+use crate::ThreadStoreError;
+use crate::ThreadStoreResult;
+
+fn error(error: impl std::fmt::Display) -> ThreadStoreError {
+    ThreadStoreError::Internal {
+        message: format!("portable history import failed: {error}"),
+    }
+}
+fn conflict(message: &str) -> ThreadStoreError {
+    ThreadStoreError::Conflict {
+        message: message.into(),
+    }
+}
+
+pub(super) async fn import(
+    store: &LocalThreadStore,
+    transfer_id: ThreadId,
+    snapshot: PortableThreadHistory,
+) -> ThreadStoreResult<PathBuf> {
+    let files = validate(&snapshot)?;
+    let thread_id = snapshot.thread_id;
+    let mut ids = snapshot
+        .segments
+        .iter()
+        .map(|s| s.rollout_id)
+        .collect::<Vec<_>>();
+    ids.push(thread_id);
+    ids.sort_by_key(ToString::to_string);
+    ids.dedup();
+    let mut local_writers = Vec::new();
+    for id in &ids {
+        local_writers.push(store.live_writer_locks.lock(*id).await);
+        store.ensure_live_recorder_absent(*id).await?;
+    }
+    let _writers = store.acquire_writer_locks(&ids).await?;
+    let database = store
+        .state_db()
+        .await
+        .ok_or_else(|| error("metadata database is unavailable"))?;
+    let subdir = if snapshot.metadata.archived_at.is_some() {
+        codex_rollout::ARCHIVED_SESSIONS_SUBDIR
+    } else {
+        codex_rollout::SESSIONS_SUBDIR
+    };
+    // Recursive rollout-ID lookup sees ancestors here, while the ordinary date
+    // directory discovery does not invent extra chats from ancestor fragments.
+    let destination = store
+        .config
+        .codex_home
+        .join(subdir)
+        .join(format!("managed-transfer-{transfer_id}"));
+    let root_path = destination.join(files.last().ok_or_else(|| error("empty lineage"))?);
+    let manifest = serde_json::to_vec(&snapshot).map_err(error)?;
+    let mut metadata = snapshot.metadata.clone();
+    metadata.rollout_path = root_path.clone();
+    if let Some(existing) = database.get_thread(thread_id).await.map_err(error)? {
+        if existing.rollout_path != root_path {
+            return Err(conflict(
+                "migration destination conversation already exists",
+            ));
+        }
+        // The import can be acknowledged before its last response reaches the
+        // worker. Exact retries return the prior result without changing history.
+        verify_manifest(&destination, &manifest)?;
+        if destination.join("complete").is_file() {
+            return Ok(root_path);
+        }
+    }
+    for segment in &snapshot.segments {
+        if let Some(existing) = codex_rollout::find_rollout_path_by_rollout_id(
+            &store.config.codex_home,
+            segment.rollout_id,
+        )
+        .await
+        .map_err(error)?
+        {
+            if existing.parent() != Some(destination.as_path()) {
+                return Err(conflict(
+                    "migration destination already owns a source rollout",
+                ));
+            }
+        }
+    }
+    let stage = store
+        .config
+        .codex_home
+        .join("managed-history-staging")
+        .join(transfer_id.to_string());
+    let publish_destination = destination.clone();
+    let manifest_copy = manifest.clone();
+    let segments = snapshot.segments.clone();
+    let import_files = files.clone();
+    tokio::task::spawn_blocking(move || -> ThreadStoreResult<()> {
+        if publish_destination.exists() {
+            verify_manifest(&publish_destination, &manifest_copy)?;
+        } else {
+            private_dir(&stage)?;
+            write_exact(&stage.join("snapshot.json"), &manifest_copy)?;
+            for (segment, name) in segments.iter().zip(&import_files) {
+                write_exact(&stage.join(name), segment.content.as_bytes())?;
+            }
+            fs::File::open(&stage)
+                .and_then(|f| f.sync_all())
+                .map_err(error)?;
+            let parent = publish_destination
+                .parent()
+                .ok_or_else(|| error("missing parent"))?;
+            private_dir(parent)?;
+            fs::rename(&stage, &publish_destination).map_err(error)?;
+            fs::File::open(parent)
+                .and_then(|f| f.sync_all())
+                .map_err(error)?;
+        }
+        for (segment, name) in segments.iter().zip(&import_files) {
+            if fs::read(publish_destination.join(name)).map_err(error)?
+                != segment.content.as_bytes()
+            {
+                return Err(conflict(
+                    "published migration history changed before completion",
+                ));
+            }
+        }
+        Ok(())
+    })
+    .await
+    .map_err(error)??;
+    if metadata.history_mode == ThreadHistoryMode::Paginated {
+        for (segment, name) in snapshot.segments.iter().zip(&files) {
+            super::thread_history_materialization::materialize_to_sqlite(
+                store,
+                segment.rollout_id,
+                &destination.join(name),
+            )
+            .await?;
+        }
+    }
+    database
+        .thread_queue()
+        .restore_into_empty(thread_id, &snapshot.queue)
+        .await
+        .map_err(error)?;
+    // Metadata is the final visibility step. No existing row is overwritten.
+    let inserted = database
+        .insert_thread_if_absent(&metadata)
+        .await
+        .map_err(error)?;
+    if !inserted
+        && database
+            .get_thread(thread_id)
+            .await
+            .map_err(error)?
+            .is_none_or(|current| current.rollout_path != root_path)
+    {
+        return Err(conflict("migration destination changed during publication"));
+    }
+    let final_directory = destination.clone();
+    tokio::task::spawn_blocking(move || {
+        write_exact(&final_directory.join("complete"), b"1\n")?;
+        fs::File::open(&final_directory)
+            .and_then(|f| f.sync_all())
+            .map_err(error)
+    })
+    .await
+    .map_err(error)??;
+    Ok(root_path)
+}
+
+fn validate(snapshot: &PortableThreadHistory) -> ThreadStoreResult<Vec<String>> {
+    if snapshot.version != 1
+        || snapshot.metadata.id != snapshot.thread_id
+        || snapshot.segments.is_empty()
+    {
+        return Err(conflict("invalid portable history identity or version"));
+    }
+    let mut seen = HashSet::new();
+    let mut names = Vec::new();
+    let mut previous = None;
+    for segment in &snapshot.segments {
+        if !seen.insert(segment.rollout_id) || !segment.content.ends_with('\n') {
+            return Err(conflict("duplicate or incomplete portable history segment"));
+        }
+        let mut lines = segment
+            .content
+            .lines()
+            .filter(|line| !line.trim().is_empty());
+        let first: RolloutLine = serde_json::from_str(lines.next().unwrap_or("")).map_err(error)?;
+        let RolloutItem::SessionMeta(meta) = first.item else {
+            return Err(conflict("portable history segment has no session metadata"));
+        };
+        if meta.meta.history_mode != snapshot.metadata.history_mode {
+            return Err(conflict("portable history modes disagree"));
+        }
+        if let Some(base) = meta.meta.history_base {
+            if previous != Some((base.thread_id, base.end_byte_offset)) {
+                return Err(conflict(
+                    "portable history ancestry or byte cutoff is incomplete",
+                ));
+            }
+        } else if previous.is_some() {
+            return Err(conflict("portable history contains an unrelated segment"));
+        }
+        for line in lines {
+            let record: RolloutLine = serde_json::from_str(line).map_err(error)?;
+            if matches!(record.item, RolloutItem::SessionMeta(_)) {
+                return Err(conflict("unexpected session metadata inside a segment"));
+            }
+        }
+        let suffix = if meta.meta.id == segment.rollout_id {
+            String::new()
+        } else {
+            format!("_{}", segment.rollout_id)
+        };
+        let timestamp = chrono::DateTime::parse_from_rfc3339(&meta.meta.timestamp)
+            .map_err(error)?
+            .format("%Y-%m-%dT%H-%M-%S");
+        names.push(format!(
+            "rollout-{timestamp}-{}{suffix}.jsonl",
+            meta.meta.id
+        ));
+        previous = Some((segment.rollout_id, segment.content.len() as u64));
+    }
+    let root: RolloutLine = serde_json::from_str(
+        snapshot
+            .segments
+            .last()
+            .unwrap()
+            .content
+            .lines()
+            .next()
+            .unwrap(),
+    )
+    .map_err(error)?;
+    if !matches!(root.item, RolloutItem::SessionMeta(meta) if meta.meta.id == snapshot.thread_id) {
+        return Err(conflict(
+            "portable history root belongs to another conversation",
+        ));
+    }
+    Ok(names)
+}
+
+fn private_dir(path: &Path) -> ThreadStoreResult<()> {
+    let mut builder = fs::DirBuilder::new();
+    builder.recursive(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::DirBuilderExt;
+        builder.mode(0o700);
+    }
+    builder.create(path).map_err(error)
+}
+fn verify_manifest(directory: &Path, expected: &[u8]) -> ThreadStoreResult<()> {
+    if fs::read(directory.join("snapshot.json")).map_err(error)? != expected {
+        return Err(conflict(
+            "migration operation ID was reused for a different snapshot",
+        ));
+    }
+    Ok(())
+}
+fn write_exact(path: &Path, content: &[u8]) -> ThreadStoreResult<()> {
+    let mut options = fs::OpenOptions::new();
+    options.write(true).create_new(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.mode(0o600);
+    }
+    match options.open(path) {
+        Ok(mut file) => {
+            file.write_all(content)
+                .and_then(|_| file.sync_all())
+                .map_err(error)?;
+        }
+        Err(err) if err.kind() == std::io::ErrorKind::AlreadyExists => {
+            let existing = fs::read(path).map_err(error)?;
+            if !content.starts_with(&existing) {
+                return Err(conflict(
+                    "migration staging file differs from the requested snapshot",
+                ));
+            }
+            let mut file = fs::OpenOptions::new()
+                .append(true)
+                .open(path)
+                .map_err(error)?;
+            file.write_all(&content[existing.len()..])
+                .and_then(|_| file.sync_all())
+                .map_err(error)?;
+        }
+        Err(err) => return Err(error(err)),
+    }
+    Ok(())
+}
