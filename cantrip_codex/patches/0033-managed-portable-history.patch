@@ -0,0 +1,74 @@
+//! Transfer artifacts stay on the worker; RPC responses carry paths, never a
+//! conversation-sized JSON payload. This is separate from model context reset.
+use std::fs;
+use std::io::Write;
+use std::path::PathBuf;
+
+use codex_protocol::ThreadId;
+use codex_thread_store::PortableThreadHistory;
+
+pub(super) async fn write_export(
+    home: PathBuf,
+    transfer_id: ThreadId,
+    snapshot: PortableThreadHistory,
+) -> anyhow::Result<PathBuf> {
+    tokio::task::spawn_blocking(move || {
+        let directory = home.join("managed-history-exports");
+        let mut builder = fs::DirBuilder::new();
+        builder.recursive(true);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::DirBuilderExt;
+            builder.mode(0o700);
+        }
+        builder.create(&directory)?;
+        let path = directory.join(format!("{transfer_id}.json"));
+        let bytes = serde_json::to_vec(&snapshot)?;
+        if path.exists() {
+            anyhow::ensure!(
+                fs::read(&path)? == bytes,
+                "history export operation ID was reused after history changed"
+            );
+            return Ok(path);
+        }
+        let temporary = directory.join(format!("{transfer_id}-{}.partial", ThreadId::new()));
+        let mut options = fs::OpenOptions::new();
+        options.write(true).create_new(true);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::OpenOptionsExt;
+            options.mode(0o600);
+        }
+        let mut file = options.open(&temporary)?;
+        file.write_all(&bytes)?;
+        file.sync_all()?;
+        drop(file);
+        // Publish without replacing an export created by a concurrent request
+        // on another thread that reused the same operation ID.
+        match fs::hard_link(&temporary, &path) {
+            Ok(()) => {}
+            Err(err) if err.kind() == std::io::ErrorKind::AlreadyExists => {
+                let same = fs::read(&path)? == bytes;
+                fs::remove_file(&temporary)?;
+                anyhow::ensure!(
+                    same,
+                    "history export operation ID was reused for another snapshot"
+                );
+                return Ok(path);
+            }
+            Err(err) => {
+                let _ = fs::remove_file(&temporary);
+                return Err(err.into());
+            }
+        }
+        fs::remove_file(&temporary)?;
+        fs::File::open(&directory)?.sync_all()?;
+        Ok(path)
+    })
+    .await?
+}
+
+pub(super) async fn read_export(path: PathBuf) -> anyhow::Result<PortableThreadHistory> {
+    anyhow::ensure!(path.is_absolute(), "history export path must be absolute");
+    tokio::task::spawn_blocking(move || Ok(serde_json::from_reader(fs::File::open(path)?)?)).await?
+}
