+++ b/codex-rs/thread-store/src/portable_history.rs
@@ -0,0 +1,27 @@
+//! Complete, worker-private conversation transport. This is not model input or
+//! an account configuration export. History identity and event timestamps survive.
+use codex_protocol::ThreadId;
+use codex_state::QueuedUserSubmissionRecord;
+use codex_state::ThreadMetadata;
+use serde::Deserialize;
+use serde::Serialize;
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct PortableThreadHistory {
+    pub version: u32,
+    pub thread_id: ThreadId,
+    pub metadata: ThreadMetadata,
+    pub segments: Vec<PortableRolloutSegment>,
+    pub queue: Vec<QueuedUserSubmissionRecord>,
+}
+
+/// Exact decoded bytes preserve native ordinals, frozen byte cutoffs, canonical
+/// item identity and each ancestor's own visibility boundary. Only the selected
+/// prefix is included; no other conversation or account configuration is copied.
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct PortableRolloutSegment {
+    pub rollout_id: ThreadId,
+    pub content: String,
+}
