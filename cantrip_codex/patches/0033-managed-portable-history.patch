+    /// Restore the exact ordered queue for a new migration destination. An exact
+    /// retry is harmless; a pre-existing different queue is never replaced.
+    pub async fn restore_into_empty(
+        &self,
+        thread_id: ThreadId,
+        records: &[QueuedUserSubmissionRecord],
+    ) -> anyhow::Result<()> {
+        let mut transaction = self.pool.begin_with("BEGIN IMMEDIATE").await?;
+        let existing = sqlx::query(
+            "SELECT id, thread_id, payload_json FROM queued_items WHERE thread_id = ? ORDER BY queue_order"
+        ).bind(thread_id.to_string()).fetch_all(&mut *transaction).await?
+            .iter().map(QueuedUserSubmissionRecord::try_from_row).collect::<anyhow::Result<Vec<_>>>()?;
+        if !existing.is_empty() {
+            anyhow::ensure!(
+                existing == records,
+                "migration destination queue is already in use"
+            );
+            transaction.commit().await?;
+            return Ok(());
+        }
+        let mut ids = std::collections::HashSet::new();
+        let now_ms = datetime_to_epoch_millis(Utc::now());
+        for (order, record) in records.iter().enumerate() {
+            anyhow::ensure!(
+                record.thread_id == thread_id && ids.insert(&record.id),
+                "invalid migration queue identity"
+            );
+            sqlx::query("INSERT INTO queued_items (id, thread_id, payload_json, queue_order, created_at_ms, updated_at_ms) VALUES (?, ?, ?, ?, ?, ?)")
+                .bind(&record.id).bind(thread_id.to_string()).bind(&record.payload)
+                .bind(i64::try_from(order)?).bind(now_ms).bind(now_ms)
+                .execute(&mut *transaction).await?;
+        }
+        transaction.commit().await?;
+        Ok(())
     }
 
