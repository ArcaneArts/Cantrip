@@ -0,0 +1,1314 @@
+//! Native continuation capture. The checkpoint refers to the committed native
+//! rollout; it never substitutes a second transcript or retains execution grants.
+
+use super::input_queue::TurnInputQueue;
+use super::session::Session;
+use super::turn::McpStartupRequirements;
+use super::turn::TurnLoopState;
+use super::turn_context::TurnContext;
+use crate::session::TurnInput;
+use crate::session::UserInputMetadata;
+use crate::tools::context::SharedTurnDiffTracker;
+use crate::turn_diff_tracker::TurnDiffSnapshot;
+use codex_history::CodexHarnessMetadata;
+use codex_history::ResponseItemEnvelope;
+use codex_history::RolloutItem;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::ThreadSettingsSnapshot;
+use codex_protocol::protocol::TokenUsage;
+use codex_protocol::protocol::TurnContextItem;
+use codex_protocol::turn_input::TurnStartOptions;
+use codex_protocol::user_input::UserInput;
+use codex_turn_checkpoint::Checkpoint;
+use codex_turn_checkpoint::CheckpointIdentity;
+use codex_turn_checkpoint::CheckpointState;
+use codex_turn_checkpoint::LockedCheckpoint;
+use serde::Deserialize;
+use serde::Serialize;
+use sha2::Digest;
+use sha2::Sha256;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+
+const RUNTIME: &str = concat!(env!("CARGO_PKG_VERSION"), "/cantrip-suspension-v2");
+
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct NativeSuspension {
+    pub thread_id: String,
+    pub turn_id: String,
+    pub checkpoint_id: String,
+    pub revision: u64,
+}
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(tag = "kind", deny_unknown_fields)]
+enum SavedInput {
+    User {
+        content: Vec<UserInput>,
+        client_id: Option<String>,
+        metadata: UserInputMetadata,
+    },
+    Function {
+        item: ResponseItem,
+        metadata: Option<CodexHarnessMetadata>,
+    },
+    Item {
+        item: ResponseItem,
+        metadata: Option<CodexHarnessMetadata>,
+    },
+    Mail {
+        communication: crate::PendingAgentMessage,
+    },
+}
+
+impl From<&TurnInput> for SavedInput {
+    fn from(input: &TurnInput) -> Self {
+        match input {
+            TurnInput::UserInput {
+                content,
+                client_id,
+                metadata,
+            } => Self::User {
+                content: content.clone(),
+                client_id: client_id.clone(),
+                metadata: *metadata,
+            },
+            TurnInput::FunctionCallOutput(item) => Self::Function {
+                item: item.item.clone(),
+                metadata: item.metadata.clone(),
+            },
+            TurnInput::ResponseItem(item) => Self::Item {
+                item: item.item.clone(),
+                metadata: item.metadata.clone(),
+            },
+            TurnInput::InterAgentCommunication(communication) => Self::Mail {
+                communication: communication.clone(),
+            },
+        }
+    }
+}
+
+impl From<SavedInput> for TurnInput {
+    fn from(input: SavedInput) -> Self {
+        match input {
+            SavedInput::User {
+                content,
+                client_id,
+                metadata,
+            } => Self::UserInput {
+                content,
+                client_id,
+                metadata,
+            },
+            SavedInput::Function { item, metadata } => {
+                Self::FunctionCallOutput(ResponseItemEnvelope { item, metadata })
+            }
+            SavedInput::Item { item, metadata } => {
+                Self::ResponseItem(ResponseItemEnvelope { item, metadata })
+            }
+            SavedInput::Mail { communication } => Self::InterAgentCommunication(communication),
+        }
+    }
+}
+
+#[derive(Clone, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct SavedEnvironment {
+    environment_id: String,
+    cwd: codex_utils_path_uri::PathUri,
+    workspace_roots: Vec<codex_utils_path_uri::PathUri>,
+}
+
+async fn environments(session: &Session) -> Vec<SavedEnvironment> {
+    session
+        .configured_environment_selections()
+        .await
+        .into_iter()
+        .map(|selection| SavedEnvironment {
+            environment_id: selection.environment_id,
+            cwd: selection.cwd,
+            workspace_roots: selection.workspace_roots,
+        })
+        .collect()
+}
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct SavedTurn {
+    pub(super) loop_state: TurnLoopState,
+    pub(super) mcp: McpStartupRequirements,
+    pub(super) diff: TurnDiffSnapshot,
+    pub(super) context: TurnContextItem,
+    initial_step_settings: super::step_settings::SuspendedStepSettings,
+    configured_token_budget: Option<crate::config::TokenBudgetConfig>,
+    use_model_token_budget_defaults: bool,
+    pub(super) next_step_settings: super::step_settings::SuspendedStepSettings,
+    pending_step_settings: Option<super::step_settings::SuspendedStepSettings>,
+    session_state: crate::state::SuspendedSessionState,
+    pub(super) timing: crate::turn_timing::SuspendedTurnTiming,
+    pub(super) settings: ThreadSettingsSnapshot,
+    environments: Vec<SavedEnvironment>,
+    pub(super) start_options: TurnStartOptions,
+    pending: Vec<SavedInput>,
+    pending_injection: bool,
+    pub(super) tool_calls: u64,
+    pub(super) has_memory_citation: bool,
+    pub(super) token_usage_at_turn_start: TokenUsage,
+    pub(super) token_usage_by_model: Vec<(String, TokenUsage)>,
+    history_items: usize,
+}
+
+/// Held by the live thread, including while sampling after an explicit Resume.
+/// An OS lock prevents another process restoring its checkpoint concurrently.
+#[derive(Default)]
+pub(crate) struct DurableSuspension {
+    epoch: AtomicU64,
+    requested: AtomicBool,
+    pub(crate) frozen: AtomicBool,
+    store: Mutex<Option<LockedCheckpoint<SavedTurn>>>,
+    boundary: Mutex<Option<std::result::Result<NativeSuspension, String>>>,
+    live_resume: Mutex<Option<Arc<LiveResume>>>,
+}
+
+pub(crate) struct LiveResume {
+    epoch: u64,
+    ready: tokio::sync::watch::Sender<Option<std::result::Result<(), String>>>,
+}
+
+impl LiveResume {
+    async fn wait(&self) -> Result<()> {
+        let mut ready = self.ready.subscribe();
+        loop {
+            if let Some(result) = ready.borrow().clone() {
+                return result.map_err(invalid);
+            }
+            ready.changed().await.map_err(io)?;
+        }
+    }
+}
+
+fn io(error: impl std::fmt::Display) -> CodexErr {
+    CodexErr::Io(std::io::Error::other(error.to_string()))
+}
+
+fn invalid(message: impl Into<String>) -> CodexErr {
+    CodexErr::InvalidRequest(message.into())
+}
+
+pub(crate) fn coordinator(session: &Session) -> Arc<DurableSuspension> {
+    session
+        .services
+        .thread_extension_data
+        .get_or_init(DurableSuspension::default)
+}
+
+/// Run while a stored thread is being attached, before startup prewarm or
+/// autonomous input admission. Loading a suspended thread never advances it.
+pub(super) async fn restore_gate_on_load(session: &Session) {
+    let owner = coordinator(session);
+    let result = async {
+        let Some(record) = owner.read(session).await? else {
+            return Ok(false);
+        };
+        if record.state != CheckpointState::Suspended {
+            return Ok(false);
+        }
+        let live = session
+            .live_thread_for_persistence("inspect suspension during thread attach")
+            .map_err(io)?;
+        let history = live.load_continuation_history().await.map_err(io)?;
+        if validate_unfinished(&history, &record.identity.turn_id).is_err() {
+            // Actual terminal/replacement history wins over an old checkpoint.
+            owner.settle(session, CheckpointState::Invalidated).await?;
+            return Ok(false);
+        }
+        Ok::<_, CodexErr>(true)
+    }
+    .await;
+    let frozen = match result {
+        Ok(frozen) => frozen,
+        Err(error) => {
+            // Keep the chat inspectable and preserve the actual read error for
+            // explicit suspension controls. Never replace an unreadable turn.
+            tracing::warn!(%error, "native suspension requires explicit recovery");
+            true
+        }
+    };
+    owner.frozen.store(frozen, Ordering::Release);
+}
+
+fn descriptor(record: &Checkpoint<SavedTurn>) -> NativeSuspension {
+    NativeSuspension {
+        thread_id: record.identity.thread_id.clone(),
+        turn_id: record.identity.turn_id.clone(),
+        checkpoint_id: record.identity.checkpoint_id.clone(),
+        revision: record.revision,
+    }
+}
+
+fn history_digest(items: &[RolloutItem]) -> Result<String> {
+    // Canonicalize even when another workspace crate enables preserve_order.
+    let mut value = serde_json::to_value(items).map_err(io)?;
+    value.sort_all_objects();
+    let bytes = serde_json::to_vec(&value).map_err(io)?;
+    Ok(format!("{:x}", Sha256::digest(bytes)))
+}
+
+impl DurableSuspension {
+    async fn with_store<T: Send + 'static>(
+        self: &Arc<Self>,
+        session: &Session,
+        action: impl FnOnce(&LockedCheckpoint<SavedTurn>) -> Result<T> + Send + 'static,
+    ) -> Result<T> {
+        let directory = session
+            .get_config()
+            .await
+            .codex_home
+            .join("turn-suspensions");
+        let thread_id = session.thread_id.to_string();
+        let owner = Arc::clone(self);
+        tokio::task::spawn_blocking(move || {
+            let mut guard = owner.store.lock().map_err(io)?;
+            if guard.is_none() {
+                *guard = Some(LockedCheckpoint::acquire(&directory, &thread_id).map_err(io)?);
+            }
+            action(
+                guard
+                    .as_ref()
+                    .ok_or_else(|| invalid("native checkpoint owner is missing"))?,
+            )
+        })
+        .await
+        .map_err(io)?
+    }
+
+    pub(crate) fn release_live_gate(&self) {
+        self.cancel_live_resume("native resumption was stopped or superseded");
+        self.epoch.fetch_add(1, Ordering::AcqRel);
+        self.requested.store(false, Ordering::Release);
+        self.frozen.store(false, Ordering::Release);
+        if let Ok(mut boundary) = self.boundary.lock() {
+            *boundary = None;
+        }
+    }
+
+    pub(crate) fn request(&self) {
+        self.cancel_live_resume("native resumption was superseded by another pause");
+        self.epoch.fetch_add(1, Ordering::AcqRel);
+        self.requested.store(true, Ordering::Release);
+        if let Ok(mut boundary) = self.boundary.lock() {
+            *boundary = None;
+        }
+    }
+
+    pub(crate) fn has_live_suspension(&self) -> bool {
+        self.requested.load(Ordering::Acquire) || self.frozen.load(Ordering::Acquire)
+    }
+
+    fn cancel_live_resume(&self, reason: &str) {
+        if let Ok(mut pending) = self.live_resume.lock()
+            && let Some(pending) = pending.take()
+        {
+            pending.ready.send_replace(Some(Err(reason.into())));
+        }
+    }
+
+    pub(crate) fn begin_live_resume(&self) -> Result<Arc<LiveResume>> {
+        let mut pending = self.live_resume.lock().map_err(io)?;
+        if let Some(pending) = pending.as_ref()
+            && pending.epoch == self.epoch.load(Ordering::Acquire)
+        {
+            return Ok(Arc::clone(pending));
+        }
+        self.requested.store(false, Ordering::Release);
+        let epoch = self.epoch.fetch_add(1, Ordering::AcqRel) + 1;
+        let resume = Arc::new(LiveResume {
+            epoch,
+            ready: tokio::sync::watch::channel(None).0,
+        });
+        *pending = Some(Arc::clone(&resume));
+        *self.boundary.lock().map_err(io)? = None;
+        Ok(resume)
+    }
+
+    pub(crate) fn complete_live_resume(&self, result: std::result::Result<(), String>) {
+        if let Ok(mut pending) = self.live_resume.lock()
+            && let Some(pending) = pending.take()
+        {
+            if pending.epoch == self.epoch.load(Ordering::Acquire) {
+                pending.ready.send_replace(Some(result));
+            } else {
+                pending
+                    .ready
+                    .send_replace(Some(Err("native resumption was superseded".into())));
+            }
+        }
+    }
+
+    pub(crate) fn boundary(&self) -> Result<NativeSuspension> {
+        self.boundary
+            .lock()
+            .map_err(io)?
+            .as_ref()
+            .ok_or_else(|| invalid("the turn finished without a resumable suspension"))?
+            .clone()
+            .map_err(invalid)
+    }
+
+    pub(crate) async fn capture(
+        self: &Arc<Self>,
+        session: &Session,
+        turn: &TurnContext,
+        state: &TurnLoopState,
+        mcp: &McpStartupRequirements,
+        diff: &SharedTurnDiffTracker,
+        pending_step: Option<&super::step_settings::ResolvedStepSettings>,
+    ) {
+        if !self.requested.load(Ordering::Acquire)
+            || self
+                .boundary
+                .lock()
+                .is_ok_and(|boundary| boundary.is_some())
+        {
+            return;
+        }
+        let epoch = self.epoch.load(Ordering::Acquire);
+        let captured = self
+            .capture_inner(session, turn, state, mcp, diff, pending_step, epoch)
+            .await;
+        if self.epoch.load(Ordering::Acquire) != epoch {
+            return;
+        }
+        if let Ok(mut boundary) = self.boundary.lock() {
+            *boundary = Some(captured.map_err(|error| error.to_string()));
+        }
+    }
+
+    #[expect(clippy::too_many_arguments)]
+    async fn capture_inner(
+        self: &Arc<Self>,
+        session: &Session,
+        turn: &TurnContext,
+        loop_state: &TurnLoopState,
+        mcp: &McpStartupRequirements,
+        diff: &SharedTurnDiffTracker,
+        pending_step: Option<&super::step_settings::ResolvedStepSettings>,
+        epoch: u64,
+    ) -> Result<NativeSuspension> {
+        let processes = session.services.unified_exec_manager.list_processes().await;
+        if !processes.is_empty() {
+            return Err(invalid(
+                "durable pause requires background commands to finish or be stopped; the live turn remains paused",
+            ));
+        }
+        if session
+            .services
+            .code_mode_service
+            .has_active_cells_for_suspension()
+        {
+            return Err(invalid(
+                "durable pause requires yielded code-mode cells to finish; the live turn remains paused",
+            ));
+        }
+        let children = session
+            .services
+            .agent_control
+            .child_agent_paths(session.thread_id)
+            .await;
+        if !children.is_empty() {
+            return Err(invalid(
+                "durable suspension of native subagent trees is not available yet; the live turn remains paused",
+            ));
+        }
+        let (
+            pending,
+            pending_injection,
+            tool_calls,
+            has_memory_citation,
+            token_usage_at_turn_start,
+            token_usage_by_model,
+        ) = {
+            let active = session.active_turn.lock().await;
+            let active = active
+                .as_ref()
+                .ok_or_else(|| invalid("the suspension no longer owns an active turn"))?;
+            if active
+                .task
+                .as_ref()
+                .is_none_or(|task| task.turn_context.sub_id != turn.sub_id)
+            {
+                return Err(invalid("the suspension belongs to a replaced turn"));
+            }
+            let state = active.turn_state.lock().await;
+            if state.has_pending_waiters() {
+                return Err(invalid(
+                    "answer outstanding native interactions before durable pause",
+                ));
+            }
+            if self.epoch.load(Ordering::Acquire) != epoch
+                || !self.requested.load(Ordering::Acquire)
+            {
+                return Err(invalid("suspension capture was superseded"));
+            }
+            // Freeze under the same active-turn lock used by input acceptance.
+            // Stop cannot finish and then be refrozen by an older capture.
+            self.frozen.store(true, Ordering::Release);
+            (
+                state
+                    .pending_input
+                    .items
+                    .iter()
+                    .map(SavedInput::from)
+                    .collect(),
+                state.pending_input.has_pending_injection,
+                state.tool_calls,
+                state.has_memory_citation,
+                state.token_usage_at_turn_start.clone(),
+                state.token_usage_by_model.suspension_snapshot(),
+            )
+        };
+        // Drain session-owned speculative inference and its usage accounting.
+        // A cancelled compaction candidate can be recomputed after explicit Resume.
+        super::async_compaction::suspend(session).await;
+        let session_state = session.state.lock().await.suspension_snapshot();
+        let live = session
+            .live_thread_for_persistence("checkpoint suspended turn")
+            .map_err(io)?;
+        live.flush().await.map_err(io)?;
+        let history = live.load_continuation_history().await.map_err(io)?;
+        validate_unfinished(&history, &turn.sub_id)?;
+        let history_binding = history_digest(&history)?;
+        let saved = SavedTurn {
+            loop_state: loop_state.clone(),
+            mcp: mcp.clone(),
+            diff: diff.lock().await.snapshot(),
+            context: turn.to_turn_context_item(),
+            initial_step_settings: turn.initial_settings.suspension_snapshot(),
+            configured_token_budget: turn.configured_token_budget.clone(),
+            use_model_token_budget_defaults: turn.use_model_token_budget_defaults,
+            next_step_settings: turn.next_step_settings.load().suspension_snapshot(),
+            pending_step_settings: pending_step.map(|settings| settings.suspension_snapshot()),
+            session_state,
+            timing: turn.turn_timing_state.suspension_snapshot().await,
+            settings: session.thread_settings_snapshot().await,
+            environments: environments(session).await,
+            start_options: {
+                let mut options = session.recovered_turn_start_options(&turn.sub_id).await;
+                options.final_output_json_schema = turn.final_output_json_schema.clone();
+                options.cyber_access_program = turn.cyber_access_program;
+                options.service_tier = Some(
+                    turn.next_step_settings
+                        .load()
+                        .selected()
+                        .service_tier
+                        .clone()
+                        .unwrap_or_else(|| {
+                            codex_protocol::config_types::SERVICE_TIER_DEFAULT_REQUEST_VALUE.into()
+                        }),
+                );
+                options
+            },
+            pending,
+            pending_injection,
+            tool_calls,
+            has_memory_citation,
+            token_usage_at_turn_start,
+            token_usage_by_model,
+            history_items: history.len(),
+        };
+        let thread_id = session.thread_id.to_string();
+        let turn_id = turn.sub_id.clone();
+        let owner = Arc::clone(self);
+        self.with_store(session, move |store| {
+            if owner.epoch.load(Ordering::Acquire) != epoch
+                || !owner.requested.load(Ordering::Acquire)
+            {
+                return Err(invalid("suspension capture was superseded"));
+            }
+            let previous = store.read(RUNTIME).map_err(io)?;
+            let expected = previous.as_ref().map(|old| old.revision);
+            let record = Checkpoint {
+                identity: CheckpointIdentity {
+                    thread_id,
+                    turn_id,
+                    checkpoint_id: uuid::Uuid::now_v7().to_string(),
+                },
+                revision: expected
+                    .unwrap_or(0)
+                    .checked_add(1)
+                    .ok_or_else(|| invalid("checkpoint revision exhausted"))?,
+                runtime_version: RUNTIME.into(),
+                history_binding,
+                state: CheckpointState::Suspended,
+                continuation: Some(saved),
+            };
+            store.commit(expected, &record).map_err(io)?;
+            Ok(descriptor(&record))
+        })
+        .await
+    }
+
+    pub(crate) async fn read(
+        self: &Arc<Self>,
+        session: &Session,
+    ) -> Result<Option<Checkpoint<SavedTurn>>> {
+        self.with_store(session, |store| store.read(RUNTIME).map_err(io))
+            .await
+    }
+
+    pub(crate) async fn settle(
+        self: &Arc<Self>,
+        session: &Session,
+        state: CheckpointState,
+    ) -> Result<()> {
+        self.with_store(session, move |store| {
+            if let Some(mut record) = store.read(RUNTIME).map_err(io)? {
+                if record.state == CheckpointState::Suspended {
+                    let revision = record.revision;
+                    record.revision = revision
+                        .checked_add(1)
+                        .ok_or_else(|| invalid("checkpoint revision exhausted"))?;
+                    record.state = state;
+                    record.continuation = None;
+                    store.commit(Some(revision), &record).map_err(io)?;
+                }
+            }
+            Ok(())
+        })
+        .await?;
+        self.frozen.store(false, Ordering::Release);
+        self.requested.store(false, Ordering::Release);
+        Ok(())
+    }
+}
+
+pub(crate) fn validate_unfinished(items: &[RolloutItem], turn_id: &str) -> Result<()> {
+    let start = items
+        .iter()
+        .rposition(|item| matches!(item, RolloutItem::EventMsg(EventMsg::TurnStarted(_))))
+        .ok_or_else(|| invalid("the suspended turn's native start is missing"))?;
+    if !matches!(&items[start], RolloutItem::EventMsg(EventMsg::TurnStarted(event)) if event.turn_id == turn_id)
+    {
+        return Err(invalid(
+            "the suspension was superseded by another native turn",
+        ));
+    }
+    if items[start..].iter().any(|item| match item {
+        RolloutItem::EventMsg(EventMsg::TurnComplete(event)) => event.turn_id == turn_id,
+        RolloutItem::EventMsg(EventMsg::TurnAborted(event)) => {
+            event.turn_id.as_deref().is_none_or(|id| id == turn_id)
+        }
+        _ => false,
+    }) {
+        return Err(invalid("the suspended native turn has already ended"));
+    }
+    Ok(())
+}
+
+pub(crate) async fn validate_saved(
+    session: &Session,
+    record: &Checkpoint<SavedTurn>,
+) -> Result<()> {
+    if record.state != CheckpointState::Suspended {
+        return Err(invalid("this checkpoint is no longer suspended"));
+    }
+    let saved = record
+        .continuation
+        .as_ref()
+        .ok_or_else(|| invalid("suspension continuation is missing"))?;
+    if saved.context.turn_id.as_deref() != Some(record.identity.turn_id.as_str()) {
+        return Err(invalid(
+            "suspended context does not identify the checkpoint's native turn",
+        ));
+    }
+    if saved.environments != environments(session).await {
+        return Err(invalid(
+            "the selected execution environment differs from the suspended turn",
+        ));
+    }
+    let live = session
+        .live_thread_for_persistence("restore suspended native turn")
+        .map_err(io)?;
+    live.flush().await.map_err(io)?;
+    let history = live.load_continuation_history().await.map_err(io)?;
+    validate_unfinished(&history, &record.identity.turn_id)?;
+    let prefix = history
+        .get(..saved.history_items)
+        .ok_or_else(|| invalid("native history is shorter than its suspension boundary"))?;
+    if history_digest(prefix)? != record.history_binding {
+        return Err(invalid(
+            "native history changed before its suspension boundary",
+        ));
+    }
+    Ok(())
+}
+
+impl SavedTurn {
+    pub(crate) fn restore_pending(&self) -> TurnInputQueue {
+        TurnInputQueue {
+            items: self
+                .pending
+                .clone()
+                .into_iter()
+                .map(TurnInput::from)
+                .collect(),
+            has_pending_injection: self.pending_injection,
+        }
+    }
+}
+
+pub(crate) struct RestoredContinuation {
+    saved: SavedTurn,
+    resumed: AtomicBool,
+    epoch: u64,
+    owner: Arc<DurableSuspension>,
+    ready: tokio::sync::watch::Sender<Option<std::result::Result<(), String>>>,
+    preparation_error: Mutex<Option<String>>,
+}
+
+pub(crate) struct RestoreAttemptGuard(Arc<RestoredContinuation>);
+
+impl Drop for RestoreAttemptGuard {
+    fn drop(&mut self) {
+        if !self.0.resumed.load(Ordering::Acquire) && self.0.ready.borrow().is_none() {
+            self.0.ready.send_replace(Some(Err(
+                "native restoration stopped before execution resumed".into(),
+            )));
+        }
+    }
+}
+
+impl RestoredContinuation {
+    fn new(saved: SavedTurn, owner: Arc<DurableSuspension>, epoch: u64) -> Self {
+        Self {
+            saved,
+            epoch,
+            owner,
+            resumed: AtomicBool::new(false),
+            ready: tokio::sync::watch::channel(None).0,
+            preparation_error: Mutex::new(None),
+        }
+    }
+    pub(super) fn applies_to(&self, turn_id: &str) -> bool {
+        self.saved.context.turn_id.as_deref() == Some(turn_id)
+    }
+
+    /// Rebuild plugin selection from the original data under fresh runtime policy.
+    pub(super) fn prepare_configuration(
+        &self,
+        configuration: &mut super::session::SessionConfiguration,
+    ) {
+        if let Some(disabled) = &self.saved.context.disabled_plugin_ids {
+            configuration.disabled_plugin_ids = disabled.clone();
+        }
+        let config = Arc::make_mut(&mut configuration.original_config_do_not_use);
+        config.token_budget = self.saved.configured_token_budget.clone();
+    }
+
+    pub(super) fn restore_initial_settings(
+        &self,
+        fresh: &super::step_settings::ResolvedStepSettings,
+    ) -> super::step_settings::ResolvedStepSettings {
+        match fresh.restore_suspension(&self.saved.initial_step_settings) {
+            Ok(settings) => settings,
+            Err(error) => {
+                if let Ok(mut preparation_error) = self.preparation_error.lock() {
+                    *preparation_error = Some(error.to_string());
+                }
+                fresh.clone()
+            }
+        }
+    }
+
+    pub(super) fn restore_context_preferences(&self, context: &mut TurnContext) {
+        context.configured_token_budget = self.saved.configured_token_budget.clone();
+        context.use_model_token_budget_defaults = self.saved.use_model_token_budget_defaults;
+        Arc::make_mut(&mut context.config).token_budget = super::token_budget::resolve_token_budget(
+            context.configured_token_budget.as_ref(),
+            context.use_model_token_budget_defaults,
+            context.initial_settings.model_info.as_ref(),
+        );
+    }
+
+    pub(crate) fn guard(self: &Arc<Self>) -> RestoreAttemptGuard {
+        RestoreAttemptGuard(Arc::clone(self))
+    }
+    pub(crate) fn is_current(&self) -> bool {
+        self.owner.epoch.load(Ordering::Acquire) == self.epoch
+    }
+
+    pub(crate) fn reject_superseded(&self) {
+        self.ready.send_replace(Some(Err(
+            "suspension resumption was superseded by another control".into(),
+        )));
+    }
+
+    pub(crate) fn did_resume(&self) -> bool {
+        self.resumed.load(Ordering::Acquire)
+    }
+}
+
+/// Release a failed fresh reservation without ending the original suspended turn.
+pub(crate) async fn preserve_failed_restoration(
+    session: &Session,
+    context: &TurnContext,
+    error: &CodexErr,
+) -> bool {
+    let Some(restored) = context.extension_data.get::<RestoredContinuation>() else {
+        return false;
+    };
+    if restored.did_resume() {
+        return false;
+    }
+    let mut active = session.active_turn.lock().await;
+    if active
+        .as_ref()
+        .and_then(|turn| turn.task.as_ref())
+        .is_none_or(|task| task.turn_context.sub_id != context.sub_id)
+    {
+        return false;
+    }
+    if let Some(mut turn) = active.take() {
+        if let Some(task) = turn.task.take() {
+            task.handle.detach();
+        }
+    }
+    session
+        .agent_status
+        .send_replace(super::AgentStatus::Interrupted);
+    restored.ready.send_replace(Some(Err(error.to_string())));
+    true
+}
+
+impl crate::CodexThread {
+    /// Opt in before requesting pause; the boundary acknowledgement alone remains
+    /// the legacy live gate. The descriptor is returned only after store commit.
+    pub async fn pause_turn_durably(&self, turn_id: &str) -> Result<NativeSuspension> {
+        {
+            let active = self.session.active_turn.lock().await;
+            if active
+                .as_ref()
+                .and_then(|active| active.task.as_ref())
+                .is_none_or(|task| task.turn_context.sub_id != turn_id)
+            {
+                return Err(invalid(
+                    "durable pause does not identify the active native turn",
+                ));
+            }
+        }
+        let owner = coordinator(&self.session);
+        if owner.frozen.load(Ordering::Acquire)
+            && let Ok(suspension) = owner.boundary()
+        {
+            return Ok(suspension);
+        }
+        self.session.set_turn_pause_boundary_reached(false);
+        owner.request();
+        self.submit(codex_protocol::protocol::Op::SetTurnPaused { paused: true })
+            .await?;
+        self.wait_until_turn_pause_boundary().await?;
+        let suspension = owner.boundary()?;
+        let committed = owner
+            .read(&self.session)
+            .await?
+            .ok_or_else(|| invalid("the committed suspension is missing"))?;
+        validate_saved(&self.session, &committed).await?;
+        if suspension.turn_id != turn_id {
+            return Err(invalid("durable pause belongs to a replaced native turn"));
+        }
+        Ok(suspension)
+    }
+
+    /// Reads and validates an actual committed checkpoint. Acquires ownership,
+    /// starts no model execution and leaves suspended input untouched.
+    pub async fn read_durable_suspension(&self) -> Result<Option<NativeSuspension>> {
+        let owner = coordinator(&self.session);
+        let Some(record) = owner.read(&self.session).await? else {
+            return Ok(None);
+        };
+        if record.state != CheckpointState::Suspended {
+            return Ok(None);
+        }
+        validate_saved(&self.session, &record).await?;
+        owner.frozen.store(true, Ordering::Release);
+        Ok(Some(descriptor(&record)))
+    }
+
+    /// Stop a cold suspension using actual native lifecycle evidence, including
+    /// when an older/corrupt checkpoint cannot be decoded by this runtime.
+    pub async fn discard_durable_suspension(&self, turn_id: &str) -> Result<()> {
+        let owner = coordinator(&self.session);
+        let active_guard = self.session.active_turn.lock().await;
+        let active = active_guard
+            .as_ref()
+            .and_then(|turn| turn.task.as_ref())
+            .map(|task| task.turn_context.sub_id.clone());
+        if let Some(active) = active {
+            if active != turn_id {
+                return Err(invalid("another native turn owns this thread"));
+            }
+            owner.release_live_gate();
+            drop(active_guard);
+            self.submit(codex_protocol::protocol::Op::Interrupt).await?;
+        } else {
+            let live = self
+                .session
+                .live_thread_for_persistence("cancel suspended turn")
+                .map_err(io)?;
+            live.flush().await.map_err(io)?;
+            let history = live.load_continuation_history().await.map_err(io)?;
+            validate_unfinished(&history, turn_id)?;
+            // Fence a deferred Resume immediately, but retain the pause gate if
+            // persisting Stop fails. Only committed terminal history releases it.
+            owner.epoch.fetch_add(1, Ordering::AcqRel);
+            let event = EventMsg::TurnAborted(codex_protocol::protocol::TurnAbortedEvent {
+                root_turn_id: None,
+                turn_id: Some(turn_id.into()),
+                reason: codex_protocol::protocol::TurnAbortReason::Interrupted,
+                error: None,
+                started_at: None,
+                completed_at: None,
+                duration_ms: None,
+            });
+            live.append_items(&[RolloutItem::EventMsg(event.clone())])
+                .await
+                .map_err(io)?;
+            live.flush().await.map_err(io)?;
+            owner.release_live_gate();
+            drop(active_guard);
+            self.session
+                .deliver_event_raw(codex_protocol::protocol::Event {
+                    id: turn_id.into(),
+                    msg: event,
+                })
+                .await;
+        }
+        // Native terminal history is the cancellation authority. Retain an
+        // undecodable checkpoint for inspection instead of deleting its bytes.
+        if let Err(error) = owner
+            .settle(&self.session, CheckpointState::Invalidated)
+            .await
+        {
+            tracing::warn!(%error, "cancelled turn retained its unreadable suspension checkpoint");
+        }
+        Ok(())
+    }
+
+    pub fn has_live_durable_suspension(&self) -> bool {
+        coordinator(&self.session).has_live_suspension()
+    }
+
+    /// The shared live loop consumes its checkpoint only after fresh capacity
+    /// returns. Persistence failures keep the actual task paused and retryable.
+    pub async fn resume_live_suspended_turn(&self, turn_id: &str) -> Result<()> {
+        let active = self.session.active_turn.lock().await;
+        if active
+            .as_ref()
+            .and_then(|turn| turn.task.as_ref())
+            .is_none_or(|task| task.turn_context.sub_id != turn_id)
+        {
+            return Err(invalid(
+                "the live suspension belongs to a replaced native turn",
+            ));
+        }
+        let owner = coordinator(&self.session);
+        let resume = owner.begin_live_resume()?;
+        drop(active);
+        self.submit(codex_protocol::protocol::Op::SetTurnPaused { paused: false })
+            .await?;
+        resume.wait().await
+    }
+
+    pub fn durable_suspension_epoch(&self) -> u64 {
+        coordinator(&self.session).epoch.load(Ordering::Acquire)
+    }
+
+    /// Explicitly resumes the original native turn under fresh runtime authority.
+    /// Restored input is supplied through turn state, never as a new user prompt.
+    pub async fn resume_durable_suspension(
+        &self,
+        expected: &NativeSuspension,
+    ) -> Result<codex_protocol::turn_input::StartIfIdleSubmission> {
+        self.resume_durable_suspension_at_epoch(expected, self.durable_suspension_epoch())
+            .await
+    }
+
+    pub async fn resume_durable_suspension_at_epoch(
+        &self,
+        expected: &NativeSuspension,
+        resume_epoch: u64,
+    ) -> Result<codex_protocol::turn_input::StartIfIdleSubmission> {
+        let owner = coordinator(&self.session);
+        if owner.epoch.load(Ordering::Acquire) != resume_epoch {
+            return Err(invalid("suspension resumption was superseded"));
+        }
+        let record = owner
+            .read(&self.session)
+            .await?
+            .ok_or_else(|| invalid("native suspension checkpoint is missing"))?;
+        if &descriptor(&record) != expected {
+            return Err(invalid("the suspension identity or revision changed"));
+        }
+        validate_saved(&self.session, &record).await?;
+        let live_root = {
+            let active = self.session.active_turn.lock().await;
+            active
+                .as_ref()
+                .and_then(|active| active.task.as_ref())
+                .map(|task| {
+                    (
+                        task.turn_context.sub_id.clone(),
+                        task.turn_context.root_turn_id(),
+                        task.turn_context
+                            .extension_data
+                            .get::<RestoredContinuation>(),
+                    )
+                })
+        };
+        if let Some((turn_id, root_turn_id, restored)) = live_root {
+            if turn_id != expected.turn_id {
+                return Err(invalid("another native turn owns this thread"));
+            }
+            if let Some(restored) = restored {
+                if !restored.did_resume() {
+                    let mut ready = restored.ready.subscribe();
+                    loop {
+                        if let Some(result) = ready.borrow().clone() {
+                            result.map_err(invalid)?;
+                            break;
+                        }
+                        ready.changed().await.map_err(io)?;
+                    }
+                    return Ok(codex_protocol::turn_input::StartIfIdleSubmission::Started {
+                        turn_id,
+                        root_turn_id,
+                    });
+                }
+            }
+            if !*self.session.subscribe_turn_pause_state().borrow() {
+                return Err(invalid("the native turn is already running"));
+            }
+            self.resume_live_suspended_turn(&turn_id).await?;
+            return Ok(codex_protocol::turn_input::StartIfIdleSubmission::Started {
+                turn_id,
+                root_turn_id,
+            });
+        }
+        let saved = record
+            .continuation
+            .ok_or_else(|| invalid("native continuation is missing"))?;
+        let current = self.thread_settings_snapshot().await;
+        if saved.settings.model_provider_id != current.model_provider_id
+            || saved.settings.permission_profile != current.permission_profile
+            || saved.settings.cwd != current.cwd
+        {
+            return Err(invalid(
+                "restored runtime provider, permissions or working directory differ from the suspended turn",
+            ));
+        }
+        if owner.epoch.load(Ordering::Acquire) != resume_epoch {
+            return Err(invalid("suspension resumption was superseded"));
+        }
+        // Retain the freshly attached host bindings. Restoration adds only a
+        // one-turn continuation marker; it never replaces host execution data.
+        let mut init = self
+            .session
+            .state
+            .lock()
+            .await
+            .session_configuration
+            .turn_extension_init
+            .clone();
+        init.insert(RestoredContinuation::new(
+            saved.clone(),
+            Arc::clone(&owner),
+            resume_epoch,
+        ));
+        let mut ready = init
+            .get::<RestoredContinuation>()
+            .ok_or_else(|| invalid("restoration state is missing"))?
+            .ready
+            .subscribe();
+        self.ensure_execution_capacity_for_turn_start(self.session.services.agent_control.as_ref())
+            .await?;
+        owner.frozen.store(true, Ordering::Release);
+        let submitted = self
+            .io
+            .submit_recover_turn(
+                codex_protocol::protocol::ThreadSettingsOverrides::default(),
+                saved.start_options.clone(),
+                None,
+                expected.turn_id.clone(),
+                Some(init),
+            )
+            .await?;
+        match submitted {
+            codex_protocol::turn_input::TurnInputSubmission::Started {
+                turn_id,
+                root_turn_id,
+            } => {
+                loop {
+                    if let Some(result) = ready.borrow().clone() {
+                        result.map_err(invalid)?;
+                        break;
+                    }
+                    ready.changed().await.map_err(io)?;
+                }
+                Ok(codex_protocol::turn_input::StartIfIdleSubmission::Started {
+                    turn_id,
+                    root_turn_id,
+                })
+            }
+            codex_protocol::turn_input::TurnInputSubmission::NotSubmitted { reason } => {
+                Ok(codex_protocol::turn_input::StartIfIdleSubmission::NotSubmitted { reason })
+            }
+            codex_protocol::turn_input::TurnInputSubmission::Steered { .. } => {
+                unreachable!("recovered turn cannot steer")
+            }
+        }
+    }
+}
+
+pub(crate) async fn run_restored_turn(
+    session: Arc<Session>,
+    context: Arc<TurnContext>,
+    restored: Arc<RestoredContinuation>,
+    cancellation_token: tokio_util::sync::CancellationToken,
+) -> Result<Option<String>> {
+    let saved = &restored.saved;
+    if let Some(error) = restored.preparation_error.lock().map_err(io)?.as_ref() {
+        return Err(invalid(format!(
+            "suspended initial settings cannot be restored: {error}"
+        )));
+    }
+    if let Some(budget) = &saved.configured_token_budget {
+        budget.validate().map_err(io)?;
+    }
+    if context.permission_profile() != saved.context.permission_profile()
+        || context.multi_agent_version
+            != saved
+                .context
+                .multi_agent_version
+                .unwrap_or(context.multi_agent_version)
+    {
+        return Err(invalid(
+            "restored turn permissions or native collaboration mode differ from the suspension",
+        ));
+    }
+    session
+        .validate_restored_step_settings(context.as_ref(), context.initial_settings.as_ref())
+        .await
+        .map_err(io)?;
+    let _inference_lifetime = if let Some(gate) = session.managed_inference_gate().await {
+        let lifetime = crate::managed_inference::ManagedInferenceTurn::begin(
+            gate,
+            session.thread_id,
+            context.sub_id.clone(),
+            cancellation_token.clone(),
+        )
+        .await?;
+        context.extension_data.insert_arc(Arc::clone(&lifetime.0));
+        Some(lifetime)
+    } else {
+        None
+    };
+    session
+        .state
+        .lock()
+        .await
+        .restore_suspension(&saved.session_state);
+    let turn_state = {
+        let active = session.active_turn.lock().await;
+        let active = active
+            .as_ref()
+            .ok_or_else(|| invalid("restored native execution lost its reservation"))?;
+        Arc::clone(&active.turn_state)
+    };
+    {
+        let mut turn = turn_state.lock().await;
+        turn.pending_input = saved.restore_pending();
+        turn.tool_calls = saved.tool_calls;
+        turn.has_memory_citation = saved.has_memory_citation;
+        turn.token_usage_at_turn_start = saved.token_usage_at_turn_start.clone();
+        turn.token_usage_by_model
+            .restore_suspension(&saved.token_usage_by_model, &context.session_telemetry);
+    }
+    context
+        .turn_timing_state
+        .restore_suspension(&saved.timing)
+        .await
+        .map_err(io)?;
+    let next_settings = context
+        .next_step_settings
+        .load()
+        .restore_suspension(&saved.next_step_settings)
+        .map_err(|error| {
+            invalid(format!(
+                "suspended step settings cannot be restored: {error}"
+            ))
+        })?;
+    let pending_settings = saved
+        .pending_step_settings
+        .as_ref()
+        .map(|pending| next_settings.restore_suspension(pending))
+        .transpose()
+        .map_err(io)?;
+    session
+        .validate_restored_step_settings(context.as_ref(), &next_settings)
+        .await
+        .map_err(io)?;
+    if let Some(pending) = &pending_settings {
+        session
+            .validate_restored_step_settings(context.as_ref(), pending)
+            .await
+            .map_err(io)?;
+    }
+    context.next_step_settings.store(Arc::new(
+        pending_settings.unwrap_or_else(|| next_settings.clone()),
+    ));
+    if let Some(started_at) = context.turn_timing_state.started_at_unix_secs().await {
+        context
+            .turn_metadata_state
+            .set_turn_started_at_unix_ms(started_at.saturating_mul(1000));
+    }
+    let mut mcp = saved.mcp.clone();
+    let step = session
+        .capture_step_context_with_required_mcp_servers(
+            Arc::clone(&context),
+            &cancellation_token,
+            &mcp.required_servers,
+            &mcp.required_plugins,
+        )
+        .await;
+    context.next_step_settings.store(Arc::new(next_settings));
+    let step = step?;
+    let world_state = session
+        .record_step_world_state_if_changed(step.as_ref())
+        .await?;
+    let client = session.services.model_client.new_session();
+    let diff = Arc::new(tokio::sync::Mutex::new(
+        crate::turn_diff_tracker::TurnDiffTracker::from_snapshot(saved.diff.clone()),
+    ));
+    session
+        .agent_status
+        .send_replace(super::AgentStatus::Running);
+    let owner = coordinator(&session);
+    // This is execution admission, after the user's explicit Resume. Consuming
+    // the checkpoint must succeed before any new model request or tool work.
+    if !restored.is_current() || cancellation_token.is_cancelled() {
+        return Err(invalid(
+            "native restoration was superseded before execution admission",
+        ));
+    }
+    owner.settle(&session, CheckpointState::Consumed).await?;
+    restored.resumed.store(true, Ordering::Release);
+    restored.ready.send_replace(Some(Ok(())));
+    super::turn::run_turn_loop(
+        session,
+        context,
+        &mut mcp,
+        client,
+        cancellation_token,
+        Some(step),
+        world_state,
+        diff,
+        saved.loop_state.clone(),
+    )
+    .await
+}
