--- a/codex-rs/core/src/turn_timing.rs
+++ b/codex-rs/core/src/turn_timing.rs
@@ -549,3 +549,101 @@ mod report;
 #[cfg(test)]
 #[path = "turn_timing_tests.rs"]
 mod tests;
+
+#[derive(Clone, serde::Serialize, serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct SuspendedTurnTiming {
+    started_at_unix_secs: Option<i64>,
+    elapsed: Duration,
+    first_token: Option<Duration>,
+    first_message: Option<Duration>,
+    item_started_at_ms: HashMap<String, i64>,
+    capture_enabled: bool,
+    seen_sampling: bool,
+    before_first_sampling: Duration,
+    sampling: Duration,
+    compaction: Duration,
+    between_sampling_overhead: Duration,
+    tool_blocking: Duration,
+    pending_idle_after_sampling: Duration,
+    sampling_request_count: u32,
+    sampling_retry_count: u32,
+    tools_change_count: u32,
+}
+
+impl TurnTimingState {
+    pub(crate) async fn suspension_snapshot(&self) -> SuspendedTurnTiming {
+        let state = self.state.lock().await;
+        let now = Instant::now();
+        let mut profile = self.profile_state();
+        profile.advance(now);
+        SuspendedTurnTiming {
+            started_at_unix_secs: state.started_at_unix_secs,
+            elapsed: state
+                .started_at
+                .map(|start| now.saturating_duration_since(start))
+                .unwrap_or_default(),
+            first_token: state
+                .first_token_at
+                .zip(state.started_at)
+                .map(|(at, start)| at.saturating_duration_since(start)),
+            first_message: state
+                .first_message_at
+                .zip(state.started_at)
+                .map(|(at, start)| at.saturating_duration_since(start)),
+            item_started_at_ms: state.item_started_at_ms.clone(),
+            capture_enabled: profile.capture_enabled,
+            seen_sampling: profile.seen_sampling,
+            before_first_sampling: profile.before_first_sampling,
+            sampling: profile.sampling,
+            compaction: profile.compaction,
+            between_sampling_overhead: profile.between_sampling_overhead,
+            tool_blocking: profile.tool_blocking,
+            pending_idle_after_sampling: profile.pending_idle_after_sampling,
+            sampling_request_count: profile.sampling_request_count,
+            sampling_retry_count: profile.sampling_retry_count,
+            tools_change_count: profile.tools_change_count,
+        }
+    }
+
+    pub(crate) async fn restore_suspension(
+        &self,
+        saved: &SuspendedTurnTiming,
+    ) -> std::io::Result<()> {
+        let now = Instant::now();
+        let start = now
+            .checked_sub(saved.elapsed)
+            .ok_or_else(|| std::io::Error::other("suspended turn timing is out of range"))?;
+        let mut state = self.state.lock().await;
+        state.started_at = Some(start);
+        state.started_at_unix_secs = saved.started_at_unix_secs;
+        state.completed_at = None;
+        state.first_token_at = saved
+            .first_token
+            .and_then(|elapsed| start.checked_add(elapsed));
+        state.first_message_at = saved
+            .first_message
+            .and_then(|elapsed| start.checked_add(elapsed));
+        state.item_started_at_ms = saved.item_started_at_ms.clone();
+        let mut profile = self.profile_state();
+        // A process-local critical path cannot be reused in the new runtime.
+        // Preserve measured counters while leaving that unavailable path explicit.
+        *profile = TurnProfileState {
+            capture_enabled: saved.capture_enabled,
+            seen_sampling: saved.seen_sampling,
+            started_at: Some(start),
+            last_transition_at: Some(now),
+            before_first_sampling: saved.before_first_sampling,
+            sampling: saved.sampling,
+            compaction: saved.compaction,
+            between_sampling_overhead: saved.between_sampling_overhead,
+            tool_blocking: saved.tool_blocking,
+            pending_idle_after_sampling: saved.pending_idle_after_sampling,
+            sampling_request_count: saved.sampling_request_count,
+            sampling_retry_count: saved.sampling_retry_count,
+            tools_change_count: saved.tools_change_count,
+            ..Default::default()
+        };
+        Ok(())
+    }
+}
