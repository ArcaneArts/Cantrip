+    let mut restored = TurnDiffTracker::from_snapshot(saved);
+    assert_eq!(restored.get_unified_diff(), expected_before);
+    let update = apply_verified_patch(
+        dir.path(),
+        "*** Begin Patch\n*** Update File: a.txt\n@@\n original\n+after-resume\n*** End Patch",
+    )
+    .await;
+    tracker.track_delta("", &update);
+    restored.track_delta("", &update);
+    assert_eq!(restored.get_unified_diff(), tracker.get_unified_diff());
+    let rendered = restored.get_unified_diff().expect("cumulative diff");
+    assert!(rendered.contains("new file mode"));
+    assert!(rendered.contains("+original"));
+    assert!(rendered.contains("+after-resume"));
+}
