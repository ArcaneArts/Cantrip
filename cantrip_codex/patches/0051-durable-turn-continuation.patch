+    pub(crate) fn seed_suspended_turn(&mut self, items: &[codex_rollout::RolloutItem]) -> bool {
+        if self.active_turn_id().is_some() {
+            return false;
+        }
+        let mut history = ThreadHistoryBuilder::new();
+        for item in items {
+            history.handle_rollout_item(item);
+        }
+        self.turn_summary = TurnSummary {
+            started_at: history
+                .active_turn_snapshot()
+                .and_then(|turn| turn.started_at),
+            ..Default::default()
+        };
+        self.current_turn_history = history;
+        true
+    }
+
+    pub(crate) fn clear_failed_suspension_restore(&mut self, turn_id: &str) -> bool {
+        if self.active_turn_id() == Some(turn_id) {
+            self.current_turn_history.reset();
+            self.turn_summary = TurnSummary::default();
+            return true;
+        }
+        false
+    }
+
     pub(crate) fn active_turn_snapshot(&self) -> Option<Turn> {
         self.current_turn_history.active_turn_snapshot()
     }
