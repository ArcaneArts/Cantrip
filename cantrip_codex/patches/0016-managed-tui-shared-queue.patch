+            self.refresh_managed_queue(true);
+            return;
+        };
+        let tx = self.app_event_tx.clone();
+        let revision = self
+            .input_queue
+            .managed
+            .revision
+            .map(|revision| revision.to_string());
+        let initial = item.text();
+        let view = CustomPromptView::new(
+            "Edit shared queued text".into(),
+            "Save with Enter; attachments stay attached".into(),
+            initial,
+            None,
+            Box::new(move |text| {
+                let mut input = item
+                    .input
+                    .iter()
+                    .filter(|input| !matches!(input, UserInput::Text { .. }))
+                    .cloned()
+                    .collect::<Vec<_>>();
+                input.insert(
+                    0,
+                    UserInput::Text {
+                        text: text.clone(),
+                        text_elements: vec![],
+                    },
+                );
+                let operation_id = uuid::Uuid::new_v4();
+                tx.send(AppEvent::ManagedQueueRequest(Request{thread_id,operation_id,method:"thread/queue/update",params:json!({"threadId":thread_id.to_string(),"queuedSubmissionId":id,"input":input,"expectedRevision":revision,"managed":{"operationId":operation_id.to_string(),"action":item.managed.action.as_deref().unwrap_or("plain")}}),draft:Some(UserMessage::from(text))}));
+            }),
+        );
+        self.bottom_pane.show_text_prompt(view);
+    }
+}
