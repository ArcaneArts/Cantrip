diff --git a/codex-rs/tui/src/managed_queue.rs b/codex-rs/tui/src/managed_queue.rs
new file mode 100644
index 0000000..e9683fa
--- /dev/null
+++ b/codex-rs/tui/src/managed_queue.rs
@@ -0,0 +1,215 @@
+//! Negotiated managed queue wire data. This is a view of the canonical queue,
+//! not a local execution queue or a replacement for native RPC acknowledgments.
+use codex_app_server_protocol::UserInput;
+use codex_protocol::ThreadId;
+use serde::Deserialize;
+use serde::Serialize;
+use serde_json::Value;
+use std::collections::BTreeMap;
+use uuid::Uuid;
+
+#[derive(Clone, Debug, Default, PartialEq, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct ItemMetadata {
+    pub frozen: bool,
+    #[serde(default)]
+    pub mode: Option<String>,
+    #[serde(default)]
+    pub model_label: Option<String>,
+    #[serde(default)]
+    pub worktree_label: Option<String>,
+    #[serde(default)]
+    pub action: Option<String>,
+}
+#[derive(Clone, Debug, PartialEq, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct Item {
+    pub id: String,
+    pub input: Vec<UserInput>,
+    pub client_user_message_id: String,
+    pub managed: ItemMetadata,
+}
+impl Item {
+    pub(crate) fn text(&self) -> String {
+        self.input
+            .iter()
+            .filter_map(|input| match input {
+                UserInput::Text { text, .. } => Some(text.as_str()),
+                _ => None,
+            })
+            .collect::<Vec<_>>()
+            .join("\n")
+    }
+    pub(crate) fn label(&self) -> String {
+        let prefix = if self.managed.frozen { "[Frozen] " } else { "" };
+        let text = self.text();
+        format!(
+            "{prefix}{}",
+            if text.is_empty() {
+                "[Attachment]"
+            } else {
+                text.as_str()
+            }
+        )
+    }
+}
+#[derive(Clone, Debug, PartialEq, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct Snapshot {
+    pub data: Vec<Item>,
+    pub next_cursor: Option<String>,
+    pub managed_queue: SnapshotMetadata,
+}
+#[derive(Clone, Debug, PartialEq, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct PendingImport {
+    pub id: String,
+    pub native_item_id: String,
+    pub status: ImportStatus,
+    pub input: Vec<UserInput>,
+}
+#[derive(Clone, Debug, PartialEq, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) enum ImportStatus {
+    Pending,
+    Conflict,
+    Uncertain,
+}
+impl PendingImport {
+    pub(crate) fn label(&self) -> String {
+        let status = match self.status {
+            ImportStatus::Pending => "pending",
+            ImportStatus::Conflict => "conflict",
+            ImportStatus::Uncertain => "uncertain",
+        };
+        let text = self
+            .input
+            .iter()
+            .filter_map(|input| match input {
+                UserInput::Text { text, .. } => Some(text.as_str()),
+                _ => None,
+            })
+            .collect::<Vec<_>>()
+            .join("\n");
+        format!(
+            "[Transfer {status}] {}",
+            if text.is_empty() {
+                "[Attachment]"
+            } else {
+                &text
+            }
+        )
+    }
+}
+#[derive(Clone, Debug, PartialEq, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct SnapshotMetadata {
+    pub revision: String,
+    pub paused: bool,
+    #[serde(default)]
+    pub pending_imports: Vec<PendingImport>,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) enum InputAction {
+    Plain,
+    Literal,
+    ParseSlash,
+    RunShell,
+}
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) struct Request {
+    pub thread_id: ThreadId,
+    pub operation_id: Uuid,
+    pub method: &'static str,
+    pub params: Value,
+    pub draft: Option<crate::chatwidget::UserMessage>,
+}
+#[derive(Clone, Debug, Default, PartialEq)]
+pub(crate) struct State {
+    pub thread_id: Option<ThreadId>,
+    pub items: Vec<Item>,
+    pub pending_imports: Vec<PendingImport>,
+    pub revision: Option<u64>,
+    pub paused: bool,
+    pub refresh_in_flight: bool,
+    pub refresh_dirty: bool,
+    pub show_on_refresh: bool,
+    pub pending: BTreeMap<Uuid, Request>,
+    pub preparing_input: Option<InputAction>,
+}
+impl State {
+    pub(crate) fn enabled(&self) -> bool {
+        self.thread_id.is_some()
+    }
+    pub(crate) fn apply(&mut self, snapshot: Snapshot) -> Result<(), String> {
+        if snapshot.next_cursor.is_some() {
+            return Err("Managed queue snapshot was incomplete".into());
+        }
+        let revision = snapshot
+            .managed_queue
+            .revision
+            .parse::<u64>()
+            .map_err(|_| "Invalid managed queue revision")?;
+        if self.revision.is_none_or(|previous| revision >= previous) {
+            let mut ids = std::collections::HashSet::new();
+            if snapshot.data.iter().any(|item| {
+                item.id.is_empty()
+                    || item.client_user_message_id.is_empty()
+                    || !ids.insert(&item.id)
+            }) {
+                return Err("Invalid managed queue item identity".into());
+            }
+            let mut import_ids = std::collections::HashSet::new();
+            if snapshot.managed_queue.pending_imports.iter().any(|item| {
+                item.id.is_empty() || item.native_item_id.is_empty() || !import_ids.insert(&item.id)
+            }) {
+                return Err("Invalid managed queue transfer identity".into());
+            }
+            self.pending_imports = snapshot.managed_queue.pending_imports;
+            self.revision = Some(revision);
+            self.items = snapshot.data;
+            self.paused = snapshot.managed_queue.paused;
+        }
+        Ok(())
+    }
+}
+
+/// A transport failure or these acknowledged uncertainty codes retain the exact
+/// original mutation. Revision conflicts are definite rejections, even at HTTP 409.
+pub(crate) fn is_uncertain_error(data: Option<&Value>) -> bool {
+    data.and_then(|value| value.get("code"))
+        .and_then(Value::as_str)
+        .is_some_and(|code| {
+            matches!(
+                code,
+                "queue-operation-uncertain" | "queue-receipt-pending" | "queue-dispatch-uncertain"
+            )
+        })
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn managed_queue_uncertainty_uses_exact_codes() {
+        for code in [
+            "queue-operation-uncertain",
+            "queue-receipt-pending",
+            "queue-dispatch-uncertain",
+        ] {
+            assert!(is_uncertain_error(Some(
+                &serde_json::json!({"code":code,"status":409})
+            )));
+        }
+        for code in [
+            "queue-revision-conflict",
+            "queue-item-not-found",
+            "permission-denied",
+        ] {
+            assert!(!is_uncertain_error(Some(
+                &serde_json::json!({"code":code,"status":409})
+            )));
+        }
+        assert!(!is_uncertain_error(None));
+    }
+}
