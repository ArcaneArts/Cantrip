+    /// Commit deletion and its exact-source receipt together. BEGIN IMMEDIATE
+    /// also fences writers in other app-server processes, which do not share
+    /// the extension's in-memory dispatch guard. Receipts retain only a digest.
+    pub async fn compare_delete(
+        &self,
+        thread_id: ThreadId,
+        item_id: &str,
+        operation_id: &str,
+        expected_payload: &str,
+    ) -> anyhow::Result<(bool, bool)> {
+        use sha2::Digest;
+        let digest = format!(
+            "{:x}",
+            sha2::Sha256::digest(serde_json::to_vec(&(
+                thread_id.to_string(),
+                item_id,
+                expected_payload
+            ))?)
+        );
+        let mut tx = self.pool.begin_with("BEGIN IMMEDIATE").await?;
+        let existing: Option<(String,String)> = sqlx::query_as("SELECT request_sha256,outcome FROM managed_queue_delete_receipts WHERE operation_id = ?")
+            .bind(operation_id).fetch_optional(tx.as_mut()).await?;
+        if let Some((previous, outcome)) = existing {
+            if previous != digest {
+                anyhow::bail!("managed queue deletion operation belongs to different input");
+            }
+            tx.commit().await?;
+            return Ok((outcome == "deleted", outcome == "changed"));
+        }
+        let current: Option<String> = sqlx::query_scalar(
+            "SELECT payload_json FROM queued_items WHERE thread_id = ? AND id = ?",
+        )
+        .bind(thread_id.to_string())
+        .bind(item_id)
+        .fetch_optional(tx.as_mut())
+        .await?;
+        let outcome = match current {
+            None => "missing",
+            Some(current)
+                if serde_json::from_str::<serde_json::Value>(&current)?
+                    == serde_json::from_str::<serde_json::Value>(expected_payload)? =>
+            {
+                let deleted = sqlx::query(
+                    "DELETE FROM queued_items WHERE thread_id = ? AND id = ? AND payload_json = ?",
+                )
+                .bind(thread_id.to_string())
+                .bind(item_id)
+                .bind(&current)
+                .execute(tx.as_mut())
+                .await?;
+                if deleted.rows_affected() != 1 {
+                    anyhow::bail!("managed queue input changed during conditional deletion");
+                }
+                "deleted"
+            }
+            Some(_) => "changed",
+        };
+        sqlx::query("INSERT INTO managed_queue_delete_receipts(operation_id,request_sha256,outcome) VALUES (?,?,?)")
+            .bind(operation_id).bind(digest).bind(outcome).execute(tx.as_mut()).await?;
+        tx.commit().await?;
+        Ok((outcome == "deleted", outcome == "changed"))
+    }
