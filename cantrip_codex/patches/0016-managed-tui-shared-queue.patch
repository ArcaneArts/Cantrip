+use super::*;
+use serde_json::json;
+
+#[tokio::test]
+async fn managed_queue_idle_queue_key_and_literal_rate_limit_use_canonical_actions() {
+    let (mut chat, mut rx, mut op_rx) = make_chatwidget_manual(None).await;
+    let thread_id = ThreadId::new();
+    chat.thread_id = Some(thread_id);
+    chat.set_managed_queue_thread(Some(thread_id));
+    while rx.try_recv().is_ok() {}
+    chat.bottom_pane
+        .set_composer_text("idle queued draft".into(), vec![], vec![]);
+    chat.handle_key_event(KeyEvent::from(KeyCode::Tab));
+    let request = std::iter::from_fn(|| rx.try_recv().ok())
+        .find_map(|event| match event {
+            AppEvent::ManagedQueueRequest(request) => Some(request),
+            _ => None,
+        })
+        .expect("idle queue key must enqueue");
+    assert_eq!(request.method, "thread/queue/add");
+    assert_eq!(request.params["input"][0]["text"], "idle queued draft");
+    assert!(op_rx.try_recv().is_err());
+    chat.input_queue.rate_limit_recovery_pending = true;
+    chat.submit_user_message_with_shell_escape_policy(
+        UserMessage::from("!literal during recovery"),
+        ShellEscapePolicy::Disallow,
+    );
+    let request = std::iter::from_fn(|| rx.try_recv().ok())
+        .find_map(|event| match event {
+            AppEvent::ManagedQueueRequest(request) => Some(request),
+            _ => None,
+        })
+        .expect("rate-limit follow-up");
+    assert_eq!(request.params["managed"]["action"], "literal");
+    assert_eq!(
+        request.params["input"][0]["text"],
+        "!literal during recovery"
+    );
+    assert!(op_rx.try_recv().is_err());
+}
+
+#[tokio::test]
+async fn managed_queue_uses_exact_input_and_never_local_drain() {
+    let (mut chat, mut rx, mut op_rx) = make_chatwidget_manual(None).await;
+    let thread_id = ThreadId::new();
+    chat.thread_id = Some(thread_id);
+    chat.set_managed_queue_thread(Some(thread_id));
+    while rx.try_recv().is_ok() {}
+    for (action, text, expected) in [
+        (QueuedInputAction::Plain, "!echo actual", "runShell"),
+        (QueuedInputAction::Literal, "!literal", "literal"),
+        (
+            QueuedInputAction::ParseSlash,
+            "/plan exact prompt",
+            "parseSlash",
+        ),
+    ] {
+        chat.queue_user_message_with_options(UserMessage::from(text), action, Vec::new());
+        let request = std::iter::from_fn(|| rx.try_recv().ok())
+            .find_map(|event| match event {
+                AppEvent::ManagedQueueRequest(request) => Some(request),
+                _ => None,
+            })
+            .expect("queue operation");
+        assert_eq!(request.method, "thread/queue/add");
+        assert_eq!(request.params["managed"]["action"], json!(expected));
+        assert_eq!(request.params["input"][0]["text"], json!(text));
+        assert!(
+            op_rx.try_recv().is_err(),
+            "queueing cannot run shell or inference"
+        );
+        assert!(chat.input_queue.queued_user_messages.is_empty());
+        assert!(!chat.maybe_send_next_queued_input());
+        assert!(
+            chat.input_queue
+                .managed
+                .pending
+                .contains_key(&request.operation_id)
+        );
+        chat.managed_queue_result(request.clone(), Err("offline".into()), true);
+        assert!(
+            chat.input_queue
+                .managed
+                .pending
+                .contains_key(&request.operation_id)
+        );
+        chat.managed_queue_result(request.clone(), Err("revision changed".into()), false);
+        assert!(chat.bottom_pane.composer_text().contains(text));
+        assert!(
+            !chat
+                .input_queue
+                .managed
+                .pending
+                .contains_key(&request.operation_id)
+        );
+    }
+}
+
+#[tokio::test]
+async fn managed_queue_snapshot_revision_and_foreign_thread_are_fenced() {
+    let (mut chat, mut rx, _) = make_chatwidget_manual(None).await;
+    let thread_id = ThreadId::new();
+    chat.thread_id = Some(thread_id);
+    chat.set_managed_queue_thread(Some(thread_id));
+    let request = std::iter::from_fn(|| rx.try_recv().ok())
+        .find_map(|event| match event {
+            AppEvent::ManagedQueueRequest(request) => Some(request),
+            _ => None,
+        })
+        .unwrap();
+    let snapshot = |revision: &str, text: &str| json!({"data":[{"id":"stable","clientUserMessageId":"client","input":[{"type":"text","text":text}],"managed":{"frozen":true,"mode":"plan"}}],"nextCursor":null,"managedQueue":{"revision":revision,"paused":true}});
+    chat.managed_queue_result(request.clone(), Ok(snapshot("2", "new")), false);
+    chat.managed_queue_result(request.clone(), Ok(snapshot("1", "stale")), false);
+    assert_eq!(chat.input_queue.managed.items[0].text(), "new");
+    assert!(chat.input_queue.managed.items[0].managed.frozen);
+    let mut foreign = request.clone();
+    foreign.thread_id = ThreadId::new();
+    chat.managed_queue_result(foreign, Ok(snapshot("3", "foreign")), false);
+    assert_eq!(chat.input_queue.managed.items[0].text(), "new");
+    chat.queue_user_message(UserMessage::from("retain me"));
+    let saved = chat.capture_thread_input_state().expect("input state");
+    assert!(!saved.managed_queue.pending.is_empty());
+}
+
+#[tokio::test]
+async fn managed_queue_controls_keep_stable_ids_and_require_an_actual_start_receipt() {
+    let (mut chat, mut rx, mut op_rx) = make_chatwidget_manual(None).await;
+    let thread_id = ThreadId::new();
+    chat.thread_id = Some(thread_id);
+    chat.set_managed_queue_thread(Some(thread_id));
+    let snapshot = serde_json::from_value(json!({
+        "data": [
+            {"id":"first","clientUserMessageId":"one","input":[{"type":"text","text":"first"}],"managed":{"frozen":false,"mode":"default","action":"literal"}},
+            {"id":"second","clientUserMessageId":"two","input":[{"type":"text","text":"second"}],"managed":{"frozen":true,"mode":"plan","action":"plain"}}
+        ],"nextCursor":null,"managedQueue":{"revision":"17","paused":true}
+    })).unwrap();
+    chat.input_queue.managed.apply(snapshot).unwrap();
+    while rx.try_recv().is_ok() {}
+    chat.show_managed_queue_item("first".into());
+    for _ in 0..3 {
+        chat.handle_key_event(KeyEvent::from(KeyCode::Down));
+    }
+    chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    let reorder = std::iter::from_fn(|| rx.try_recv().ok())
+        .find_map(|event| match event {
+            AppEvent::ManagedQueueRequest(request) => Some(request),
+            _ => None,
+        })
+        .expect("reorder request");
+    assert_eq!(reorder.method, "thread/queue/reorder");
+    assert_eq!(
+        reorder.params["queuedSubmissionIds"],
+        json!(["second", "first"])
+    );
+    assert_eq!(reorder.params["expectedRevision"], json!("17"));
+    assert!(op_rx.try_recv().is_err());
+    let mut start = reorder.clone();
+    start.method = "thread/queue/start";
+    chat.retain_managed_queue_request(&start);
+    chat.managed_queue_result(start.clone(), Ok(json!({})), false);
+    assert!(
+        chat.input_queue
+            .managed
+            .pending
+            .contains_key(&start.operation_id)
+    );
+    chat.managed_queue_disconnected();
+    let saved = chat.capture_thread_input_state().unwrap();
+    assert_eq!(
+        saved.managed_queue.pending[&start.operation_id].params,
+        reorder.params
+    );
+    chat.managed_queue_result(start.clone(), Ok(json!({"managedAction":{
+        "operationId":start.operation_id.to_string(),"executionOperationId":"actual-operation", "method":"thread/shellCommand","status":"applied"
+    }})), false);
+    assert!(
+        !chat
+            .input_queue
+            .managed
+            .pending
+            .contains_key(&start.operation_id)
+    );
+    assert!(op_rx.try_recv().is_err());
+}
+
+#[tokio::test]
+async fn managed_queue_pending_imports_are_visible_but_never_executable() {
+    let (mut chat, mut rx, mut op_rx) = make_chatwidget_manual(None).await;
+    let thread_id = ThreadId::new();
+    chat.thread_id = Some(thread_id);
+    chat.set_managed_queue_thread(Some(thread_id));
+    let snapshot = serde_json::from_value(json!({"data":[],"nextCursor":null,"managedQueue":{"revision":"4","paused":false,"pendingImports":[{"id":"import","nativeItemId":"legacy","status":"conflict","input":[{"type":"text","text":"preserved original"}]}]}})).unwrap();
+    chat.input_queue.managed.apply(snapshot).unwrap();
+    assert!(chat.input_queue.managed.items.is_empty());
+    assert_eq!(
+        chat.input_queue.managed.pending_imports[0].label(),
+        "[Transfer conflict] preserved original"
+    );
+    while rx.try_recv().is_ok() {}
+    chat.show_managed_queue();
+    // The disabled transfer row cannot select a start/edit/delete action.
+    chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+    for event in std::iter::from_fn(|| rx.try_recv().ok()) {
+        if let AppEvent::ManagedQueueRequest(ref request) = event {
+            assert_eq!(request.method, "thread/queue/list");
+        }
+        assert!(!matches!(event, AppEvent::ManagedQueueItemMenu(_)));
+    }
+    assert!(op_rx.try_recv().is_err());
+    assert!(!chat.maybe_send_next_queued_input());
+}
