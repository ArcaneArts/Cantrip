+#[tokio::test]
+async fn managed_queue_compare_delete_preserves_external_edits_and_durable_receipts() {
+    let (runtime, thread_id) = runtime_with_thread().await;
+    let sqlite = runtime.sqlite().clone();
+    let other = StateRuntime::init(sqlite.clone(), "test-provider".into())
+        .await
+        .unwrap();
+    let original =
+        r#"{"UserInput":{"content":[{"type":"text","text":"original"}],"client_id":"client"}}"#;
+    let changed = r#"{"UserInput":{"content":[{"type":"text","text":"edited elsewhere"}],"client_id":"client"}}"#;
+    let item = runtime
+        .thread_queue()
+        .enqueue(thread_id, original)
+        .await
+        .unwrap();
+    other
+        .thread_queue()
+        .update(thread_id, &item.id, changed)
+        .await
+        .unwrap();
+    assert_eq!(
+        runtime
+            .thread_queue()
+            .compare_delete(thread_id, &item.id, "old-snapshot", original)
+            .await
+            .unwrap(),
+        (false, true)
+    );
+    assert_eq!(
+        runtime
+            .thread_queue()
+            .list_page(thread_id, 0, 1)
+            .await
+            .unwrap()[0]
+            .payload,
+        changed
+    );
+    assert_eq!(
+        runtime
+            .thread_queue()
+            .compare_delete(thread_id, &item.id, "exact-snapshot", changed)
+            .await
+            .unwrap(),
+        (true, false)
+    );
+    runtime.close().await;
+    other.close().await;
+    drop(runtime);
+    drop(other);
+    let reopened = StateRuntime::init(sqlite, "test-provider".into())
+        .await
+        .unwrap();
+    assert_eq!(
+        reopened
+            .thread_queue()
+            .compare_delete(thread_id, &item.id, "exact-snapshot", changed)
+            .await
+            .unwrap(),
+        (true, false),
+        "lost ACK must reconcile against durable exact deletion"
+    );
+    assert!(
+        reopened
+            .thread_queue()
+            .compare_delete(thread_id, &item.id, "exact-snapshot", original)
+            .await
+            .is_err(),
+        "same operation cannot change its source"
+    );
+    assert_eq!(
+        reopened
+            .thread_queue()
+            .compare_delete(thread_id, &item.id, "unknown-missing", changed)
+            .await
+            .unwrap(),
+        (false, false),
+        "absence alone is not deletion evidence"
+    );
+}
