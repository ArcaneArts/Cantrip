diff --git a/codex-rs/tui/src/chatwidget/managed_queue.rs b/codex-rs/tui/src/chatwidget/managed_queue.rs
new file mode 100644
index 0000000..407f364
--- /dev/null
+++ b/codex-rs/tui/src/chatwidget/managed_queue.rs
@@ -0,0 +1,441 @@
+use super::*;
+use crate::managed_queue::InputAction;
+use crate::managed_queue::Request;
+use crate::managed_queue::Snapshot;
+use serde_json::json;
+
+impl ChatWidget {
+    pub(crate) fn set_managed_queue_thread(&mut self, thread_id: Option<ThreadId>) {
+        self.bottom_pane.set_managed_queue(thread_id.is_some());
+        if self.input_queue.managed.thread_id == thread_id {
+            return;
+        }
+        // Pending mutation records survive transport loss; a different thread
+        // cannot replay them. They remain available when that exact view returns.
+        self.input_queue.managed.thread_id = thread_id;
+        self.input_queue.managed.items.clear();
+        self.input_queue.managed.pending_imports.clear();
+        self.input_queue.managed.revision = None;
+        self.input_queue.managed.refresh_in_flight = false;
+        self.input_queue.managed.refresh_dirty = false;
+        if thread_id.is_some() {
+            self.refresh_managed_queue(false);
+        }
+        self.refresh_pending_input_preview();
+    }
+
+    pub(crate) fn managed_queue_disconnected(&mut self) {
+        self.input_queue.managed.refresh_in_flight = false;
+        self.input_queue.managed.refresh_dirty = true;
+    }
+
+    pub(crate) fn refresh_managed_queue(&mut self, show: bool) {
+        let state = &mut self.input_queue.managed;
+        let Some(thread_id) = state.thread_id else {
+            return;
+        };
+        state.show_on_refresh |= show;
+        if state.refresh_in_flight {
+            state.refresh_dirty = true;
+            return;
+        }
+        state.refresh_in_flight = true;
+        state.refresh_dirty = false;
+        self.app_event_tx
+            .send(AppEvent::ManagedQueueRequest(Request {
+                thread_id,
+                operation_id: uuid::Uuid::new_v4(),
+                method: "thread/queue/list",
+                params: json!({"threadId":thread_id.to_string()}),
+                draft: None,
+            }));
+    }
+
+    pub(crate) fn managed_queue_result(
+        &mut self,
+        request: Request,
+        result: Result<serde_json::Value, String>,
+        uncertain: bool,
+    ) {
+        let current = self.input_queue.managed.thread_id == Some(request.thread_id);
+        if request.method == "thread/queue/list" {
+            if !current {
+                return;
+            }
+            self.input_queue.managed.refresh_in_flight = false;
+            match result
+                .and_then(|value| {
+                    serde_json::from_value::<Snapshot>(value).map_err(|error| error.to_string())
+                })
+                .and_then(|snapshot| self.input_queue.managed.apply(snapshot))
+            {
+                Ok(()) => {
+                    self.refresh_pending_input_preview();
+                    if self.input_queue.managed.show_on_refresh {
+                        self.input_queue.managed.show_on_refresh = false;
+                        self.show_managed_queue();
+                    }
+                }
+                Err(error) => {
+                    self.add_error_message(format!("Could not load shared queue: {error}"))
+                }
+            }
+            if self.input_queue.managed.refresh_dirty {
+                self.refresh_managed_queue(false);
+            }
+            return;
+        }
+        match result {
+            Ok(value) => {
+                // A start receipt describes actual native execution, never a
+                // projected future turn or completion of the model response.
+                if request.method == "thread/queue/start"
+                    && value
+                        .pointer("/turn/id")
+                        .and_then(serde_json::Value::as_str)
+                        .is_none_or(str::is_empty)
+                    && !(value
+                        .pointer("/managedAction/status")
+                        .and_then(serde_json::Value::as_str)
+                        == Some("applied")
+                        && value
+                            .pointer("/managedAction/operationId")
+                            .and_then(serde_json::Value::as_str)
+                            == Some(request.operation_id.to_string().as_str())
+                        && value
+                            .pointer("/managedAction/method")
+                            .and_then(serde_json::Value::as_str)
+                            .is_some_and(|method| !method.is_empty()))
+                {
+                    self.add_error_message("Shared queue start returned no native turn receipt; its operation is retained for reconciliation.".into());
+                    return;
+                }
+                self.input_queue
+                    .managed
+                    .pending
+                    .remove(&request.operation_id);
+                if current {
+                    self.refresh_managed_queue(false);
+                }
+            }
+            Err(error) => {
+                if uncertain {
+                    self.add_error_message(format!("Shared queue acknowledgment was lost: {error}. Ctrl+Q retains this exact operation for retry."));
+                } else {
+                    self.input_queue
+                        .managed
+                        .pending
+                        .remove(&request.operation_id);
+                    if current {
+                        if let Some(draft) = request.draft {
+                            self.restore_user_message_to_composer(draft);
+                        }
+                        self.add_error_message(format!("Shared queue operation rejected: {error}"));
+                        self.refresh_managed_queue(false);
+                    }
+                }
+            }
+        }
+        self.request_redraw();
+    }
+
+    pub(crate) fn retain_managed_queue_request(&mut self, request: &Request) {
+        if request.method != "thread/queue/list" {
+            self.input_queue
+                .managed
+                .pending
+                .insert(request.operation_id, request.clone());
+        }
+    }
+
+    pub(super) fn prepare_managed_queue_input(
+        &mut self,
+        mut message: UserMessage,
+        action: QueuedInputAction,
+        pending_pastes: Vec<(String, String)>,
+    ) {
+        (message.text, message.text_elements) =
+            crate::bottom_pane::ChatComposer::expand_pending_pastes(
+                &message.text,
+                message.text_elements,
+                &pending_pastes,
+            );
+        if !self.is_session_configured() {
+            self.restore_user_message_to_composer(message);
+            self.add_error_message(
+                "Shared thread is still loading; the draft has been preserved.".into(),
+            );
+            return;
+        }
+        let action = match action {
+            QueuedInputAction::Plain if message.text.starts_with('!') => InputAction::RunShell,
+            QueuedInputAction::Plain => InputAction::Plain,
+            QueuedInputAction::Literal => InputAction::Literal,
+            QueuedInputAction::ParseSlash => InputAction::ParseSlash,
+            QueuedInputAction::RunShell => InputAction::RunShell,
+        };
+        self.input_queue.managed.preparing_input = Some(action);
+        // Reuse native mention/skill/image/IDE/task-reference conversion. The
+        // submission hook below captures input before any turn or shell effect.
+        self.submit_user_message_with_shell_escape_policy(message, ShellEscapePolicy::Disallow);
+        self.input_queue.managed.preparing_input = None;
+    }
+
+    pub(super) fn submit_managed_queue_input(&mut self, input: Vec<UserInput>, draft: UserMessage) {
+        let Some(thread_id) = self.input_queue.managed.thread_id else {
+            return;
+        };
+        let Some(action) = self.input_queue.managed.preparing_input else {
+            return;
+        };
+        let operation_id = uuid::Uuid::new_v4();
+        let request = Request {
+            thread_id,
+            operation_id,
+            method: "thread/queue/add",
+            params: json!({"threadId":thread_id.to_string(),"input":input,"clientUserMessageId":operation_id.to_string(),"managed":{"operationId":operation_id.to_string(),"action":action},"expectedRevision":self.input_queue.managed.revision.map(|revision|revision.to_string())}),
+            draft: Some(draft),
+        };
+        self.retain_managed_queue_request(&request);
+        self.app_event_tx
+            .send(AppEvent::ManagedQueueRequest(request));
+    }
+
+    pub(crate) fn show_managed_queue(&mut self) {
+        let Some(thread_id) = self.input_queue.managed.thread_id else {
+            return;
+        };
+        let mut items = self
+            .input_queue
+            .managed
+            .items
+            .iter()
+            .map(|item| {
+                let id = item.id.clone();
+                SelectionItem {
+                    name: item.label(),
+                    description: Some(
+                        [
+                            item.managed.mode.as_deref(),
+                            item.managed.model_label.as_deref(),
+                            item.managed.worktree_label.as_deref(),
+                        ]
+                        .into_iter()
+                        .flatten()
+                        .collect::<Vec<_>>()
+                        .join(" · "),
+                    ),
+                    actions: vec![Box::new(move |tx| {
+                        tx.send(AppEvent::ManagedQueueItemMenu(id.clone()))
+                    })],
+                    dismiss_on_select: true,
+                    ..Default::default()
+                }
+            })
+            .collect::<Vec<_>>();
+        for transfer in &self.input_queue.managed.pending_imports {
+            items.push(SelectionItem {
+                name: transfer.label(),
+                description: Some(
+                    "Preserved native input; transfer needs reconciliation before execution."
+                        .into(),
+                ),
+                is_disabled: true,
+                ..Default::default()
+            });
+        }
+        for request in self
+            .input_queue
+            .managed
+            .pending
+            .values()
+            .filter(|request| request.thread_id == thread_id)
+        {
+            let request = request.clone();
+            items.push(SelectionItem {
+                name: format!("Retry unacknowledged {}", request.method),
+                description: request.draft.as_ref().map(|draft| draft.text.clone()),
+                actions: vec![Box::new(move |tx| {
+                    tx.send(AppEvent::ManagedQueueRequest(request.clone()))
+                })],
+                dismiss_on_select: true,
+                ..Default::default()
+            });
+        }
+        let refresh = Request {
+            thread_id,
+            operation_id: uuid::Uuid::new_v4(),
+            method: "thread/queue/list",
+            params: json!({"threadId":thread_id.to_string()}),
+            draft: None,
+        };
+        items.push(SelectionItem {
+            name: "Refresh shared queue".into(),
+            actions: vec![Box::new(move |tx| {
+                tx.send(AppEvent::ManagedQueueRequest(refresh.clone()))
+            })],
+            dismiss_on_select: true,
+            ..Default::default()
+        });
+        self.show_selection_view(SelectionViewParams {
+            title: Some("Shared queue".into()),
+            subtitle: Some(
+                if self.input_queue.managed.paused {
+                    "Paused. Start an item explicitly to resume."
+                } else {
+                    "Changes are shared with the other views."
+                }
+                .into(),
+            ),
+            items,
+            footer_hint: Some(standard_popup_hint_line()),
+            ..Default::default()
+        });
+    }
+
+    pub(crate) fn show_managed_queue_item(&mut self, id: String) {
+        let Some(thread_id) = self.input_queue.managed.thread_id else {
+            return;
+        };
+        let Some(item) = self
+            .input_queue
+            .managed
+            .items
+            .iter()
+            .find(|item| item.id == id)
+            .cloned()
+        else {
+            self.refresh_managed_queue(true);
+            return;
+        };
+        let revision = self
+            .input_queue
+            .managed
+            .revision
+            .map(|revision| revision.to_string());
+        let make_action = |name: &str, method: &'static str, mut params: serde_json::Value| {
+            let operation_id = uuid::Uuid::new_v4();
+            params["threadId"] = json!(thread_id.to_string());
+            params["expectedRevision"] = json!(revision);
+            params["managed"] = json!({"operationId":operation_id.to_string()});
+            let request = Request {
+                thread_id,
+                operation_id,
+                method,
+                params,
+                draft: None,
+            };
+            SelectionItem {
+                name: name.into(),
+                actions: vec![Box::new(move |tx| {
+                    tx.send(AppEvent::ManagedQueueRequest(request.clone()))
+                })],
+                dismiss_on_select: true,
+                ..Default::default()
+            }
+        };
+        let edit_id = id.clone();
+        let mut items = vec![
+            SelectionItem {
+                name: "Edit text".into(),
+                actions: vec![Box::new(move |tx| {
+                    tx.send(AppEvent::ManagedQueueEdit(edit_id.clone()))
+                })],
+                dismiss_on_select: true,
+                ..Default::default()
+            },
+            make_action(
+                "Remove",
+                "thread/queue/delete",
+                json!({"queuedSubmissionId":id}),
+            ),
+            make_action(
+                "Start now",
+                "thread/queue/start",
+                json!({"queuedSubmissionId":id}),
+            ),
+        ];
+        let mut ids = self
+            .input_queue
+            .managed
+            .items
+            .iter()
+            .map(|item| item.id.clone())
+            .collect::<Vec<_>>();
+        let position = ids
+            .iter()
+            .position(|current| current == &id)
+            .unwrap_or_default();
+        if position > 0 {
+            ids.swap(position, position - 1);
+            items.push(make_action(
+                "Move up",
+                "thread/queue/reorder",
+                json!({"queuedSubmissionIds":ids}),
+            ));
+            ids.swap(position, position - 1);
+        }
+        if position + 1 < ids.len() {
+            ids.swap(position, position + 1);
+            items.push(make_action(
+                "Move down",
+                "thread/queue/reorder",
+                json!({"queuedSubmissionIds":ids}),
+            ));
+        }
+        self.show_selection_view(SelectionViewParams {
+            title: Some(item.label()),
+            items,
+            footer_hint: Some(standard_popup_hint_line()),
+            ..Default::default()
+        });
+    }
+
+    pub(crate) fn edit_managed_queue_item(&mut self, id: String) {
+        let Some(thread_id) = self.input_queue.managed.thread_id else {
+            return;
+        };
+        let Some(item) = self
+            .input_queue
+            .managed
+            .items
+            .iter()
+            .find(|item| item.id == id)
+            .cloned()
