+#[tokio::test]
+async fn managed_goal_epoch_matches_attempt_and_survives_cold_resume() -> Result<()> {
+    use codex_app_server_protocol::ManagedExecutionRequestedNotification;
+    let (app, home, server) = queue_app(Vec::new()).await?;
+    drop(app);
+    let config_path = home.path().join("config.toml");
+    let mut config: toml::Value = toml::from_str(&std::fs::read_to_string(&config_path)?)?;
+    config
+        .as_table_mut()
+        .unwrap()
+        .entry("features")
+        .or_insert_with(|| toml::Value::Table(Default::default()))
+        .as_table_mut()
+        .unwrap()
+        .insert("goals".into(), toml::Value::Boolean(true));
+    std::fs::write(config_path, toml::to_string(&config)?)?;
+    let mut app = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .without_managed_config()
+        .build_initialized()
+        .await?;
+    let managed = |generation: &str| json!({"mcpServers":{},"developerInstructions":null,"multiAgentEnabled":false,"subagentModel":null,"subagentReasoningEffort":null,"executionGate":{"runnerGeneration":generation}});
+    let thread = app
+        .start_thread(serde_json::from_value(
+            json!({"managedConfig":managed("epoch-one")}),
+        )?)
+        .await?
+        .thread;
+    let set = app
+        .send_raw_request(
+            "thread/goal/set",
+            Some(json!({"threadId":thread.id,"objective":"identical objective","status":"paused"})),
+        )
+        .await?;
+    let first: Value = timeout(READ_TIMEOUT, app.read_response(set)).await??;
+    let set = app
+        .send_raw_request(
+            "thread/goal/set",
+            Some(json!({"threadId":thread.id,"objective":"identical objective","status":"paused"})),
+        )
+        .await?;
+    let second: Value = timeout(READ_TIMEOUT, app.read_response(set)).await??;
+    assert_ne!(first["goalEpoch"], second["goalEpoch"]);
+    let set = app
+        .send_raw_request(
+            "thread/goal/set",
+            Some(json!({"threadId":thread.id,"status":"active"})),
+        )
+        .await?;
+    let active: Value = timeout(READ_TIMEOUT, app.read_response(set)).await??;
+    let epoch = active["goalEpoch"]
+        .as_str()
+        .context("actual goal epoch")?
+        .to_string();
+    let proposed: ManagedExecutionRequestedNotification = timeout(
+        READ_TIMEOUT,
+        app.read_notification("thread/managedExecution/requested"),
+    )
+    .await??;
+    assert_eq!(proposed.goal_epoch.as_deref(), Some(epoch.as_str()));
+    let get = app
+        .send_raw_request("thread/goal/get", Some(json!({"threadId":thread.id})))
+        .await?;
+    let current: Value = timeout(READ_TIMEOUT, app.read_response(get)).await??;
+    assert_eq!(current["goalEpoch"], json!(epoch));
+    let deny=app.send_raw_request("thread/managedExecution/resolve",Some(json!({"threadId":thread.id,"runnerGeneration":"epoch-one","attemptId":proposed.attempt_id,"operationGeneration":null,"allow":false}))).await?;
+    let _: Value = timeout(READ_TIMEOUT, app.read_response(deny)).await??;
+    drop(app);
+    let mut app = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .without_managed_config()
+        .build_initialized()
+        .await?;
+    let resume = app
+        .send_raw_request(
+            "thread/resume",
+            Some(json!({"threadId":thread.id,"managedConfig":managed("epoch-two")})),
+        )
+        .await?;
+    let _: Value = timeout(READ_TIMEOUT, app.read_response(resume)).await??;
+    let proposed: ManagedExecutionRequestedNotification = timeout(
+        READ_TIMEOUT,
+        app.read_notification("thread/managedExecution/requested"),
+    )
+    .await??;
+    assert_eq!(proposed.goal_epoch.as_deref(), Some(epoch.as_str()));
+    let get = app
+        .send_raw_request("thread/goal/get", Some(json!({"threadId":thread.id})))
+        .await?;
+    let current: Value = timeout(READ_TIMEOUT, app.read_response(get)).await??;
+    assert_eq!(current["goalEpoch"], json!(epoch));
+    // Stop invalidates the exact pending ticket before clear takes the goal permit.
+    let stop = app
+        .send_raw_request(
+            "thread/managedExecution/invalidate",
+            Some(json!({"threadId":thread.id,"runnerGeneration":"epoch-two"})),
+        )
+        .await?;
+    let _: Value = timeout(READ_TIMEOUT, app.read_response(stop)).await??;
+    let clear = app
+        .send_raw_request("thread/goal/clear", Some(json!({"threadId":thread.id})))
+        .await?;
+    let cleared: Value = timeout(READ_TIMEOUT, app.read_response(clear)).await??;
+    assert_eq!(cleared["cleared"], json!(true));
+    let get = app
+        .send_raw_request("thread/goal/get", Some(json!({"threadId":thread.id})))
+        .await?;
+    let current: Value = timeout(READ_TIMEOUT, app.read_response(get)).await??;
+    assert_eq!(current["goalEpoch"], Value::Null);
+    let set = app
+        .send_raw_request(
+            "thread/goal/set",
+            Some(json!({"threadId":thread.id,"objective":"identical objective","status":"paused"})),
+        )
+        .await?;
+    let recreated: Value = timeout(READ_TIMEOUT, app.read_response(set)).await??;
+    assert_ne!(recreated["goalEpoch"], json!(epoch));
+    assert!(server.received_requests().await.unwrap().is_empty());
+    Ok(())
+}
