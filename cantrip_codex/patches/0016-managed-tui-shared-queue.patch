+    assert_eq!(completed.turn.id, next.turn_id);
+    assert_eq!(server.received_requests().await.unwrap().len(), 1);
+    let following: ManagedExecutionRequestedNotification = timeout(
+        READ_TIMEOUT,
+        app.read_notification("thread/managedExecution/requested"),
+    )
+    .await??;
+    let stop = app
+        .send_raw_request(
+            "thread/managedExecution/invalidate",
+            Some(json!({"threadId":thread.id,"runnerGeneration":"goal-runner"})),
+        )
+        .await?;
+    let _: Value = timeout(READ_TIMEOUT, app.read_response(stop)).await??;
+    let stopped: ManagedExecutionDeclinedNotification = timeout(
+        READ_TIMEOUT,
+        app.read_notification("thread/managedExecution/declined"),
+    )
+    .await??;
+    assert_eq!(stopped.attempt_id, following.attempt_id);
+    let wake = app
+        .send_raw_request(
+            "thread/managedExecution/wake",
+            Some(json!({"threadId":thread.id,"runnerGeneration":"goal-runner"})),
+        )
+        .await?;
+    let receipt: Value = timeout(READ_TIMEOUT, app.read_response(wake)).await??;
+    assert_eq!(receipt, json!({"scheduled":false}));
+    assert_eq!(server.received_requests().await.unwrap().len(), 1);
+    Ok(())
+}
