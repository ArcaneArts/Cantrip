+#[tokio::test]
+async fn managed_execution_queue_delete_compares_input_and_recovers_receipt_after_restart()
+-> Result<()> {
+    let (mut app, home, server) = queue_app(Vec::new()).await?;
+    let config = |generation: &str| json!({"mcpServers":{},"developerInstructions":null,"multiAgentEnabled":false,"subagentModel":null,"subagentReasoningEffort":null,"executionGate":{"runnerGeneration":generation}});
+    let thread = app
+        .start_thread(serde_json::from_value(
+            json!({"managedConfig":config("delete-runner")}),
+        )?)
+        .await?
+        .thread;
+    let stop = app
+        .send_raw_request(
+            "thread/managedExecution/invalidate",
+            Some(json!({"threadId":thread.id,"runnerGeneration":"delete-runner"})),
+        )
+        .await?;
+    let _: Value = app.read_response(stop).await?;
+    let add = app
+        .send_raw_request(
+            "thread/queue/add",
+            Some(serde_json::to_value(submission(&thread.id, "original"))?),
+        )
+        .await?;
+    let original: ThreadQueueAddResponse = app.read_response(add).await?;
+    let id = original.queued_submission.id.clone();
+    let update=app.send_raw_request("thread/queue/update",Some(json!({"threadId":thread.id,"queuedSubmissionId":id,"input":[{"type":"text","text":"edited elsewhere"}]}))).await?;
+    let changed: ThreadQueueUpdateResponse = app.read_response(update).await?;
+    let expected = |generation: &str, operation: &str, item: &QueuedSubmission| json!({"threadId":thread.id,"runnerGeneration":generation,"operationId":operation,"queuedSubmissionId":item.id,"expectedInput":item.input,"expectedClientUserMessageId":item.client_user_message_id});
+    let wrong = app
+        .send_raw_request(
+            "thread/managedExecution/queueDelete",
+            Some(expected(
+                "other-runner",
+                "wrong-owner",
+                &original.queued_submission,
+            )),
+        )
+        .await?;
+    app.read_stream_until_error_message(RequestId::Integer(wrong))
+        .await?;
+    let stale = app
+        .send_raw_request(
+            "thread/managedExecution/queueDelete",
+            Some(expected(
+                "delete-runner",
+                "stale-source",
+                &original.queued_submission,
+            )),
+        )
+        .await?;
+    assert_eq!(
+        app.read_response::<Value>(stale).await?,
+        json!({"deleted":false,"conflict":true})
+    );
+    let list = app
+        .send_raw_request("thread/queue/list", Some(json!({"threadId":thread.id})))
+        .await?;
+    assert_eq!(
+        app.read_response::<ThreadQueueListResponse>(list)
+            .await?
+            .data,
+        vec![changed.queued_submission.clone()]
+    );
+    let delete = app
+        .send_raw_request(
+            "thread/managedExecution/queueDelete",
+            Some(expected(
+                "delete-runner",
+                "exact-source",
+                &changed.queued_submission,
+            )),
+        )
+        .await?;
+    assert_eq!(
+        app.read_response::<Value>(delete).await?,
+        json!({"deleted":true,"conflict":false})
+    );
+    app.shutdown_gracefully().await?;
+    let mut reopened = TestAppServer::builder()
+        .with_codex_home(home.path())
+        .without_managed_config()
+        .build_initialized()
+        .await?;
+    let resume = reopened
+        .send_raw_request(
+            "thread/resume",
+            Some(json!({"threadId":thread.id,"managedConfig":config("reopened-delete-runner")})),
+        )
+        .await?;
+    let _: Value = reopened.read_response(resume).await?;
+    let retry = reopened
+        .send_raw_request(
+            "thread/managedExecution/queueDelete",
+            Some(expected(
+                "reopened-delete-runner",
+                "exact-source",
+                &changed.queued_submission,
+            )),
+        )
+        .await?;
+    assert_eq!(
+        reopened.read_response::<Value>(retry).await?,
+        json!({"deleted":true,"conflict":false})
+    );
+    let mismatch = reopened
+        .send_raw_request(
+            "thread/managedExecution/queueDelete",
+            Some(expected(
+                "reopened-delete-runner",
+                "exact-source",
+                &original.queued_submission,
+            )),
+        )
+        .await?;
+    reopened
+        .read_stream_until_error_message(RequestId::Integer(mismatch))
+        .await?;
+    assert!(server.received_requests().await.unwrap().is_empty());
+    Ok(())
+}
