+#[test]
+fn inspects_metadata_and_reports_runtime_before_decoding_an_incompatible_payload() {
+    #[derive(Debug, Deserialize, Serialize)]
+    struct CurrentPayload {
+        required_current_field: u64,
+    }
+    let directory = tempfile::tempdir().unwrap();
+    let owner = store(directory.path());
+    owner.commit(None, &checkpoint(1)).unwrap();
+    let bytes = std::fs::read(&owner.path).unwrap();
+    drop(owner);
+    let current =
+        LockedCheckpoint::<CurrentPayload>::acquire(directory.path(), "thread/with/unsafe/path")
+            .unwrap();
+    let metadata = current.read_metadata().unwrap().unwrap();
+    assert_eq!(metadata.identity, checkpoint(1).identity);
+    assert_eq!(metadata.runtime_version, "fixture-runtime-1");
+    assert_eq!(metadata.revision, 1);
+    assert_eq!(metadata.state, CheckpointState::Suspended);
+    let error = current.read("fixture-runtime-2").unwrap_err();
+    assert!(error.to_string().contains("runtime version is unsupported"));
+    assert!(error.to_string().contains("fixture-runtime-1"));
+    assert!(error.to_string().contains("fixture-runtime-2"));
+    assert!(
+        current
+            .read("fixture-runtime-1")
+            .unwrap_err()
+            .to_string()
+            .contains("continuation")
+    );
+    assert_eq!(std::fs::read(&current.path).unwrap(), bytes);
+    // Metadata inspection is subject to the same actual checksum and identity
+    // evidence as restoration; it never invents a descriptor from corrupt bytes.
+    let mut envelope: Envelope = serde_json::from_slice(&bytes).unwrap();
+    envelope.record_json.push(' ');
+    std::fs::write(&current.path, serde_json::to_vec(&envelope).unwrap()).unwrap();
+    assert!(current.read_metadata().is_err());
+}
