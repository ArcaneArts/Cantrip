+//! Stored suspension inspection without creating a session or runtime resources.
+
+use super::ThreadManager;
+use crate::session::durable_suspension::NativeSuspension;
+use crate::session::durable_suspension::SavedTurn;
+use crate::session::durable_suspension::descriptor;
+use crate::session::durable_suspension::validate_record_history;
+use codex_protocol::ThreadId;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::CodexErrorDetails;
+use codex_protocol::error::Result;
+use codex_protocol::protocol::ThreadHistoryMode;
+use codex_thread_store::LoadThreadHistoryParams;
+use codex_thread_store::ReadThreadParams;
+use codex_turn_checkpoint::CheckpointState;
+use codex_turn_checkpoint::LockedCheckpoint;
+use std::path::Path;
+
+fn io(error: impl std::fmt::Display) -> CodexErr {
+    CodexErr::Io(std::io::Error::other(error.to_string()))
+}
+
+impl ThreadManager {
+    /// A loaded thread retains its existing process lock. An unloaded thread is
+    /// inspected under temporary exclusive ownership and is never attached.
+    pub async fn read_stored_durable_suspension(
+        &self,
+        codex_home: &Path,
+        thread_id: ThreadId,
+    ) -> Result<Option<NativeSuspension>> {
+        match self.get_thread(thread_id).await {
+            Ok(thread) => return thread.read_durable_suspension().await,
+            Err(error) if matches!(error.details(), CodexErrorDetails::ThreadNotFound(_)) => {}
+            Err(error) => return Err(error),
+        }
+        let directory = codex_home.join("turn-suspensions");
+        let (ownership, record) = tokio::task::spawn_blocking(move || {
+            let ownership =
+                LockedCheckpoint::<SavedTurn>::acquire(&directory, &thread_id.to_string())
+                    .map_err(io)?;
+            let record = ownership
+                .read(crate::session::durable_suspension::RUNTIME)
+                .map_err(io)?;
+            Ok::<_, CodexErr>((ownership, record))
+        })
+        .await
+        .map_err(io)??;
+        // Keep the actual OS lock through all native-history validation.
+        let _ownership = ownership;
+        let Some(record) = record else {
+            return Ok(None);
+        };
+        if record.state != CheckpointState::Suspended {
+            return Ok(None);
+        }
+        let stored = self
+            .state
+            .thread_store
+            .read_thread(ReadThreadParams {
+                thread_id,
+                include_archived: true,
+                include_history: false,
+            })
+            .await
+            .map_err(io)?;
+        if stored.source.is_internal() {
+            return Err(CodexErr::ThreadNotFound(thread_id));
+        }
+        let history = if stored.history_mode == ThreadHistoryMode::Paginated {
+            self.state
+                .thread_store
+                .read_paginated_history_snapshot(LoadThreadHistoryParams {
+                    thread_id,
+                    include_archived: true,
+                })
+                .await
+                .map_err(io)?
+                .records
+        } else {
+            self.state
+                .thread_store
+                .load_history(LoadThreadHistoryParams {
+                    thread_id,
+                    include_archived: true,
+                })
+                .await
+                .map_err(io)?
+                .items
+        };
+        validate_record_history(&record, &history)?;
+        Ok(Some(descriptor(&record)))
+    }
+}
