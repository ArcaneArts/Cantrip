+    /// Caller holds `inputs`. Commit data before publishing acceptance to live
+    /// memory or an RPC caller. Stable capture identity survives amendments.
+    async fn amend(
+        self: &Arc<Self>,
+        session: &Session,
+        change: impl FnOnce(&mut SavedTurn) -> Result<()> + Send + 'static,
+    ) -> Result<()> {
+        if !self.frozen.load(Ordering::Acquire) || self.capture_pending.load(Ordering::Acquire) {
+            // The actual final capture takes this same input boundary and will
+            // include everything accepted before it commits.
+            return Ok(());
+        }
+        let epoch = self.epoch.load(Ordering::Acquire);
+        let owner = Arc::clone(self);
+        self.with_store(session, move |store| {
+            if owner.epoch.load(Ordering::Acquire) != epoch
+                || !owner.frozen.load(Ordering::Acquire)
+                || owner.stopping.load(Ordering::Acquire)
+            {
+                return Err(invalid("held input acceptance was superseded"));
+            }
+            let mut record = store
+                .read(RUNTIME)
+                .map_err(io)?
+                .ok_or_else(|| invalid("held input requires its committed native checkpoint"))?;
+            if !record.state.retains_continuation() {
+                return Err(invalid(
+                    "held input cannot amend a retired native checkpoint",
+                ));
+            }
+            owner.validate_expected(Some(&record))?;
+            change(
+                record
+                    .continuation
+                    .as_mut()
+                    .ok_or_else(|| invalid("native continuation is missing"))?,
+            )?;
+            let revision = record.revision;
+            record.revision = revision
+                .checked_add(1)
+                .ok_or_else(|| invalid("checkpoint revision exhausted"))?;
+            if owner.epoch.load(Ordering::Acquire) != epoch {
+                return Err(invalid(
+                    "held input acceptance was superseded before commit",
+                ));
+            }
+            store.commit(Some(revision), &record).map_err(io)?;
+            let _control = owner.control();
+            if owner.epoch.load(Ordering::Acquire) != epoch
+                || !owner.frozen.load(Ordering::Acquire)
+                || owner.stopping.load(Ordering::Acquire)
+            {
+                return Err(invalid(
+                    "held input acceptance was superseded during commit",
+                ));
+            }
+            Ok(())
+        })
+        .await
+    }
