+#[test]
+fn suspended_retained_context_keeps_later_accepted_authorization_without_reappending() {
+    let mut history = root_history();
+    let message = |id: &str, text: &str, order| ResponseItemEnvelope {
+        item: ResponseItem::Message {
+            status: None,
+            encrypted_content: None,
+            id: Some(ResponseItemId::with_suffix("msg", id)),
+            role: "user".to_owned(),
+            content: vec![ContentItem::InputText {
+                text: text.to_owned(),
+            }],
+            phase: None,
+            internal_chat_message_metadata_passthrough: Some(
+                InternalChatMessageMetadataPassthrough {
+                    turn_id: Some("held-turn".to_owned()),
+                    content_item_kinds: Some(vec![ContentItemKind("user.text".to_owned())]),
+                    ..Default::default()
+                },
+            ),
+        },
+        metadata: Some(CodexHarnessMetadata {
+            user_input_order: Some(order),
+            ..Default::default()
+        }),
+    };
+    history.record_annotated_items(
+        &mut [message("original", "Keep the original restriction.", 2)],
+        TruncationPolicy::Tokens(10_000),
+    );
+    let saved = history.retained_context().clone();
+    history.record_annotated_items(
+        &mut [message("later", "The accepted Goal now requires tests.", 7)],
+        TruncationPolicy::Tokens(10_000),
+    );
+    let expected = history.retained_context().clone();
+    let items = history.annotated_items().to_vec();
+    for _ in 0..2 {
+        history.restore_suspended_retained_context(&saved);
+        assert_eq!(history.retained_context(), &expected);
+        assert_eq!(history.annotated_items(), items);
+    }
+    assert_eq!(history.reserve_input_order(), 8);
+}
