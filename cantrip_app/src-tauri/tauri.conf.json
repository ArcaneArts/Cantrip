{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cantrip",
  "version": "0.0.0",
  "identifier": "art.cantrip",
  "build": {
    "beforeDevCommand": "pnpm --dir .. dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cantrip",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
