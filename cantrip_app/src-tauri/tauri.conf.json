{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cantrip",
  "version": "0.0.0",
  "identifier": "art.cantrip",
  "build": {
    "beforeDevCommand": "pnpm dev:desktop",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cantrip",
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundThrottling": "disabled",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/runtime": "runtime"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ArcaneArts/Cantrip/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzNzZEN0U2NUE5NDE4NTMKUldSVEdKUmE1dGQyTTVvTHFUQk9hdXFWbHUwRUEyOUlUdndyNUhMMkJJMWJrdVk0M1Y2OEExMEQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
