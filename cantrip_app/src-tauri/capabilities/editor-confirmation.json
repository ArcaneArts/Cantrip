{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "editor-confirmation",
  "description": "Show unsaved-editor confirmation messages without filesystem dialog access",
  "windows": [
    "main",
    "cantrip-pane-*",
    "cantrip-editor-*",
    "cantrip-chat-file-*"
  ],
  "permissions": ["dialog:allow-message"]
}
