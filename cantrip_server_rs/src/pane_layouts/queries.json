    "insert_member": {
      "source": "insert into \"tab_group_members\" (\"tab_key\", \"group_id\", \"project_id\", \"tab_kind\", \"tab_id\", \"position\", \"created_at\", \"updated_at\") values ($1, $2, $3, $4, $5, $6, default, default)",
