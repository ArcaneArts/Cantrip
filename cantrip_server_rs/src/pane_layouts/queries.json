      "types": ["text", "text"]
    },
    "builtin_create": {
      "source": "insert into \"project_builtin_surface_states\" (\"project_id\", \"definition_id\", \"worktree_id\", \"created_at\", \"updated_at\") values ($1, $2, default, default, default) on conflict do nothing",
      "types": ["text", "text"]
    },
    "attach_pane": {
      "source": "select \"id\", \"region\" from \"tab_groups\" where (\"tab_groups\".\"id\" = $1 and \"tab_groups\".\"project_id\" = $2) limit $3",
