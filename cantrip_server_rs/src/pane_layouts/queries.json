      "types": ["timestamptz", "text"]
    },
    "remaining_member_keys": {
      "source": "select \"tab_key\" from \"tab_group_members\" where \"tab_group_members\".\"group_id\" = $1 order by \"tab_group_members\".\"position\" asc, \"tab_group_members\".\"tab_key\" asc",
      "types": ["text"]
    },
    "groups_remaining": {
